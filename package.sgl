;;; sigil-bitcoin — Bitcoin Libraries for Sigil
;;;
;;; Workspace providing a rust-bitcoin-like ecosystem in Sigil.

(workspace
  name: "sigil-bitcoin"
  version: "0.1.0"
  description: "Bitcoin libraries for Sigil"
  url: "https://codeberg.org/sigil/sigil-bitcoin"
  license: "BSD-3-Clause"

  packages: (list
    ;; Bitcoin packages
    "packages/sigil-bitcoin-utils"
    "packages/sigil-secp256k1"
    "packages/sigil-bitcoin-primitives"
    "packages/sigil-bitcoin-encoding"
    "packages/sigil-bitcoin-keys"
    "packages/sigil-bitcoin-script"
    "packages/sigil-bitcoin-tx"
    "packages/sigil-bitcoin-miniscript"
    "packages/sigil-bitcoin-consensus"
    "packages/sigil-bitcoin-demo")

  configs: (list
    (config
      name: 'dev
      output-dir: "build/dev"
      debug?: #t
      optimize: 0
      bundle?: #f)

    (config
      name: 'web
      output-dir: "build/web"
      toolchain: 'zig
      target: "wasm32-wasi"
      deploy-dir: "www"
      debug?: #f
      optimize: 2
      c-flags: (with-sigil-c-flags
        '("-std=c99" "-D_GNU_SOURCE" "-D__SIGIL_WASM__" "-Wall" "-O2"))
      link-flags: '("-Wl,--export=sigil_wasm_init"
                    "-Wl,--export=sigil_wasm_start"
                    "-Wl,--export=sigil_wasm_eval"
                    "-Wl,--export=sigil_wasm_eval_string_length"
                    "-Wl,--export=sigil_wasm_last_result_length"
                    "-Wl,--export=sigil_wasm_copy_result"
                    "-Wl,--export=sigil_wasm_input"
                    "-Wl,--export=sigil_wasm_resume_async"
                    "-Wl,--export=malloc"
                    "-Wl,--export=free"
                    "-lc")
      features: '(web wasm))))
