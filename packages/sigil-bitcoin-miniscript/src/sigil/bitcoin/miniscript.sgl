;;; (sigil bitcoin miniscript) — Miniscript, descriptors, and wallet policies

(define-library (sigil bitcoin miniscript)
  (import (sigil struct)
          (sigil math)
          (sigil crypto)
          (sigil bitcoin utils)
          (sigil bitcoin primitives)
          (sigil bitcoin encoding)
          (sigil bitcoin keys)
          (sigil bitcoin script)
          (sigil bitcoin tx)
          (sigil secp256k1))
  (export
    miniscript-fragment miniscript-fragment?
    miniscript-fragment-kind miniscript-fragment-args miniscript-fragment-data
    miniscript-pk-k
    miniscript-pk-h
    miniscript-pk
    miniscript-after
    miniscript-older
    miniscript-sha256
    miniscript-hash256
    miniscript-ripemd160
    miniscript-hash160
    miniscript-multi
    miniscript-sortedmulti
    miniscript-and-v
    miniscript-and-b
    miniscript-andor
    miniscript-or-b
    miniscript-or-c
    miniscript-or-d
    miniscript-or-i
    miniscript-thresh
    miniscript-wrapper
    miniscript-parse
    miniscript-type-info miniscript-type-info?
    miniscript-type-info-base miniscript-type-info-properties
    miniscript-type-info-satisfaction-items
    miniscript-type-info-requires-signature
    miniscript-type-info-requires-preimage
    miniscript-type-info-has-timelock
    miniscript-type-info-nonmalleable
    miniscript-type
    miniscript-type-check
    miniscript->string
    miniscript-compile
    miniscript-compile-tapscript
    descriptor descriptor?
    descriptor-kind descriptor-args descriptor-data
    descriptor-parse
    descriptor->string
    descriptor-checksum
    descriptor-add-checksum
    descriptor-checksum-valid?
    descriptor-strip-checksum
    taproot-leaf-hash
    taproot-branch-hash
    taproot-tree-root
    taproot-output-xonly
    descriptor-derive
    descriptor-script-pubkey
    descriptor-derive-script-pubkey
    wallet-policy wallet-policy?
    wallet-policy-template wallet-policy-keys
    descriptor-psbt-plan descriptor-psbt-plan?
    descriptor-psbt-plan-descriptor
    descriptor-psbt-plan-script-pubkey
    descriptor-psbt-plan-redeem-script
    descriptor-psbt-plan-witness-script
    descriptor-psbt-plan-bip32-derivations
    descriptor-psbt-plan-taproot-bip32-derivations
    descriptor-psbt-plan-change?
    wallet-policy-from-template
    wallet-policy-descriptor
    descriptor-derive-psbt-plan
    wallet-policy-derive-psbt-plan
    descriptor-psbt-plan-annotate-input
    descriptor-psbt-plan-annotate-output
    descriptor-psbt-plan-sign-input
    descriptor-psbt-plan-finalize-input)
  (begin

    ;;; Miniscript fragment AST node.
    (define-struct miniscript-fragment
      (kind symbol?)
      (args list?)
      (data any?))

    ;;; Derived metadata used by descriptor policy and signing flows.
    (define-struct miniscript-type-info-record
      (base symbol?)
      (properties list?)
      (satisfaction-items integer?)
      (requires-signature boolean?)
      (requires-preimage boolean?)
      (has-timelock boolean?)
      (nonmalleable boolean?))

    ;;; Output descriptor AST node.
    (define-struct descriptor
      (kind symbol?)
      (args list?)
      (data any?))

    ;;; BIP390 MuSig key expression placeholder.
    (define-struct musig-key
      (keys list?)
      (suffix string?))

    ;;; BIP388 wallet policy with descriptor template and key list.
    (define-struct wallet-policy
      (template descriptor?)
      (keys list?))

    ;;; Derived descriptor data ready to attach to a PSBT input or output.
    (define-struct descriptor-psbt-plan
      (descriptor descriptor?)
      (script-pubkey bytevector?)
      (redeem-script any?)
      (witness-script any?)
      (bip32-derivations list?)
      (taproot-bip32-derivations list?)
      (change? boolean?))

    (define (whitespace? c)
      (or (char=? c #\space)
          (char=? c #\tab)
          (char=? c #\newline)
          (char=? c #\return)))

    (define (strip-whitespace s)
      (let ((chars '()))
        (do ((i 0 (+ i 1)))
            ((>= i (string-length s)) (list->string (reverse chars)))
          (let ((c (string-ref s i)))
            (unless (whitespace? c)
              (set! chars (cons c chars)))))))

    (define (string-prefix? prefix s)
      (let ((plen (string-length prefix)))
        (and (<= plen (string-length s))
             (string=? prefix (substring s 0 plen)))))

    (define (string-ends-with? s c)
      (and (> (string-length s) 0)
           (char=? c (string-ref s (- (string-length s) 1)))))

    (define (string-index-char s c)
      (let loop ((i 0))
        (cond ((>= i (string-length s)) #f)
              ((char=? c (string-ref s i)) i)
              (else (loop (+ i 1))))))

    (define (string-contains-char? s c)
      (and (string-index-char s c) #t))

    (define (string-contains-substring? s needle)
      (let ((nlen (string-length needle)))
        (cond ((= 0 nlen) #t)
              ((> nlen (string-length s)) #f)
              (else
               (let loop ((i 0))
                 (cond ((> (+ i nlen) (string-length s)) #f)
                       ((string=? needle (substring s i (+ i nlen))) #t)
                       (else (loop (+ i 1)))))))))

    (define (function-inner who prefix s)
      (unless (and (string-prefix? prefix s)
                   (string-ends-with? s #\)))
        (error (string-append who ": malformed expression")))
      (substring s (string-length prefix) (- (string-length s) 1)))

    (define (decimal-digit c)
      (let ((n (char->integer c)))
        (and (<= 48 n 57) (- n 48))))

    (define (parse-decimal s who)
      (when (= 0 (string-length s))
        (error (string-append who ": empty number")))
      (let ((n 0))
        (do ((i 0 (+ i 1)))
            ((>= i (string-length s)) n)
          (let ((d (decimal-digit (string-ref s i))))
            (when (not d)
              (error (string-append who ": invalid decimal number")))
            (set! n (+ (* n 10) d))))))

    (define (hex-char? c)
      (let ((n (char->integer c)))
        (or (<= 48 n 57)
            (<= 65 n 70)
            (<= 97 n 102))))

    (define (hex-string? s)
      (and (> (string-length s) 0)
           (let ((ok #t))
             (do ((i 0 (+ i 1)))
                 ((>= i (string-length s)) ok)
               (unless (hex-char? (string-ref s i))
                 (set! ok #f))))))

    (define (alpha-char? c)
      (let ((n (char->integer c)))
        (or (<= 65 n 90)
            (<= 97 n 122))))

    (define (compressed-pubkey-hex? s)
      (and (= 66 (string-length s))
           (hex-string? s)
           (or (string-prefix? "02" s)
               (string-prefix? "03" s))))

    (define (placeholder-key? s)
      (and (> (string-length s) 1)
           (char=? #\@ (string-ref s 0))))

    (define (symbolic-key? s)
      (and (> (string-length s) 0)
           (or (alpha-char? (string-ref s 0))
               (char=? #\[ (string-ref s 0)))))

    (define (valid-multipath-branch? branch)
      (> (string-length branch) 0))

    (define (split-semicolons s)
      (let loop ((i 0)
                 (start 0)
                 (parts '()))
        (if (>= i (string-length s))
            (reverse (cons (substring s start (string-length s)) parts))
            (if (char=? #\; (string-ref s i))
                (loop (+ i 1) (+ i 1) (cons (substring s start i) parts))
                (loop (+ i 1) start parts)))))

    (define (valid-multipath-expression? body)
      (let ((branches (split-semicolons body)))
        (and (> (length branches) 1)
             (let loop ((xs branches))
               (cond ((null? xs) #t)
                     ((valid-multipath-branch? (car xs)) (loop (cdr xs)))
                     (else #f))))))

    (define (valid-multipath-key? key)
      (let loop ((i 0)
                 (in-multipath? #f)
                 (start 0)
                 (seen? #f))
        (cond ((>= i (string-length key))
               (not in-multipath?))
              ((and in-multipath? (char=? #\> (string-ref key i)))
               (and (valid-multipath-expression? (substring key start i))
                    (loop (+ i 1) #f 0 #t)))
              (in-multipath?
               (loop (+ i 1) #t start seen?))
              ((char=? #\< (string-ref key i))
               (if seen?
                   #f
                   (loop (+ i 1) #t (+ i 1) seen?)))
              ((char=? #\> (string-ref key i))
               #f)
              (else
               (loop (+ i 1) #f start seen?)))))

    (define (valid-symbolic-key-expression? key)
      (and (symbolic-key? key)
           (valid-multipath-key? key)))

    (define (matching-close-index s open-index)
      (let loop ((i open-index)
                 (depth 0))
        (cond ((>= i (string-length s))
               #f)
              ((char=? #\( (string-ref s i))
               (loop (+ i 1) (+ depth 1)))
              ((char=? #\) (string-ref s i))
               (if (= depth 1)
                   i
                   (loop (+ i 1) (- depth 1))))
              (else
               (loop (+ i 1) depth)))))

    (define (key-expression-ranged? key)
      (and (string? key)
           (or (string-contains-substring? key "/*")
               (string-contains-substring? key "/<"))))

    (define (xpub-key-expression? key)
      (and (string? key)
           (let* ((start (if (and (> (string-length key) 0)
                                  (char=? #\[ (string-ref key 0)))
                             (let ((close (string-index-char key #\])))
                               (if close (+ close 1) (string-length key)))
                             0))
                  (rest (substring key start (string-length key))))
             (or (string-prefix? "xpub" rest)
                 (string-prefix? "tpub" rest)))))

    (define (valid-musig-suffix? suffix)
      (or (string=? suffix "")
          (and (string-prefix? "/" suffix)
               (not (string-contains-char? suffix #\h))
               (not (string-contains-char? suffix #\'))
               (valid-multipath-key? (string-append "xpub" suffix)))))

    (define (parse-musig-key-expression s)
      (let ((close (matching-close-index s 5)))
        (unless close
          (error "miniscript: malformed musig key expression"))
        (let* ((inner (substring s 6 close))
               (suffix (substring s (+ close 1) (string-length s)))
               (args (split-top-level-commas inner)))
          (unless (>= (length args) 2)
            (error "miniscript: musig requires at least two keys"))
          (unless (valid-musig-suffix? suffix)
            (error "miniscript: invalid musig derivation suffix"))
          (let ((keys (let loop ((xs args)
                                 (out '()))
                        (if (null? xs)
                            (reverse out)
                            (let ((key (parse-key-expression (car xs))))
                              (when (musig-key? key)
                                (error "miniscript: nested musig is not allowed"))
                              (loop (cdr xs) (cons key out)))))))
            (when (not (string=? suffix ""))
              (do ((xs keys (cdr xs)))
                  ((null? xs))
                (when (key-expression-ranged? (car xs))
                  (error "miniscript: ranged musig cannot contain ranged participant keys"))
                (unless (or (and (string? (car xs))
                                 (placeholder-key? (car xs)))
                            (xpub-key-expression? (car xs)))
                  (error "miniscript: ranged musig requires xpub participant keys"))))
            (musig-key keys: keys suffix: suffix)))))

    (define (valid-key-expression? key)
      (or (bytevector? key)
          (musig-key? key)
          (and (string? key)
               (or (compressed-pubkey-hex? key)
                   (placeholder-key? key)
                   (valid-symbolic-key-expression? key)))))

    (define (parse-key-expression s)
      (cond ((string-prefix? "musig(" s)
             (parse-musig-key-expression s))
            ((compressed-pubkey-hex? s)
             (hex-decode s))
            ((or (placeholder-key? s) (symbolic-key? s))
             (if (or (placeholder-key? s) (valid-symbolic-key-expression? s))
                 s
                 (error "miniscript: invalid key expression")))
            (else
             (error "miniscript: invalid key expression"))))

    (define (parse-hash-expression s len who)
      (unless (and (= (* len 2) (string-length s)) (hex-string? s))
        (error (string-append who ": invalid hash expression")))
      (hex-decode s))

    (define (key->string key)
      (cond ((bytevector? key)
             (hex-encode key))
            ((musig-key? key)
             (musig-key->string key))
            ((string? key)
             key)
            (else
             (error "miniscript: invalid key"))))

    (define (key->bytevector who key)
      (cond ((bytevector? key)
             key)
            ((and (string? key) (compressed-pubkey-hex? key))
             (hex-decode key))
            (else
             (error (string-append who ": expected concrete compressed public key")))))

    (define (key->compressed-pubkey-bytevector who key)
      (let ((pubkey (key->bytevector who key)))
        (unless (and (= 33 (bytevector-length pubkey))
                     (or (= 2 (bytevector-u8-ref pubkey 0))
                         (= 3 (bytevector-u8-ref pubkey 0)))
                     (secp256k1-pubkey-parse pubkey))
          (error (string-append who ": expected concrete compressed public key")))
        pubkey))

    (define (bytes32-one)
      (let ((out (make-bytevector 32 0)))
        (bytevector-u8-set! out 31 1)
        out))

    (define (bytevector-concat-list chunks)
      (let ((len (let loop ((xs chunks)
                            (n 0))
                   (if (null? xs)
                       n
                       (loop (cdr xs) (+ n (bytevector-length (car xs))))))))
        (let ((out (make-bytevector len 0)))
          (let loop ((xs chunks)
                     (offset 0))
            (if (null? xs)
                out
                (let ((chunk (car xs)))
                  (bytevector-copy! out offset chunk)
                  (loop (cdr xs) (+ offset (bytevector-length chunk)))))))))

    (define (musig-hash-keys pubkeys)
      (tagged-hash "KeyAgg list" (bytevector-concat-list pubkeys)))

    (define (musig-second-key pubkeys)
      (let ((first (car pubkeys)))
        (let loop ((xs pubkeys))
          (cond ((null? xs) (make-bytevector 33 0))
                ((equal? (car xs) first) (loop (cdr xs)))
                (else (car xs))))))

    (define (musig-key-aggregate-pubkey key)
      (unless (string=? "" (musig-key-suffix key))
        (error "musig-key-aggregate: ranged musig key needs concrete derivation first"))
      (let* ((pubkeys (let loop ((xs (musig-key-keys key))
                                 (out '()))
                        (if (null? xs)
                            (reverse out)
                            (loop (cdr xs)
                                  (cons (key->compressed-pubkey-bytevector
                                          "musig-key-aggregate"
                                          (car xs))
                                        out)))))
             (key-list-hash (musig-hash-keys pubkeys))
             (second-key (musig-second-key pubkeys)))
        (let loop ((xs pubkeys)
                   (aggregate #f))
          (if (null? xs)
              aggregate
              (let* ((pubkey (car xs))
                     (coefficient (if (equal? pubkey second-key)
                                      (bytes32-one)
                                      (tagged-hash
                                        "KeyAgg coefficient"
                                        (bytevector-append key-list-hash pubkey))))
                     (term (if (equal? coefficient (bytes32-one))
                               pubkey
                               (secp256k1-pubkey-tweak-mul pubkey coefficient))))
                (loop (cdr xs)
                      (if aggregate
                          (secp256k1-pubkey-combine aggregate term)
                          term)))))))

    (define (key->xonly-bytevector who key)
      (cond ((musig-key? key)
             (secp256k1-pubkey-xonly (musig-key-aggregate-pubkey key)))
            (else
             (secp256k1-pubkey-xonly
               (key->compressed-pubkey-bytevector who key)))))

    (define (key->tapscript-bytevector who key)
      (cond ((musig-key? key)
             (key->xonly-bytevector who key))
            (else
             (let ((pubkey (key->bytevector who key)))
               (unless (and (= 33 (bytevector-length pubkey))
                            (or (= 2 (bytevector-u8-ref pubkey 0))
                                (= 3 (bytevector-u8-ref pubkey 0))))
                 (error (string-append who ": expected concrete compressed public key")))
               (bytevector-copy pubkey 1 33)))))

    (define %taproot-leaf-version #xc0)

    (define (bytevector-lexicographic<? left right)
      (let ((llen (bytevector-length left))
            (rlen (bytevector-length right)))
        (let loop ((i 0))
          (cond ((and (= i llen) (= i rlen)) #f)
                ((= i llen) #t)
                ((= i rlen) #f)
                ((< (bytevector-u8-ref left i) (bytevector-u8-ref right i)) #t)
                ((> (bytevector-u8-ref left i) (bytevector-u8-ref right i)) #f)
                (else (loop (+ i 1)))))))

    ;;; Compute the BIP341 TapLeaf hash for a tapscript leaf.
    (define (taproot-leaf-hash script)
      (: bytevector? -> bytevector?)
      (tagged-hash
        "TapLeaf"
        (bytevector-append
          (make-bytevector 1 %taproot-leaf-version)
          (compact-size-encode (bytevector-length script))
          script)))

    ;;; Compute the BIP341 TapBranch hash with lexicographically sorted children.
    (define (taproot-branch-hash left right)
      (: bytevector? bytevector? -> bytevector?)
      (let* ((right-first? (bytevector-lexicographic<? right left))
             (a (if right-first? right left))
             (b (if right-first? left right)))
        (tagged-hash "TapBranch" (bytevector-append a b))))

    (define (taproot-output-xonly internal-xonly . maybe-merkle-root)
      (let* ((merkle-root (if (null? maybe-merkle-root) #f (car maybe-merkle-root)))
             (tweak-data (if merkle-root
                             (bytevector-append internal-xonly merkle-root)
                             internal-xonly))
             (tweak (tagged-hash "TapTweak" tweak-data))
             (output-pubkey (secp256k1-xonly-pubkey-tweak-add internal-xonly tweak)))
        (secp256k1-pubkey-xonly output-pubkey)))

    (define (parse-non-musig-key-expression who s)
      (let ((key (parse-key-expression s)))
        (when (musig-key? key)
          (error (string-append who ": musig key expression is only supported in Taproot descriptors")))
        key))

    (define (require-key who key)
      (unless (valid-key-expression? key)
        (error (string-append who ": invalid key expression")))
      key)

    (define (require-locktime who n)
      (unless (and (integer? n) (<= 0 n #xffffffff))
        (error (string-append who ": value out of range")))
      n)

    (define (require-hash who value len)
      (unless (and (bytevector? value) (= len (bytevector-length value)))
        (error (string-append who ": invalid hash length")))
      value)

    ;;; Construct a `pk_k(key)` Miniscript fragment.
    (define (miniscript-pk-k key)
      (: any? -> miniscript-fragment?)
      (miniscript-fragment kind: 'pk-k args: '() data: (require-key "miniscript-pk-k" key)))

    ;;; Construct a `pk_h(key)` Miniscript fragment.
    (define (miniscript-pk-h key)
      (: any? -> miniscript-fragment?)
      (miniscript-fragment kind: 'pk-h args: '() data: (require-key "miniscript-pk-h" key)))

    ;;; Construct the `pk(key)` alias for `c:pk_k(key)`.
    (define (miniscript-pk key)
      (: any? -> miniscript-fragment?)
      (miniscript-fragment kind: 'pk args: '() data: (require-key "miniscript-pk" key)))

    ;;; Construct an absolute locktime `after(n)` fragment.
    (define (miniscript-after locktime)
      (: integer? -> miniscript-fragment?)
      (miniscript-fragment kind: 'after args: '() data: (require-locktime "miniscript-after" locktime)))

    ;;; Construct a relative locktime `older(n)` fragment.
    (define (miniscript-older sequence)
      (: integer? -> miniscript-fragment?)
      (miniscript-fragment kind: 'older args: '() data: (require-locktime "miniscript-older" sequence)))

    ;;; Construct a `sha256(hash)` preimage fragment.
    (define (miniscript-sha256 hash)
      (: bytevector? -> miniscript-fragment?)
      (miniscript-fragment kind: 'sha256 args: '() data: (require-hash "miniscript-sha256" hash 32)))

    ;;; Construct a `hash256(hash)` preimage fragment.
    (define (miniscript-hash256 hash)
      (: bytevector? -> miniscript-fragment?)
      (miniscript-fragment kind: 'hash256 args: '() data: (require-hash "miniscript-hash256" hash 32)))

    ;;; Construct a `ripemd160(hash)` preimage fragment.
    (define (miniscript-ripemd160 hash)
      (: bytevector? -> miniscript-fragment?)
      (miniscript-fragment kind: 'ripemd160 args: '() data: (require-hash "miniscript-ripemd160" hash 20)))

    ;;; Construct a `hash160(hash)` preimage fragment.
    (define (miniscript-hash160 hash)
      (: bytevector? -> miniscript-fragment?)
      (miniscript-fragment kind: 'hash160 args: '() data: (require-hash "miniscript-hash160" hash 20)))

    (define (require-fragments who fragments)
      (do ((xs fragments (cdr xs)))
          ((null? xs) fragments)
        (unless (miniscript-fragment? (car xs))
          (error (string-append who ": expected miniscript fragment")))))

    ;;; Construct a `multi(k, keys...)` multisig fragment.
    (define (miniscript-multi threshold keys)
      (: integer? list? -> miniscript-fragment?)
      (unless (and (integer? threshold) (> threshold 0) (<= threshold (length keys)) (<= (length keys) 16))
        (error "miniscript-multi: invalid threshold or key count"))
      (do ((xs keys (cdr xs)))
          ((null? xs))
        (require-key "miniscript-multi" (car xs)))
      (miniscript-fragment kind: 'multi args: keys data: threshold))

    ;;; Construct a `sortedmulti(k, keys...)` multisig fragment.
    (define (miniscript-sortedmulti threshold keys)
      (: integer? list? -> miniscript-fragment?)
      (unless (and (integer? threshold) (> threshold 0) (<= threshold (length keys)) (<= (length keys) 16))
        (error "miniscript-sortedmulti: invalid threshold or key count"))
      (do ((xs keys (cdr xs)))
          ((null? xs))
        (require-key "miniscript-sortedmulti" (car xs)))
      (miniscript-fragment kind: 'sortedmulti args: keys data: threshold))

    ;;; Construct an `and_v(left, right)` fragment.
    (define (miniscript-and-v left right)
      (: miniscript-fragment? miniscript-fragment? -> miniscript-fragment?)
      (miniscript-fragment kind: 'and-v args: (list left right) data: #f))

    ;;; Construct an `and_b(left, right)` fragment.
    (define (miniscript-and-b left right)
      (: miniscript-fragment? miniscript-fragment? -> miniscript-fragment?)
      (miniscript-fragment kind: 'and-b args: (list left right) data: #f))

    ;;; Construct an `andor(left, then, else)` fragment.
    (define (miniscript-andor left then-fragment else-fragment)
      (: miniscript-fragment? miniscript-fragment? miniscript-fragment? -> miniscript-fragment?)
      (miniscript-fragment kind: 'andor args: (list left then-fragment else-fragment) data: #f))

    ;;; Construct an `or_b(left, right)` fragment.
    (define (miniscript-or-b left right)
      (: miniscript-fragment? miniscript-fragment? -> miniscript-fragment?)
      (miniscript-fragment kind: 'or-b args: (list left right) data: #f))

    ;;; Construct an `or_c(left, right)` fragment.
    (define (miniscript-or-c left right)
      (: miniscript-fragment? miniscript-fragment? -> miniscript-fragment?)
      (miniscript-fragment kind: 'or-c args: (list left right) data: #f))

    ;;; Construct an `or_d(left, right)` fragment.
    (define (miniscript-or-d left right)
      (: miniscript-fragment? miniscript-fragment? -> miniscript-fragment?)
      (miniscript-fragment kind: 'or-d args: (list left right) data: #f))

    ;;; Construct an `or_i(left, right)` fragment.
    (define (miniscript-or-i left right)
      (: miniscript-fragment? miniscript-fragment? -> miniscript-fragment?)
      (miniscript-fragment kind: 'or-i args: (list left right) data: #f))

    ;;; Construct a `thresh(k, fragments...)` fragment.
    (define (miniscript-thresh threshold fragments)
      (: integer? list? -> miniscript-fragment?)
      (unless (and (integer? threshold) (> threshold 0) (<= threshold (length fragments)))
        (error "miniscript-thresh: invalid threshold"))
      (require-fragments "miniscript-thresh" fragments)
      (miniscript-fragment kind: 'thresh args: fragments data: threshold))

    ;;; Apply wrapper characters to a Miniscript fragment.
    (define (miniscript-wrapper wrappers fragment)
      (: string? miniscript-fragment? -> miniscript-fragment?)
      (unless (and (string? wrappers) (> (string-length wrappers) 0))
        (error "miniscript-wrapper: empty wrapper"))
      (unless (miniscript-fragment? fragment)
        (error "miniscript-wrapper: expected miniscript fragment"))
      (miniscript-fragment kind: 'wrapper args: (list fragment) data: wrappers))

    (define (bump-depth depth c)
      (cond ((or (char=? c #\() (char=? c #\{) (char=? c #\[) (char=? c #\<))
             (+ depth 1))
            ((or (char=? c #\)) (char=? c #\}) (char=? c #\]) (char=? c #\>))
             (- depth 1))
            (else
             depth)))

    (define (split-top-level-commas s)
      (let loop ((i 0)
                 (depth 0)
                 (start 0)
                 (parts '()))
        (if (>= i (string-length s))
            (begin
              (when (> depth 0)
                (error "miniscript-parse: unbalanced expression"))
              (reverse (cons (substring s start (string-length s)) parts)))
            (let ((c (string-ref s i)))
              (cond ((and (char=? c #\,) (= depth 0))
                     (loop (+ i 1) depth (+ i 1) (cons (substring s start i) parts)))
                    (else
                     (let ((next-depth (bump-depth depth c)))
                       (when (< next-depth 0)
                         (error "miniscript-parse: unbalanced expression"))
                       (loop (+ i 1) next-depth start parts))))))))

    (define (split-top-level-comma s)
      (let ((parts (split-top-level-commas s)))
        (unless (= 2 (length parts))
          (error "miniscript-parse: expected two arguments"))
        parts))

    (define (find-wrapper-colon s)
      (let loop ((i 0))
        (cond ((>= i (string-length s))
               #f)
              ((char=? (string-ref s i) #\()
               #f)
              ((char=? (string-ref s i) #\:)
               i)
              (else
               (loop (+ i 1))))))

    (define (parse-key-list args)
      (let loop ((xs args)
                 (out '()))
        (if (null? xs)
            (reverse out)
            (loop (cdr xs) (cons (parse-key-expression (car xs)) out)))))

    (define (parse-fragment s)
      (let ((colon (find-wrapper-colon s)))
        (if colon
            (miniscript-wrapper
              (substring s 0 colon)
              (parse-fragment (substring s (+ colon 1) (string-length s))))
            (cond ((string=? s "1")
                   (miniscript-fragment kind: 'one args: '() data: #f))
                  ((string-prefix? "pk_k(" s)
                   (miniscript-pk-k
                     (parse-key-expression (function-inner "pk_k" "pk_k(" s))))
                  ((string-prefix? "pk_h(" s)
                   (miniscript-pk-h
                     (parse-key-expression (function-inner "pk_h" "pk_h(" s))))
                  ((string-prefix? "pk(" s)
                   (miniscript-pk
                     (parse-key-expression (function-inner "pk" "pk(" s))))
                  ((string-prefix? "after(" s)
                   (miniscript-after
                     (parse-decimal (function-inner "after" "after(" s) "after")))
                  ((string-prefix? "older(" s)
                   (miniscript-older
                     (parse-decimal (function-inner "older" "older(" s) "older")))
                  ((string-prefix? "sha256(" s)
                   (miniscript-sha256
                     (parse-hash-expression (function-inner "sha256" "sha256(" s) 32 "sha256")))
                  ((string-prefix? "hash256(" s)
                   (miniscript-hash256
                     (parse-hash-expression (function-inner "hash256" "hash256(" s) 32 "hash256")))
                  ((string-prefix? "ripemd160(" s)
                   (miniscript-ripemd160
                     (parse-hash-expression (function-inner "ripemd160" "ripemd160(" s) 20 "ripemd160")))
                  ((string-prefix? "hash160(" s)
                   (miniscript-hash160
                     (parse-hash-expression (function-inner "hash160" "hash160(" s) 20 "hash160")))
                  ((string-prefix? "multi(" s)
                   (let ((args (split-top-level-commas (function-inner "multi" "multi(" s))))
                     (miniscript-multi
                       (parse-decimal (car args) "multi")
                       (parse-key-list (cdr args)))))
                  ((string-prefix? "sortedmulti(" s)
                   (let ((args (split-top-level-commas (function-inner "sortedmulti" "sortedmulti(" s))))
                     (miniscript-sortedmulti
                       (parse-decimal (car args) "sortedmulti")
                       (parse-key-list (cdr args)))))
                  ((string-prefix? "and_v(" s)
                   (let ((parts (split-top-level-comma (function-inner "and_v" "and_v(" s))))
                     (miniscript-and-v
                       (parse-fragment (car parts))
                       (parse-fragment (cadr parts)))))
                  ((string-prefix? "and_b(" s)
                   (let ((parts (split-top-level-comma (function-inner "and_b" "and_b(" s))))
                     (miniscript-and-b
                       (parse-fragment (car parts))
                       (parse-fragment (cadr parts)))))
                  ((string-prefix? "andor(" s)
                   (let ((parts (split-top-level-commas (function-inner "andor" "andor(" s))))
                     (unless (= 3 (length parts))
                       (error "miniscript-parse: andor expected three arguments"))
                     (miniscript-andor
                       (parse-fragment (car parts))
                       (parse-fragment (cadr parts))
                       (parse-fragment (caddr parts)))))
                  ((string-prefix? "or_b(" s)
                   (let ((parts (split-top-level-comma (function-inner "or_b" "or_b(" s))))
                     (miniscript-or-b
                       (parse-fragment (car parts))
                       (parse-fragment (cadr parts)))))
                  ((string-prefix? "or_c(" s)
                   (let ((parts (split-top-level-comma (function-inner "or_c" "or_c(" s))))
                     (miniscript-or-c
                       (parse-fragment (car parts))
                       (parse-fragment (cadr parts)))))
                  ((string-prefix? "or_d(" s)
                   (let ((parts (split-top-level-comma (function-inner "or_d" "or_d(" s))))
                     (miniscript-or-d
                       (parse-fragment (car parts))
                       (parse-fragment (cadr parts)))))
                  ((string-prefix? "or_i(" s)
                   (let ((parts (split-top-level-comma (function-inner "or_i" "or_i(" s))))
                     (miniscript-or-i
                       (parse-fragment (car parts))
                       (parse-fragment (cadr parts)))))
                  ((string-prefix? "thresh(" s)
                   (let ((args (split-top-level-commas (function-inner "thresh" "thresh(" s))))
                     (miniscript-thresh
                       (parse-decimal (car args) "thresh")
                       (let loop ((xs (cdr args))
                                  (out '()))
                         (if (null? xs)
                             (reverse out)
                             (loop (cdr xs) (cons (parse-fragment (car xs)) out)))))))
                  (else
                   (error "miniscript-parse: unsupported fragment"))))))

    ;;; Parse a Miniscript expression into a fragment AST.
    (define (miniscript-parse s)
      (: string? -> miniscript-fragment?)
      (parse-fragment (strip-whitespace s)))

    (define (max-integer a b)
      (if (> a b) a b))

    (define (any-info? accessor infos)
      (let loop ((xs infos))
        (cond ((null? xs) #f)
              ((accessor (car xs)) #t)
              (else (loop (cdr xs))))))

    (define (miniscript-type-info? value)
      (miniscript-type-info-record? value))

    (define (miniscript-type-info-base info)
      (miniscript-type-info-record-base info))

    (define (miniscript-type-info-properties info)
      (miniscript-type-info-record-properties info))

    (define (miniscript-type-info-satisfaction-items info)
      (miniscript-type-info-record-satisfaction-items info))

    (define (miniscript-type-info-requires-signature info)
      (miniscript-type-info-record-requires-signature info))

    (define (miniscript-type-info-requires-preimage info)
      (miniscript-type-info-record-requires-preimage info))

    (define (miniscript-type-info-has-timelock info)
      (miniscript-type-info-record-has-timelock info))

    (define (miniscript-type-info-nonmalleable info)
      (miniscript-type-info-record-nonmalleable info))

    (define (all-info? accessor infos)
      (let loop ((xs infos))
        (cond ((null? xs) #t)
              ((accessor (car xs)) (loop (cdr xs)))
              (else #f))))

    (define (sum-satisfaction-items infos)
      (let loop ((xs infos)
                 (total 0))
        (if (null? xs)
            total
            (loop (cdr xs)
                  (+ total (miniscript-type-info-satisfaction-items (car xs)))))))

    (define (max-satisfaction-items infos)
      (let loop ((xs infos)
                 (best 0))
        (if (null? xs)
            best
            (loop (cdr xs)
                  (max-integer best (miniscript-type-info-satisfaction-items (car xs)))))))

    (define (type-properties unit? safe? nonmalleable?)
      (let ((props '()))
        (when unit?
          (set! props (cons 'unit props)))
        (when safe?
          (set! props (cons 'safe props)))
        (when nonmalleable?
          (set! props (cons 'nonmalleable props)))
        (reverse props)))

    (define (make-type-info base unit? safe? satisfaction-items requires-signature requires-preimage has-timelock nonmalleable)
      (miniscript-type-info-record
        base: base
        properties: (type-properties unit? safe? nonmalleable)
        satisfaction-items: satisfaction-items
        requires-signature: requires-signature
        requires-preimage: requires-preimage
        has-timelock: has-timelock
        nonmalleable: nonmalleable))

    (define (combine-type-info base children satisfaction-items nonmalleable)
      (make-type-info
        base
        #t
        (all-info? miniscript-type-info-nonmalleable children)
        satisfaction-items
        (any-info? miniscript-type-info-requires-signature children)
        (any-info? miniscript-type-info-requires-preimage children)
        (any-info? miniscript-type-info-has-timelock children)
        nonmalleable))

    ;;; Return Miniscript base type and signing/satisfaction metadata.
    (define (miniscript-type-info fragment)
      (: miniscript-fragment? -> any?)
      (unless (miniscript-fragment? fragment)
        (error "miniscript-type-info: expected miniscript fragment"))
      (let ((kind (miniscript-fragment-kind fragment)))
        (cond ((eq? kind 'pk-k)
               (make-type-info 'K #t #t 1 #t #f #f #t))
              ((eq? kind 'pk-h)
               (make-type-info 'K #t #t 2 #t #f #f #t))
              ((eq? kind 'pk)
               (make-type-info 'B #t #t 1 #t #f #f #t))
              ((eq? kind 'one)
               (make-type-info 'B #t #t 0 #f #f #f #t))
              ((or (eq? kind 'after) (eq? kind 'older))
               (make-type-info 'B #t #t 0 #f #f #t #t))
              ((or (eq? kind 'sha256)
                   (eq? kind 'hash256)
                   (eq? kind 'ripemd160)
                   (eq? kind 'hash160))
               (make-type-info 'B #t #t 1 #f #t #f #t))
              ((or (eq? kind 'multi) (eq? kind 'sortedmulti))
               (make-type-info 'B #t #t (+ 1 (miniscript-fragment-data fragment)) #t #f #f #t))
              ((eq? kind 'wrapper)
               (let* ((child (car (miniscript-fragment-args fragment)))
                      (child-info (miniscript-type-info child))
                      (base (if (string=? "v" (miniscript-fragment-data fragment))
                                'V
                                (miniscript-type-info-base child-info))))
                 (make-type-info
                   base
                   #t
                   (miniscript-type-info-nonmalleable child-info)
                   (miniscript-type-info-satisfaction-items child-info)
                   (miniscript-type-info-requires-signature child-info)
                   (miniscript-type-info-requires-preimage child-info)
                   (miniscript-type-info-has-timelock child-info)
                   (miniscript-type-info-nonmalleable child-info))))
              ((or (eq? kind 'and-v) (eq? kind 'and-b))
               (let* ((infos (map miniscript-type-info (miniscript-fragment-args fragment)))
                      (nonmalleable (all-info? miniscript-type-info-nonmalleable infos)))
                 (combine-type-info 'B infos (sum-satisfaction-items infos) nonmalleable)))
              ((eq? kind 'andor)
               (let ((infos (map miniscript-type-info (miniscript-fragment-args fragment))))
                 (combine-type-info 'B infos (sum-satisfaction-items infos) #f)))
              ((or (eq? kind 'or-b)
                   (eq? kind 'or-c)
                   (eq? kind 'or-d))
               (let ((infos (map miniscript-type-info (miniscript-fragment-args fragment))))
                 (combine-type-info 'B infos (sum-satisfaction-items infos) #f)))
              ((eq? kind 'or-i)
               (let ((infos (map miniscript-type-info (miniscript-fragment-args fragment))))
                 (combine-type-info 'B infos (+ 1 (max-satisfaction-items infos)) #f)))
              ((eq? kind 'thresh)
               (let ((infos (map miniscript-type-info (miniscript-fragment-args fragment))))
                 (combine-type-info 'B infos (sum-satisfaction-items infos)
                                    (all-info? miniscript-type-info-nonmalleable infos))))
              (else
               (error "miniscript-type-info: unsupported fragment")))))

    ;;; Return the coarse Miniscript base type for a fragment.
    (define (miniscript-type fragment)
      (: miniscript-fragment? -> symbol?)
      (miniscript-type-info-base (miniscript-type-info fragment)))

    ;;; Validate a Miniscript fragment and return its coarse base type.
    (define (miniscript-type-check fragment)
      (: miniscript-fragment? -> boolean?)
      (and (miniscript-type fragment) #t))

    (define (key-list->string keys)
      (join-strings
        (let loop ((xs keys)
                   (out '()))
          (if (null? xs)
              (reverse out)
              (loop (cdr xs) (cons (key->string (car xs)) out))))
        ","))

    (define (musig-key->string key)
      (string-append
        "musig("
        (key-list->string (musig-key-keys key))
        ")"
        (musig-key-suffix key)))

    (define (fragment-list->string fragments)
      (join-strings
        (let loop ((xs fragments)
                   (out '()))
          (if (null? xs)
              (reverse out)
              (loop (cdr xs) (cons (miniscript->string (car xs)) out))))
        ","))

    ;;; Render a Miniscript fragment to its canonical string form.
    (define (miniscript->string fragment)
      (: miniscript-fragment? -> string?)
      (let ((kind (miniscript-fragment-kind fragment)))
        (cond ((eq? kind 'one)
               "1")
              ((eq? kind 'pk-k)
               (string-append "pk_k(" (key->string (miniscript-fragment-data fragment)) ")"))
              ((eq? kind 'pk-h)
               (string-append "pk_h(" (key->string (miniscript-fragment-data fragment)) ")"))
              ((eq? kind 'pk)
               (string-append "pk(" (key->string (miniscript-fragment-data fragment)) ")"))
              ((eq? kind 'after)
               (string-append "after(" (number->string (miniscript-fragment-data fragment)) ")"))
              ((eq? kind 'older)
               (string-append "older(" (number->string (miniscript-fragment-data fragment)) ")"))
              ((eq? kind 'sha256)
               (string-append "sha256(" (hex-encode (miniscript-fragment-data fragment)) ")"))
              ((eq? kind 'hash256)
               (string-append "hash256(" (hex-encode (miniscript-fragment-data fragment)) ")"))
              ((eq? kind 'ripemd160)
               (string-append "ripemd160(" (hex-encode (miniscript-fragment-data fragment)) ")"))
              ((eq? kind 'hash160)
               (string-append "hash160(" (hex-encode (miniscript-fragment-data fragment)) ")"))
              ((eq? kind 'multi)
               (string-append "multi("
                              (number->string (miniscript-fragment-data fragment))
                              ","
                              (key-list->string (miniscript-fragment-args fragment))
                              ")"))
              ((eq? kind 'sortedmulti)
               (string-append "sortedmulti("
                              (number->string (miniscript-fragment-data fragment))
                              ","
                              (key-list->string (miniscript-fragment-args fragment))
                              ")"))
              ((eq? kind 'and-v)
               (string-append "and_v(" (fragment-list->string (miniscript-fragment-args fragment)) ")"))
              ((eq? kind 'and-b)
               (string-append "and_b(" (fragment-list->string (miniscript-fragment-args fragment)) ")"))
              ((eq? kind 'andor)
               (string-append "andor(" (fragment-list->string (miniscript-fragment-args fragment)) ")"))
              ((eq? kind 'or-b)
               (string-append "or_b(" (fragment-list->string (miniscript-fragment-args fragment)) ")"))
              ((eq? kind 'or-c)
               (string-append "or_c(" (fragment-list->string (miniscript-fragment-args fragment)) ")"))
              ((eq? kind 'or-d)
               (string-append "or_d(" (fragment-list->string (miniscript-fragment-args fragment)) ")"))
              ((eq? kind 'or-i)
               (string-append "or_i(" (fragment-list->string (miniscript-fragment-args fragment)) ")"))
              ((eq? kind 'thresh)
               (string-append "thresh("
                              (number->string (miniscript-fragment-data fragment))
                              ","
                              (fragment-list->string (miniscript-fragment-args fragment))
                              ")"))
              ((eq? kind 'wrapper)
               (string-append (miniscript-fragment-data fragment)
                              ":"
                              (miniscript->string (car (miniscript-fragment-args fragment)))))
              (else
               (error "miniscript->string: unsupported fragment")))))

    (define (integer->script-number n)
      (unless (and (integer? n) (<= 0 n #xffffffff))
        (error "integer->script-number: value out of range"))
      (if (= n 0)
          #u8()
          (let loop ((v n) (bytes '()))
            (if (= v 0)
                (let ((out (make-bytevector (length bytes) 0)))
                  (do ((xs bytes (cdr xs))
                       (i 0 (+ i 1)))
                      ((null? xs) out)
                    (bytevector-u8-set! out i (car xs))))
                (loop (quotient v 256)
                      (append bytes (list (remainder v 256))))))))

    (define (script-push-int n)
      (cond ((= n 0)
             (script-op op-0))
            ((and (>= n 1) (<= n 16))
             (script-op (+ #x50 n)))
            (else
             (script-push-data (integer->script-number n)))))

    (define (compile-key-push key tapscript?)
      (script-push-data
        (if tapscript?
            (key->tapscript-bytevector "miniscript-compile-tapscript" key)
            (key->bytevector "miniscript-compile" key))))

    (define (compile-multisig fragment verify? tapscript?)
      (when tapscript?
        (error "miniscript-compile-tapscript: multi/sortedmulti needs tapscript CHECKSIGADD support"))
      (let ((keys (miniscript-fragment-args fragment))
            (threshold (miniscript-fragment-data fragment)))
        (let ((script (script-push-int threshold)))
          (do ((xs keys (cdr xs)))
              ((null? xs))
            (set! script (script-append script (compile-key-push (car xs) tapscript?))))
          (script-append script
                         (script-push-int (length keys))
                         (script-op (if verify? op-checkmultisigverify op-checkmultisig))))))

    (define (compile-hashlock opcode expected)
      (script-append
        (script-op op-size)
        (script-push-int 32)
        (script-op op-equalverify)
        (script-op opcode)
        (script-push-data expected)
        (script-op op-equal)))

    (define (compile-thresh fragment tapscript?)
      (let ((fragments (miniscript-fragment-args fragment))
            (threshold (miniscript-fragment-data fragment)))
        (let ((script (compile-fragment (car fragments) tapscript?)))
          (do ((xs (cdr fragments) (cdr xs)))
              ((null? xs))
            (set! script
                  (script-append script
                                 (compile-fragment (car xs) tapscript?)
                                 (script-op op-add))))
          (script-append script
                         (script-push-int threshold)
                         (script-op op-equal)))))

    (define (compile-wrapper wrappers child tapscript?)
      (cond ((string=? wrappers "c")
             (let ((kind (miniscript-fragment-kind child)))
               (cond ((eq? kind 'pk-k)
                      (script-append
                        (compile-fragment child tapscript?)
                        (script-op op-checksig)))
                     ((eq? kind 'pk-h)
                      (script-append
                        (compile-fragment child tapscript?)
                        (script-op op-checksig)))
                     (else
                      (error "miniscript-compile: c wrapper currently supports pk_k/pk_h")))))
            ((string=? wrappers "v")
             (script-append (compile-fragment child tapscript?) (script-op op-verify)))
            ((string=? wrappers "j")
             (compile-fragment child tapscript?))
            ((string=? wrappers "s")
             (script-append (script-op op-swap) (compile-fragment child tapscript?)))
            (else
             (error "miniscript-compile: unsupported wrapper"))))

    (define (compile-fragment fragment tapscript?)
      (miniscript-type-check fragment)
      (let ((kind (miniscript-fragment-kind fragment)))
        (cond ((eq? kind 'one)
               (script-op op-1))
              ((eq? kind 'pk-k)
               (compile-key-push (miniscript-fragment-data fragment) tapscript?))
              ((eq? kind 'pk-h)
               (let ((pubkey (if tapscript?
                                 (key->tapscript-bytevector
                                   "miniscript-compile-tapscript"
                                   (miniscript-fragment-data fragment))
                                 (key->bytevector
                                   "miniscript-compile"
                                   (miniscript-fragment-data fragment)))))
                 (script-append
                   (script-op op-dup)
                   (script-op op-hash160)
                   (script-push-data (hash160 pubkey))
                   (script-op op-equalverify))))
              ((eq? kind 'pk)
               (script-append
                 (compile-key-push (miniscript-fragment-data fragment) tapscript?)
                 (script-op op-checksig)))
              ((eq? kind 'after)
               (script-append
                 (script-push-int (miniscript-fragment-data fragment))
                 (script-op op-checklocktimeverify)))
              ((eq? kind 'older)
               (script-append
                 (script-push-int (miniscript-fragment-data fragment))
                 (script-op op-checksequenceverify)))
              ((eq? kind 'sha256)
               (compile-hashlock op-sha256 (miniscript-fragment-data fragment)))
              ((eq? kind 'hash256)
               (compile-hashlock op-hash256 (miniscript-fragment-data fragment)))
              ((eq? kind 'ripemd160)
               (compile-hashlock op-ripemd160 (miniscript-fragment-data fragment)))
              ((eq? kind 'hash160)
               (compile-hashlock op-hash160 (miniscript-fragment-data fragment)))
              ((or (eq? kind 'multi) (eq? kind 'sortedmulti))
               (compile-multisig fragment #f tapscript?))
              ((eq? kind 'and-v)
               (script-append
                 (compile-fragment (car (miniscript-fragment-args fragment)) tapscript?)
                 (compile-fragment (cadr (miniscript-fragment-args fragment)) tapscript?)))
              ((eq? kind 'and-b)
               (script-append
                 (compile-fragment (car (miniscript-fragment-args fragment)) tapscript?)
                 (compile-fragment (cadr (miniscript-fragment-args fragment)) tapscript?)
                 (script-op op-booland)))
              ((eq? kind 'andor)
               (script-append
                 (compile-fragment (car (miniscript-fragment-args fragment)) tapscript?)
                 (script-op op-notif)
                 (compile-fragment (caddr (miniscript-fragment-args fragment)) tapscript?)
                 (script-op op-else)
                 (compile-fragment (cadr (miniscript-fragment-args fragment)) tapscript?)
                 (script-op op-endif)))
              ((eq? kind 'or-b)
               (script-append
                 (compile-fragment (car (miniscript-fragment-args fragment)) tapscript?)
                 (compile-fragment (cadr (miniscript-fragment-args fragment)) tapscript?)
                 (script-op op-boolor)))
              ((eq? kind 'or-c)
               (script-append
                 (compile-fragment (car (miniscript-fragment-args fragment)) tapscript?)
                 (script-op op-notif)
                 (compile-fragment (cadr (miniscript-fragment-args fragment)) tapscript?)
                 (script-op op-endif)))
              ((eq? kind 'or-d)
               (script-append
                 (compile-fragment (car (miniscript-fragment-args fragment)) tapscript?)
                 (script-op op-ifdup)
                 (script-op op-notif)
                 (compile-fragment (cadr (miniscript-fragment-args fragment)) tapscript?)
                 (script-op op-endif)))
              ((eq? kind 'or-i)
               (script-append
                 (script-op op-if)
                 (compile-fragment (car (miniscript-fragment-args fragment)) tapscript?)
                 (script-op op-else)
                 (compile-fragment (cadr (miniscript-fragment-args fragment)) tapscript?)
                 (script-op op-endif)))
              ((eq? kind 'thresh)
               (compile-thresh fragment tapscript?))
              ((eq? kind 'wrapper)
               (compile-wrapper
                 (miniscript-fragment-data fragment)
                 (car (miniscript-fragment-args fragment))
                 tapscript?))
              (else
               (error "miniscript-compile: unsupported fragment")))))

    ;;; Compile a supported Miniscript fragment into script bytes.
    (define (miniscript-compile fragment)
      (: miniscript-fragment? -> bytevector?)
      (compile-fragment fragment #f))

    ;;; Compile a supported Miniscript fragment into BIP342 tapscript bytes.
    (define (miniscript-compile-tapscript fragment)
      (: miniscript-fragment? -> bytevector?)
      (compile-fragment fragment #t))

    (define (descriptor-pkh key)
      (descriptor kind: 'pkh args: '() data: (require-key "descriptor-pkh" key)))

    (define (descriptor-wpkh key)
      (descriptor kind: 'wpkh args: '() data: (require-key "descriptor-wpkh" key)))

    (define (descriptor-sh inner)
      (descriptor kind: 'sh args: (list inner) data: #f))

    (define (key-expression-musig? key)
      (musig-key? key))

    (define (fragment-contains-musig? fragment)
      (or (key-expression-musig? (miniscript-fragment-data fragment))
          (let loop ((xs (miniscript-fragment-args fragment)))
            (cond ((null? xs) #f)
                  ((fragment-contains-musig? (car xs)) #t)
                  (else (loop (cdr xs)))))))

    (define (descriptor-contains-musig? desc)
      (let ((kind (descriptor-kind desc)))
        (cond ((or (eq? kind 'pkh) (eq? kind 'wpkh))
               (key-expression-musig? (descriptor-data desc)))
              ((eq? kind 'wsh)
               (fragment-contains-musig? (car (descriptor-args desc))))
              ((eq? kind 'sh)
               (descriptor-contains-musig? (car (descriptor-args desc))))
              (else #f))))

    (define (descriptor-wsh fragment)
      (when (fragment-contains-musig? fragment)
        (error "descriptor-wsh: musig key expression is only supported in Taproot descriptors"))
      (descriptor kind: 'wsh args: (list fragment) data: #f))

    (define (descriptor-tr key . scripts)
      (descriptor kind: 'tr args: scripts data: (require-key "descriptor-tr" key)))

    (define (tapbranch left right)
      (list 'tapbranch left right))

    (define (tapbranch? value)
      (and (pair? value) (eq? (car value) 'tapbranch)))

    (define (tapbranch-left branch)
      (cadr branch))

    (define (tapbranch-right branch)
      (caddr branch))

    (define (braced-expression? s)
      (and (> (string-length s) 1)
           (char=? #\{ (string-ref s 0))
           (string-ends-with? s #\})))

    (define (braced-inner who s)
      (unless (braced-expression? s)
        (error (string-append who ": malformed Taproot script tree")))
      (substring s 1 (- (string-length s) 1)))

    (define (parse-taproot-tree s)
      (if (braced-expression? s)
          (let ((parts (split-top-level-comma (braced-inner "tr" s))))
            (tapbranch
              (parse-taproot-tree (car parts))
              (parse-taproot-tree (cadr parts))))
          (parse-fragment s)))

    (define (taproot-tree->string tree)
      (cond ((miniscript-fragment? tree)
             (miniscript->string tree))
            ((tapbranch? tree)
             (string-append
               "{"
               (taproot-tree->string (tapbranch-left tree))
               ","
               (taproot-tree->string (tapbranch-right tree))
               "}"))
            (else
             (error "descriptor->string: unsupported Taproot script tree"))))

    ;;; Compile a parsed Taproot script tree into its BIP341 Merkle root.
    (define (taproot-tree-root tree)
      (: any? -> bytevector?)
      (cond ((miniscript-fragment? tree)
             (taproot-leaf-hash (miniscript-compile-tapscript tree)))
            ((tapbranch? tree)
             (taproot-branch-hash
               (taproot-tree-root (tapbranch-left tree))
               (taproot-tree-root (tapbranch-right tree))))
            (else
             (error "taproot-tree-root: unsupported Taproot script tree"))))

    (define %descriptor-input-charset
      (string-append
        "0123456789()[],'/*abcdefgh@:$%{}"
        "IJKLMNOPQRSTUVWXYZ&+-.;<=>?!^_|~"
        "ijklmnopqrstuvwxyzABCDEFGH`#\"\\ "))

    (define %descriptor-checksum-charset "qpzry9x8gf2tvdw0s3jn54khce6mua7l")

    (define %descriptor-checksum-generator
      (vector #xf5dee51989 #xa9fdca3312 #x1bab10e32d #x3706b1677a #x644d626ffd))

    (define (descriptor-charset-index charset c)
      (string-index-char charset c))

    (define (descriptor-string-in-charset? charset s)
      (let ((ok #t))
        (do ((i 0 (+ i 1)))
            ((>= i (string-length s)) ok)
          (unless (descriptor-charset-index charset (string-ref s i))
            (set! ok #f)))))

    (define (descriptor-polymod symbols)
      (let ((chk 1))
        (do ((xs symbols (cdr xs)))
            ((null? xs) chk)
          (let* ((value (car xs))
                 (top (arithmetic-shift chk -35))
                 (chk5 (bitwise-xor
                         (arithmetic-shift (bitwise-and chk #x7ffffffff) 5)
                         value)))
            (set! chk chk5)
            (do ((i 0 (+ i 1)))
                ((>= i 5))
              (when (not (zero? (bitwise-and top (arithmetic-shift 1 i))))
                (set! chk (bitwise-xor chk (vector-ref %descriptor-checksum-generator i)))))))))

    (define (descriptor-expand s)
      (let ((groups '())
            (symbols '()))
        (do ((i 0 (+ i 1)))
            ((>= i (string-length s))
             (begin
               (cond ((= 1 (length groups))
                      (set! symbols (append symbols (list (car groups)))))
                     ((= 2 (length groups))
                      (set! symbols
                        (append symbols (list (+ (* (car groups) 3) (cadr groups)))))))
               symbols))
          (let ((v (descriptor-charset-index %descriptor-input-charset (string-ref s i))))
            (unless v
              (error "descriptor-checksum: invalid descriptor character"))
            (set! symbols (append symbols (list (bitwise-and v 31))))
            (set! groups (append groups (list (arithmetic-shift v -5))))
            (when (= 3 (length groups))
              (set! symbols
                (append symbols
                        (list (+ (* (car groups) 9)
                                 (* (cadr groups) 3)
                                 (caddr groups)))))
              (set! groups '()))))))

    (define (descriptor-checksum-values checksum)
      (let loop ((i 0)
                 (out '()))
        (if (>= i (string-length checksum))
            (reverse out)
            (let ((v (descriptor-charset-index %descriptor-checksum-charset (string-ref checksum i))))
              (unless v
                (error "descriptor-checksum: invalid checksum character"))
              (loop (+ i 1) (cons v out))))))

    ;;; Compute the BIP380 8-character descriptor checksum.
    (define (descriptor-checksum descriptor-text)
      (: string? -> string?)
      (when (string-contains-char? descriptor-text #\#)
        (error "descriptor-checksum: descriptor already contains a checksum separator"))
      (let* ((symbols (append (descriptor-expand descriptor-text)
                              '(0 0 0 0 0 0 0 0)))
             (sum (bitwise-xor (descriptor-polymod symbols) 1))
             (out (make-string 8 #\q)))
        (do ((i 0 (+ i 1)))
            ((>= i 8) out)
          (let ((v (bitwise-and (arithmetic-shift sum (* -5 (- 7 i))) 31)))
            (string-set! out i (string-ref %descriptor-checksum-charset v))))))

    ;;; Append a BIP380 checksum to a descriptor string.
    (define (descriptor-add-checksum descriptor-text)
      (: string? -> string?)
      (string-append descriptor-text "#" (descriptor-checksum descriptor-text)))

    ;;; Return true when a descriptor contains a valid BIP380 checksum.
    (define (descriptor-checksum-valid? descriptor-text)
      (: string? -> boolean?)
      (let ((len (string-length descriptor-text)))
        (and (>= len 9)
             (char=? #\# (string-ref descriptor-text (- len 9)))
             (let ((checksum (substring descriptor-text (- len 8) len)))
               (let ((payload (substring descriptor-text 0 (- len 9))))
                 (and (descriptor-string-in-charset? %descriptor-input-charset payload)
                      (descriptor-string-in-charset? %descriptor-checksum-charset checksum)
                      (= 1
                         (descriptor-polymod
                           (append
                             (descriptor-expand payload)
                             (descriptor-checksum-values checksum))))))))))

    ;;; Remove and validate a checksum when one is present.
    (define (descriptor-strip-checksum descriptor-text)
      (: string? -> string?)
      (let ((separator (string-index-char descriptor-text #\#)))
        (if separator
            (begin
              (unless (descriptor-checksum-valid? descriptor-text)
                (error "descriptor-parse: invalid descriptor checksum"))
              (substring descriptor-text 0 (- (string-length descriptor-text) 9)))
            descriptor-text)))

    (define (parse-descriptor-inner s)
      (cond ((string-prefix? "pkh(" s)
             (descriptor-pkh (parse-non-musig-key-expression "pkh" (function-inner "pkh" "pkh(" s))))
            ((string-prefix? "wpkh(" s)
             (descriptor-wpkh (parse-non-musig-key-expression "wpkh" (function-inner "wpkh" "wpkh(" s))))
            ((string-prefix? "sh(" s)
             (descriptor-sh (parse-descriptor-inner (function-inner "sh" "sh(" s))))
            ((string-prefix? "wsh(" s)
             (descriptor-wsh (parse-fragment (function-inner "wsh" "wsh(" s))))
            ((string-prefix? "tr(" s)
             (let ((args (split-top-level-commas (function-inner "tr" "tr(" s))))
               (unless (or (= 1 (length args)) (= 2 (length args)))
                 (error "descriptor-parse: tr expects key plus optional script tree"))
               (if (= 1 (length args))
                   (descriptor-tr (parse-key-expression (car args)))
                   (descriptor-tr
                     (parse-key-expression (car args))
                     (parse-taproot-tree (cadr args))))))
            (else
             (error "descriptor-parse: unsupported descriptor"))))

    ;;; Parse an output descriptor into a descriptor AST.
    (define (descriptor-parse s)
      (: string? -> descriptor?)
      (parse-descriptor-inner (descriptor-strip-checksum (strip-whitespace s))))

    ;;; Render a descriptor AST to a canonical descriptor string.
    (define (descriptor->string desc)
      (: descriptor? -> string?)
      (let ((kind (descriptor-kind desc)))
        (cond ((eq? kind 'pkh)
               (string-append "pkh(" (key->string (descriptor-data desc)) ")"))
              ((eq? kind 'wpkh)
               (string-append "wpkh(" (key->string (descriptor-data desc)) ")"))
              ((eq? kind 'sh)
               (string-append "sh(" (descriptor->string (car (descriptor-args desc))) ")"))
              ((eq? kind 'wsh)
               (string-append "wsh(" (miniscript->string (car (descriptor-args desc))) ")"))
              ((eq? kind 'tr)
               (if (null? (descriptor-args desc))
                   (string-append "tr(" (key->string (descriptor-data desc)) ")")
                   (string-append
                     "tr("
                     (key->string (descriptor-data desc))
                     ","
                     (taproot-tree->string (car (descriptor-args desc)))
                     ")")))
              (else
               (error "descriptor->string: unsupported descriptor")))))

    (define (descriptor-redeem-script desc)
      (let ((kind (descriptor-kind desc)))
        (cond ((eq? kind 'pkh)
               (script-p2pkh (hash160 (key->bytevector "descriptor-redeem-script" (descriptor-data desc)))))
              ((eq? kind 'wpkh)
               (script-p2wpkh (hash160 (key->bytevector "descriptor-redeem-script" (descriptor-data desc)))))
              ((eq? kind 'wsh)
               (miniscript-compile (car (descriptor-args desc))))
              (else
               (error "descriptor-redeem-script: unsupported nested descriptor")))))

    ;;; Derive the scriptPubKey for a descriptor.
    ;;;
    ;;; Requires concrete public keys for descriptors that directly encode
    ;;; address scripts.
    (define (descriptor-script-pubkey desc)
      (: descriptor? -> bytevector?)
      (let ((kind (descriptor-kind desc)))
        (cond ((eq? kind 'pkh)
               (script-p2pkh (hash160 (key->bytevector "descriptor-script-pubkey" (descriptor-data desc)))))
              ((eq? kind 'wpkh)
               (script-p2wpkh (hash160 (key->bytevector "descriptor-script-pubkey" (descriptor-data desc)))))
              ((eq? kind 'sh)
               (script-p2sh (hash160 (descriptor-redeem-script (car (descriptor-args desc))))))
              ((eq? kind 'wsh)
               (script-p2wsh (sha256-bytes (miniscript-compile (car (descriptor-args desc))))))
              ((eq? kind 'tr)
               (let ((internal-xonly (key->xonly-bytevector
                                       "descriptor-script-pubkey"
                                       (descriptor-data desc))))
                 (script-p2tr
                   (if (null? (descriptor-args desc))
                       (taproot-output-xonly internal-xonly)
                       (taproot-output-xonly
                         internal-xonly
                         (taproot-tree-root (car (descriptor-args desc))))))))
              (else
               (error "descriptor-script-pubkey: unsupported descriptor")))))

    (define (list-ref-safe xs i)
      (cond ((< i 0)
             #f)
            ((null? xs)
             #f)
            ((= i 0)
             (car xs))
            (else
             (list-ref-safe (cdr xs) (- i 1)))))

    (define (require-derivation-index who n)
      (unless (and (integer? n) (>= n 0) (< n #x80000000))
        (error (string-append who ": expected non-hardened child index")))
      n)

    (define (path-segment->child-number segment)
      (let* ((len (string-length segment))
             (last (if (> len 0) (string-ref segment (- len 1)) #\space))
             (hardened? (or (char=? last #\')
                            (char=? last #\h)
                            (char=? last #\H)))
             (digits (if hardened? (substring segment 0 (- len 1)) segment))
             (n (if (> (string-length digits) 0)
                    (string->number digits)
                    #f)))
        (when (or (not n) (< n 0) (>= n #x80000000))
          (error "descriptor key origin: invalid path segment"))
        (if hardened? (+ n #x80000000) n)))

    (define (path-segments->bytes segments)
      (let loop ((xs segments)
                 (out '()))
        (if (null? xs)
            (if (null? out)
                #u8()
                (apply bytevector-append (reverse out)))
            (loop (cdr xs)
                  (cons (u32-le (path-segment->child-number (car xs))) out)))))

    (define (key-expression-origin key)
      (if (and (> (string-length key) 0)
               (char=? #\[ (string-ref key 0)))
          (let ((close (string-index-char key #\])))
            (unless close
              (error "descriptor key origin: malformed origin"))
            (substring key 1 close))
          #f))

    (define (key-expression-body key)
      (if (and (> (string-length key) 0)
               (char=? #\[ (string-ref key 0)))
          (let ((close (string-index-char key #\])))
            (unless close
              (error "descriptor-derive: malformed key origin"))
            (substring key (+ close 1) (string-length key)))
          key))

    (define (split-xpub-key-expression who key)
      (let* ((body (key-expression-body key))
             (slash (string-index-char body #\/))
             (base (if slash (substring body 0 slash) body))
             (suffix (if slash (substring body slash (string-length body)) "")))
        (unless (or (string-prefix? "xpub" base)
                    (string-prefix? "tpub" base))
          (error (string-append who ": expected xpub or tpub key expression")))
        (list base suffix)))

    (define (origin-fingerprint origin)
      (let* ((slash (string-index-char origin #\/))
             (fingerprint-text (if slash (substring origin 0 slash) origin)))
        (unless (and (= 8 (string-length fingerprint-text))
                     (hex-string? fingerprint-text))
          (error "descriptor key origin: invalid fingerprint"))
        (hex-decode fingerprint-text)))

    (define (origin-path-segments origin)
      (let ((slash (string-index-char origin #\/)))
        (if slash
            (split-derivation-suffix (string-append
                                       "/"
                                       (substring origin (+ slash 1) (string-length origin))))
            '())))

    (define (split-derivation-suffix suffix)
      (if (string=? suffix "")
          '()
          (begin
            (unless (char=? #\/ (string-ref suffix 0))
              (error "descriptor-derive: malformed derivation suffix"))
            (let loop ((i 1)
                       (start 1)
                       (parts '()))
              (cond ((>= i (string-length suffix))
                     (reverse (cons (substring suffix start (string-length suffix)) parts)))
                    ((char=? #\/ (string-ref suffix i))
                     (loop (+ i 1) (+ i 1) (cons (substring suffix start i) parts)))
                    (else
                     (loop (+ i 1) start parts)))))))

    (define (multipath-segment? segment)
      (and (> (string-length segment) 1)
           (char=? #\< (string-ref segment 0))
           (char=? #\> (string-ref segment (- (string-length segment) 1)))))

    (define (resolve-derivation-segment segment branch index)
      (cond ((string=? segment "")
             (error "descriptor-derive: empty derivation path segment"))
            ((string=? segment "*")
             (number->string index))
            ((multipath-segment? segment)
             (let* ((body (substring segment 1 (- (string-length segment) 1)))
                    (branches (split-semicolons body))
                    (selected (list-ref-safe branches branch)))
               (unless selected
                 (error "descriptor-derive: multipath branch index out of range"))
               selected))
            (else
             segment)))

    (define (resolve-derivation-suffix suffix branch index)
      (let ((parts (split-derivation-suffix suffix)))
        (if (null? parts)
            ""
            (string-append
              "/"
              (join-strings
                (let loop ((xs parts)
                           (out '()))
                  (if (null? xs)
                      (reverse out)
                      (loop (cdr xs)
                            (cons (resolve-derivation-segment (car xs) branch index)
                                  out))))
                "/")))))

    (define (derive-xpub-key-expression who key branch index)
      (let* ((parts (split-xpub-key-expression who key))
             (xpub (string->bip32-xpub (car parts)))
             (suffix (resolve-derivation-suffix (cadr parts) branch index))
             (derived (if (string=? suffix "")
                          xpub
                          (bip32-derive-path xpub (string-append "m" suffix)))))
        (extended-public-key-public-key derived)))

    (define (derive-key-expression who key branch index)
      (cond ((bytevector? key)
             key)
            ((musig-key? key)
             (derive-musig-key key branch index))
            ((and (string? key) (compressed-pubkey-hex? key))
             (hex-decode key))
            ((and (string? key) (placeholder-key? key))
             (error (string-append who ": unresolved wallet policy placeholder")))
            ((and (string? key) (xpub-key-expression? key))
             (derive-xpub-key-expression who key branch index))
            (else
             (error (string-append who ": expected concrete or derivable key expression")))))

    (define (derive-musig-key key branch index)
      (let ((suffix (musig-key-suffix key)))
        (musig-key
          keys: (let loop ((xs (musig-key-keys key))
                           (out '()))
                  (if (null? xs)
                      (reverse out)
                      (let ((participant (car xs)))
                        (loop
                          (cdr xs)
                          (cons
                            (if (string=? suffix "")
                                (derive-key-expression "descriptor-derive" participant branch index)
                                (derive-key-expression
                                  "descriptor-derive"
                                  (string-append (key->string participant) suffix)
                                  branch
                                  index))
                            out)))))
          suffix: "")))

    (define (derive-key-list keys branch index)
      (let loop ((xs keys)
                 (out '()))
        (if (null? xs)
            (reverse out)
            (loop (cdr xs)
                  (cons (derive-key-expression "descriptor-derive" (car xs) branch index)
                        out)))))

    (define (derive-fragment fragment branch index)
      (let ((kind (miniscript-fragment-kind fragment)))
        (cond ((or (eq? kind 'pk-k) (eq? kind 'pk-h) (eq? kind 'pk))
               (miniscript-fragment
                 kind: kind
                 args: '()
                 data: (derive-key-expression
                         "descriptor-derive"
                         (miniscript-fragment-data fragment)
                         branch
                         index)))
              ((or (eq? kind 'multi) (eq? kind 'sortedmulti))
               (miniscript-fragment
                 kind: kind
                 args: (derive-key-list (miniscript-fragment-args fragment) branch index)
                 data: (miniscript-fragment-data fragment)))
              ((or (eq? kind 'one)
                   (eq? kind 'after)
                   (eq? kind 'older)
                   (eq? kind 'sha256)
                   (eq? kind 'hash256)
                   (eq? kind 'ripemd160)
                   (eq? kind 'hash160))
               fragment)
              (else
               (miniscript-fragment
                 kind: kind
                 args: (let loop ((xs (miniscript-fragment-args fragment))
                                  (out '()))
                         (if (null? xs)
                             (reverse out)
                             (loop (cdr xs)
                                   (cons (derive-fragment (car xs) branch index) out))))
                 data: (miniscript-fragment-data fragment))))))

    (define (derive-taproot-tree tree branch index)
      (cond ((miniscript-fragment? tree)
             (derive-fragment tree branch index))
            ((tapbranch? tree)
             (tapbranch
               (derive-taproot-tree (tapbranch-left tree) branch index)
               (derive-taproot-tree (tapbranch-right tree) branch index)))
            (else
             (error "descriptor-derive: unsupported Taproot script tree"))))

    ;;; Derive ranged descriptor keys into concrete public keys.
    ;;;
    ;;; `branch` selects BIP389 multipath alternatives, and `index` replaces
    ;;; wildcard path segments.
    (define (descriptor-derive desc branch index)
      (: descriptor? integer? integer? -> descriptor?)
      (require-derivation-index "descriptor-derive branch" branch)
      (require-derivation-index "descriptor-derive index" index)
      (let ((kind (descriptor-kind desc)))
        (cond ((or (eq? kind 'pkh) (eq? kind 'wpkh))
               (descriptor
                 kind: kind
                 args: '()
                 data: (derive-key-expression "descriptor-derive" (descriptor-data desc) branch index)))
              ((eq? kind 'sh)
               (descriptor-sh (descriptor-derive (car (descriptor-args desc)) branch index)))
              ((eq? kind 'wsh)
               (descriptor-wsh (derive-fragment (car (descriptor-args desc)) branch index)))
              ((eq? kind 'tr)
               (let ((key (derive-key-expression "descriptor-derive" (descriptor-data desc) branch index)))
                 (if (null? (descriptor-args desc))
                     (descriptor-tr key)
                     (descriptor-tr
                       key
                       (derive-taproot-tree (car (descriptor-args desc)) branch index)))))
              (else
               (error "descriptor-derive: unsupported descriptor")))))

    ;;; Derive a ranged descriptor and return its concrete scriptPubKey.
    (define (descriptor-derive-script-pubkey desc branch index)
      (: descriptor? integer? integer? -> bytevector?)
      (descriptor-script-pubkey (descriptor-derive desc branch index)))

    (define (resolved-key-origin-value key branch index taproot?)
      (let ((origin (key-expression-origin key)))
        (if origin
            (let* ((parts (split-xpub-key-expression "descriptor key origin" key))
                   (resolved-suffix (resolve-derivation-suffix (cadr parts) branch index))
                   (origin-path (origin-path-segments origin))
                   (derived-path (split-derivation-suffix resolved-suffix))
                   (base-value (bytevector-append
                                 (origin-fingerprint origin)
                                 (path-segments->bytes (append origin-path derived-path)))))
              (if taproot?
                  (bytevector-append #u8(0) base-value)
                  base-value))
            #f)))

    (define (key-origin-entry key branch index taproot?)
      (if (and (string? key) (xpub-key-expression? key))
          (let ((origin-value (resolved-key-origin-value key branch index taproot?)))
            (if origin-value
                (let ((pubkey (derive-xpub-key-expression
                                "descriptor key origin"
                                key
                                branch
                                index)))
                  (cons (if taproot?
                            (secp256k1-pubkey-xonly pubkey)
                            pubkey)
                        origin-value))
                #f))
          #f))

    (define (append-origin-entry maybe-entry entries)
      (if maybe-entry
          (cons maybe-entry entries)
          entries))

    (define (key-origin-entries key branch index taproot?)
      (cond ((musig-key? key)
             (let ((suffix (musig-key-suffix key)))
               (let loop ((xs (musig-key-keys key))
                          (out '()))
                 (if (null? xs)
                     out
                     (let ((participant (car xs)))
                       (loop
                         (cdr xs)
                         (append
                           (key-origin-entries
                             (if (string=? suffix "")
                                 participant
                                 (string-append (key->string participant) suffix))
                             branch
                             index
                             taproot?)
                           out)))))))
            (else
             (append-origin-entry
               (key-origin-entry key branch index taproot?)
               '()))))

    (define (key-list-origin-entries keys branch index taproot?)
      (let loop ((xs keys)
                 (out '()))
        (if (null? xs)
            out
            (loop (cdr xs)
                  (append (key-origin-entries (car xs) branch index taproot?) out)))))

    (define (fragment-origin-entries fragment branch index taproot?)
      (let ((kind (miniscript-fragment-kind fragment)))
        (cond ((or (eq? kind 'pk-k) (eq? kind 'pk-h) (eq? kind 'pk))
               (key-origin-entries (miniscript-fragment-data fragment) branch index taproot?))
              ((or (eq? kind 'multi) (eq? kind 'sortedmulti))
               (key-list-origin-entries (miniscript-fragment-args fragment) branch index taproot?))
              (else
               (let loop ((xs (miniscript-fragment-args fragment))
                          (out '()))
                 (if (null? xs)
                     out
                     (loop (cdr xs)
                           (append (fragment-origin-entries (car xs) branch index taproot?)
                                   out))))))))

    (define (taproot-tree-origin-entries tree branch index)
      (cond ((miniscript-fragment? tree)
             (fragment-origin-entries tree branch index #t))
            ((tapbranch? tree)
             (append
               (taproot-tree-origin-entries (tapbranch-left tree) branch index)
               (taproot-tree-origin-entries (tapbranch-right tree) branch index)))
            (else
             (error "descriptor PSBT plan: unsupported Taproot script tree"))))

    (define (descriptor-origin-entries desc branch index taproot?)
      (let ((kind (descriptor-kind desc)))
        (cond ((or (eq? kind 'pkh) (eq? kind 'wpkh))
               (key-origin-entries (descriptor-data desc) branch index taproot?))
              ((eq? kind 'sh)
               (descriptor-origin-entries (car (descriptor-args desc)) branch index taproot?))
              ((eq? kind 'wsh)
               (fragment-origin-entries (car (descriptor-args desc)) branch index taproot?))
              ((eq? kind 'tr)
               (append
                 (key-origin-entries (descriptor-data desc) branch index #t)
                 (if (null? (descriptor-args desc))
                     '()
                     (taproot-tree-origin-entries (car (descriptor-args desc)) branch index))))
              (else
               (error "descriptor PSBT plan: unsupported descriptor")))))

    (define (descriptor-plan-redeem-script desc)
      (if (eq? (descriptor-kind desc) 'sh)
          (descriptor-redeem-script (car (descriptor-args desc)))
          #f))

    (define (descriptor-plan-witness-script desc)
      (let ((kind (descriptor-kind desc)))
        (cond ((eq? kind 'wsh)
               (miniscript-compile (car (descriptor-args desc))))
              ((and (eq? kind 'sh)
                    (eq? (descriptor-kind (car (descriptor-args desc))) 'wsh))
               (miniscript-compile
                 (car (descriptor-args (car (descriptor-args desc))))))
              (else
               #f))))

    ;;; Build a derived descriptor plan containing script and PSBT key-origin data.
    (define (descriptor-derive-psbt-plan desc branch index)
      (: descriptor? integer? integer? -> descriptor-psbt-plan?)
      (let* ((derived (descriptor-derive desc branch index))
             (script (descriptor-script-pubkey derived))
             (taproot? (eq? (descriptor-kind desc) 'tr)))
        (descriptor-psbt-plan
          descriptor: derived
          script-pubkey: script
          redeem-script: (descriptor-plan-redeem-script derived)
          witness-script: (descriptor-plan-witness-script derived)
          bip32-derivations: (if taproot?
                                 '()
                                 (reverse (descriptor-origin-entries desc branch index #f)))
          taproot-bip32-derivations: (if taproot?
                                         (reverse (descriptor-origin-entries desc branch index #t))
                                         '())
          change?: (= branch 1))))

    (define (placeholder-index key)
      (unless (placeholder-key? key)
        (error "wallet-policy: expected key placeholder"))
      (let loop ((i 1)
                 (digits ""))
        (if (or (>= i (string-length key))
                (not (decimal-digit (string-ref key i))))
            (begin
              (when (= 0 (string-length digits))
                (error "wallet-policy: empty key placeholder index"))
              (when (and (> (string-length digits) 1)
                         (char=? #\0 (string-ref digits 0)))
                (error "wallet-policy: key placeholder has leading zeros"))
              (list (parse-decimal digits "wallet-policy") (substring key i (string-length key))))
            (loop (+ i 1) (string-append digits (string (string-ref key i)))))))

    (define (string-contains-placeholder? s)
      (let ((found #f))
        (do ((i 0 (+ i 1)))
            ((>= i (string-length s)) found)
          (when (char=? #\@ (string-ref s i))
            (set! found #t)))))

    (define (wallet-policy-expand-key key keys)
      (if (and (string? key) (placeholder-key? key))
          (let* ((parts (placeholder-index key))
                 (index (car parts))
                 (suffix (cadr parts))
                 (key-info (list-ref-safe keys index)))
            (unless key-info
              (error "wallet-policy: missing key info for placeholder"))
            (string-append
              key-info
              (if (string=? suffix "/**") "/<0;1>/*" suffix)))
          (if (musig-key? key)
              (musig-key->string-with-keys key keys)
              (key->string key))))

    (define (musig-key->string-with-keys key keys)
      (string-append
        "musig("
        (key-list->string-with-keys (musig-key-keys key) keys)
        ")"
        (musig-key-suffix key)))

    (define (key-list->string-with-keys keys policy-keys)
      (join-strings
        (let loop ((xs keys)
                   (out '()))
          (if (null? xs)
              (reverse out)
              (loop (cdr xs) (cons (wallet-policy-expand-key (car xs) policy-keys) out))))
        ","))

    (define (miniscript->string-with-keys fragment keys)
      (let ((kind (miniscript-fragment-kind fragment)))
        (cond ((eq? kind 'pk-k)
               (string-append "pk_k(" (wallet-policy-expand-key (miniscript-fragment-data fragment) keys) ")"))
              ((eq? kind 'pk-h)
               (string-append "pk_h(" (wallet-policy-expand-key (miniscript-fragment-data fragment) keys) ")"))
              ((eq? kind 'pk)
               (string-append "pk(" (wallet-policy-expand-key (miniscript-fragment-data fragment) keys) ")"))
              ((or (eq? kind 'sha256)
                   (eq? kind 'hash256)
                   (eq? kind 'ripemd160)
                   (eq? kind 'hash160))
               (miniscript->string fragment))
              ((or (eq? kind 'multi) (eq? kind 'sortedmulti))
               (string-append
                 (if (eq? kind 'multi) "multi(" "sortedmulti(")
                 (number->string (miniscript-fragment-data fragment))
                 ","
                 (key-list->string-with-keys (miniscript-fragment-args fragment) keys)
                 ")"))
              ((eq? kind 'wrapper)
               (string-append
                 (miniscript-fragment-data fragment)
                 ":"
                 (miniscript->string-with-keys (car (miniscript-fragment-args fragment)) keys)))
              ((eq? kind 'and-v)
               (string-append
                 "and_v("
                 (miniscript->string-with-keys (car (miniscript-fragment-args fragment)) keys)
                 ","
                 (miniscript->string-with-keys (cadr (miniscript-fragment-args fragment)) keys)
                 ")"))
              ((eq? kind 'and-b)
               (string-append
                 "and_b("
                 (miniscript->string-with-keys (car (miniscript-fragment-args fragment)) keys)
                 ","
                 (miniscript->string-with-keys (cadr (miniscript-fragment-args fragment)) keys)
                 ")"))
              ((eq? kind 'andor)
               (string-append
                 "andor("
                 (miniscript->string-with-keys (car (miniscript-fragment-args fragment)) keys)
                 ","
                 (miniscript->string-with-keys (cadr (miniscript-fragment-args fragment)) keys)
                 ","
                 (miniscript->string-with-keys (caddr (miniscript-fragment-args fragment)) keys)
                 ")"))
              ((eq? kind 'or-b)
               (string-append
                 "or_b("
                 (miniscript->string-with-keys (car (miniscript-fragment-args fragment)) keys)
                 ","
                 (miniscript->string-with-keys (cadr (miniscript-fragment-args fragment)) keys)
                 ")"))
              ((eq? kind 'or-c)
               (string-append
                 "or_c("
                 (miniscript->string-with-keys (car (miniscript-fragment-args fragment)) keys)
                 ","
                 (miniscript->string-with-keys (cadr (miniscript-fragment-args fragment)) keys)
                 ")"))
              ((eq? kind 'or-d)
               (string-append
                 "or_d("
                 (miniscript->string-with-keys (car (miniscript-fragment-args fragment)) keys)
                 ","
                 (miniscript->string-with-keys (cadr (miniscript-fragment-args fragment)) keys)
                 ")"))
              ((eq? kind 'or-i)
               (string-append
                 "or_i("
                 (miniscript->string-with-keys (car (miniscript-fragment-args fragment)) keys)
                 ","
                 (miniscript->string-with-keys (cadr (miniscript-fragment-args fragment)) keys)
                 ")"))
              ((eq? kind 'thresh)
               (string-append
                 "thresh("
                 (number->string (miniscript-fragment-data fragment))
                 ","
                 (join-strings
                   (let loop ((xs (miniscript-fragment-args fragment))
                              (out '()))
                     (if (null? xs)
                         (reverse out)
                         (loop (cdr xs) (cons (miniscript->string-with-keys (car xs) keys) out))))
                   ",")
                 ")"))
              (else
               (miniscript->string fragment)))))

    (define (taproot-tree->string-with-keys tree keys)
      (cond ((miniscript-fragment? tree)
             (miniscript->string-with-keys tree keys))
            ((tapbranch? tree)
             (string-append
               "{"
               (taproot-tree->string-with-keys (tapbranch-left tree) keys)
               ","
               (taproot-tree->string-with-keys (tapbranch-right tree) keys)
               "}"))
            (else
             (error "wallet-policy: unsupported Taproot script tree"))))

    (define (descriptor->string-with-keys desc keys)
      (let ((kind (descriptor-kind desc)))
        (cond ((eq? kind 'pkh)
               (string-append "pkh(" (wallet-policy-expand-key (descriptor-data desc) keys) ")"))
              ((eq? kind 'wpkh)
               (string-append "wpkh(" (wallet-policy-expand-key (descriptor-data desc) keys) ")"))
              ((eq? kind 'sh)
               (string-append "sh(" (descriptor->string-with-keys (car (descriptor-args desc)) keys) ")"))
              ((eq? kind 'wsh)
               (string-append "wsh(" (miniscript->string-with-keys (car (descriptor-args desc)) keys) ")"))
              ((eq? kind 'tr)
               (if (null? (descriptor-args desc))
                   (string-append "tr(" (wallet-policy-expand-key (descriptor-data desc) keys) ")")
                   (string-append
                     "tr("
                     (wallet-policy-expand-key (descriptor-data desc) keys)
                     ","
                     (taproot-tree->string-with-keys (car (descriptor-args desc)) keys)
                     ")")))
              (else
               (error "wallet-policy: unsupported descriptor template")))))

    ;;; Build a BIP388 wallet policy from descriptor template text and keys.
    (define (wallet-policy-from-template template keys)
      (: string? list? -> wallet-policy?)
      (unless (string-contains-placeholder? template)
        (error "wallet-policy: descriptor template must contain a key placeholder"))
      (wallet-policy template: (descriptor-parse template) keys: keys))

    ;;; Expand a wallet policy into a concrete descriptor.
    (define (wallet-policy-descriptor policy)
      (: wallet-policy? -> string?)
      (descriptor->string-with-keys
        (wallet-policy-template policy)
        (wallet-policy-keys policy)))

    ;;; Expand and derive a wallet policy into a PSBT planning record.
    (define (wallet-policy-derive-psbt-plan policy branch index)
      (: wallet-policy? integer? integer? -> descriptor-psbt-plan?)
      (descriptor-derive-psbt-plan
        (descriptor-parse (wallet-policy-descriptor policy))
        branch
        index))

    ;;; Attach descriptor-derived metadata to a PSBT input.
    (define (descriptor-psbt-plan-annotate-input p input-index plan)
      (: psbt? integer? descriptor-psbt-plan? -> psbt?)
      (psbt-annotate-input-scripts
        (psbt-annotate-input
          p
          input-index
          (descriptor-psbt-plan-script-pubkey plan)
          (descriptor-psbt-plan-bip32-derivations plan)
          (descriptor-psbt-plan-taproot-bip32-derivations plan))
        input-index
        (descriptor-psbt-plan-redeem-script plan)
        (descriptor-psbt-plan-witness-script plan)))

    ;;; Attach descriptor-derived metadata to a PSBT output.
    (define (descriptor-psbt-plan-annotate-output p output-index plan)
      (: psbt? integer? descriptor-psbt-plan? -> psbt?)
      (psbt-annotate-output
        p
        output-index
        (descriptor-psbt-plan-script-pubkey plan)
        (descriptor-psbt-plan-bip32-derivations plan)
        (descriptor-psbt-plan-taproot-bip32-derivations plan)))

    ;;; Annotate and sign a standard descriptor PSBT input.
    (define (descriptor-psbt-plan-sign-input p input-index plan private-key)
      (: psbt? integer? descriptor-psbt-plan? bytevector? -> psbt?)
      (psbt-sign-standard-input
        (descriptor-psbt-plan-annotate-input p input-index plan)
        input-index
        private-key))

    ;;; Finalize a standard descriptor PSBT input.
    (define (descriptor-psbt-plan-finalize-input p input-index plan)
      (: psbt? integer? descriptor-psbt-plan? -> psbt?)
      (psbt-finalize-standard-input
        (descriptor-psbt-plan-annotate-input p input-index plan)
        input-index))))
