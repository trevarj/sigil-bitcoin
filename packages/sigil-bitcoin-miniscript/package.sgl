;;; sigil-bitcoin-miniscript — Bitcoin Miniscript policy fragments
;;;
;;; Initial Miniscript AST, parser, type checker, and script compiler.

(package
  name: "sigil-bitcoin-miniscript"
  version: "0.1.0"
  sigil: "^0.16"
  description: "Bitcoin Miniscript AST, parser, type checker, and script compiler"
  url: "https://codeberg.org/sigil/sigil-bitcoin"
  license: "BSD-3-Clause"

  dependencies: (list
    (from-path dir: "../sigil-bitcoin-primitives"
               package: "sigil-bitcoin-primitives")
    (from-path dir: "../sigil-bitcoin-encoding"
               package: "sigil-bitcoin-encoding")
    (from-path dir: "../sigil-bitcoin-keys"
               package: "sigil-bitcoin-keys")
    (from-path dir: "../sigil-bitcoin-script"
               package: "sigil-bitcoin-script")
    (from-path dir: "../sigil-bitcoin-tx"
               package: "sigil-bitcoin-tx")
    (from-path dir: "../sigil-secp256k1"
               package: "sigil-secp256k1")
    (from-path dir: "../../../sigil-crypto"
               package: "sigil-crypto"))

  dev-dependencies: (list
    (from-git url: "codeberg:sigil/sigil"
              package: "sigil-stdlib" version: "^0.15")
    (from-git url: "codeberg:sigil/sigil-ansi" version: "^0.13.1")
    (from-git url: "codeberg:sigil/sigil-json" version: "^0.13.1")
    (from-git url: "codeberg:sigil/sigil-version" version: "^0.13.1")
    (from-git url: "codeberg:sigil/sigil"
              package: "sigil-test" version: "^0.15")
    (from-git url: "codeberg:sigil/sigil"
              package: "sigil-test-runner" version: "^0.15"))

  tasks: (list
    (task
      name: 'build
      description: "Build sigil-bitcoin-miniscript"
      steps: (list
        (compile-sigil-modules
          sources: "src/**/*.sgl")))))
