;;; sigil-bitcoin-primitives — Bitcoin hash combinators
;;;
;;; Library providing HASH160, HASH256, and BIP-340 tagged hashes.
;;; Uses upstream sigil-crypto for raw SHA256 and native RIPEMD-160 when linked.

(package
  name: "sigil-bitcoin-primitives"
  version: "0.1.0"
  sigil: "^0.16"
  description: "Bitcoin hash primitives: HASH160, HASH256, tagged hashes"
  url: "https://codeberg.org/sigil/sigil-bitcoin"
  license: "BSD-3-Clause"

  dependencies: (list
    (from-git url: "codeberg:sigil/sigil-crypto" version: "^0.16.1"))

  tasks: (list
    (task
      name: 'build
      description: "Build sigil-bitcoin-primitives"
      steps: (list
        (compile-sigil-modules
          sources: "src/**/*.sgl")))))
