(import (sigil test)
        (sigil bitcoin primitives)
        (sigil crypto))


;; ── Known-answer test vectors ────────────────────────────
;;
;; All expected values computed with Python 3 hashlib.
;; HASH160(x) = RIPEMD160(SHA256(x))
;; HASH256(x) = SHA256(SHA256(x))
;; tagged_hash(tag, x) = SHA256(SHA256(tag) || SHA256(tag) || x)

(test-group "hash160"
  (test "empty string matches known vector"
    (assert-equal #u8(
      #xb4 #x72 #xa2 #x66 #xd0 #xbd #x89 #xc1 #x37 #x06
      #xa4 #x13 #x2c #xcf #xb1 #x6f #x7c #x3b #x9f #xcb)
      (hash160 "")))
  (test "hello world matches known vector"
    (assert-equal #u8(
      #xd7 #xd5 #xee #x78 #x24 #xff #x93 #xf9 #x4c #x30
      #x55 #xaf #x93 #x82 #xc8 #x6c #x68 #xb5 #xca #x92)
      (hash160 "hello world")))
  (test "accepts bytevector input"
    (assert-equal 20 (bytevector-length (hash160 (sha256-bytes "test")))))
  (test "returns 20-byte bytevector"
    (assert-equal 20 (bytevector-length (hash160 "some data")))))

(test-group "hash256"
  (test "empty string matches known vector"
    (assert-equal #u8(
      #x5d #xf6 #xe0 #xe2 #x76 #x13 #x59 #xd3 #x0a #x82
      #x75 #x05 #x8e #x29 #x9f #xcc #x03 #x81 #x53 #x45
      #x45 #xf5 #x5c #xf4 #x3e #x41 #x98 #x3f #x5d #x4c
      #x94 #x56)
      (hash256 "")))
  (test "hello world matches known vector"
    (assert-equal #u8(
      #xbc #x62 #xd4 #xb8 #x0d #x9e #x36 #xda #x29 #xc1
      #x6c #x5d #x4d #x9f #x11 #x73 #x1f #x36 #x05 #x2c
      #x72 #x40 #x1a #x76 #xc2 #x3c #x0f #xb5 #xa9 #xb7
      #x44 #x23)
      (hash256 "hello world")))
  (test "accepts bytevector input"
    (assert-equal 32 (bytevector-length (hash256 (sha256-bytes "test")))))
  (test "returns 32-byte bytevector"
    (assert-equal 32 (bytevector-length (hash256 "data")))
    (assert-equal 32 (bytevector-length (hash256 #u8(1 2 3))))))

(test-group "tagged-hash"
  (test "BIP0340/challenge with 32 zero bytes matches known vector"
    (assert-equal #u8(
      #xa5 #x08 #x85 #xaa #xde #xf9 #x4e #xe5 #x7e #x55
      #x37 #xe2 #x7e #xf8 #x2d #x4d #xb7 #xc7 #x56 #x19
      #x35 #x39 #xd3 #xd8 #xd0 #xbb #x6e #xe5 #xf3 #xa7
      #xad #x46)
      (tagged-hash bip0340/challenge (make-bytevector 32 0))))
  (test "BIP0340/aux with ones vector matches known vector"
    (assert-equal #u8(
      #xee #x87 #x90 #xe3 #xe6 #x5f #x54 #x08 #xc3 #xf4
      #x1b #x56 #xa8 #x8c #x4e #x09 #x61 #x26 #xa7 #x1a
      #xbb #x3a #x9c #xcc #xe6 #xef #xd1 #x9d #xaf #xc7
      #xec #x32)
      (tagged-hash bip0340/aux
        #u8(
          #x00 #x00 #x00 #x00 #x00 #x00 #x00 #x00 #x00 #x00
          #x00 #x00 #x00 #x00 #x00 #x00 #x00 #x00 #x00 #x00
          #x00 #x00 #x00 #x00 #x00 #x00 #x00 #x00 #x00 #x00
          #x00 #x01)))))
  (test "BIP0340/nonce with all zeros matches known vector"
    (assert-equal #u8(
      #xad #x70 #xff #x62 #x28 #xd5 #x76 #xe4 #x9a #x9a
      #x88 #xc6 #xfb #x09 #x63 #x55 #xca #x94 #xad #x0f
      #xdc #x3c #xcb #x2f #xb4 #x98 #x4d #xca #xf7 #xac
      #x58 #x5c)
      (tagged-hash bip0340/nonce (make-bytevector 32 0))))
  (test "TapSighash empty message matches known vector"
    (assert-equal #u8(
      #xda #xbc #x11 #x91 #x4a #xbc #xd8 #x07 #x29 #x00
      #x04 #x2a #x26 #x81 #xe5 #x2f #x8d #xba #x99 #xce
      #x82 #xe2 #x24 #xf9 #x7b #x5f #xdb #x7c #xd4 #xb9
      #xc8 #x03)
      (tagged-hash "TapSighash" #u8())))
  (test "TapLeaf with zero byte matches known vector"
    (assert-equal #u8(
      #xed #x13 #x82 #x03 #x78 #x00 #xc9 #xdd #x93 #x8d
      #xd8 #x85 #x4f #x1a #x88 #x63 #xbc #xde #xb6 #x70
      #x50 #x69 #xb4 #xb5 #x6a #x66 #xec #x22 #x51 #x9d
      #x58 #x29)
      (tagged-hash "TapLeaf" #u8(#x00))))
  (test "TapBranch empty matches known vector"
    (assert-equal #u8(
      #x53 #xc3 #x73 #xec #x4d #x6f #x3c #x53 #xc1 #xf5
      #xfb #x2f #xf5 #x06 #xdc #xef #xe1 #xa0 #xed #x74
      #x87 #x4f #x93 #xfa #x93 #xc8 #x21 #x4c #xbe #x9f
      #xfd #xdf)
      (tagged-hash "TapBranch" #u8())))
  (test "custom tag matches known vector"
    (assert-equal #u8(
      #xf3 #xe6 #x9d #xb8 #xcc #x3c #x05 #x11 #x1c #x07
      #x3f #xc2 #xb8 #x3a #x73 #x50 #xb2 #xf0 #xa7 #xee
      #x7e #xa2 #xd6 #x30 #xbb #xcc #x99 #x51 #x90 #xeb
      #x54 #xde)
      (tagged-hash "CustomApp/v1" (sha256-bytes "Hello, World!"))))

;; ── Properties ───────────────────────────────────────────

(test-group "idempotency"
  (test "hash160 is deterministic"
    (assert-equal (hash160 "test") (hash160 "test")))
  (test "hash256 is deterministic"
    (assert-equal (hash256 "test") (hash256 "test")))
  (test "tagged-hash is deterministic"
    (assert-equal (tagged-hash "X" #u8(1 2 3))
                  (tagged-hash "X" #u8(1 2 3))))
  (test "different tags produce different hashes"
    (assert-false (equal? (tagged-hash "A" #u8(0))
                          (tagged-hash "B" #u8(0)))))
  (test "different data with same tag produces different hashes"
    (assert-false (equal? (tagged-hash "A" #u8(0))
                          (tagged-hash "A" #u8(1))))))

(test-group "tag-constants"
  (test "bip0340/challenge is the correct string"
    (assert-equal "BIP0340/challenge" bip0340/challenge))
  (test "bip0340/aux is the correct string"
    (assert-equal "BIP0340/aux" bip0340/aux))
  (test "bip0340/nonce is the correct string"
    (assert-equal "BIP0340/nonce" bip0340/nonce))
  (test "taproot/elements is the correct string"
    (assert-equal "TapRoot/elements" taproot/elements)))

(run-tests)

