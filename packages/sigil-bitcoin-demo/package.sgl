;;; sigil-bitcoin-demo - Browser toolbench dispatcher for sigil-bitcoin

(package
  name: "sigil-bitcoin-demo"
  version: "0.1.0"
  sigil: "^0.17"
  description: "Live browser tools for Sigil Bitcoin"
  url: "https://codeberg.org/sigil/sigil-bitcoin"
  license: "BSD-3-Clause"
  entry: '(sigil bitcoin demo)

  dependencies: (list
    (from-path dir: "../../../sigil"
               package: "sigil-lib")
    (from-path dir: "../../../sigil"
               package: "sigil-stdlib")
    (from-git url: "codeberg:sigil/sigil-crypto" version: "^0.16.1")
    (from-path dir: "../sigil-secp256k1"
               package: "sigil-secp256k1")
    (from-path dir: "../sigil-bitcoin-utils"
               package: "sigil-bitcoin-utils")
    (from-path dir: "../sigil-bitcoin-primitives"
               package: "sigil-bitcoin-primitives")
    (from-path dir: "../sigil-bitcoin-encoding"
               package: "sigil-bitcoin-encoding")
    (from-path dir: "../sigil-bitcoin-keys"
               package: "sigil-bitcoin-keys")
    (from-path dir: "../sigil-bitcoin-script"
               package: "sigil-bitcoin-script")
    (from-path dir: "../sigil-bitcoin-tx"
               package: "sigil-bitcoin-tx")
    (from-path dir: "../sigil-bitcoin-miniscript"
               package: "sigil-bitcoin-miniscript"))

  configs: (list
    (config
      name: 'web
      output-dir: "build/web"
      toolchain: 'zig
      target: "wasm32-wasi"
      deploy-dir: "www"
      debug?: #f
      optimize: 2
      c-flags: (with-sigil-c-flags
        '("-Iwasm-include"
          "-std=c99" "-D_GNU_SOURCE" "-D__SIGIL_WASM__" "-Wall" "-O2"))
      link-flags: '("-Wl,--export=sigil_wasm_init"
                    "-Wl,--export=sigil_wasm_start"
                    "-Wl,--export=sigil_wasm_eval"
                    "-Wl,--export=sigil_wasm_eval_string_length"
                    "-Wl,--export=sigil_wasm_last_result_length"
                    "-Wl,--export=sigil_wasm_copy_result"
                    "-Wl,--export=sigil_wasm_input"
                    "-Wl,--export=sigil_wasm_resume_async"
                    "-Wl,--export=malloc"
                    "-Wl,--export=free"
                    "-lc")
      features: '(web wasm)))

  default-config: 'web

  tasks: (list
    (task
      name: 'build
      description: "Build sigil-bitcoin-demo browser WASM"
      steps: (list
        (compile-c-sources
          sources: '("native/web-runtime.c" "native/wasm-stubs.c")
          flags: (with-sigil-c-flags
            '("-std=c99" "-D_GNU_SOURCE" "-D__SIGIL_WASM__" "-Wall" "-O2")))
        (compile-sigil-modules
          sources: "src/**/*.sgl")
        (link-web-application
          name: "sigil-bitcoin-demo")))))
