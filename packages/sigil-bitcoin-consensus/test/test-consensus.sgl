            (connect-block bitcoin-regtest-consensus-params 100 initial b))))

      (test "validates P2SH-wrapped P2WSH single-key CHECKSIG spends"
        (let* ((funding (make-p2sh-coinbase-tx 5000 %p2wsh-redeem-script))
               (initial (connect-block
