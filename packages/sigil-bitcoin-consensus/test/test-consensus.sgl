               (unsigned (make-unsigned-spend-tx funding 4000))
               (bad-script (script-append
                             (script-push-data (make-bytevector 33 2))
                             (script-op op-checksig)))
               (spend (sign-p2wsh-spend unsigned bad-script 5000))
               (coinbase (make-coinbase-tx (+ (block-subsidy 100) 1000)))
               (b (make-test-block (list coinbase spend) 2)))
