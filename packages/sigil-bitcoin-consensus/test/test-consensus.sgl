                        unsigned
                        %p2wsh-redeem-script
                        %p2wsh-witness-script
                        5000))
               (coinbase (make-coinbase-tx (+ (block-subsidy 100) 1000)))
               (b (make-test-block (list coinbase spend) 2))
               (updated (connect-block
                          bitcoin-regtest-consensus-params
                          100
                          initial
                          b)))
          (assert-true
            (utxo-entry?
              (utxo-set-lookup updated
                               (outpoint txid: (transaction-txid spend) index: 0))))))

      (test "validates Taproot key-path spends"
        (let* ((tweaked (bip86-tweaked-keypair %one))
               (xonly (secp256k1-keypair-xonly-pub tweaked))
               (funding (make-p2tr-coinbase-tx 5000 xonly))
               (prevout (txout value: 5000
                               script-pubkey: (txout-script-pubkey
                                                (car (transaction-outputs funding)))))
               (initial (connect-block
                          bitcoin-regtest-consensus-params
                          0
                          '()
                          (make-test-block (list funding) 1)))
               (unsigned (make-unsigned-spend-tx funding 4000))
               (spend (transaction-sign-p2tr-keypath-input
                        unsigned
                        0
                        (list prevout)
                        %one))
               (coinbase (make-coinbase-tx (+ (block-subsidy 100) 1000)))
               (b (make-test-block (list coinbase spend) 2))
               (updated (connect-block
                          bitcoin-regtest-consensus-params
                          100
                          initial
                          b)))
          (assert-true (standard-input-script-valid? spend 0 prevout (list prevout)))
          (assert-true
            (utxo-entry?
              (utxo-set-lookup updated
                               (outpoint txid: (transaction-txid spend) index: 0))))))

      (test "rejects invalid Taproot key-path signatures"
        (let* ((tweaked (bip86-tweaked-keypair %one))
               (xonly (secp256k1-keypair-xonly-pub tweaked))
               (funding (make-p2tr-coinbase-tx 5000 xonly))
               (prevout (txout value: 5000
                               script-pubkey: (txout-script-pubkey
                                                (car (transaction-outputs funding)))))
               (initial (connect-block
                          bitcoin-regtest-consensus-params
                          0
                          '()
                          (make-test-block (list funding) 1)))
               (unsigned (make-unsigned-spend-tx funding 4000))
               (spend (transaction-set-input-witness
                        unsigned
                        0
                        (list (make-bytevector 64 0))))
               (coinbase (make-coinbase-tx (+ (block-subsidy 100) 1000)))
               (b (make-test-block (list coinbase spend) 2)))
          (assert-false (standard-input-script-valid? spend 0 prevout (list prevout)))
          (assert-error
            (connect-block bitcoin-regtest-consensus-params 100 initial b))))

      (test "validates Taproot single-key script-path spends"
        (let* ((keypair (secp256k1-keypair-create %one))
               (internal-xonly (secp256k1-keypair-xonly-pub keypair))
               (script (make-p2tr-script))
               (output-data (taproot-script-output-data internal-xonly script))
               (output-xonly (car output-data))
               (control-block (cadr output-data))
               (funding (make-p2tr-coinbase-tx 5000 output-xonly))
               (prevout (txout value: 5000
                               script-pubkey: (txout-script-pubkey
                                                (car (transaction-outputs funding)))))
               (initial (connect-block
                          bitcoin-regtest-consensus-params
                          0
                          '()
                          (make-test-block (list funding) 1)))
               (unsigned (make-unsigned-spend-tx funding 4000))
               (spend (sign-p2tr-scriptpath-spend
                        unsigned
                        (list prevout)
                        script
                        control-block))
               (coinbase (make-coinbase-tx (+ (block-subsidy 100) 1000)))
               (b (make-test-block (list coinbase spend) 2))
               (updated (connect-block
                          bitcoin-regtest-consensus-params
                          100
                          initial
                          b)))
          (assert-true (standard-input-script-valid? spend 0 prevout (list prevout)))
          (assert-true
            (utxo-entry?
              (utxo-set-lookup updated
                               (outpoint txid: (transaction-txid spend) index: 0))))))

      (test "rejects Taproot script-path spends with wrong control block"
        (let* ((keypair (secp256k1-keypair-create %one))
               (internal-xonly (secp256k1-keypair-xonly-pub keypair))
               (script (make-p2tr-script))
               (output-data (taproot-script-output-data internal-xonly script))
               (output-xonly (car output-data))
               (control-block (cadr output-data))
               (wrong-internal-xonly (secp256k1-keypair-xonly-pub
                                       (secp256k1-keypair-create %two)))
               (bad-control (bytevector-append
                              (bytevector-copy control-block 0 1)
                              wrong-internal-xonly))
               (funding (make-p2tr-coinbase-tx 5000 output-xonly))
               (prevout (txout value: 5000
                               script-pubkey: (txout-script-pubkey
                                                (car (transaction-outputs funding)))))
               (initial (connect-block
                          bitcoin-regtest-consensus-params
                          0
                          '()
                          (make-test-block (list funding) 1)))
               (unsigned (make-unsigned-spend-tx funding 4000))
               (spend (sign-p2tr-scriptpath-spend
                        unsigned
                        (list prevout)
                        script
                        bad-control))
               (coinbase (make-coinbase-tx (+ (block-subsidy 100) 1000)))
               (b (make-test-block (list coinbase spend) 2)))
          (assert-false (standard-input-script-valid? spend 0 prevout (list prevout)))
          (assert-error
            (connect-block bitcoin-regtest-consensus-params 100 initial b))))
      #t)
    #t)

  (test "rejects immature coinbase spends"
    (let* ((funding (make-coinbase-tx 5000))
           (initial (connect-block
                      bitcoin-regtest-consensus-params
                      0
                      '()
                      (make-test-block (list funding) 1)))
           (spend (make-spend-tx funding 4000))
           (coinbase (make-coinbase-tx (+ (block-subsidy 99) 1000)))
           (b (make-test-block (list coinbase spend) 2)))
      (assert-error
        (connect-block bitcoin-regtest-consensus-params 99 initial b))))

  (test "rejects duplicate spends in one block"
    (let* ((funding (make-coinbase-tx 5000))
           (initial (connect-block
                      bitcoin-regtest-consensus-params
                      0
                      '()
                      (make-test-block (list funding) 1)))
           (spend-a (make-spend-tx funding 4000))
           (spend-b (make-spend-tx funding 3000))
           (coinbase (make-coinbase-tx (+ (block-subsidy 100) 3000)))
           (b (make-test-block (list coinbase spend-a spend-b) 2)))
      (assert-error
        (connect-block bitcoin-regtest-consensus-params 100 initial b)))))

;; A fake non-Bitcoin profile: emission is flat and larger than Bitcoin's
;; subsidy at the same height, and the coinbase input carries far more than
;; Bitcoin's 100-byte cap. It reuses Bitcoin's connector, which is the case a
;; chain that changes only emission and coinbase layout needs.
(define %fake-subsidy-value 10000000000)
(define %fake-coinbase-script-len 240)

(define %fake-block-rules
  (block-rules connect: (block-rules-connect bitcoin-block-rules)
               subsidy: (lambda (height) %fake-subsidy-value)
               coinbase-script-bounds: (cons 2 512)))

(test-group "block rules"
  (test "defaults to bitcoin emission and coinbase bounds"
    (assert-true (block-rules? bitcoin-block-rules))
    (assert-equal '(2 . 100)
                  (block-rules-coinbase-script-bounds bitcoin-block-rules))
    (assert-equal '(2 . 100) bitcoin-coinbase-script-bounds)
    (assert-equal (block-subsidy 0)
                  ((block-rules-subsidy bitcoin-block-rules) 0))
    (assert-equal (block-subsidy 210000)
                  ((block-rules-subsidy bitcoin-block-rules) 210000)))

  (test "passing bitcoin block rules matches omitting them"
    (let* ((coinbase (make-coinbase-tx (block-subsidy 0)))
           (b (make-test-block (list coinbase) 1))
           (implicit (connect-block bitcoin-regtest-consensus-params 0 '() b))
           (explicit (connect-block bitcoin-regtest-consensus-params
                                    0
                                    '()
                                    b
                                    bitcoin-block-rules)))
      (assert-equal (utxo-entry-height
                      (utxo-set-lookup
                        implicit
                        (outpoint txid: (transaction-txid coinbase) index: 0)))
                    (utxo-entry-height
                      (utxo-set-lookup
                        explicit
                        (outpoint txid: (transaction-txid coinbase)
                                  index: 0))))))

  (test "rejects a rules argument that is not a block-rules record"
    (let* ((coinbase (make-coinbase-tx (block-subsidy 0)))
           (b (make-test-block (list coinbase) 1)))
      (assert-error
        (connect-block bitcoin-regtest-consensus-params 0 '() b 'nonsense))
      (assert-error
        (connect-block/structural bitcoin-regtest-consensus-params
                                  0
                                  '()
                                  b
                                  'nonsense))
      (assert-error (connect-block bitcoin-regtest-consensus-params
                                   0
                                   '()
                                   b
                                   bitcoin-block-rules
                                   'garbage))))

  (test "connects a block bitcoin would reject on subsidy and coinbase size"
    (let* ((coinbase (make-padded-coinbase-tx %fake-subsidy-value
                                              %fake-coinbase-script-len))
           (b (make-test-block (list coinbase) 1))
           (op (outpoint txid: (transaction-txid coinbase) index: 0)))
      ;; Bitcoin rejects this block twice over: the scriptSig is 240 bytes and
      ;; the claim is twice the height-1 subsidy.
      (assert-true (> %fake-coinbase-script-len
                      (cdr bitcoin-coinbase-script-bounds)))
      (assert-true (> %fake-subsidy-value (block-subsidy 1)))
      (assert-error (connect-block bitcoin-regtest-consensus-params 1 '() b))
      (let ((utxos (connect-block bitcoin-regtest-consensus-params
                                  1
                                  '()
                                  b
                                  %fake-block-rules)))
        (assert-true (utxo-entry-coinbase? (utxo-set-lookup utxos op)))
        (assert-equal %fake-subsidy-value
                      (txout-value
                        (utxo-entry-output (utxo-set-lookup utxos op)))))))

  (test "enforces the chain's own subsidy and coinbase bounds"
    (let ((over-subsidy
            (make-test-block
              (list (make-padded-coinbase-tx (+ 1 %fake-subsidy-value)
                                             %fake-coinbase-script-len))
              1))
          (over-script
            (make-test-block
              (list (make-padded-coinbase-tx %fake-subsidy-value 513))
              1)))
      ;; The replacement rules are limits, not a bypass.
      (assert-error (connect-block bitcoin-regtest-consensus-params
                                   1
                                   '()
                                   over-subsidy
                                   %fake-block-rules))
      (assert-error (connect-block bitcoin-regtest-consensus-params
                                   1
                                   '()
                                   over-script
                                   %fake-block-rules))))

  (test "routes structural connection through the chain's rules too"
    (let* ((coinbase (make-padded-coinbase-tx %fake-subsidy-value
                                              %fake-coinbase-script-len))
           (b (make-test-block (list coinbase) 1)))
      (assert-error
        (connect-block/structural bitcoin-regtest-consensus-params 1 '() b))
      (let ((utxos (connect-block/structural bitcoin-regtest-consensus-params
                                             1
                                             '()
                                             b
                                             %fake-block-rules)))
        (assert-true
          (utxo-entry-coinbase?
            (utxo-set-lookup
              utxos
              (outpoint txid: (transaction-txid coinbase) index: 0)))))))

  (test "lets a chain replace the connector outright"
    (let* ((calls '())
           (rules (block-rules
                    connect: (lambda (rules params height utxos b verify?)
                               (set! calls (cons height calls))
                               'replaced)
                    subsidy: (lambda (height) 0)
                    coinbase-script-bounds: (cons 0 0)))
           (b (make-test-block (list (make-coinbase-tx 0)) 1)))
      ;; Nothing about the block is inspected, which is what a chain whose
      ;; body is not a Bitcoin block needs.
      (assert-equal 'replaced
                    (connect-block bitcoin-regtest-consensus-params
                                   7
                                   '()
                                   b
                                   rules))
      (assert-equal '(7) calls))))

(test-group "blocks"
  (test "serializes and parses synthetic block"
    (let* ((tx (make-synthetic-tx 7))
           (root (transaction-txid tx))
           (header (block-header version: 2
                                 previous-block: %zero32
                                 merkle-root: root
                                 time: 42
                                 bits: #x207fffff
                                 nonce: 99))
           (b (block header-field: header transactions: (list tx)))
           (parsed (block-parse (block-serialize b))))
      (assert-equal (block-header-serialize header)
                    (block-header-serialize (block-header-field parsed)))
      (assert-equal 1 (length (block-transactions parsed)))
      (assert-true (block-merkle-root-valid? parsed))))

  (test "parses multi-transaction block vectors"
    (let* ((tx1 (make-synthetic-tx 8))
           (tx2 (make-synthetic-tx 9))
           (root (merkle-root (list (transaction-txid tx1)
                                    (transaction-txid tx2))))
           (header (block-header version: 2
                                 previous-block: %zero32
                                 merkle-root: root
                                 time: 43
                                 bits: #x207fffff
                                 nonce: 100))
           (b (block header-field: header transactions: (list tx1 tx2)))
           (parsed (block-parse (block-serialize b))))
      (assert-equal 2 (length (block-transactions parsed)))
      (assert-true (block-merkle-root-valid? parsed))))

  (test "rejects empty blocks"
    (assert-error
      (validate-block
        (block header-field: (block-header-parse %genesis-header-bytes)
               transactions: '())))))

(run-tests)
