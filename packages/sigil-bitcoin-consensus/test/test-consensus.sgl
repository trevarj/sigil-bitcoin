               (coinbase (make-coinbase-tx (+ (block-subsidy 100) 1000)))
               (b (make-test-block (list coinbase spend) 2))
               (updated (connect-block/structural
                          bitcoin-regtest-consensus-params
                          100
                          initial
                          b)))
          (assert-true
            (utxo-entry?
              (utxo-set-lookup updated
                               (outpoint txid: (transaction-txid spend) index: 0))))))

      (test "validates signed native P2WPKH spends during block connection"
        (let* ((funding (make-p2wpkh-coinbase-tx 5000))
               (initial (connect-block
                          bitcoin-regtest-consensus-params
                          0
                          '()
