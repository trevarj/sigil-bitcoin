;;; (sigil bitcoin consensus) — Block/header consensus helpers

(define-library (sigil bitcoin consensus)
  (import (sigil math)
          (sigil struct)
          (sigil crypto)
          (sigil secp256k1)
          (sigil bitcoin utils)
          (sigil bitcoin primitives)
          (sigil bitcoin encoding)
          (sigil bitcoin script)
          (sigil bitcoin tx)
          (sigil bitcoin tx sighash)
          (sigil bitcoin tx wire))
  (export
    block-header block-header?
    block-header-version block-header-previous-block
    block-header-merkle-root block-header-time
    block-header-bits block-header-nonce
    block block?
    block-header-field block-transactions
    utxo-entry utxo-entry?
    utxo-entry-output utxo-entry-coinbase? utxo-entry-height
    consensus-params consensus-params?
    consensus-params-pow-limit-bits consensus-params-target-spacing
    consensus-params-target-timespan consensus-params-retarget-interval
    bitcoin-mainnet-consensus-params
    bitcoin-testnet-consensus-params
    bitcoin-regtest-consensus-params
    validate-block-header
    validate-block
    block-header-serialize
    block-header-parse
    block-header-hash
    block-header-id
    block-serialize
    block-parse
    merkle-root
    block-merkle-root
    block-merkle-root-valid?
    compact-target->integer
    integer->compact-target
    block-header-target
    block-header-work-value
    block-header-proof-of-work-valid?
    block-header-chain-work
    next-required-bits
    block-header-links?
    block-header-valid-after?
    validate-header-chain
    header-chain-valid?
    header-chain-work
    bitcoin-max-money
    block-subsidy
    coinbase-transaction?
    verify-standard-input-script
    standard-input-script-valid?
    utxo-set-lookup
    connect-block)
  (begin

    (define %max-target
      #xffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffff)

    ;;; Maximum Bitcoin money supply in satoshis.
    (define bitcoin-max-money 2100000000000000)

    (define %coinbase-maturity 100)

    ;;; Bitcoin block header.
    (define-struct block-header
      (version integer?)
      (previous-block bytevector?)
      (merkle-root bytevector?)
      (time integer?)
      (bits integer?)
      (nonce integer?))

    ;;; Bitcoin block with a header and transaction list.
    (define-struct block
      (header-field block-header?)
      (transactions list?))

    ;;; UTXO set entry tracked by the consensus block connector.
    (define-struct utxo-entry
      (output txout?)
      (coinbase? boolean?)
      (height integer?))

    ;;; Parameters needed for proof-of-work target transitions.
    (define-struct consensus-params
      (pow-limit-bits integer?)
      (target-spacing integer?)
      (target-timespan integer?)
      (retarget-interval integer?))

    ;;; Bitcoin mainnet proof-of-work schedule parameters.
    (define bitcoin-mainnet-consensus-params
      (consensus-params pow-limit-bits: #x1d00ffff
                        target-spacing: 600
                        target-timespan: 1209600
                        retarget-interval: 2016))

    ;;; Testnet uses the same retarget cadence; minimum-difficulty exceptions
    ;;; are intentionally left to a future policy layer.
    (define bitcoin-testnet-consensus-params
      (consensus-params pow-limit-bits: #x1d00ffff
                        target-spacing: 600
                        target-timespan: 1209600
                        retarget-interval: 2016))

    ;;; Regtest keeps Bitcoin's spacing constants but a much easier pow limit.
    (define bitcoin-regtest-consensus-params
      (consensus-params pow-limit-bits: #x207fffff
                        target-spacing: 600
                        target-timespan: 1209600
                        retarget-interval: 2016))

    (define (validate-consensus-params params)
      (unless (consensus-params? params)
        (error "consensus params: expected consensus-params"))
      (require-uint "consensus pow limit bits"
                    (consensus-params-pow-limit-bits params)
                    %u32-max)
      (compact-target->integer (consensus-params-pow-limit-bits params))
      (require-uint "consensus target spacing"
                    (consensus-params-target-spacing params)
                    %u32-max)
      (require-uint "consensus target timespan"
                    (consensus-params-target-timespan params)
                    %u32-max)
      (require-uint "consensus retarget interval"
                    (consensus-params-retarget-interval params)
                    %u32-max)
      (when (= 0 (consensus-params-retarget-interval params))
        (error "consensus retarget interval: expected positive integer"))
      params)

    (define (validate-block-header header)
      (unless (block-header? header)
        (error "block-header: expected block-header"))
      (require-uint "block-header version" (block-header-version header) %u32-max)
      (require-bytevector-length "block-header previous block"
                                 (block-header-previous-block header)
                                 32)
      (require-bytevector-length "block-header merkle root"
                                 (block-header-merkle-root header)
                                 32)
      (require-uint "block-header time" (block-header-time header) %u32-max)
      (require-uint "block-header bits" (block-header-bits header) %u32-max)
      (require-uint "block-header nonce" (block-header-nonce header) %u32-max)
      header)

    (define (validate-block b)
      (unless (block? b)
        (error "block: expected block"))
      (validate-block-header (block-header-field b))
      (unless (list? (block-transactions b))
        (error "block transactions: expected list"))
      (when (null? (block-transactions b))
        (error "block transactions: expected at least one transaction"))
      (do ((xs (block-transactions b) (cdr xs)))
          ((null? xs) b)
        (validate-transaction (car xs))))

    ;;; Serialize a block header in Bitcoin wire order.
    (define (block-header-serialize header)
      (: block-header? -> bytevector?)
      (validate-block-header header)
      (bytevector-append
        (u32-le (block-header-version header))
        (block-header-previous-block header)
        (block-header-merkle-root header)
        (u32-le (block-header-time header))
        (u32-le (block-header-bits header))
        (u32-le (block-header-nonce header))))

    ;;; Parse exactly one 80-byte Bitcoin block header.
    (define (block-header-parse bytes)
      (: bytevector? -> block-header?)
      (require-bytevector "block-header-parse" bytes)
      (unless (= 80 (bytevector-length bytes))
        (error "block-header-parse: expected 80 bytes"))
      (block-header
        version: (read-u32-le bytes 0 "block-header version")
        previous-block: (bytevector-copy bytes 4 36)
        merkle-root: (bytevector-copy bytes 36 68)
        time: (read-u32-le bytes 68 "block-header time")
        bits: (read-u32-le bytes 72 "block-header bits")
        nonce: (read-u32-le bytes 76 "block-header nonce")))

    ;;; Return the internal 32-byte double-SHA256 header hash.
    (define (block-header-hash header)
      (: block-header? -> bytevector?)
      (hash256 (block-header-serialize header)))

    ;;; Return the conventional display hash/id for a block header.
    (define (block-header-id header)
      (: block-header? -> string?)
      (hex-encode (reverse-bytevector (block-header-hash header))))

    (define (hash-pair left right)
      (hash256 (bytevector-append left right)))

    (define (merkle-layer hashes)
      (let loop ((xs hashes) (out '()))
        (cond ((null? xs)
               (reverse out))
              ((null? (cdr xs))
               (reverse (cons (hash-pair (car xs) (car xs)) out)))
              (else
               (loop (cddr xs)
                     (cons (hash-pair (car xs) (cadr xs)) out))))))

    ;;; Compute the Bitcoin Merkle root from internal transaction hash bytes.
    (define (merkle-root hashes)
      (: list? -> bytevector?)
      (when (null? hashes)
        (error "merkle-root: expected at least one hash"))
      (do ((xs hashes (cdr xs)))
          ((null? xs))
        (require-bytevector-length "merkle-root hash" (car xs) 32))
      (let loop ((level hashes))
        (if (null? (cdr level))
            (car level)
            (loop (merkle-layer level)))))

    ;;; Compute a block's Merkle root from its transaction IDs.
    (define (block-merkle-root b)
      (: block? -> bytevector?)
      (validate-block b)
      (merkle-root (map transaction-txid (block-transactions b))))

    (define (block-merkle-root-valid? b)
      (: block? -> boolean?)
      (equal? (block-header-merkle-root (block-header-field b))
              (block-merkle-root b)))

    ;;; Decode Bitcoin compact target (`nBits`) to an integer target.
    (define (compact-target->integer bits)
      (: integer? -> integer?)
      (require-uint "compact-target->integer" bits %u32-max)
      (let* ((size (arithmetic-shift bits -24))
             (word (bitwise-and bits #x007fffff))
             (negative? (not (= 0 (bitwise-and bits #x00800000))))
             (target (if (<= size 3)
                         (arithmetic-shift word (* 8 (- size 3)))
                         (arithmetic-shift word (* 8 (- size 3))))))
        (when negative?
          (error "compact-target->integer: negative target"))
        (when (or (= word 0) (< target 0) (> target %max-target))
          (error "compact-target->integer: target out of range"))
        target))

    (define (integer-byte-size n)
      (let loop ((v n) (size 0))
        (if (= v 0)
            size
            (loop (quotient v 256) (+ size 1)))))

    ;;; Encode an integer target as Bitcoin compact target (`nBits`).
    (define (integer->compact-target target)
      (: integer? -> integer?)
      (unless (and (integer? target) (> target 0) (<= target %max-target))
        (error "integer->compact-target: target out of range"))
      (let* ((size (integer-byte-size target))
             (compact (if (<= size 3)
                          (arithmetic-shift target (* 8 (- 3 size)))
                          (arithmetic-shift target (* -8 (- size 3)))))
             (adjust? (not (= 0 (bitwise-and compact #x00800000))))
             (final-size (if adjust? (+ size 1) size))
             (final-compact (if adjust?
                                (arithmetic-shift compact -8)
                                compact)))
        (bitwise-ior (arithmetic-shift final-size 24)
                     (bitwise-and final-compact #x007fffff))))

    (define (block-header-target header)
      (: block-header? -> integer?)
      (compact-target->integer (block-header-bits (validate-block-header header))))

    (define (bytes->integer-le bytes)
      (let ((n 0))
        (do ((i (- (bytevector-length bytes) 1) (- i 1)))
            ((< i 0) n)
          (set! n (+ (arithmetic-shift n 8)
                     (bytevector-u8-ref bytes i))))))

    ;;; Return the header hash interpreted as a proof-of-work integer.
    (define (block-header-work-value header)
      (: block-header? -> integer?)
      (bytes->integer-le (block-header-hash header)))

    (define (block-header-proof-of-work-valid? header)
      (: block-header? -> boolean?)
      (<= (block-header-work-value header)
          (block-header-target header)))

    ;;; Return the amount of chain work represented by a header target.
    (define (block-header-chain-work header)
      (: block-header? -> integer?)
      (quotient (+ %max-target 1)
                (+ (block-header-target header) 1)))

    (define (clamp-timespan params actual-timespan)
      (let* ((target-timespan (consensus-params-target-timespan params))
             (min-timespan (quotient target-timespan 4))
             (max-timespan (* target-timespan 4)))
        (cond ((< actual-timespan min-timespan) min-timespan)
              ((> actual-timespan max-timespan) max-timespan)
              (else actual-timespan))))

    (define (nth xs index)
      (if (= index 0)
          (car xs)
          (nth (cdr xs) (- index 1))))

    (define (last-item xs)
      (if (null? (cdr xs))
          (car xs)
          (last-item (cdr xs))))

    (define (retarget-required-bits params previous-headers)
      (let* ((interval (consensus-params-retarget-interval params))
             (count (length previous-headers)))
        (when (< count interval)
          (error "next-required-bits: insufficient retarget history"))
        (let* ((first (nth previous-headers (- count interval)))
               (last (last-item previous-headers))
               (actual-timespan (- (block-header-time last)
                                   (block-header-time first)))
               (adjusted-timespan (clamp-timespan params actual-timespan))
               (old-target (block-header-target last))
               (pow-limit (compact-target->integer
                            (consensus-params-pow-limit-bits params)))
               (new-target (quotient (* old-target adjusted-timespan)
                                      (consensus-params-target-timespan params)))
               (bounded-target (if (> new-target pow-limit)
                                   pow-limit
                                   new-target)))
          (integer->compact-target bounded-target))))

    ;;; Return the required `nBits` for the next header after `previous-headers`.
    ;;;
    ;;; `previous-headers` are ordered from oldest to newest. Genesis uses the
    ;;; configured pow limit, non-retarget heights keep the previous header's
    ;;; target, and retarget heights use Bitcoin's 4x clamped timespan rule.
    (define (next-required-bits params previous-headers)
      (: consensus-params? list? -> integer?)
      (validate-consensus-params params)
      (unless (list? previous-headers)
        (error "next-required-bits: expected header list"))
      (cond ((null? previous-headers)
             (consensus-params-pow-limit-bits params))
            ((not (= 0 (remainder (length previous-headers)
                                  (consensus-params-retarget-interval params))))
             (block-header-bits (last-item previous-headers)))
            (else
             (retarget-required-bits params previous-headers))))

    (define (block-header-links? previous header)
      (: block-header? block-header? -> boolean?)
      (equal? (block-header-previous-block header)
              (block-header-hash previous)))

    ;;; Validate a header against the existing ordered header chain.
    (define (block-header-valid-after? params previous-headers header)
      (: consensus-params? list? block-header? -> boolean?)
      (validate-block-header header)
      (and (= (block-header-bits header)
              (next-required-bits params previous-headers))
           (block-header-proof-of-work-valid? header)
           (or (null? previous-headers)
               (block-header-links? (last-item previous-headers) header))))

    ;;; Validate an ordered header chain and return it on success.
    (define (validate-header-chain params headers)
      (: consensus-params? list? -> list?)
      (validate-consensus-params params)
      (unless (list? headers)
        (error "validate-header-chain: expected header list"))
      (let loop ((remaining headers) (accepted '()))
        (if (null? remaining)
            headers
            (let ((history (reverse accepted))
                  (header (car remaining)))
              (unless (block-header-valid-after? params history header)
                (error "validate-header-chain: invalid header"))
              (loop (cdr remaining) (cons header accepted))))))

    (define (header-chain-valid? params headers)
      (: consensus-params? list? -> boolean?)
      (guard (err (else #f))
        (validate-header-chain params headers)
        #t))

    (define (header-chain-work headers)
      (: list? -> integer?)
      (let loop ((xs headers) (work 0))
        (if (null? xs)
            work
            (loop (cdr xs)
                  (+ work (block-header-chain-work (car xs)))))))

    (define (require-money who value)
      (require-uint who value bitcoin-max-money))

    (define (sum-money who outputs)
      (let loop ((xs outputs) (total 0))
        (if (null? xs)
            total
            (let ((output (car xs)))
              (validate-txout output)
              (require-money who (txout-value output))
              (let ((next (+ total (txout-value output))))
                (require-money who next)
                (loop (cdr xs) next))))))

    ;;; Return the block subsidy in satoshis for a block height.
    (define (block-subsidy height)
      (: integer? -> integer?)
      (require-uint "block-subsidy height" height %u32-max)
      (let ((halvings (quotient height 210000)))
        (if (>= halvings 64)
            0
            (quotient 5000000000 (expt 2 halvings)))))

    (define (coinbase-outpoint? op)
      (and (outpoint? op)
           (= #xffffffff (outpoint-index op))
           (equal? (make-bytevector 32 0) (outpoint-txid op))))

    ;;; Return true when `tx` has the Bitcoin coinbase prevout shape.
    (define (coinbase-transaction? tx)
      (: transaction? -> boolean?)
      (validate-transaction tx)
      (and (= 1 (length (transaction-inputs tx)))
           (coinbase-outpoint? (txin-previous-output
                                 (car (transaction-inputs tx))))))

    (define (validate-coinbase tx)
      (unless (coinbase-transaction? tx)
        (error "coinbase: expected coinbase transaction"))
      (let* ((script (txin-script-sig (car (transaction-inputs tx))))
             (script-len (bytevector-length script)))
        (when (or (< script-len 2) (> script-len 100))
          (error "coinbase: scriptSig length outside consensus bounds")))
      (when (null? (transaction-outputs tx))
        (error "coinbase: expected at least one output"))
      tx)

    (define (validate-regular-transaction tx)
      (validate-transaction tx)
      (when (coinbase-transaction? tx)
        (error "transaction: unexpected coinbase"))
      (when (null? (transaction-inputs tx))
        (error "transaction: expected at least one input"))
      (when (null? (transaction-outputs tx))
        (error "transaction: expected at least one output"))
      (sum-money "transaction output value" (transaction-outputs tx))
      tx)

    (define (outpoint=? a b)
      (and (= (outpoint-index a) (outpoint-index b))
           (equal? (outpoint-txid a) (outpoint-txid b))))

    ;;; Return a UTXO entry for `op`, or `#f` when it is absent.
    (define (utxo-set-lookup utxos op)
      (: list? outpoint? -> any?)
      (validate-outpoint op)
      (let loop ((xs utxos))
        (cond ((null? xs) #f)
              ((outpoint=? op (car (car xs))) (cdr (car xs)))
              (else (loop (cdr xs))))))

    (define (utxo-set-remove utxos op)
      (let loop ((xs utxos) (out '()) (removed? #f))
        (cond ((null? xs)
               (if removed?
                   (reverse out)
                   (error "utxo-set-remove: missing outpoint")))
              ((outpoint=? op (car (car xs)))
               (loop (cdr xs) out #t))
              (else
               (loop (cdr xs) (cons (car xs) out) removed?)))))

    (define (utxo-set-add utxos op entry)
      (validate-outpoint op)
      (unless (utxo-entry? entry)
        (error "utxo-set-add: expected utxo-entry"))
      (validate-txout (utxo-entry-output entry))
      (require-uint "utxo-entry height" (utxo-entry-height entry) %u32-max)
      (when (utxo-set-lookup utxos op)
        (error "utxo-set-add: duplicate unspent outpoint"))
      (cons (cons op entry) utxos))

    (define (output-outpoint tx index)
      (outpoint txid: (transaction-txid tx) index: index))

    (define (add-transaction-outputs utxos tx height coinbase?)
      (let loop ((outputs (transaction-outputs tx))
                 (index 0)
                 (next-utxos utxos))
        (if (null? outputs)
            next-utxos
            (loop
              (cdr outputs)
              (+ index 1)
              (utxo-set-add
                next-utxos
                (output-outpoint tx index)
                (utxo-entry output: (car outputs)
                            coinbase?: coinbase?
                            height: height))))))

    (define (spendable-utxo-entry height op entry)
      (when (and (utxo-entry-coinbase? entry)
                 (< (- height (utxo-entry-height entry)) %coinbase-maturity))
        (error "connect-block: immature coinbase spend"))
      entry)

    (define (script-push-chunk? chunk)
      (bytevector? (script-chunk-data chunk)))

    (define (last-list-item xs who)
      (when (null? xs)
        (error (string-append who ": expected non-empty list")))
      (if (null? (cdr xs))
          (car xs)
          (last-list-item (cdr xs) who)))

    (define (drop-last-list-item xs who)
      (when (null? xs)
        (error (string-append who ": expected non-empty list")))
      (if (null? (cdr xs))
          '()
          (cons (car xs) (drop-last-list-item (cdr xs) who))))

    (define (input-with-script-and-witness input script-sig witness)
      (txin previous-output: (txin-previous-output input)
            script-sig: script-sig
            sequence: (txin-sequence input)
            witness: witness))

    (define (chunks->push-script chunks)
      (apply script-append (map script-push-data (map script-chunk-data chunks))))

    (define (single-key-checksig-script-pubkey script who)
      (let ((chunks (script-parse script)))
        (unless (and (= 2 (length chunks))
                     (script-push-chunk? (car chunks))
                     (= op-checksig (script-chunk-opcode (cadr chunks)))
                     (not (script-chunk-data (cadr chunks))))
          (error (string-append who ": expected single-key CHECKSIG script")))
        (script-chunk-data (car chunks))))

    (define (single-key-tapscript-pubkey script who)
      (let ((pubkey (single-key-checksig-script-pubkey script who)))
        (require-bytevector-length who pubkey 32)
        pubkey))

    (define (single-byte-sighash-all? sig)
      (and (> (bytevector-length sig) 0)
           (= sighash-all (bytevector-u8-ref sig (- (bytevector-length sig) 1)))))

    (define (signature-der-bytes sig)
      (bytevector-copy sig 0 (- (bytevector-length sig) 1)))

    (define (verify-ecdsa-sighash-all sig pubkey msghash who)
      (unless (single-byte-sighash-all? sig)
        (error (string-append who ": only SIGHASH_ALL is supported")))
      (unless (secp256k1-ecdsa-verify
                (secp256k1-ecdsa-signature-parse-der
                  (signature-der-bytes sig))
                msghash
                pubkey)
        (error (string-append who ": signature check failed")))
      #t)

    (define (taproot-signature-hash-type sig who)
      (let ((len (bytevector-length sig)))
        (cond ((= len 64) sighash-default)
              ((= len 65)
               (let ((sighash-type (bytevector-u8-ref sig 64)))
                 (unless (or (= sighash-type sighash-default)
                             (= sighash-type sighash-all))
                   (error (string-append who ": unsupported Taproot sighash type")))
                 sighash-type))
              (else
               (error (string-append who ": expected 64 or 65 byte Schnorr signature"))))))

    (define (taproot-signature-bytes sig)
      (if (= 64 (bytevector-length sig))
          sig
          (bytevector-copy sig 0 64)))

    (define (verify-schnorr-taproot-sig sig msghash xonly who)
      (unless (secp256k1-schnorrsig-verify
                (taproot-signature-bytes sig)
                msghash
                xonly)
        (error (string-append who ": signature check failed")))
      #t)

    (define (verify-p2pkh-input tx input-index input prevout)
      (let* ((chunks (script-parse (txin-script-sig input)))
             (who "verify-standard-input-script p2pkh"))
        (unless (and (= 2 (length chunks))
                     (script-push-chunk? (car chunks))
                     (script-push-chunk? (cadr chunks))
                     (null? (txin-witness input)))
          (error (string-append who ": expected signature and public key scriptSig")))
        (let* ((sig (script-chunk-data (car chunks)))
               (pubkey (script-chunk-data (cadr chunks)))
               (pubkey-hash (script-standard-payload (txout-script-pubkey prevout)))
               (script-code (script-p2pkh pubkey-hash))
               (msghash (transaction-sighash-legacy tx input-index script-code sighash-all)))
          (unless (equal? pubkey-hash (hash160 pubkey))
            (error (string-append who ": public key hash mismatch")))
          (verify-ecdsa-sighash-all sig pubkey msghash who))))

    (define (verify-p2wpkh-input tx input-index input prevout)
      (let* ((witness (txin-witness input))
             (who "verify-standard-input-script p2wpkh"))
        (unless (and (= 0 (bytevector-length (txin-script-sig input)))
                     (= 2 (length witness))
                     (bytevector? (car witness))
                     (bytevector? (cadr witness)))
          (error (string-append who ": expected signature and public key witness")))
        (let* ((sig (car witness))
               (pubkey (cadr witness))
               (pubkey-hash (script-standard-payload (txout-script-pubkey prevout)))
               (script-code (script-p2pkh pubkey-hash))
               (msghash (transaction-sighash-segwit-v0
                          tx
                          input-index
                          script-code
                          (txout-value prevout)
                          sighash-all)))
          (unless (equal? pubkey-hash (hash160 pubkey))
            (error (string-append who ": public key hash mismatch")))
          (verify-ecdsa-sighash-all sig pubkey msghash who))))

    (define (verify-p2wsh-input tx input-index input prevout)
      (let* ((witness (txin-witness input))
             (who "verify-standard-input-script p2wsh"))
        (unless (and (= 0 (bytevector-length (txin-script-sig input)))
                     (= 2 (length witness))
                     (bytevector? (car witness))
                     (bytevector? (cadr witness)))
          (error (string-append who ": expected signature and witness script")))
        (let* ((sig (car witness))
               (witness-script (cadr witness))
               (script-hash (script-standard-payload (txout-script-pubkey prevout)))
               (pubkey (single-key-checksig-script-pubkey witness-script who))
               (msghash (transaction-sighash-segwit-v0
                          tx
                          input-index
                          witness-script
                          (txout-value prevout)
                          sighash-all)))
          (unless (equal? script-hash (sha256-bytes witness-script))
            (error (string-append who ": witness script hash mismatch")))
          (verify-ecdsa-sighash-all sig pubkey msghash who))))

    (define (verify-p2tr-keypath-input tx input-index prevouts input prevout)
      (let* ((witness (txin-witness input))
             (who "verify-standard-input-script p2tr keypath"))
        (unless (and (= 0 (bytevector-length (txin-script-sig input)))
                     (= 1 (length witness))
                     (bytevector? (car witness)))
          (error (string-append who ": expected single signature witness")))
        (let* ((sig (car witness))
               (sighash-type (taproot-signature-hash-type sig who))
               (output-xonly (script-standard-payload (txout-script-pubkey prevout)))
               (msghash (transaction-sighash-taproot-keypath
                          tx
                          input-index
                          prevouts
                          sighash-type)))
          (verify-schnorr-taproot-sig sig msghash output-xonly who))))

    (define (verify-p2tr-scriptpath-input tx input-index prevouts input prevout)
      (let* ((witness (txin-witness input))
             (who "verify-standard-input-script p2tr scriptpath"))
        (unless (and (= 0 (bytevector-length (txin-script-sig input)))
                     (= 3 (length witness))
                     (bytevector? (car witness))
                     (bytevector? (cadr witness))
                     (bytevector? (caddr witness)))
          (error (string-append who ": expected signature, script, and control block witness")))
        (validate-taproot-control-block who (caddr witness))
        (let* ((sig (car witness))
               (script (cadr witness))
               (control-block (caddr witness))
               (leaf-version (bitwise-and (bytevector-u8-ref control-block 0) #xfe))
               (leaf-hash (taproot-leaf-hash script leaf-version))
               (output-xonly (script-standard-payload (txout-script-pubkey prevout)))
               (control-output-xonly (taproot-control-block-output-xonly
                                       leaf-hash
                                       control-block))
               (pubkey (single-key-tapscript-pubkey script who))
               (sighash-type (taproot-signature-hash-type sig who))
               (msghash (transaction-sighash-taproot-scriptpath
                          tx
                          input-index
                          prevouts
                          script
                          leaf-version
                          sighash-type)))
          (unless (= #xc0 leaf-version)
            (error (string-append who ": unsupported Taproot leaf version")))
          (unless (equal? output-xonly control-output-xonly)
            (error (string-append who ": control block does not match output key")))
          (verify-schnorr-taproot-sig sig msghash pubkey who))))

    (define (verify-p2tr-input tx input-index prevouts input prevout)
      (let ((witness (txin-witness input))
            (who "verify-standard-input-script p2tr"))
        (when (null? witness)
          (error (string-append who ": missing witness")))
        (if (= 1 (length witness))
            (verify-p2tr-keypath-input tx input-index prevouts input prevout)
            (verify-p2tr-scriptpath-input tx input-index prevouts input prevout))))

    (define (verify-p2sh-input tx input-index input prevout)
      (let* ((chunks (script-parse (txin-script-sig input)))
             (who "verify-standard-input-script p2sh"))
        (when (null? chunks)
          (error (string-append who ": missing redeem script")))
        (do ((xs chunks (cdr xs)))
            ((null? xs))
          (unless (script-push-chunk? (car xs))
            (error (string-append who ": scriptSig must be push-only"))))
        (let* ((redeem-script (script-chunk-data (last-list-item chunks who)))
               (initial-chunks (drop-last-list-item chunks who))
               (redeem-hash (script-standard-payload (txout-script-pubkey prevout)))
               (redeem-class (script-classify redeem-script))
               (nested-prevout (txout value: (txout-value prevout)
                                      script-pubkey: redeem-script)))
          (unless (equal? redeem-hash (hash160 redeem-script))
            (error (string-append who ": redeem script hash mismatch")))
          (case redeem-class
            ((p2pkh)
             (verify-p2pkh-input
               tx
               input-index
               (input-with-script-and-witness
                 input
                 (chunks->push-script initial-chunks)
                 '())
               nested-prevout))
            ((p2wpkh)
             (unless (= 1 (length chunks))
               (error (string-append who ": P2SH witness scriptSig must only push redeem script")))
             (verify-p2wpkh-input
               tx
               input-index
               (input-with-script-and-witness input #u8() (txin-witness input))
               nested-prevout))
            ((p2wsh)
             (unless (= 1 (length chunks))
               (error (string-append who ": P2SH witness scriptSig must only push redeem script")))
             (verify-p2wsh-input
               tx
               input-index
               (input-with-script-and-witness input #u8() (txin-witness input))
               nested-prevout))
            (else #t)))))

    ;;; Verify one input against recognized standard consensus script templates.
    ;;;
    ;;; P2PKH and P2SH-P2PKH use legacy `SIGHASH_ALL`; native and P2SH-wrapped
    ;;; P2WPKH/P2WSH use BIP143 `SIGHASH_ALL`. P2TR supports key-path Schnorr
    ;;; signatures and single-key Tapscript CHECKSIG leaves. P2WSH and script
    ;;; path P2TR stay intentionally narrow until the general interpreter lands.
    ;;; Unknown scripts pass through so existing structural block validation
    ;;; remains usable for nonstandard test fixtures.
    ;;;
    ;;; ```scheme
    ;;; (verify-standard-input-script tx 0 prevout)
    ;;; ```
    (define (verify-standard-input-script tx input-index prevout . maybe-prevouts)
      (: transaction? integer? txout? list? ... -> boolean?)
      (validate-transaction tx)
      (validate-txout prevout)
      (let ((input (nth (transaction-inputs tx) input-index))
            (prevouts (if (null? maybe-prevouts)
                          (list prevout)
                          (car maybe-prevouts))))
        (case (script-classify (txout-script-pubkey prevout))
          ((p2pkh)
           (verify-p2pkh-input tx input-index input prevout))
          ((p2wpkh)
           (verify-p2wpkh-input tx input-index input prevout))
          ((p2wsh)
           (verify-p2wsh-input tx input-index input prevout))
          ((p2sh)
           (verify-p2sh-input tx input-index input prevout))
          ((p2tr)
           (verify-p2tr-input tx input-index prevouts input prevout))
          (else #t))))

    ;;; Return true when `verify-standard-input-script` accepts an input.
    ;;;
    ;;; ```scheme
    ;;; (standard-input-script-valid? tx 0 prevout)
    ;;; ```
    (define (standard-input-script-valid? tx input-index prevout . maybe-prevouts)
      (: transaction? integer? txout? list? ... -> boolean?)
      (guard (err (else #f))
        (if (null? maybe-prevouts)
            (verify-standard-input-script tx input-index prevout)
            (verify-standard-input-script tx input-index prevout (car maybe-prevouts)))
        #t))

    (define (verify-transaction-standard-scripts tx prevouts)
      (let loop ((xs prevouts) (input-index 0))
        (if (null? xs)
            #t
            (begin
              (verify-standard-input-script tx input-index (car xs) prevouts)
              (loop (cdr xs) (+ input-index 1))))))

    (define (spend-transaction-inputs utxos tx height)
      (let loop ((inputs (transaction-inputs tx))
                 (next-utxos utxos)
                 (prevouts '())
                 (input-value 0))
        (if (null? inputs)
            (list next-utxos (reverse prevouts) input-value)
            (let* ((op (txin-previous-output (car inputs)))
                   (entry (utxo-set-lookup next-utxos op)))
              (unless entry
                (error "connect-block: missing or already-spent input"))
              (spendable-utxo-entry height op entry)
              (let ((new-input-value (+ input-value
                                        (txout-value (utxo-entry-output entry)))))
                (require-money "connect-block input value" new-input-value)
                (loop (cdr inputs)
                      (utxo-set-remove next-utxos op)
                      (cons (utxo-entry-output entry) prevouts)
                      new-input-value))))))

    (define (connect-regular-transaction utxos tx height)
      (validate-regular-transaction tx)
      (let* ((spent (spend-transaction-inputs utxos tx height))
             (without-inputs (car spent))
             (prevouts (cadr spent))
             (input-value (caddr spent))
             (output-value (sum-money "connect-block output value"
                                      (transaction-outputs tx))))
        (verify-transaction-standard-scripts tx prevouts)
        (when (< input-value output-value)
          (error "connect-block: transaction spends more than its inputs"))
        (list
          (add-transaction-outputs without-inputs tx height #f)
          (- input-value output-value))))

    ;;; Validate a block's transactions against `utxos` and return the updated
    ;;; UTXO set. Recognized standard P2PKH, P2SH, P2WPKH, P2WSH, and P2TR
    ;;; inputs execute signature checks; remaining deployment-era rules are
    ;;; tracked in the roadmap.
    ;;; The connector also enforces structural block transaction rules, UTXO
    ;;; availability, value conservation, coinbase maturity, subsidy, and fees.
    (define (connect-block params height utxos b)
      (: consensus-params? integer? list? block? -> list?)
      (validate-consensus-params params)
      (require-uint "connect-block height" height %u32-max)
      (validate-block b)
      (unless (block-merkle-root-valid? b)
        (error "connect-block: invalid merkle root"))
      (let* ((txs (block-transactions b))
             (coinbase (car txs)))
        (validate-coinbase coinbase)
        (let loop ((remaining (cdr txs))
                   (next-utxos utxos)
                   (fees 0))
          (if (null? remaining)
              (let* ((allowed (+ (block-subsidy height) fees))
                     (claimed (sum-money "connect-block coinbase value"
                                         (transaction-outputs coinbase))))
                (when (> claimed allowed)
                  (error "connect-block: coinbase reward exceeds subsidy plus fees"))
                (add-transaction-outputs next-utxos coinbase height #t))
              (let ((connected (connect-regular-transaction
                                 next-utxos
                                 (car remaining)
                                 height)))
                (loop (cdr remaining)
                      (car connected)
                      (+ fees (cadr connected))))))))

    ;;; Serialize a block in Bitcoin wire order.
    (define (block-serialize b)
      (: block? -> bytevector?)
      (validate-block b)
      (bytevector-append
        (block-header-serialize (block-header-field b))
        (serialize-vector (block-transactions b) transaction-serialize)))

    (define (parse-transactions bytes offset count)
      (let loop ((i 0) (cursor offset) (txs '()))
        (if (>= i count)
            (list (reverse txs) cursor)
            (let* ((parsed (transaction-parse-at bytes cursor))
                   (tx (car parsed))
                   (next (cadr parsed)))
              (loop (+ i 1) next (cons tx txs))))))

    ;;; Parse a Bitcoin block with a transaction vector.
    (define (block-parse bytes)
      (: bytevector? -> block?)
      (require-bytevector "block-parse" bytes)
      (ensure-available "block-parse" bytes 0 81)
      (let* ((header (block-header-parse (bytevector-copy bytes 0 80)))
             (count-result (compact-size-decode-at bytes 80))
             (count (car count-result))
             (tx-result (parse-transactions bytes (cadr count-result) count))
             (txs (car tx-result))
             (end (cadr tx-result)))
        (unless (= end (bytevector-length bytes))
          (error "block-parse: trailing bytes"))
        (block header-field: header transactions: txs)))))
