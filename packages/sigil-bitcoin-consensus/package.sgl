;;; sigil-bitcoin-consensus — Bitcoin block and header consensus helpers
;;;
;;; Pure Sigil library providing block/header wire parsing, Merkle roots, and
;;; proof-of-work target checks.

(package
  name: "sigil-bitcoin-consensus"
  version: "0.1.0"
  sigil: "0.20"
  description: "Bitcoin block headers, Merkle roots, and proof-of-work helpers"
  url: "https://codeberg.org/sigil/sigil-bitcoin"
  license: "BSD-3-Clause"

  dependencies: (list
    (from-git url: "codeberg:sigil/sigil-crypto" version: "^0.16.1")
    (from-workspace name: "sigil-bitcoin-utils")
    (from-workspace name: "sigil-bitcoin-primitives")
    (from-workspace name: "sigil-bitcoin-encoding")
    (from-workspace name: "sigil-bitcoin-script")
    (from-workspace name: "sigil-bitcoin-keys")
    (from-workspace name: "sigil-bitcoin-tx")
    (from-workspace name: "sigil-secp256k1"))

  dev-dependencies: (list
    (from-git url: "codeberg:sigil/sigil"
              package: "sigil-stdlib" version: "^0.20")
    (from-git url: "codeberg:sigil/sigil-ansi" version: "^0.16.0")
    (from-git url: "codeberg:sigil/sigil-json" version: "^0.16.0")
    (from-git url: "codeberg:sigil/sigil-version" version: "^0.16.0")
    (from-git url: "codeberg:sigil/sigil"
              package: "sigil-test" version: "^0.20")
    (from-git url: "codeberg:sigil/sigil"
              package: "sigil-test-runner" version: "^0.20"))

  tasks: (list
    (task
      name: 'build
      description: "Build sigil-bitcoin-consensus"
      steps: (list
        (compile-sigil-modules
          sources: "src/**/*.sgl")))))
