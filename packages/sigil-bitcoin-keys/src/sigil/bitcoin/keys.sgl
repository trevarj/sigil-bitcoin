;;; (sigil bitcoin keys) — Bitcoin key, address, BIP32, and BIP39 helpers

(define-library (sigil bitcoin keys)
  (import (sigil struct)
          (sigil crypto)
          (sigil math)
          (sigil secp256k1)
          (sigil bitcoin primitives)
          (sigil bitcoin encoding)
          (sigil bitcoin bip39-words))
  (export
    bitcoin-network bitcoin-network?
    bitcoin-network-name bitcoin-network-wif bitcoin-network-p2pkh
    bitcoin-network-p2sh bitcoin-network-bech32 bitcoin-network-xprv
    bitcoin-network-xpub
    bitcoin-mainnet bitcoin-testnet
    extended-private-key extended-private-key?
    extended-private-key-network extended-private-key-depth
    extended-private-key-parent-fingerprint
    extended-private-key-child-number extended-private-key-chain-code
    extended-private-key-private-key
    extended-public-key extended-public-key?
    extended-public-key-network extended-public-key-depth
    extended-public-key-parent-fingerprint
    extended-public-key-child-number extended-public-key-chain-code
    extended-public-key-public-key
    private-key->wif wif->private-key
    private-key->public-key public-key? compressed-public-key?
    x-only-public-key
    public-key->p2pkh-address script-hash->p2sh-address
    public-key->p2wpkh-address script->p2wsh-address
    x-only-public-key->p2tr-address
    bip32-master-key bip32-private-child bip32-public-child
    bip32-derive-path extended-private-key->public-key
    bip32-xprv->string bip32-xpub->string
    string->bip32-xprv string->bip32-xpub
    bip39-entropy->mnemonic bip39-mnemonic->entropy
    bip39-mnemonic->seed)
  (begin

    ;;; Bitcoin network parameters used by key and address encoders.
    (define-struct bitcoin-network
      (name symbol?)
      (wif integer?)
      (p2pkh integer?)
      (p2sh integer?)
      (bech32 string?)
      (xprv integer?)
      (xpub integer?))

    ;;; Mainnet address and extended-key version constants.
    (define bitcoin-mainnet
      (bitcoin-network name: 'mainnet
                       wif: #x80
                       p2pkh: #x00
                       p2sh: #x05
                       bech32: "bc"
                       xprv: #x0488ade4
                       xpub: #x0488b21e))

    ;;; Testnet address and extended-key version constants.
    (define bitcoin-testnet
      (bitcoin-network name: 'testnet
                       wif: #xef
                       p2pkh: #x6f
                       p2sh: #xc4
                       bech32: "tb"
                       xprv: #x04358394
                       xpub: #x043587cf))

    ;;; BIP32 extended private key record.
    (define-struct extended-private-key
      (network bitcoin-network?)
      (depth integer?)
      (parent-fingerprint bytevector?)
      (child-number integer?)
      (chain-code bytevector?)
      (private-key bytevector?))

    ;;; BIP32 extended public key record.
    (define-struct extended-public-key
      (network bitcoin-network?)
      (depth integer?)
      (parent-fingerprint bytevector?)
      (child-number integer?)
      (chain-code bytevector?)
      (public-key bytevector?))

    (define %hardened-offset #x80000000)

    (define (require-bytevector-length who bytes len)
      (unless (and (bytevector? bytes) (= len (bytevector-length bytes)))
        (error (string-append who ": expected "
                              (number->string len)
                              "-byte bytevector")))
      bytes)

    (define (require-private-key key)
      (require-bytevector-length "private key" key 32)
      (unless (secp256k1-seckey-verify? key)
        (error "private key: invalid secp256k1 secret key"))
      key)

    (define (copy4 bytes)
      (require-bytevector-length "fingerprint" bytes 4)
      (bytevector-copy bytes))

    (define (zero4? bytes offset)
      (and (= 0 (bytevector-u8-ref bytes offset))
           (= 0 (bytevector-u8-ref bytes (+ offset 1)))
           (= 0 (bytevector-u8-ref bytes (+ offset 2)))
           (= 0 (bytevector-u8-ref bytes (+ offset 3)))))

    (define (u32->bytevector n)
      (let ((out (make-bytevector 4 0)))
        (when (or (< n 0) (> n #xffffffff))
          (error "u32->bytevector: value out of range"))
        (bytevector-u8-set! out 0 (bitwise-and (arithmetic-shift n -24) #xff))
        (bytevector-u8-set! out 1 (bitwise-and (arithmetic-shift n -16) #xff))
        (bytevector-u8-set! out 2 (bitwise-and (arithmetic-shift n -8) #xff))
        (bytevector-u8-set! out 3 (bitwise-and n #xff))
        out))

    (define (bytevector->u32 bytes offset)
      (bitwise-ior
        (arithmetic-shift (bytevector-u8-ref bytes offset) 24)
        (arithmetic-shift (bytevector-u8-ref bytes (+ offset 1)) 16)
        (arithmetic-shift (bytevector-u8-ref bytes (+ offset 2)) 8)
        (bytevector-u8-ref bytes (+ offset 3))))

    (define (write-u32! out offset n)
      (let ((bytes (u32->bytevector n)))
        (bytevector-copy! out offset bytes)))

    (define (valid-network-version version private?)
      (cond ((and private? (= version (bitcoin-network-xprv bitcoin-mainnet))) bitcoin-mainnet)
            ((and private? (= version (bitcoin-network-xprv bitcoin-testnet))) bitcoin-testnet)
            ((and (not private?) (= version (bitcoin-network-xpub bitcoin-mainnet))) bitcoin-mainnet)
            ((and (not private?) (= version (bitcoin-network-xpub bitcoin-testnet))) bitcoin-testnet)
            (else #f)))

    ;;; Encode a 32-byte private key as Wallet Import Format.
    ;;;
    ;;; `network` selects the WIF version byte. `compressed?` controls whether
    ;;; the compressed-public-key marker is included in the payload.
    (define (private-key->wif key network compressed?)
      (: bytevector? bitcoin-network? boolean? -> string?)
      (require-private-key key)
      (let ((payload (if compressed?
                         (bytevector-append key #u8(1))
                         key)))
        (base58check-encode (bitcoin-network-wif network) payload)))

    ;;; Decode a Wallet Import Format string.
    ;;;
    ;;; Returns `(key network . compressed?)`.
    (define (wif->private-key wif)
      (: string? -> list?)
      (let* ((decoded (base58check-decode wif))
             (version (car decoded))
             (payload (cadr decoded))
             (plen (bytevector-length payload))
             (network (cond ((= version (bitcoin-network-wif bitcoin-mainnet)) bitcoin-mainnet)
                            ((= version (bitcoin-network-wif bitcoin-testnet)) bitcoin-testnet)
                            (else #f))))
        (unless network
          (error "wif->private-key: unknown WIF version"))
        (cond ((= plen 32)
               (let ((key (bytevector-copy payload)))
                 (require-private-key key)
                 (list key network #f)))
              ((and (= plen 33) (= 1 (bytevector-u8-ref payload 32)))
               (let ((key (bytevector-copy payload 0 32)))
                 (require-private-key key)
                 (list key network #t)))
              (else
               (error "wif->private-key: invalid payload length")))))

    ;;; Derive a compressed public key from a 32-byte secp256k1 private key.
    (define (private-key->public-key key)
      (: bytevector? -> bytevector?)
      (secp256k1-pubkey-create (require-private-key key)))

    ;;; Return true when `key` is a valid compressed or uncompressed public key.
    (define (public-key? key)
      (: any? -> boolean?)
      (and (bytevector? key)
           (or (= 33 (bytevector-length key))
               (= 65 (bytevector-length key)))
           (bytevector? (secp256k1-pubkey-parse key))))

    ;;; Return true when `key` is a valid 33-byte compressed public key.
    (define (compressed-public-key? key)
      (: any? -> boolean?)
      (and (public-key? key)
           (= 33 (bytevector-length key))
           (or (= #x02 (bytevector-u8-ref key 0))
               (= #x03 (bytevector-u8-ref key 0)))))

    ;;; Convert a serialized public key into a 32-byte x-only public key.
    (define (x-only-public-key key)
      (: bytevector? -> bytevector?)
      (cond ((and (bytevector? key) (= 32 (bytevector-length key)))
             (bytevector-copy key))
            ((public-key? key)
             (bytevector-copy (secp256k1-pubkey-parse key) 0 32))
            (else
             (let ((kp (secp256k1-keypair-create (require-private-key key))))
               (secp256k1-keypair-xonly-pub kp)))))

    ;;; Derive a Base58Check P2PKH address from a serialized public key.
    (define (public-key->p2pkh-address key network)
      (: bytevector? bitcoin-network? -> string?)
      (unless (public-key? key)
        (error "public-key->p2pkh-address: invalid public key"))
      (base58check-encode (bitcoin-network-p2pkh network) (hash160 key)))

    ;;; Encode a 20-byte script hash as a Base58Check P2SH address.
    (define (script-hash->p2sh-address script-hash network)
      (: bytevector? bitcoin-network? -> string?)
      (require-bytevector-length "script-hash->p2sh-address" script-hash 20)
      (base58check-encode (bitcoin-network-p2sh network) script-hash))

    ;;; Derive a native SegWit P2WPKH address from a serialized public key.
    (define (public-key->p2wpkh-address key network)
      (: bytevector? bitcoin-network? -> string?)
      (unless (public-key? key)
        (error "public-key->p2wpkh-address: invalid public key"))
      (segwit-encode (bitcoin-network-bech32 network) 0 (hash160 key)))

    ;;; Derive a native SegWit P2WSH address from a witness script.
    (define (script->p2wsh-address script network)
      (: bytevector? bitcoin-network? -> string?)
      (segwit-encode (bitcoin-network-bech32 network) 0 (hash256 script)))

    ;;; Encode a 32-byte x-only public key as a native Taproot address.
    (define (x-only-public-key->p2tr-address xonly network)
      (: bytevector? bitcoin-network? -> string?)
      (segwit-encode (bitcoin-network-bech32 network) 1
                     (x-only-public-key xonly)))

    ;;; Return the BIP32 4-byte key fingerprint for a serialized public key.
    (define (fingerprint key)
      (bytevector-copy (hash160 key) 0 4))

    ;;; Neuter an extended private key into the matching extended public key.
    (define (extended-private-key->public-key xprv)
      (: extended-private-key? -> extended-public-key?)
      (extended-public-key
        network: (extended-private-key-network xprv)
        depth: (extended-private-key-depth xprv)
        parent-fingerprint: (copy4 (extended-private-key-parent-fingerprint xprv))
        child-number: (extended-private-key-child-number xprv)
        chain-code: (bytevector-copy (extended-private-key-chain-code xprv))
        public-key: (private-key->public-key (extended-private-key-private-key xprv))))

    ;;; Derive a BIP32 master extended private key from seed bytes.
    (define (bip32-master-key seed network)
      (: bytevector? bitcoin-network? -> extended-private-key?)
      (let* ((i (hmac-sha512-bytes "Bitcoin seed" seed))
             (il (bytevector-copy i 0 32))
             (ir (bytevector-copy i 32 64)))
        (require-private-key il)
        (extended-private-key
          network: network
          depth: 0
          parent-fingerprint: #u8(0 0 0 0)
          child-number: 0
          chain-code: ir
          private-key: il)))

    ;;; Derive a BIP32 private child key.
    ;;;
    ;;; Hardened children use child numbers greater than or equal to
    ;;; `#x80000000`.
    (define (bip32-private-child parent child-number)
      (: extended-private-key? integer? -> extended-private-key?)
      (when (or (< child-number 0) (> child-number #xffffffff))
        (error "bip32-private-child: child number out of range"))
      (let* ((hardened? (>= child-number %hardened-offset))
             (parent-key (extended-private-key-private-key parent))
             (data (bytevector-append
                     (if hardened?
                         (bytevector-append #u8(0) parent-key)
                         (private-key->public-key parent-key))
                     (u32->bytevector child-number)))
             (i (hmac-sha512-bytes (extended-private-key-chain-code parent) data))
             (il (bytevector-copy i 0 32))
             (ir (bytevector-copy i 32 64))
             (child-key (secp256k1-seckey-tweak-add parent-key il)))
        (unless (and (bytevector? child-key)
                     (secp256k1-seckey-verify? child-key))
          (error "bip32-private-child: invalid derived key"))
        (extended-private-key
          network: (extended-private-key-network parent)
          depth: (+ 1 (extended-private-key-depth parent))
          parent-fingerprint: (fingerprint (private-key->public-key parent-key))
          child-number: child-number
          chain-code: ir
          private-key: child-key)))

    ;;; Derive a non-hardened BIP32 public child key.
    (define (bip32-public-child parent child-number)
      (: extended-public-key? integer? -> extended-public-key?)
      (when (>= child-number %hardened-offset)
        (error "bip32-public-child: cannot derive hardened child from public key"))
      (let* ((data (bytevector-append
                     (extended-public-key-public-key parent)
                     (u32->bytevector child-number)))
             (i (hmac-sha512-bytes (extended-public-key-chain-code parent) data))
             (il (bytevector-copy i 0 32))
             (ir (bytevector-copy i 32 64))
             (child-pub (secp256k1-pubkey-tweak-add
                          (extended-public-key-public-key parent)
                          il)))
        (unless (public-key? child-pub)
          (error "bip32-public-child: invalid derived key"))
        (extended-public-key
          network: (extended-public-key-network parent)
          depth: (+ 1 (extended-public-key-depth parent))
          parent-fingerprint: (fingerprint (extended-public-key-public-key parent))
          child-number: child-number
          chain-code: ir
          public-key: child-pub)))

    (define (path-segment->child-number segment)
      (let* ((len (string-length segment))
             (last (if (> len 0) (string-ref segment (- len 1)) #\space))
             (hardened? (or (char=? last #\')
                            (char=? last #\h)
                            (char=? last #\H)))
             (digits (if hardened? (substring segment 0 (- len 1)) segment))
             (n (string->number digits)))
        (when (or (not n) (< n 0) (>= n %hardened-offset))
          (error "bip32-derive-path: invalid path segment"))
        (if hardened? (+ n %hardened-offset) n)))

    (define (split-path path)
      (let ((len (string-length path)))
        (let loop ((i 0) (start 0) (parts '()))
          (cond ((>= i len)
                 (reverse (cons (substring path start len) parts)))
                ((char=? #\/ (string-ref path i))
                 (loop (+ i 1) (+ i 1)
                       (cons (substring path start i) parts)))
                (else
                 (loop (+ i 1) start parts))))))

    ;;; Derive a BIP32 path such as `m/84'/0'/0'/0/0`.
    ;;;
    ;;; The input key may be an extended private key or extended public key.
    (define (bip32-derive-path key path)
      (: any? string? -> any?)
      (let ((parts (split-path path)))
        (when (or (null? parts)
                  (not (or (string=? (car parts) "m")
                           (string=? (car parts) "M"))))
          (error "bip32-derive-path: path must start with m"))
        (let loop ((current key) (rest (cdr parts)))
          (if (null? rest)
              current
              (let ((child (path-segment->child-number (car rest))))
                (loop
                  (cond ((extended-private-key? current)
                         (bip32-private-child current child))
                        ((extended-public-key? current)
                         (bip32-public-child current child))
                        (else
                         (error "bip32-derive-path: expected extended key")))
                  (cdr rest)))))))

    (define (xkey-payload version depth parent-fingerprint child-number chain-code key-data)
      (let ((payload (make-bytevector 78 0)))
        (write-u32! payload 0 version)
        (bytevector-u8-set! payload 4 depth)
        (bytevector-copy! payload 5 parent-fingerprint)
        (write-u32! payload 9 child-number)
        (bytevector-copy! payload 13 chain-code)
        (bytevector-copy! payload 45 key-data)
        payload))

    (define (validate-xkey-depth-fields who payload)
      (let ((depth (bytevector-u8-ref payload 4)))
        (when (and (= depth 0)
                   (or (not (zero4? payload 5))
                       (not (zero4? payload 9))))
          (error (string-append who
                                ": zero depth requires zero parent fingerprint and child number")))))

    (define (base58check-encode-bytes payload)
      (base58-encode
        (bytevector-append payload (bytevector-copy (hash256 payload) 0 4))))

    (define (base58check-decode-bytes str)
      (let* ((raw (base58-decode str))
             (len (bytevector-length raw)))
        (when (< len 5)
          (error "base58check-decode-bytes: too short"))
        (let* ((payload (bytevector-copy raw 0 (- len 4)))
               (cksum (bytevector-copy raw (- len 4) len))
               (expected (bytevector-copy (hash256 payload) 0 4)))
          (unless (equal? cksum expected)
            (error "base58check-decode-bytes: checksum mismatch"))
          payload)))

    ;;; Serialize a BIP32 extended private key as Base58Check text.
    (define (bip32-xprv->string key)
      (: extended-private-key? -> string?)
      (let* ((network (extended-private-key-network key))
             (payload (xkey-payload
                        (bitcoin-network-xprv network)
                        (extended-private-key-depth key)
                        (extended-private-key-parent-fingerprint key)
                        (extended-private-key-child-number key)
                        (extended-private-key-chain-code key)
                        (bytevector-append #u8(0)
                                           (extended-private-key-private-key key)))))
        (base58check-encode-bytes payload)))

    ;;; Serialize a BIP32 extended public key as Base58Check text.
    (define (bip32-xpub->string key)
      (: extended-public-key? -> string?)
      (let* ((network (extended-public-key-network key))
             (payload (xkey-payload
                        (bitcoin-network-xpub network)
                        (extended-public-key-depth key)
                        (extended-public-key-parent-fingerprint key)
                        (extended-public-key-child-number key)
                        (extended-public-key-chain-code key)
                        (extended-public-key-public-key key))))
        (base58check-encode-bytes payload)))

    ;;; Parse a Base58Check BIP32 extended private key.
    (define (string->bip32-xprv str)
      (: string? -> extended-private-key?)
      (let* ((payload (base58check-decode-bytes str)))
        (require-bytevector-length "string->bip32-xprv" payload 78)
        (validate-xkey-depth-fields "string->bip32-xprv" payload)
        (let* ((version (bytevector->u32 payload 0))
               (network (valid-network-version version #t))
               (key-data (bytevector-copy payload 45 78)))
          (unless network
            (error "string->bip32-xprv: unknown version"))
          (unless (= 0 (bytevector-u8-ref key-data 0))
            (error "string->bip32-xprv: invalid private key marker"))
          (extended-private-key
            network: network
            depth: (bytevector-u8-ref payload 4)
            parent-fingerprint: (bytevector-copy payload 5 9)
            child-number: (bytevector->u32 payload 9)
            chain-code: (bytevector-copy payload 13 45)
            private-key: (require-private-key (bytevector-copy key-data 1 33))))))

    ;;; Parse a Base58Check BIP32 extended public key.
    (define (string->bip32-xpub str)
      (: string? -> extended-public-key?)
      (let* ((payload (base58check-decode-bytes str)))
        (require-bytevector-length "string->bip32-xpub" payload 78)
        (validate-xkey-depth-fields "string->bip32-xpub" payload)
        (let* ((version (bytevector->u32 payload 0))
               (network (valid-network-version version #f))
               (pub (bytevector-copy payload 45 78)))
          (unless network
            (error "string->bip32-xpub: unknown version"))
          (unless (public-key? pub)
            (error "string->bip32-xpub: invalid public key"))
          (extended-public-key
            network: network
            depth: (bytevector-u8-ref payload 4)
            parent-fingerprint: (bytevector-copy payload 5 9)
            child-number: (bytevector->u32 payload 9)
            chain-code: (bytevector-copy payload 13 45)
            public-key: pub))))

    (define (valid-entropy-length? len)
      (or (= len 16) (= len 20) (= len 24) (= len 28) (= len 32)))

    (define (bytevector-bit-ref bytes bit-index)
      (let* ((byte (bytevector-u8-ref bytes (quotient bit-index 8)))
             (shift (- 7 (remainder bit-index 8))))
        (if (zero? (bitwise-and byte (arithmetic-shift 1 shift))) 0 1)))

    (define (bytevector-bit-set! bytes bit-index bit)
      (when (= bit 1)
        (let* ((offset (quotient bit-index 8))
               (old (bytevector-u8-ref bytes offset))
               (shift (- 7 (remainder bit-index 8))))
          (bytevector-u8-set! bytes offset
                              (bitwise-ior old (arithmetic-shift 1 shift))))))

    (define (bip39-index->word index)
      (bip39-english-word index))

    (define (bip39-word->index word)
      (bip39-english-word-index word))

    (define (split-words str)
      (let ((len (string-length str)))
        (let loop ((i 0) (start #f) (parts '()))
          (cond ((>= i len)
                 (reverse
                   (if start
                       (cons (substring str start len) parts)
                       parts)))
                ((char=? #\space (string-ref str i))
                 (if start
                     (loop (+ i 1) #f (cons (substring str start i) parts))
                     (loop (+ i 1) #f parts)))
                (else
                 (loop (+ i 1) (if start start i) parts))))))

    ;;; Convert BIP39 entropy bytes into an English mnemonic sentence.
    (define (bip39-entropy->mnemonic entropy)
      (: bytevector? -> string?)
      (let* ((ent-bytes (bytevector-length entropy))
             (ent-bits (* ent-bytes 8))
             (checksum-bits (/ ent-bits 32))
             (total-bits (+ ent-bits checksum-bits))
             (checksum (sha256-bytes entropy))
             (word-count (/ total-bits 11))
             (words '()))
        (unless (valid-entropy-length? ent-bytes)
          (error "bip39-entropy->mnemonic: entropy must be 16, 20, 24, 28, or 32 bytes"))
        (do ((w 0 (+ w 1)))
            ((>= w word-count) (string-join (reverse words) " "))
          (let ((index 0))
            (do ((j 0 (+ j 1)))
                ((>= j 11))
              (let* ((bit-pos (+ (* w 11) j))
                     (bit (if (< bit-pos ent-bits)
                              (bytevector-bit-ref entropy bit-pos)
                              (bytevector-bit-ref checksum (- bit-pos ent-bits)))))
                (set! index (+ (* index 2) bit))))
            (set! words (cons (bip39-index->word index) words))))))

    ;;; Convert a BIP39 English mnemonic sentence back to entropy bytes.
    (define (bip39-mnemonic->entropy mnemonic)
      (: string? -> bytevector?)
      (let* ((words (split-words mnemonic))
             (word-count (length words))
             (total-bits (* word-count 11))
             (ent-bits (/ (* total-bits 32) 33))
             (checksum-bits (- total-bits ent-bits))
             (entropy (make-bytevector (/ ent-bits 8) 0))
             (indexes '()))
        (unless (or (= word-count 12) (= word-count 15) (= word-count 18)
                    (= word-count 21) (= word-count 24))
          (error "bip39-mnemonic->entropy: invalid word count"))
        (do ((rest words (cdr rest)))
            ((null? rest))
          (let ((index (bip39-word->index (car rest))))
            (unless index
              (error "bip39-mnemonic->entropy: unknown word"))
            (set! indexes (append indexes (list index)))))
        (do ((bit-pos 0 (+ bit-pos 1)))
            ((>= bit-pos ent-bits))
          (let* ((word-index (list-ref indexes (quotient bit-pos 11)))
                 (shift (- 10 (remainder bit-pos 11)))
                 (bit (if (zero? (bitwise-and word-index
                                               (arithmetic-shift 1 shift)))
                          0
                          1)))
            (bytevector-bit-set! entropy bit-pos bit)))
        (let ((checksum (sha256-bytes entropy)))
          (do ((i 0 (+ i 1)))
              ((>= i checksum-bits))
            (let* ((bit-pos (+ ent-bits i))
                   (word-index (list-ref indexes (quotient bit-pos 11)))
                   (shift (- 10 (remainder bit-pos 11)))
                   (actual (if (zero? (bitwise-and word-index
                                                   (arithmetic-shift 1 shift)))
                               0
                               1))
                   (expected (bytevector-bit-ref checksum i)))
              (unless (= actual expected)
                (error "bip39-mnemonic->entropy: checksum mismatch")))))
        entropy))

    ;;; Derive a 64-byte BIP39 seed from a mnemonic and optional passphrase.
    (define (bip39-mnemonic->seed mnemonic . maybe-passphrase)
      (: string? string? ... -> bytevector?)
      (let ((passphrase (if (null? maybe-passphrase) "" (car maybe-passphrase))))
        (pbkdf2-sha512 mnemonic (string-append "mnemonic" passphrase) 2048 64)))

    ))
