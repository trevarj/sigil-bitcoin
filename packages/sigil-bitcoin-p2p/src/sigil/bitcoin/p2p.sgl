;;; (sigil bitcoin p2p) — Bitcoin peer-to-peer wire messages

(define-library (sigil bitcoin p2p)
  (import (sigil math)
          (sigil struct)
          (sigil socket)
          (sigil bitcoin utils)
          (sigil bitcoin primitives)
          (sigil bitcoin consensus)
          (sigil bitcoin tx)
          (sigil bitcoin tx wire))
  (export
    bitcoin-mainnet-magic
    bitcoin-testnet-magic
    bitcoin-testnet4-magic
    bitcoin-signet-magic
    bitcoin-regtest-magic
    p2p-max-payload-size
    p2p-max-headers-per-message
    p2p-max-addresses-per-message
    p2p-max-inventory-per-message
    network-address network-address?
    network-address-services network-address-ip network-address-port
    p2p-address p2p-address?
    p2p-address-time p2p-address-services p2p-address-network-id
    p2p-address-address p2p-address-port
    addrv2-network-ipv4 addrv2-network-ipv6 addrv2-network-torv3
    addrv2-network-i2p addrv2-network-cjdns addrv2-network-yggdrasil
    version-message version-message?
    version-message-version version-message-services version-message-timestamp
    version-message-addr-recv version-message-addr-from version-message-nonce
    version-message-user-agent version-message-start-height version-message-relay?
    getheaders-message getheaders-message?
    getheaders-message-version getheaders-message-locator-hashes
    getheaders-message-stop-hash
    inventory-vector inventory-vector?
    inventory-vector-type inventory-vector-hash
    inv-error inv-tx inv-block inv-filtered-block inv-witness-tx inv-witness-block
    peer-state peer-state?
    peer-state-version-sent? peer-state-version-received?
    peer-state-verack-sent? peer-state-verack-received?
    peer-state-headers peer-state-known-inventory
    peer-state-last-ping peer-state-last-pong
    p2p-session p2p-session?
    p2p-session-magic p2p-session-protocol-version p2p-session-services
    p2p-session-addr-recv p2p-session-addr-from p2p-session-nonce
    p2p-session-user-agent p2p-session-start-height p2p-session-relay?
    p2p-session-state p2p-session-outbound
    p2p-peer p2p-peer?
    p2p-peer-id p2p-peer-session p2p-peer-score
    p2p-peer-failures p2p-peer-banned?
    p2p-relay-request p2p-relay-request?
    p2p-relay-request-peer-id p2p-relay-request-items
    p2p-relay-request-payload
    p2p-envelope p2p-envelope?
    p2p-envelope-magic p2p-envelope-command p2p-envelope-payload
    p2p-checksum
    p2p-envelope-serialize
    p2p-envelope-parse
    p2p-message
    version-message-serialize
    version-message-parse
    verack-message
    ping-message
    pong-message
    getaddr-message
    addr-message
    addr-message-parse
    addrv2-message
    addrv2-message-parse
    getheaders-message-serialize
    getheaders-message-parse
    headers-message-serialize
    headers-message-parse
    inventory-message-serialize
    inventory-message-parse
    inv-message
    getdata-message
    notfound-message
    tx-message
    tx-message-parse
    block-message
    block-message-parse
    peer-state-create
    peer-state-mark-version-sent
    peer-state-mark-verack-sent
    peer-state-handshake-complete?
    peer-state-apply-envelope
    peer-state-next-getheaders
    p2p-read-envelope
    p2p-write-envelope
    p2p-socket-connect
    p2p-socket-connect-timeout
    p2p-socket-read-envelope
    p2p-socket-read-envelope-timeout
    p2p-socket-write-envelope
    p2p-session-create
    p2p-session-start
    p2p-session-apply-envelope
    p2p-session-drain-outbound
    p2p-session-flush
    p2p-session-step
    p2p-session-handshake
    p2p-session-sync-headers
    p2p-session-next-getheaders
    p2p-session-request-addresses
    p2p-session-request-inventory
    p2p-peer-create
    p2p-peer-select
    p2p-peer-select-many
    p2p-relay-schedule)
  (begin

    (define bitcoin-mainnet-magic #u8(#xf9 #xbe #xb4 #xd9))
    (define bitcoin-testnet-magic #u8(#x0b #x11 #x09 #x07))
    (define bitcoin-testnet4-magic #u8(#x1c #x16 #x3f #x28))
    (define bitcoin-signet-magic #u8(#x0a #x03 #xcf #x40))
    (define bitcoin-regtest-magic #u8(#xfa #xbf #xb5 #xda))
    (define p2p-max-payload-size (* 32 1024 1024))
    (define p2p-max-headers-per-message 2000)
    (define p2p-max-addresses-per-message 1000)
    (define p2p-max-inventory-per-message 50000)
    (define addrv2-network-ipv4 #x01)
    (define addrv2-network-ipv6 #x02)
    (define addrv2-network-torv3 #x04)
    (define addrv2-network-i2p #x05)
    (define addrv2-network-cjdns #x06)
    (define addrv2-network-yggdrasil #x07)

    (define-struct network-address
      (services integer?)
      (ip bytevector?)
      (port integer?))

    (define-struct p2p-address
      (time integer?)
      (services integer?)
      (network-id integer?)
      (address bytevector?)
      (port integer?))

    (define-struct version-message
      (version integer?)
      (services integer?)
      (timestamp integer?)
      (addr-recv network-address?)
      (addr-from network-address?)
      (nonce integer?)
      (user-agent string?)
      (start-height integer?)
      (relay? boolean?))

    (define-struct getheaders-message
      (version integer?)
      (locator-hashes list?)
      (stop-hash bytevector?))

    (define-struct inventory-vector
      (type integer?)
      (hash bytevector?))

    (define-struct peer-state
      (version-sent? boolean?)
      (version-received? boolean?)
      (verack-sent? boolean?)
      (verack-received? boolean?)
      (headers list?)
      (known-inventory list?)
      (last-ping any?)
      (last-pong any?))

    (define-struct p2p-session
      (magic bytevector?)
      (protocol-version integer?)
      (services integer?)
      (addr-recv network-address?)
      (addr-from network-address?)
      (nonce integer?)
      (user-agent string?)
      (start-height integer?)
      (relay? boolean?)
      (state peer-state?)
      (outbound list?))

    (define-struct p2p-peer
      (id any?)
      (session p2p-session?)
      (score integer?)
      (failures integer?)
      (banned? boolean?))

    (define-struct p2p-relay-request
      (peer-id any?)
      (items list?)
      (payload bytevector?))

    (define-struct p2p-envelope
      (magic bytevector?)
      (command string?)
      (payload bytevector?))

    (define %u8-max #xff)

    (define inv-error 0)
    (define inv-tx 1)
    (define inv-block 2)
    (define inv-filtered-block 3)
    (define inv-witness-tx #x40000001)
    (define inv-witness-block #x40000002)

    (define (require-network-address who addr)
      (unless (network-address? addr)
        (error (string-append who ": expected network-address")))
      (require-uint (string-append who " services")
                    (network-address-services addr)
                    %u64-max)
      (require-bytevector-length (string-append who " ip")
                                 (network-address-ip addr)
                                 16)
      (require-uint (string-append who " port")
                    (network-address-port addr)
                    #xffff)
      addr)

    (define (addrv2-address-length network-id)
      (cond ((= network-id addrv2-network-ipv4) 4)
            ((= network-id addrv2-network-ipv6) 16)
            ((= network-id addrv2-network-torv3) 32)
            ((= network-id addrv2-network-i2p) 32)
            ((= network-id addrv2-network-cjdns) 16)
            ((= network-id addrv2-network-yggdrasil) 16)
            (else #f)))

    (define (require-p2p-address item)
      (unless (p2p-address? item)
        (error "p2p-address: expected p2p-address"))
      (require-uint "p2p-address time" (p2p-address-time item) %u32-max)
      (require-uint "p2p-address services" (p2p-address-services item) %u64-max)
      (require-uint "p2p-address network-id" (p2p-address-network-id item) %u8-max)
      (require-bytevector "p2p-address address" (p2p-address-address item))
      (require-uint "p2p-address port" (p2p-address-port item) #xffff)
      (let ((expected (addrv2-address-length (p2p-address-network-id item))))
        (when (and expected
                   (not (= expected
                           (bytevector-length (p2p-address-address item)))))
          (error "p2p-address: invalid address length")))
      item)

    (define (require-p2p-address-list items)
      (unless (list? items)
        (error "address message: expected list"))
      (when (> (length items) p2p-max-addresses-per-message)
        (error "address message: too many addresses"))
      (do ((xs items (cdr xs)))
          ((null? xs) items)
        (require-p2p-address (car xs))))

    (define (require-command command)
      (unless (string? command)
        (error "p2p command: expected string"))
      (when (> (string-length command) 12)
        (error "p2p command: command too long"))
      command)

    (define (require-hash-list who hashes)
      (unless (list? hashes)
        (error (string-append who ": expected list")))
      (do ((xs hashes (cdr xs)))
          ((null? xs) hashes)
        (require-bytevector-length who (car xs) 32)))

    (define (require-inventory-vector item)
      (unless (inventory-vector? item)
        (error "inventory-vector: expected inventory-vector"))
      (require-uint "inventory-vector type" (inventory-vector-type item) %u32-max)
      (require-bytevector-length "inventory-vector hash" (inventory-vector-hash item) 32)
      item)

    (define (require-inventory-list items)
      (unless (list? items)
        (error "inventory message: expected list"))
      (when (> (length items) p2p-max-inventory-per-message)
        (error "inventory message: too many inventory vectors"))
      (do ((xs items (cdr xs)))
          ((null? xs) items)
        (require-inventory-vector (car xs))))

    (define (string->ascii-bytes text)
      (let* ((len (string-length text))
             (out (make-bytevector len 0)))
        (do ((i 0 (+ i 1)))
            ((>= i len) out)
          (let ((ch (char->integer (string-ref text i))))
            (when (> ch #x7f)
              (error "string->ascii-bytes: expected ASCII string"))
            (bytevector-u8-set! out i ch)))))

    (define (ascii-bytes->string bytes)
      (let* ((len (bytevector-length bytes))
             (out (make-string len)))
        (do ((i 0 (+ i 1)))
            ((>= i len) out)
          (string-set! out i (integer->char (bytevector-u8-ref bytes i))))))

    (define (u16-be n)
      (require-uint "u16-be" n #xffff)
      (let ((out (make-bytevector 2 0)))
        (bytevector-u8-set! out 0 (bitwise-and (arithmetic-shift n -8) #xff))
        (bytevector-u8-set! out 1 (bitwise-and n #xff))
        out))

    (define (read-u16-be bytes offset who)
      (ensure-available who bytes offset 2)
      (+ (arithmetic-shift (bytevector-u8-ref bytes offset) 8)
         (bytevector-u8-ref bytes (+ offset 1))))

    (define (command->field command)
      (let ((raw (string->ascii-bytes (require-command command)))
            (out (make-bytevector 12 0)))
        (bytevector-copy! out 0 raw)
        out))

    (define (field->command bytes)
      (let loop ((i 0))
        (if (or (>= i 12) (= 0 (bytevector-u8-ref bytes i)))
            (ascii-bytes->string (bytevector-copy bytes 0 i))
            (loop (+ i 1)))))

    (define (p2p-checksum payload)
      (require-bytevector "p2p-checksum" payload)
      (bytevector-copy (hash256 payload) 0 4))

    (define (p2p-envelope-serialize envelope)
      (: p2p-envelope? -> bytevector?)
      (unless (p2p-envelope? envelope)
        (error "p2p-envelope-serialize: expected p2p-envelope"))
      (require-bytevector-length "p2p magic" (p2p-envelope-magic envelope) 4)
      (require-command (p2p-envelope-command envelope))
      (require-bytevector "p2p payload" (p2p-envelope-payload envelope))
      (bytevector-append
        (p2p-envelope-magic envelope)
        (command->field (p2p-envelope-command envelope))
        (u32-le (bytevector-length (p2p-envelope-payload envelope)))
        (p2p-checksum (p2p-envelope-payload envelope))
        (p2p-envelope-payload envelope)))

    (define (p2p-envelope-parse bytes)
      (: bytevector? -> p2p-envelope?)
      (require-bytevector "p2p-envelope-parse" bytes)
      (ensure-available "p2p-envelope-parse" bytes 0 24)
      (let* ((magic (bytevector-copy bytes 0 4))
             (command (field->command (bytevector-copy bytes 4 16)))
             (payload-len (read-u32-le bytes 16 "p2p payload length"))
             (checksum (bytevector-copy bytes 20 24))
             (end (+ 24 payload-len)))
        (ensure-available "p2p-envelope-parse" bytes 24 payload-len)
        (when (> payload-len p2p-max-payload-size)
          (error "p2p-envelope-parse: payload too large"))
        (unless (= end (bytevector-length bytes))
          (error "p2p-envelope-parse: trailing bytes"))
        (let ((payload (bytevector-copy bytes 24 end)))
          (unless (equal? checksum (p2p-checksum payload))
            (error "p2p-envelope-parse: invalid checksum"))
          (p2p-envelope magic: magic command: command payload: payload))))

    (define (p2p-read-exact read-bytes count)
      (let ((out (make-bytevector count 0)))
        (let loop ((cursor 0))
          (if (>= cursor count)
              out
              (let ((chunk (read-bytes (- count cursor))))
                (when (or (not chunk) (eof-object? chunk))
                  (error "p2p-read-envelope: unexpected end of stream"))
                (require-bytevector "p2p-read-envelope chunk" chunk)
                (let ((len (bytevector-length chunk)))
                  (when (= len 0)
                    (error "p2p-read-envelope: empty read"))
                  (when (> len (- count cursor))
                    (error "p2p-read-envelope: reader returned too many bytes"))
                  (bytevector-copy! out cursor chunk)
                  (loop (+ cursor len))))))))

    (define (p2p-read-envelope read-bytes)
      (: procedure? -> p2p-envelope?)
      (let* ((header (p2p-read-exact read-bytes 24))
             (payload-len (read-u32-le header 16 "p2p payload length")))
        (when (> payload-len p2p-max-payload-size)
          (error "p2p-read-envelope: payload too large"))
        (p2p-envelope-parse
          (bytevector-append header (p2p-read-exact read-bytes payload-len)))))

    (define (p2p-write-envelope write-bytes envelope)
      (: procedure? p2p-envelope? -> integer?)
      (let ((wire (p2p-envelope-serialize envelope)))
        (let loop ((cursor 0) (written 0))
          (if (>= cursor (bytevector-length wire))
              written
              (let* ((chunk (bytevector-copy wire cursor (bytevector-length wire)))
                     (result (write-bytes chunk)))
                (unless result
                  (error "p2p-write-envelope: write failed"))
                (let ((n (if (integer? result)
                             result
                             (bytevector-length chunk))))
                  (when (<= n 0)
                    (error "p2p-write-envelope: short write"))
                  (when (> n (bytevector-length chunk))
                    (error "p2p-write-envelope: writer returned too many bytes"))
                  (loop (+ cursor n) (+ written n))))))))

    (define (p2p-socket-connect host port)
      (: string? integer? -> any?)
      (let ((sock (tcp-connect host port)))
        (unless sock
          (error "p2p-socket-connect: connection failed"))
        sock))

    ;;; Connect to a numeric peer address with a bounded timeout.
    ;;;
    ;;; DNS resolution is intentionally left to callers so they can apply their
    ;;; own seed/manual-peer policy before the TCP dial.
    ;;;
    ;;; ```scheme
    ;;; (p2p-socket-connect-timeout "127.0.0.1" 18444 1000)
    ;;; ```
    (define (p2p-socket-connect-timeout host port timeout-ms)
      (: string? integer? integer? -> any?)
      (let* ((result (%tcp-connect-ip-timeout-status host port timeout-ms))
             (status (car result))
             (sock (cdr result)))
        (unless sock
          (error (string-append "p2p-socket-connect-timeout: " status)))
        sock))

    (define (p2p-socket-read-envelope sock)
      (: any? -> p2p-envelope?)
      (p2p-read-envelope
        (lambda (count)
          (socket-read-bytevector sock count))))

    ;;; Read one P2P envelope from a socket with a per-chunk timeout.
    ;;;
    ;;; The timeout applies before each socket read so a peer cannot stall in
    ;;; the middle of an envelope indefinitely.
    ;;;
    ;;; ```scheme
    ;;; (p2p-socket-read-envelope-timeout sock 1000)
    ;;; ```
    (define (p2p-socket-read-envelope-timeout sock timeout-ms)
      (: any? integer? -> p2p-envelope?)
      (p2p-read-envelope
        (lambda (count)
          (unless (socket-ready? sock timeout-ms)
            (error "p2p-socket-read-envelope-timeout: read timed out"))
          (socket-read-bytevector sock count))))

    (define (p2p-socket-write-envelope sock envelope)
      (: any? p2p-envelope? -> integer?)
      (p2p-write-envelope
        (lambda (bytes)
          (socket-write sock bytes))
        envelope))

    (define (p2p-message magic command payload)
      (: bytevector? string? bytevector? -> bytevector?)
      (p2p-envelope-serialize
        (p2p-envelope magic: magic command: command payload: payload)))

    (define (network-address-serialize addr)
      (require-network-address "network-address" addr)
      (bytevector-append
        (u64-le (network-address-services addr))
        (network-address-ip addr)
        (u16-be (network-address-port addr))))

    (define (network-address-parse bytes offset)
      (let ((services (read-u64-le bytes offset "network-address services"))
            (ip (bytevector-copy bytes (+ offset 8) (+ offset 24)))
            (port (read-u16-be bytes (+ offset 24) "network-address port")))
        (list (network-address services: services ip: ip port: port)
              (+ offset 26))))

    (define (ipv4-mapped-address? ip)
      (and (= 16 (bytevector-length ip))
           (= 0 (bytevector-u8-ref ip 0))
           (= 0 (bytevector-u8-ref ip 1))
           (= 0 (bytevector-u8-ref ip 2))
           (= 0 (bytevector-u8-ref ip 3))
           (= 0 (bytevector-u8-ref ip 4))
           (= 0 (bytevector-u8-ref ip 5))
           (= 0 (bytevector-u8-ref ip 6))
           (= 0 (bytevector-u8-ref ip 7))
           (= 0 (bytevector-u8-ref ip 8))
           (= 0 (bytevector-u8-ref ip 9))
           (= #xff (bytevector-u8-ref ip 10))
           (= #xff (bytevector-u8-ref ip 11))))

    (define (legacy-ip->p2p-address time services ip port)
      (if (ipv4-mapped-address? ip)
          (p2p-address time: time
                       services: services
                       network-id: addrv2-network-ipv4
                       address: (bytevector-copy ip 12 16)
                       port: port)
          (p2p-address time: time
                       services: services
                       network-id: addrv2-network-ipv6
                       address: ip
                       port: port)))

    (define (p2p-address->legacy-ip item)
      (let ((network-id (p2p-address-network-id item))
            (address (p2p-address-address item)))
        (cond ((= network-id addrv2-network-ipv4)
               (bytevector-append
                 #u8(#x00 #x00 #x00 #x00 #x00 #x00 #x00 #x00
                     #x00 #x00 #xff #xff)
                 address))
              ((= network-id addrv2-network-ipv6)
               address)
              (else
               (error "addr-message: legacy addr supports only IPv4 and IPv6")))))

    (define (addr-entry-serialize item)
      (require-p2p-address item)
      (bytevector-append
        (u32-le (p2p-address-time item))
        (u64-le (p2p-address-services item))
        (p2p-address->legacy-ip item)
        (u16-be (p2p-address-port item))))

    (define (addr-entry-parse bytes offset)
      (ensure-available "addr entry" bytes offset 30)
      (let ((time (read-u32-le bytes offset "addr time"))
            (services (read-u64-le bytes (+ offset 4) "addr services"))
            (ip (bytevector-copy bytes (+ offset 12) (+ offset 28)))
            (port (read-u16-be bytes (+ offset 28) "addr port")))
        (list (legacy-ip->p2p-address time services ip port)
              (+ offset 30))))

    ;;; Serialize a legacy `addr` message.
    ;;;
    ;;; ```scheme
    ;;; (addr-message (list (p2p-address time: 1 services: 1 network-id: 1 address: #u8(127 0 0 1) port: 8333)))
    ;;; ```
    (define (addr-message items)
      (: list? -> bytevector?)
      (require-p2p-address-list items)
      (let ((payloads (map addr-entry-serialize items)))
        (if (null? payloads)
            (compact-size-encode 0)
            (bytevector-append
              (compact-size-encode (length items))
              (apply bytevector-append payloads)))))

    ;;; Parse a legacy `addr` message.
    ;;;
    ;;; ```scheme
    ;;; (addr-message-parse (addr-message '()))
    ;;; ```
    (define (addr-message-parse bytes)
      (: bytevector? -> list?)
      (require-bytevector "addr-message-parse" bytes)
      (let* ((count-result (compact-size-decode-at bytes 0))
             (count (car count-result)))
        (when (> count p2p-max-addresses-per-message)
          (error "addr-message-parse: too many addresses"))
        (let loop ((i 0) (cursor (cadr count-result)) (items '()))
          (if (>= i count)
              (begin
                (unless (= cursor (bytevector-length bytes))
                  (error "addr-message-parse: trailing bytes"))
                (reverse items))
              (let ((parsed (addr-entry-parse bytes cursor)))
                (loop (+ i 1)
                      (cadr parsed)
                      (cons (car parsed) items)))))))

    (define (addrv2-entry-serialize item)
      (require-p2p-address item)
      (bytevector-append
        (u32-le (p2p-address-time item))
        (compact-size-encode (p2p-address-services item))
        (make-bytevector 1 (p2p-address-network-id item))
        (compact-size-encode (bytevector-length (p2p-address-address item)))
        (p2p-address-address item)
        (u16-be (p2p-address-port item))))

    (define (addrv2-entry-parse bytes offset)
      (ensure-available "addrv2 entry" bytes offset 4)
      (let* ((time (read-u32-le bytes offset "addrv2 time"))
             (services-result (compact-size-decode-at bytes (+ offset 4)))
             (services (car services-result))
             (network-offset (cadr services-result)))
        (ensure-available "addrv2 network id" bytes network-offset 1)
        (let* ((network-id (read-byte bytes network-offset "addrv2 network id"))
               (length-result (compact-size-decode-at bytes (+ network-offset 1)))
               (address-len (car length-result))
               (address-offset (cadr length-result))
               (port-offset (+ address-offset address-len))
               (expected (addrv2-address-length network-id)))
          (when (> address-len 512)
            (error "addrv2-message-parse: address too long"))
          (when (and expected (not (= expected address-len)))
            (error "addrv2-message-parse: invalid address length"))
          (ensure-available "addrv2 address" bytes address-offset address-len)
          (ensure-available "addrv2 port" bytes port-offset 2)
          (list (p2p-address
                  time: time
                  services: services
                  network-id: network-id
                  address: (bytevector-copy bytes address-offset port-offset)
                  port: (read-u16-be bytes port-offset "addrv2 port"))
                (+ port-offset 2)))))

    ;;; Serialize a BIP155 `addrv2` message.
    ;;;
    ;;; ```scheme
    ;;; (addrv2-message (list (p2p-address time: 1 services: 1 network-id: 1 address: #u8(127 0 0 1) port: 8333)))
    ;;; ```
    (define (addrv2-message items)
      (: list? -> bytevector?)
      (require-p2p-address-list items)
      (let ((payloads (map addrv2-entry-serialize items)))
        (if (null? payloads)
            (compact-size-encode 0)
            (bytevector-append
              (compact-size-encode (length items))
              (apply bytevector-append payloads)))))

    ;;; Parse a BIP155 `addrv2` message.
    ;;;
    ;;; ```scheme
    ;;; (addrv2-message-parse (addrv2-message '()))
    ;;; ```
    (define (addrv2-message-parse bytes)
      (: bytevector? -> list?)
      (require-bytevector "addrv2-message-parse" bytes)
      (let* ((count-result (compact-size-decode-at bytes 0))
             (count (car count-result)))
        (when (> count p2p-max-addresses-per-message)
          (error "addrv2-message-parse: too many addresses"))
        (let loop ((i 0) (cursor (cadr count-result)) (items '()))
          (if (>= i count)
              (begin
                (unless (= cursor (bytevector-length bytes))
                  (error "addrv2-message-parse: trailing bytes"))
                (reverse items))
              (let ((parsed (addrv2-entry-parse bytes cursor)))
                (loop (+ i 1)
                      (cadr parsed)
                      (cons (car parsed) items)))))))

    (define (varstr-serialize text)
      (let ((raw (string->ascii-bytes text)))
        (bytevector-append (compact-size-encode (bytevector-length raw)) raw)))

    (define (varstr-parse bytes offset)
      (let* ((len-result (compact-size-decode-at bytes offset))
             (len (car len-result))
             (start (cadr len-result))
             (end (+ start len)))
        (ensure-available "varstr" bytes start len)
        (list (ascii-bytes->string (bytevector-copy bytes start end)) end)))

    (define (version-message-serialize msg)
      (: version-message? -> bytevector?)
      (unless (version-message? msg)
        (error "version-message-serialize: expected version-message"))
      (require-network-address "version addr_recv" (version-message-addr-recv msg))
      (require-network-address "version addr_from" (version-message-addr-from msg))
      (bytevector-append
        (u32-le (require-uint "version version" (version-message-version msg) %u32-max))
        (u64-le (require-uint "version services" (version-message-services msg) %u64-max))
        (u64-le (require-uint "version timestamp" (version-message-timestamp msg) %u64-max))
        (network-address-serialize (version-message-addr-recv msg))
        (network-address-serialize (version-message-addr-from msg))
        (u64-le (require-uint "version nonce" (version-message-nonce msg) %u64-max))
        (varstr-serialize (version-message-user-agent msg))
        (u32-le (require-uint "version start-height" (version-message-start-height msg) %u32-max))
        (make-bytevector 1 (if (version-message-relay? msg) 1 0))))

    (define (version-message-parse bytes)
      (: bytevector? -> version-message?)
      (require-bytevector "version-message-parse" bytes)
      (ensure-available "version-message-parse" bytes 0 85)
      (let* ((version (read-u32-le bytes 0 "version version"))
             (services (read-u64-le bytes 4 "version services"))
             (timestamp (read-u64-le bytes 12 "version timestamp"))
             (addr-recv-result (network-address-parse bytes 20))
             (addr-from-result (network-address-parse bytes (cadr addr-recv-result)))
             (nonce-offset (cadr addr-from-result))
             (nonce (read-u64-le bytes nonce-offset "version nonce"))
             (agent-result (varstr-parse bytes (+ nonce-offset 8)))
             (height-offset (cadr agent-result))
             (start-height (read-u32-le bytes height-offset "version start-height"))
             (relay-offset (+ height-offset 4))
             (relay? (if (< relay-offset (bytevector-length bytes))
                         (not (= 0 (read-byte bytes relay-offset "version relay")))
                         #t))
             (end (if (< relay-offset (bytevector-length bytes))
                      (+ relay-offset 1)
                      relay-offset)))
        (unless (= end (bytevector-length bytes))
          (error "version-message-parse: trailing bytes"))
        (version-message version: version
                         services: services
                         timestamp: timestamp
                         addr-recv: (car addr-recv-result)
                         addr-from: (car addr-from-result)
                         nonce: nonce
                         user-agent: (car agent-result)
                         start-height: start-height
                         relay?: relay?)))

    (define (verack-message)
      #u8())

    (define (nonce-message who nonce)
      (u64-le (require-uint who nonce %u64-max)))

    (define (ping-message nonce)
      (nonce-message "ping nonce" nonce))

    (define (pong-message nonce)
      (nonce-message "pong nonce" nonce))

    ;;; Return the empty payload for a `getaddr` peer-discovery request.
    ;;;
    ;;; ```scheme
    ;;; (getaddr-message)
    ;;; ```
    (define (getaddr-message)
      (: -> bytevector?)
      #u8())

    (define (getheaders-message-serialize msg)
      (: getheaders-message? -> bytevector?)
      (unless (getheaders-message? msg)
        (error "getheaders-message-serialize: expected getheaders-message"))
      (require-hash-list "getheaders locator hash"
                         (getheaders-message-locator-hashes msg))
      (require-bytevector-length "getheaders stop hash"
                                 (getheaders-message-stop-hash msg)
                                 32)
      (bytevector-append
        (u32-le (require-uint "getheaders version"
                              (getheaders-message-version msg)
                              %u32-max))
        (serialize-vector (getheaders-message-locator-hashes msg)
                          (lambda (hash) hash))
        (getheaders-message-stop-hash msg)))

    (define (parse-hash-vector bytes offset)
      (let* ((count-result (compact-size-decode-at bytes offset))
             (count (car count-result)))
        (let loop ((i 0) (cursor (cadr count-result)) (hashes '()))
          (if (>= i count)
              (list (reverse hashes) cursor)
              (begin
                (ensure-available "hash vector" bytes cursor 32)
                (loop (+ i 1)
                      (+ cursor 32)
                      (cons (bytevector-copy bytes cursor (+ cursor 32))
                            hashes)))))))

    (define (getheaders-message-parse bytes)
      (: bytevector? -> getheaders-message?)
      (require-bytevector "getheaders-message-parse" bytes)
      (let* ((version (read-u32-le bytes 0 "getheaders version"))
             (hashes-result (parse-hash-vector bytes 4))
             (stop-offset (cadr hashes-result)))
        (ensure-available "getheaders stop hash" bytes stop-offset 32)
        (let ((end (+ stop-offset 32)))
          (unless (= end (bytevector-length bytes))
            (error "getheaders-message-parse: trailing bytes"))
          (getheaders-message
            version: version
            locator-hashes: (car hashes-result)
            stop-hash: (bytevector-copy bytes stop-offset end)))))

    (define (headers-message-serialize headers)
      (: list? -> bytevector?)
      (when (> (length headers) p2p-max-headers-per-message)
        (error "headers-message-serialize: too many headers"))
      (let ((payloads (map (lambda (header)
                             (bytevector-append
                               (block-header-serialize header)
                               #u8(0)))
                           headers)))
        (if (null? payloads)
            (compact-size-encode 0)
            (bytevector-append
              (compact-size-encode (length headers))
              (apply bytevector-append payloads)))))

    (define (parse-headers bytes offset count)
      (let loop ((i 0) (cursor offset) (headers '()))
        (if (>= i count)
            (list (reverse headers) cursor)
            (begin
              (ensure-available "headers message" bytes cursor 81)
              (let ((header (block-header-parse
                              (bytevector-copy bytes cursor (+ cursor 80))))
                    (tx-count (read-byte bytes (+ cursor 80) "headers tx count")))
                (unless (= tx-count 0)
                  (error "headers-message-parse: header tx count must be zero"))
                (loop (+ i 1) (+ cursor 81) (cons header headers)))))))

    (define (headers-message-parse bytes)
      (: bytevector? -> list?)
      (require-bytevector "headers-message-parse" bytes)
      (let* ((count-result (compact-size-decode-at bytes 0))
             (count (car count-result)))
        (when (> count p2p-max-headers-per-message)
          (error "headers-message-parse: too many headers"))
        (let ((parsed (parse-headers bytes (cadr count-result) count)))
          (unless (= (cadr parsed) (bytevector-length bytes))
            (error "headers-message-parse: trailing bytes"))
          (car parsed))))

    (define (inventory-vector-serialize item)
      (require-inventory-vector item)
      (bytevector-append
        (u32-le (inventory-vector-type item))
        (inventory-vector-hash item)))

    (define (inventory-vector-parse bytes offset)
      (ensure-available "inventory-vector" bytes offset 36)
      (list
        (inventory-vector type: (read-u32-le bytes offset "inventory-vector type")
                          hash: (bytevector-copy bytes (+ offset 4) (+ offset 36)))
        (+ offset 36)))

    (define (inventory-message-serialize items)
      (: list? -> bytevector?)
      (require-inventory-list items)
      (let ((payloads (map inventory-vector-serialize items)))
        (if (null? payloads)
            (compact-size-encode 0)
            (bytevector-append
              (compact-size-encode (length items))
              (apply bytevector-append payloads)))))

    (define (inventory-message-parse bytes)
      (: bytevector? -> list?)
      (require-bytevector "inventory-message-parse" bytes)
      (let* ((count-result (compact-size-decode-at bytes 0))
             (count (car count-result)))
        (when (> count p2p-max-inventory-per-message)
          (error "inventory-message-parse: too many inventory vectors"))
        (let loop ((i 0) (cursor (cadr count-result)) (items '()))
          (if (>= i count)
              (begin
                (unless (= cursor (bytevector-length bytes))
                  (error "inventory-message-parse: trailing bytes"))
                (reverse items))
              (let ((parsed (inventory-vector-parse bytes cursor)))
                (loop (+ i 1)
                      (cadr parsed)
                      (cons (car parsed) items)))))))

    (define (inv-message items)
      (inventory-message-serialize items))

    (define (getdata-message items)
      (inventory-message-serialize items))

    (define (notfound-message items)
      (inventory-message-serialize items))

    (define (tx-message tx)
      (: transaction? -> bytevector?)
      (transaction-serialize tx))

    (define (tx-message-parse bytes)
      (: bytevector? -> transaction?)
      (transaction-parse bytes))

    (define (block-message b)
      (: block? -> bytevector?)
      (block-serialize b))

    (define (block-message-parse bytes)
      (: bytevector? -> block?)
      (block-parse bytes))

    (define (peer-state-create)
      (peer-state version-sent?: #f
                  version-received?: #f
                  verack-sent?: #f
                  verack-received?: #f
                  headers: '()
                  known-inventory: '()
                  last-ping: #f
                  last-pong: #f))

    (define (peer-state-copy state version-sent? version-received?
                             verack-sent? verack-received? headers
                             known-inventory last-ping last-pong)
      (peer-state version-sent?: version-sent?
                  version-received?: version-received?
                  verack-sent?: verack-sent?
                  verack-received?: verack-received?
                  headers: headers
                  known-inventory: known-inventory
                  last-ping: last-ping
                  last-pong: last-pong))

    (define (peer-state-handshake-complete? state)
      (: peer-state? -> boolean?)
      (and (peer-state-version-sent? state)
           (peer-state-version-received? state)
           (peer-state-verack-sent? state)
           (peer-state-verack-received? state)))

    (define (peer-state-mark-version-sent state)
      (: peer-state? -> peer-state?)
      (peer-state-copy state
                       #t
                       (peer-state-version-received? state)
                       (peer-state-verack-sent? state)
                       (peer-state-verack-received? state)
                       (peer-state-headers state)
                       (peer-state-known-inventory state)
                       (peer-state-last-ping state)
                       (peer-state-last-pong state)))

    (define (peer-state-mark-verack-sent state)
      (: peer-state? -> peer-state?)
      (peer-state-copy state
                       (peer-state-version-sent? state)
                       (peer-state-version-received? state)
                       #t
                       (peer-state-verack-received? state)
                       (peer-state-headers state)
                       (peer-state-known-inventory state)
                       (peer-state-last-ping state)
                       (peer-state-last-pong state)))

    (define (nonce-payload->integer bytes who)
      (unless (= 8 (bytevector-length bytes))
        (error (string-append who ": expected 8-byte nonce")))
      (read-u64-le bytes 0 who))

    (define (append-known-inventory known new-items)
      (append known new-items))

    (define (peer-state-apply-envelope state envelope)
      (: peer-state? p2p-envelope? -> peer-state?)
      (unless (peer-state? state)
        (error "peer-state-apply-envelope: expected peer-state"))
      (let ((command (p2p-envelope-command envelope))
            (payload (p2p-envelope-payload envelope)))
        (cond
          ((string=? command "version")
           (version-message-parse payload)
           (peer-state-copy state
                            (peer-state-version-sent? state)
                            #t
                            (peer-state-verack-sent? state)
                            (peer-state-verack-received? state)
                            (peer-state-headers state)
                            (peer-state-known-inventory state)
                            (peer-state-last-ping state)
                            (peer-state-last-pong state)))
          ((string=? command "verack")
           (unless (= 0 (bytevector-length payload))
             (error "verack: expected empty payload"))
           (peer-state-copy state
                            (peer-state-version-sent? state)
                            (peer-state-version-received? state)
                            (peer-state-verack-sent? state)
                            #t
                            (peer-state-headers state)
                            (peer-state-known-inventory state)
                            (peer-state-last-ping state)
                            (peer-state-last-pong state)))
          ((string=? command "headers")
           (peer-state-copy state
                            (peer-state-version-sent? state)
                            (peer-state-version-received? state)
                            (peer-state-verack-sent? state)
                            (peer-state-verack-received? state)
                            (append (peer-state-headers state)
                                    (headers-message-parse payload))
                            (peer-state-known-inventory state)
                            (peer-state-last-ping state)
                            (peer-state-last-pong state)))
          ((string=? command "inv")
           (peer-state-copy state
                            (peer-state-version-sent? state)
                            (peer-state-version-received? state)
                            (peer-state-verack-sent? state)
                            (peer-state-verack-received? state)
                            (peer-state-headers state)
                            (append-known-inventory
                              (peer-state-known-inventory state)
                              (inventory-message-parse payload))
                            (peer-state-last-ping state)
                            (peer-state-last-pong state)))
          ((string=? command "ping")
           (peer-state-copy state
                            (peer-state-version-sent? state)
                            (peer-state-version-received? state)
                            (peer-state-verack-sent? state)
                            (peer-state-verack-received? state)
                            (peer-state-headers state)
                            (peer-state-known-inventory state)
                            (nonce-payload->integer payload "ping")
                            (peer-state-last-pong state)))
          ((string=? command "pong")
           (peer-state-copy state
                            (peer-state-version-sent? state)
                            (peer-state-version-received? state)
                            (peer-state-verack-sent? state)
                            (peer-state-verack-received? state)
                            (peer-state-headers state)
                            (peer-state-known-inventory state)
                            (peer-state-last-ping state)
                            (nonce-payload->integer payload "pong")))
          (else state))))

    (define (peer-state-next-getheaders state version stop-hash)
      (: peer-state? integer? bytevector? -> bytevector?)
      (unless (peer-state-handshake-complete? state)
        (error "peer-state-next-getheaders: handshake incomplete"))
      (getheaders-message-serialize
        (getheaders-message
          version: version
          locator-hashes: (if (null? (peer-state-headers state))
                              '()
                              (list (block-header-hash
                                      (car (reverse (peer-state-headers state))))))
          stop-hash: stop-hash)))

    (define (p2p-session-create magic protocol-version services addr-recv
                                addr-from nonce user-agent start-height relay?)
      (: bytevector? integer? integer? network-address? network-address?
         integer? string? integer? boolean? -> p2p-session?)
      (require-bytevector-length "p2p-session magic" magic 4)
      (require-uint "p2p-session protocol-version" protocol-version %u32-max)
      (require-uint "p2p-session services" services %u64-max)
      (require-network-address "p2p-session addr-recv" addr-recv)
      (require-network-address "p2p-session addr-from" addr-from)
      (require-uint "p2p-session nonce" nonce %u64-max)
      (require-uint "p2p-session start-height" start-height %u32-max)
      (p2p-session magic: magic
                   protocol-version: protocol-version
                   services: services
                   addr-recv: addr-recv
                   addr-from: addr-from
                   nonce: nonce
                   user-agent: user-agent
                   start-height: start-height
                   relay?: relay?
                   state: (peer-state-create)
                   outbound: '()))

    (define (p2p-session-copy session state outbound)
      (p2p-session magic: (p2p-session-magic session)
                   protocol-version: (p2p-session-protocol-version session)
                   services: (p2p-session-services session)
                   addr-recv: (p2p-session-addr-recv session)
                   addr-from: (p2p-session-addr-from session)
                   nonce: (p2p-session-nonce session)
                   user-agent: (p2p-session-user-agent session)
                   start-height: (p2p-session-start-height session)
                   relay?: (p2p-session-relay? session)
                   state: state
                   outbound: outbound))

    (define (p2p-session-queue session command payload)
      (p2p-session-copy
        session
        (p2p-session-state session)
        (append (p2p-session-outbound session)
                (list (p2p-envelope magic: (p2p-session-magic session)
                                    command: command
                                    payload: payload)))))

    (define (p2p-session-start session)
      (: p2p-session? -> p2p-session?)
      (let* ((version (version-message
                        version: (p2p-session-protocol-version session)
                        services: (p2p-session-services session)
                        timestamp: 0
                        addr-recv: (p2p-session-addr-recv session)
                        addr-from: (p2p-session-addr-from session)
                        nonce: (p2p-session-nonce session)
                        user-agent: (p2p-session-user-agent session)
                        start-height: (p2p-session-start-height session)
                        relay?: (p2p-session-relay? session)))
             (started (p2p-session-copy
                        session
                        (peer-state-mark-version-sent
                          (p2p-session-state session))
                        (p2p-session-outbound session))))
        (p2p-session-queue started "version" (version-message-serialize version))))

    (define (relay-inventory? item)
      (let ((type (inventory-vector-type item)))
        (or (= type inv-tx)
            (= type inv-block)
            (= type inv-witness-tx)
            (= type inv-witness-block))))

    (define (filter-relay-inventory items)
      (let loop ((xs items) (out '()))
        (cond
          ((null? xs) (reverse out))
          ((relay-inventory? (car xs))
           (loop (cdr xs) (cons (car xs) out)))
          (else (loop (cdr xs) out)))))

    (define (p2p-session-request-inventory session items)
      (: p2p-session? list? -> p2p-session?)
      (require-inventory-list items)
      (if (null? items)
          session
          (p2p-session-queue session "getdata" (getdata-message items))))

    ;;; Queue a `getaddr` request for peer address discovery.
    ;;;
    ;;; ```scheme
    ;;; (p2p-session-request-addresses session)
    ;;; ```
    (define (p2p-session-request-addresses session)
      (: p2p-session? -> p2p-session?)
      (p2p-session-queue session "getaddr" (getaddr-message)))

    (define (inventory-vector=? a b)
      (and (= (inventory-vector-type a) (inventory-vector-type b))
           (equal? (inventory-vector-hash a) (inventory-vector-hash b))))

    (define (inventory-member? item items)
      (cond
        ((null? items) #f)
        ((inventory-vector=? item (car items)) #t)
        (else (inventory-member? item (cdr items)))))

    (define (dedupe-inventory items)
      (let loop ((xs items) (out '()))
        (cond
          ((null? xs) (reverse out))
          ((inventory-member? (car xs) out) (loop (cdr xs) out))
          (else (loop (cdr xs) (cons (car xs) out))))))

    (define (take-up-to items count)
      (let loop ((xs items) (i 0) (out '()))
        (if (or (null? xs) (>= i count))
            (reverse out)
            (loop (cdr xs) (+ i 1) (cons (car xs) out)))))

    (define (drop-up-to items count)
      (let loop ((xs items) (i 0))
        (if (or (null? xs) (>= i count))
            xs
            (loop (cdr xs) (+ i 1)))))

    (define (p2p-session-apply-envelope session envelope)
      (: p2p-session? p2p-envelope? -> p2p-session?)
      (let* ((old-state (p2p-session-state session))
             (new-state (peer-state-apply-envelope old-state envelope))
             (updated (p2p-session-copy session
                                        new-state
                                        (p2p-session-outbound session)))
             (command (p2p-envelope-command envelope))
             (payload (p2p-envelope-payload envelope)))
        (cond
          ((and (string=? command "version")
                (not (peer-state-verack-sent? old-state)))
           (p2p-session-queue
             (p2p-session-copy updated
                               (peer-state-mark-verack-sent new-state)
                               (p2p-session-outbound updated))
             "verack"
             (verack-message)))
          ((string=? command "ping")
           (p2p-session-queue updated "pong" payload))
          ((string=? command "inv")
           (p2p-session-request-inventory
             updated
             (filter-relay-inventory (inventory-message-parse payload))))
          (else updated))))

    (define (p2p-session-drain-outbound session)
      (: p2p-session? -> list?)
      (list (p2p-session-outbound session)
            (p2p-session-copy session
                              (p2p-session-state session)
                              '())))

    (define (p2p-session-flush write-envelope session)
      (: procedure? p2p-session? -> p2p-session?)
      (do ((xs (p2p-session-outbound session) (cdr xs)))
          ((null? xs)
           (p2p-session-copy session
                             (p2p-session-state session)
                             '()))
        (write-envelope (car xs))))

    (define (p2p-session-step read-envelope session)
      (: procedure? p2p-session? -> p2p-session?)
      (p2p-session-apply-envelope session (read-envelope)))

    (define (p2p-session-handshake read-envelope write-envelope session max-steps)
      (: procedure? procedure? p2p-session? integer? -> p2p-session?)
      (let loop ((current (if (peer-state-version-sent?
                                (p2p-session-state session))
                              session
                              (p2p-session-start session)))
                 (remaining max-steps))
        (let ((flushed (p2p-session-flush write-envelope current)))
          (cond
            ((peer-state-handshake-complete? (p2p-session-state flushed))
             flushed)
            ((<= remaining 0)
             (error "p2p-session-handshake: handshake did not complete"))
            (else
             (loop (p2p-session-step read-envelope flushed)
                   (- remaining 1)))))))

    (define (p2p-session-sync-headers read-envelope write-envelope session
                                      stop-hash max-steps)
      (: procedure? procedure? p2p-session? bytevector? integer? -> p2p-session?)
      (unless (peer-state-handshake-complete? (p2p-session-state session))
        (error "p2p-session-sync-headers: handshake incomplete"))
      (let loop ((current (p2p-session-next-getheaders session stop-hash))
                 (remaining max-steps))
        (let ((flushed (p2p-session-flush write-envelope current)))
          (when (<= remaining 0)
            (error "p2p-session-sync-headers: header sync did not complete"))
          (let* ((envelope (read-envelope))
                 (next (p2p-session-apply-envelope flushed envelope)))
            (if (string=? "headers" (p2p-envelope-command envelope))
                (let ((headers (headers-message-parse
                                 (p2p-envelope-payload envelope))))
                  (if (= (length headers) p2p-max-headers-per-message)
                      (loop (p2p-session-next-getheaders next stop-hash)
                            (- remaining 1))
                      next))
                (loop next (- remaining 1)))))))

    (define (p2p-session-next-getheaders session stop-hash)
      (: p2p-session? bytevector? -> p2p-session?)
      (p2p-session-queue
        session
        "getheaders"
        (peer-state-next-getheaders
          (p2p-session-state session)
          (p2p-session-protocol-version session)
          stop-hash)))

    (define (p2p-peer-create id session score failures banned?)
      (: any? p2p-session? integer? integer? boolean? -> p2p-peer?)
      (unless (p2p-session? session)
        (error "p2p-peer-create: expected p2p-session"))
      (require-uint "p2p-peer score" score %u64-max)
      (require-uint "p2p-peer failures" failures %u32-max)
      (p2p-peer id: id
                session: session
                score: score
                failures: failures
                banned?: banned?))

    (define (p2p-peer-eligible? peer)
      (and (p2p-peer? peer)
           (not (p2p-peer-banned? peer))
           (peer-state-handshake-complete?
             (p2p-session-state (p2p-peer-session peer)))))

    (define (p2p-peer-better? left right)
      (cond
        ((not right) #t)
        ((> (p2p-peer-score left) (p2p-peer-score right)) #t)
        ((< (p2p-peer-score left) (p2p-peer-score right)) #f)
        ((< (p2p-peer-failures left) (p2p-peer-failures right)) #t)
        (else #f)))

    (define (p2p-peer-select peers)
      (: list? -> any?)
      (let loop ((xs peers) (best #f))
        (cond
          ((null? xs) best)
          ((and (p2p-peer-eligible? (car xs))
                (p2p-peer-better? (car xs) best))
           (loop (cdr xs) (car xs)))
          (else (loop (cdr xs) best)))))

    (define (remove-peer target peers)
      (let loop ((xs peers) (out '()))
        (cond
          ((null? xs) (reverse out))
          ((eq? target (car xs)) (append (reverse out) (cdr xs)))
          (else (loop (cdr xs) (cons (car xs) out))))))

    (define (p2p-peer-select-many peers count)
      (: list? integer? -> list?)
      (let loop ((remaining peers) (i 0) (out '()))
        (if (>= i count)
            (reverse out)
            (let ((best (p2p-peer-select remaining)))
              (if best
                  (loop (remove-peer best remaining)
                        (+ i 1)
                        (cons best out))
                  (reverse out))))))

    (define (round-robin-peer peers index)
      (let loop ((xs peers) (i index))
        (cond
          ((null? xs) #f)
          ((= i 0) (car xs))
          (else (loop (cdr xs) (- i 1))))))

    (define (p2p-relay-schedule peers items batch-size)
      (: list? list? integer? -> list?)
      (when (<= batch-size 0)
        (error "p2p-relay-schedule: expected positive batch-size"))
      (require-inventory-list items)
      (let ((selected (p2p-peer-select-many peers (length peers)))
            (relay-items (dedupe-inventory
                           (filter-relay-inventory items))))
        (if (null? relay-items)
            '()
            (begin
              (when (null? selected)
                (error "p2p-relay-schedule: no eligible peers"))
              (let loop ((remaining relay-items) (peer-index 0) (requests '()))
                (if (null? remaining)
                    (reverse requests)
                    (let* ((batch (take-up-to remaining batch-size))
                           (peer (round-robin-peer selected peer-index)))
                      (loop (drop-up-to remaining batch-size)
                            (if (>= (+ peer-index 1) (length selected))
                                0
                                (+ peer-index 1))
                            (cons (p2p-relay-request
                                    peer-id: (p2p-peer-id peer)
                                    items: batch
                                    payload: (getdata-message batch))
                                  requests)))))))))))
