;;; sigil-bitcoin-node — Chain-generic Bitcoin node runtime

(package
  name: "sigil-bitcoin-node"
  version: "0.1.0"
  sigil: "^0.17"
  description: "Chain-generic header-sync node runtime for sigil-bitcoin"
  url: "https://codeberg.org/sigil/sigil-bitcoin"
  license: "BSD-3-Clause"
  entry: '(sigil bitcoin node main)

  dependencies: (list
    (from-git url: "codeberg:sigil/sigil" package: "sigil-stdlib" version: "^0.17")
    (from-git url: "codeberg:sigil/sigil-crypto" version: "^0.16.1")
    (from-git url: "codeberg:sigil/sigil-sqlite" version: "^0.16.0")
    (from-path dir: "../sigil-bitcoin-utils"
               package: "sigil-bitcoin-utils")
    (from-path dir: "../sigil-bitcoin-primitives"
               package: "sigil-bitcoin-primitives")
    (from-path dir: "../sigil-bitcoin-encoding"
               package: "sigil-bitcoin-encoding")
    (from-path dir: "../sigil-secp256k1"
               package: "sigil-secp256k1")
    (from-path dir: "../sigil-bitcoin-keys"
               package: "sigil-bitcoin-keys")
    (from-path dir: "../sigil-bitcoin-script"
               package: "sigil-bitcoin-script")
    (from-path dir: "../sigil-bitcoin-tx"
               package: "sigil-bitcoin-tx")
    (from-path dir: "../sigil-bitcoin-consensus"
               package: "sigil-bitcoin-consensus")
    (from-path dir: "../sigil-bitcoin-p2p"
               package: "sigil-bitcoin-p2p"))

  dev-dependencies: (list
    (from-git url: "codeberg:sigil/sigil-ansi" version: "^0.16.0")
    (from-git url: "codeberg:sigil/sigil-json" version: "^0.16.0")
    (from-git url: "codeberg:sigil/sigil-version" version: "^0.16.0")
    (from-git url: "codeberg:sigil/sigil"
              package: "sigil-test" version: "^0.17")
    (from-git url: "codeberg:sigil/sigil"
              package: "sigil-test-runner" version: "^0.17"))

  tasks: (list
    (task
      name: 'build
      description: "Build sigil-bitcoin-node"
      steps: (list
        (compile-sigil-modules
          sources: "src/**/*.sgl")))))
