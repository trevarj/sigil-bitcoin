(import (sigil test)
        (sigil fs)
        (sigil io)
        (sigil string)
        (sigil bitcoin encoding)
        (sigil bitcoin consensus)
        (sigil bitcoin node)
        (sigil bitcoin node main)
        (sigil bitcoin p2p)
        (sigil bitcoin tx))

(define %zero32 (make-bytevector 32 0))
(define %ipv6-loopback
  #u8(#x00 #x00 #x00 #x00 #x00 #x00 #x00 #x00
      #x00 #x00 #x00 #x00 #x00 #x00 #x00 #x01))
(define %node-module (find-module '(sigil bitcoin node)))
(define %node-main-module (find-module '(sigil bitcoin node main)))
(define chain-config* (module-ref %node-module 'chain-config))
(define chain-config-name* (module-ref %node-module 'chain-config-name))
(define chain-config-by-name* (module-ref %node-module 'chain-config-by-name))
