  (test "persists announced addr and addrv2 peers"
    (let* ((dir (test-data-dir))
           (n (node-open* bitcoin-signet-chain* dir))
           (legacy (addr-message-parse
                     (addr-message
                       (list (p2p-address time: 10
                                          services: 1
                                          network-id: addrv2-network-ipv4
                                          address: #u8(93 184 216 34)
                                          port: 38333)))))
           (modern (addrv2-message-parse
                     (addrv2-message
                      (list (p2p-address time: 11
                                          services: 1
                                          network-id: addrv2-network-ipv4
                                          address: #u8(93 184 216 35)
                                          port: 38334)
                             (p2p-address time: 12
                                          services: 1
                                          network-id: addrv2-network-torv3
                                          address: (make-bytevector 32 1)
                                          port: 8333)
                             (p2p-address time: 13
                                          services: 0
                                          network-id: addrv2-network-ipv4
                                          address: #u8(93 184 216 36)
                                          port: 38335)
                             (p2p-address time: 14
                                          services: 1024
                                          network-id: addrv2-network-ipv4
                                          address: #u8(93 184 216 37)
                                          port: 38336))))))
      (assert-equal 1 (node-ingest-peer-addresses* n legacy "addr" 1000))
      (assert-equal 2 (node-ingest-peer-addresses* n modern "addrv2" 1000))
      (let ((peers (node-peers* n)))
        (assert-equal 3 (length peers))
        (let ((legacy-peer (find-peer-by-address peers "93.184.216.34"))
              (modern-peer (find-peer-by-address peers "93.184.216.35"))
              (limited-peer (find-peer-by-address peers "93.184.216.37")))
          (assert-equal "discovered" (node-peer-source* legacy-peer))
          (assert-equal "addr" (node-peer-seed-host* legacy-peer))
          (assert-equal 10 (node-peer-last-seen* legacy-peer))
          (assert-equal 38334 (node-peer-port* modern-peer))
          (assert-equal "addrv2" (node-peer-seed-host* modern-peer))
          (assert-equal 11 (node-peer-last-seen* modern-peer))
          (assert-equal 38336 (node-peer-port* limited-peer))
          (assert-equal 14 (node-peer-last-seen* limited-peer))
          (assert-false (find-peer-by-address peers "93.184.216.36"))))
      (node-close* n)))

