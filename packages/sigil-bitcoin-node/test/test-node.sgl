            '("93.184.216.7"))
          100
          1
          1))
      (node-add-peer* n "success.example" 18444)
      (let ((status (node-sync-with-peers*
                      n
                      (lambda (peer)
                        (if (string=? "93.184.216.7"
                                      (node-peer-address* peer))
                            (error "p2p-socket-connect-timeout: connection refused")
                            (empty-sync-transport chain (lambda () #t))))
                      2
                      0
                      8
                      0)))
        (assert-equal "idle" (node-status-snapshot-sync-stage* status)))
      (let ((peer (find-peer-by-address (node-peers* n) "93.184.216.7")))
        (assert-equal "discovered" (node-peer-source* peer))
        (assert-equal "seed.example" (node-peer-seed-host* peer))
        (assert-equal "failure" (node-peer-last-result* peer))
        (assert-equal
          "connect failed: p2p-socket-connect-timeout: connection refused"
          (node-peer-last-error* peer)))
      (node-close* n)))

  (test "summarizes peer failure categories"
    (let* ((dir (test-data-dir))
           (n (node-open* bitcoin-regtest-chain* dir)))
      (node-add-peer* n "untried.example" 18444)
      (node-sync-configured-peer*
        n
        "refused.example"
        18444
        (lambda (peer)
          (error "p2p-socket-connect-timeout: connection refused"))
        1
        0)
      (node-sync-configured-peer*
        n
        "timeout.example"
        18444
        (lambda (peer)
          (error "p2p-socket-connect-timeout: connection timed out"))
        1
        0)
      (node-close* n)
      (let ((output
              (with-output-to-string
                (lambda ()
                  (run-peers* (list "summary"
                                    "--chain"
                                    "bitcoin-regtest"
                                    "--data-dir"
                                    dir))))))
        (assert-true (string-find output "total: 3"))
        (assert-true (string-find output "manual: 3"))
        (assert-true (string-find output "untried: 1"))
        (assert-true (string-find output "connect-refused: 1"))
        (assert-true (string-find output "connect-timeout: 1"))
        (assert-true (string-find output "other-failed: 0")))))

  (test "run loop persists failed attempts"
    (let ((dir (test-data-dir)))
