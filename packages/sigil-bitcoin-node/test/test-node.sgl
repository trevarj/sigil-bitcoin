  (test "fetches multiple block batches over one handshaken peer"
    (let* ((dir (test-data-dir))
           (n (node-open* bitcoin-regtest-chain* dir))
           (h0 (chain-config-genesis-header* bitcoin-regtest-chain*))
           (blocks (make-coinbase-chain h0 3 1296688602))
           (headers (map block-header-field blocks))
           (writes '()))
      (node-ingest-headers* n headers)
      (node-fetch-blocks-with-peer*
        n
        "blocks.example"
        18444
        (one-envelope-reader
          (append
            (empty-sync-envelopes bitcoin-regtest-chain*)
            (map (lambda (b)
                   (p2p-envelope magic: (chain-config-magic* bitcoin-regtest-chain*)
                                 command: "block"
                                 payload: (block-message b)))
                 blocks)))
        (lambda (envelope)
          (set! writes (cons envelope writes)))
        8
        1)
      (let ((requests (filter
                        (lambda (envelope)
                          (string=? "getdata" (p2p-envelope-command envelope)))
                        writes)))
        (assert-equal 3 (length requests))
        (for-each
          (lambda (header)
            (assert-true
              (let loop ((xs requests))
                (cond ((null? xs) #f)
                      ((inventory-hash-member?
                         (block-header-hash header)
                         (inventory-message-parse
                           (p2p-envelope-payload (car xs))))
                       #t)
                      (else (loop (cdr xs)))))))
          headers))
      (assert-equal 3
                    (node-status-snapshot-block-count* (node-status* n)))
      (node-close* n)))

  (test "block fetch prioritizes manual peers over addr gossip when bounded"
    (let* ((dir (test-data-dir))
           (chain (test-chain '(("seed.example" . 18444)) '()))
           (n (node-open* chain dir))
           (h0 (chain-config-genesis-header* bitcoin-regtest-chain*))
           (b1 (make-coinbase-block (list h0) 1 1296688602))
           (h1 (block-header-field b1))
           (attempted '()))
      (node-ingest-headers* n (list h1))
      (node-bootstrap-discovered-peers*
        n
        (lambda (host port timeout-ms)
          '("101.0.0.1" "101.0.1.1" "101.0.2.1"))
        100
        1
        8)
      (node-add-peer* n "203.0.113.9" 18444)
      (node-fetch-blocks-with-peers*
        n
        (lambda (peer)
          (set! attempted
                (append attempted (list (node-peer-address* peer))))
          (if (string=? "203.0.113.9" (node-peer-address* peer))
              (list
                (one-envelope-reader
                  (append
                    (empty-sync-envelopes chain)
                    (list
                      (p2p-envelope magic: (chain-config-magic* chain)
                                    command: "block"
                                    payload: (block-message b1)))))
                (lambda (envelope) #t)
                (lambda () #t))
              (error "addr gossip peer should not be selected first")))
        1
        0
        8
        1)
      (assert-equal '("203.0.113.9") attempted)
      (assert-equal 1
                    (node-status-snapshot-block-count* (node-status* n)))
      (node-close* n)))

  (test "persists and reports sync stages"
    (let* ((dir (test-data-dir))
           (n (node-open* bitcoin-regtest-chain* dir))
           (header-stage-seen #f)
           (envelopes (empty-sync-envelopes bitcoin-regtest-chain*))
           (read-count 0)
           (reader
             (lambda ()
               (set! read-count (+ read-count 1))
               (if (< read-count 3)
                   (assert-equal "handshake"
                                 (node-status-snapshot-sync-stage*
                                   (node-status* n)))
                   (begin
                     (assert-equal "header-sync"
                                   (node-status-snapshot-sync-stage*
                                     (node-status* n)))
                     (set! header-stage-seen #t)))
               (when (null? envelopes)
                 (error "stage reader exhausted"))
               (let ((envelope (car envelopes)))
                 (set! envelopes (cdr envelopes))
                 envelope))))
      (assert-equal "idle"
                    (node-status-snapshot-sync-stage*
                      (node-status* n)))
      (node-sync-with-peer* n
                            "stage.example"
                            18444
                            reader
                            (lambda (envelope) #t)
                            8
                            4)
      (assert-true header-stage-seen)
      (assert-equal "idle"
                    (node-status-snapshot-sync-stage*
                      (node-status* n)))
      (node-close* n)))

  (test "records actionable sync and run attempt metadata"
    (let* ((dir (test-data-dir))
           (n (node-open* bitcoin-regtest-chain* dir)))
      (assert-error
        (node-sync-with-peer*
          n
          "metadata.example"
          18444
          (lambda () (error "simulated handshake timeout"))
          (lambda (envelope) #t)
          1
          1))
      (let ((status (node-status* n))
            (peer (car (node-peers* n))))
        (assert-equal "failed" (node-status-snapshot-sync-stage* status))
        (assert-equal "handshake"
                      (node-status-snapshot-sync-failed-stage* status))
        (assert-equal "handshake failed: simulated handshake timeout"
                      (node-status-snapshot-sync-last-error* status))
        (assert-equal
          "metadata.example:18444 handshake failed: simulated handshake timeout"
                      (node-status-snapshot-last-peer-error* status))
        (assert-equal "handshake failed: simulated handshake timeout"
                      (node-peer-last-error* peer)))
      (node-record-run-attempt* n "failure" "run failed")
      (let ((status (node-status* n)))
        (assert-equal 1 (node-status-snapshot-run-attempts* status))
        (assert-equal "failure" (node-status-snapshot-run-last-result* status))
        (assert-equal "run failed" (node-status-snapshot-run-last-error* status)))
      (node-record-run-attempt* n "success" "")
      (let ((status (node-status* n)))
        (assert-equal 2 (node-status-snapshot-run-attempts* status))
        (assert-equal "success" (node-status-snapshot-run-last-result* status))
        (assert-equal "" (node-status-snapshot-run-last-error* status)))
      (node-record-run-loop-state* n "unbounded" 0 7 2)
      (let ((status (node-status* n)))
        (assert-equal "unbounded" (node-status-snapshot-run-mode* status))
        (assert-equal 0
                      (node-status-snapshot-run-target-iterations* status))
        (assert-equal 7
                      (node-status-snapshot-run-completed-iterations* status))
        (assert-equal 2 (node-status-snapshot-run-retry-count* status)))
      (node-close* n)))

  (test "records actionable malformed handshake metadata"
    (let* ((dir (test-data-dir))
           (n (node-open* bitcoin-regtest-chain* dir)))
      (assert-error
        (node-sync-with-peer*
          n
          "malformed.example"
