  (test "summarizes peer failure categories"
    (let* ((dir (test-data-dir))
           (n (node-open* bitcoin-regtest-chain* dir)))
      (node-add-peer* n "untried.example" 18444)
      (node-sync-configured-peer*
        n
        "refused.example"
        18444
        (lambda (peer)
          (error "p2p-socket-connect-timeout: connection refused"))
        1
        0)
      (node-sync-configured-peer*
        n
        "timeout.example"
        18444
        (lambda (peer)
          (error "p2p-socket-connect-timeout: connection timed out"))
        1
        0)
      (node-close* n)
      (let ((output
              (with-output-to-string
                (lambda ()
                  (run-peers* (list "summary"
                                    "--chain"
                                    "bitcoin-regtest"
                                    "--data-dir"
                                    dir))))))
        (assert-true (string-find output "total: 3"))
        (assert-true (string-find output "manual: 3"))
        (assert-true (string-find output "untried: 1"))
        (assert-true (string-find output "connect-refused: 1"))
        (assert-true (string-find output "connect-timeout: 1"))
        (assert-true (string-find output "other-failed: 0")))))

  (test "run loop persists failed attempts"
    (let ((dir (test-data-dir)))
      (guard (err (else #t))
        (run-loop* (list "--chain" "bitcoin-regtest"
                         "--data-dir" dir
                         "--iterations" "1"
                         "--max-retries" "0")))
      (let* ((n (node-open* bitcoin-regtest-chain* dir))
             (status (node-status* n)))
        (assert-equal 1 (node-status-snapshot-run-attempts* status))
        (assert-equal "bounded" (node-status-snapshot-run-mode* status))
        (assert-equal "failure"
                      (node-status-snapshot-run-last-result* status))
        (assert-equal
          "run failed: node-sync-with-peers: no peers configured"
          (node-status-snapshot-run-last-error* status))
        (assert-equal 1
                      (node-status-snapshot-run-target-iterations* status))
        (assert-equal 0
                      (node-status-snapshot-run-completed-iterations* status))
        (assert-equal 0 (node-status-snapshot-run-retry-count* status))
        (node-close* n))))

