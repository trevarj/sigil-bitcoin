                              command: "verack"
                              payload: (verack-message))
                (p2p-envelope magic: (chain-config-magic* bitcoin-regtest-chain*)
                              command: "headers"
                              payload: (headers-message-serialize full-batch))
                (p2p-envelope magic: (chain-config-magic* bitcoin-regtest-chain*)
                              command: "headers"
                              payload: (headers-message-serialize full-batch))
                (p2p-envelope magic: (chain-config-magic* bitcoin-regtest-chain*)
                              command: "block"
