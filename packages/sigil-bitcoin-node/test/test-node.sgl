  (test "resolves configured seed peers"
    (let* ((dir (test-data-dir))
           (chain (test-chain '(("seed-one.example" . 18444)
                                ("seed-two.example" . 18445))
                              '()))
           (resolved '())
           (resolver
             (lambda (host port timeout-ms)
               (set! resolved (cons (list host port timeout-ms) resolved))
               (cond ((string=? host "seed-one.example")
                      '("93.184.216.34" "93.184.216.35"))
                     ((string=? host "seed-two.example")
                      (list (cons "93.184.216.36" 18446)))
                     (else
                      '()))))
           (n (node-open* chain dir)))
      (assert-equal 0
                    (node-status-snapshot-peer-count*
                      (node-status* n)))
      (assert-equal 3
                    (node-bootstrap-discovered-peers*
                      n
                      resolver
                      2500
                      2
                      4))
      (let ((peers (node-peers* n)))
        (assert-equal 3 (length peers))
        (let ((first (find-peer-by-address peers "93.184.216.34"))
              (second (find-peer-by-address peers "93.184.216.36")))
          (assert-equal "discovered" (node-peer-source* first))
          (assert-equal "seed-one.example" (node-peer-seed-host* first))
          (assert-equal 18446 (node-peer-port* second))
          (assert-equal "seed-two.example" (node-peer-seed-host* second))))
      (assert-equal 2 (length resolved))
      (assert-equal 0
                    (node-bootstrap-discovered-peers*
                      n
                    resolver
                    2500
                    2
                    4))
      (let ((status (node-status* n)))
        (assert-equal "success"
                      (node-status-snapshot-bootstrap-last-result* status))
        (assert-equal ""
                      (node-status-snapshot-bootstrap-last-error* status)))
      (node-close* n)))

