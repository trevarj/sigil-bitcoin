(define (test-chain seed-peers extensions)
  (let ((genesis (chain-config-genesis-header* bitcoin-regtest-chain*)))
    (chain-config* name: "test-chain"
                   network-id: "test"
                   magic: (chain-config-magic* bitcoin-regtest-chain*)
                   default-port: 18444
                   seed-peers: seed-peers
                   protocol-version: 70015
                   services: 1
                   user-agent: "/test-chain:0.1.0/"
                   genesis-header: genesis
                   genesis-hash: (block-header-hash genesis)
                   consensus-params: bitcoin-regtest-consensus-params
                   extensions: extensions)))

(define (test-data-dir)
  (let ((dir (make-temp-directory)))
    (unless dir
      (error "test-data-dir: failed to create temp directory"))
    dir))

(define (same-header? left right)
  (equal? (block-header-serialize left)
          (block-header-serialize right)))

(define (mine-header previous-headers time bits)
  (let ((previous-hash (if (null? previous-headers)
                           %zero32
                           (block-header-hash
                             (car (reverse previous-headers))))))
    (let loop ((nonce 0))
      (let ((header (block-header version: 1
                                  previous-block: previous-hash
                                  merkle-root: %zero32
                                  time: time
                                  bits: bits
                                  nonce: nonce)))
        (if (block-header-proof-of-work-valid? header)
            header
            (loop (+ nonce 1)))))))

(define (mine-next previous-headers time)
  (mine-header previous-headers time #x207fffff))

(define (make-coinbase-tx height value)
  (transaction
    version: 1
    inputs: (list
      (txin previous-output: (outpoint txid: %zero32 index: #xffffffff)
            script-sig: (bytevector #x03 height)
            sequence: #xffffffff
            witness: '()))
    outputs: (list
      (txout value: value script-pubkey: #u8(#x51)))
    lock-time: 0))

(define (mine-block previous-headers txs time)
  (let* ((previous (car (reverse previous-headers)))
         (previous-hash (block-header-hash previous))
         (root (merkle-root (map transaction-txid txs))))
    (let loop ((nonce 0))
      (let ((header (block-header version: 1
                                  previous-block: previous-hash
                                  merkle-root: root
                                  time: time
                                  bits: #x207fffff
                                  nonce: nonce)))
        (if (block-header-proof-of-work-valid? header)
            (block header-field: header transactions: txs)
            (loop (+ nonce 1)))))))

(define (make-coinbase-block previous-headers height time)
  (mine-block previous-headers
              (list (make-coinbase-tx height (block-subsidy height)))
              time))

(define (make-coinbase-chain genesis count start-time)
  (let loop ((headers (list genesis))
             (blocks '())
             (height 1)
             (time start-time))
    (if (> height count)
        (reverse blocks)
        (let ((b (make-coinbase-block headers height time)))
          (loop (append headers (list (block-header-field b)))
                (cons b blocks)
                (+ height 1)
                (+ time 600))))))

(define (one-envelope-reader envelopes)
  (let ((remaining envelopes))
    (lambda ()
      (when (null? remaining)
        (error "one-envelope-reader: no envelopes left"))
      (let ((envelope (car remaining)))
        (set! remaining (cdr remaining))
        envelope))))

(define (remote-version-envelope chain)
  (let ((addr (network-address services: 1 ip: %ipv6-loopback port: 18444)))
    (p2p-envelope
      magic: (chain-config-magic* chain)
      command: "version"
      payload: (version-message-serialize
                 (version-message
                   version: 70015
                   services: 1
                   timestamp: 123456789
                   addr-recv: addr
                   addr-from: addr
                   nonce: 1
                   user-agent: "/peer:0.1.0/"
                   start-height: 0
                   relay?: #t)))))

(define (empty-sync-envelopes chain)
  (list (remote-version-envelope chain)
        (p2p-envelope magic: (chain-config-magic* chain)
                      command: "verack"
                      payload: (verack-message))
        (p2p-envelope magic: (chain-config-magic* chain)
                      command: "headers"
                      payload: (headers-message-serialize '()))))

(define (empty-sync-transport chain close-proc)
  (list (one-envelope-reader (empty-sync-envelopes chain))
        (lambda (envelope) #t)
        close-proc))

(define (find-peer-by-address peers address)
  (cond ((null? peers) #f)
        ((string=? (node-peer-address* (car peers)) address) (car peers))
        (else (find-peer-by-address (cdr peers) address))))

(test-group "chain configs"
  (test "exports header locator"
    (assert-true (procedure? node-header-locator*)))

  (test "exports header ingest"
    (assert-true (procedure? node-ingest-headers*)))

  (test "exports peer add"
    (assert-true (procedure? node-add-peer*)))

  (test "exports live probe entry point"
    (assert-true (procedure? run-probe*)))

  (test "looks up builtin chains"
    (assert-equal "bitcoin-mainnet"
                  (chain-config-name*
                    (chain-config-by-name* "mainnet")))
    (assert-equal "bitcoin-testnet"
                  (chain-config-name*
                    (chain-config-by-name* "testnet")))
    (assert-equal "bitcoin-testnet4"
                  (chain-config-name*
                    (chain-config-by-name* "testnet4")))
    (assert-equal "bitcoin-signet"
                  (chain-config-name*
                    (chain-config-by-name* "signet")))
    (assert-equal "bitcoin-regtest"
                  (chain-config-name*
                    (chain-config-by-name* "regtest")))
    (assert-equal 18444
                  (chain-config-default-port* bitcoin-regtest-chain*)))

  (test "keeps bitcoin bootstrap and mining defaults"
    (assert-true (> (length (chain-config-seed-peers*
                              bitcoin-mainnet-chain*))
                    0))
    (assert-equal '()
                  (chain-config-seed-peers* bitcoin-regtest-chain*))
    (assert-equal '()
                  (chain-config-mining-metadata*
                    bitcoin-mainnet-chain*)))

  (test "keeps testnet3 testnet4 and signet chain configs isolated"
    (assert-equal 18333
                  (chain-config-default-port* bitcoin-testnet-chain*))
    (assert-equal 48333
                  (chain-config-default-port* bitcoin-testnet4-chain*))
    (assert-equal 38333
                  (chain-config-default-port* bitcoin-signet-chain*))
    (assert-equal bitcoin-testnet-magic
                  (chain-config-magic* bitcoin-testnet-chain*))
    (assert-equal bitcoin-testnet4-magic
                  (chain-config-magic* bitcoin-testnet4-chain*))
    (assert-equal bitcoin-signet-magic
                  (chain-config-magic* bitcoin-signet-chain*))
    (assert-false
      (equal? (block-header-hash
                (chain-config-genesis-header* bitcoin-testnet-chain*))
              (block-header-hash
                (chain-config-genesis-header* bitcoin-testnet4-chain*))))
    (assert-false
      (equal? (block-header-hash
                (chain-config-genesis-header* bitcoin-testnet-chain*))
              (block-header-hash
                (chain-config-genesis-header* bitcoin-signet-chain*))))
    (assert-equal 1
                  (consensus-params-bip34-height
                    (chain-config-consensus-params* bitcoin-testnet4-chain*)))
    (assert-equal 1
                  (consensus-params-segwit-height
                    (chain-config-consensus-params* bitcoin-testnet4-chain*)))
    (assert-true (> (length (chain-config-seed-peers*
                              bitcoin-testnet4-chain*))
                    0))
    (assert-equal #x1e0377ae
                  (consensus-params-pow-limit-bits
                    (chain-config-consensus-params* bitcoin-signet-chain*)))
    (assert-equal 1
                  (consensus-params-taproot-height
                    (chain-config-consensus-params* bitcoin-signet-chain*)))
    (assert-true (> (length (chain-config-seed-peers*
                              bitcoin-signet-chain*))
                    0))
    (assert-true (> (length (chain-config-extension*
                              bitcoin-signet-chain*
                              'signet
                              '()))
                    0)))

  (test "looks up sigilcoin placeholder chain"
    (let ((chain (chain-config-by-name* "sigilcoin")))
      (assert-equal "sigilcoin"
                    (chain-config-name* chain))
      (assert-equal 19444
                    (chain-config-default-port* chain))
      (assert-true (> (length (chain-config-mining-metadata* chain))
                      0))))

  (test "keeps sigilcoin node runtime config chain-local"
    (let ((chain (chain-config-by-name* "sigilcoin")))
      (assert-equal 19444 (chain-config-default-port* chain))
      (assert-equal 70015 (chain-config-protocol-version chain))
      (assert-equal 1 (chain-config-services chain))
      (assert-equal "/sigilcoin-node:0.1.0/"
                    (chain-config-user-agent chain))
      (assert-true (> (length (chain-config-seed-peers* chain)) 0))
      (assert-equal 8333
                    (chain-config-default-port* bitcoin-mainnet-chain*))
      (assert-equal "/sigil-bitcoin-node:0.1.0/"
                    (chain-config-user-agent bitcoin-mainnet-chain*))))

  (test "attaches chain mining metadata without changing bitcoin"
    (let* ((metadata '((irc-channel . "#sigilcoin")
                       (claim-format . "sigilcoin-v1")))
           (chain (test-chain '() (list (cons 'mining metadata)))))
      (assert-equal '()
                    (chain-config-mining-metadata*
                      bitcoin-mainnet-chain*))
      (assert-equal metadata
                    (chain-config-mining-metadata* chain)))))

(test-group "node state"
  (test "initializes genesis header"
    (let* ((dir (test-data-dir))
           (n (node-open* bitcoin-regtest-chain* dir))
           (status (node-status* n)))
      (assert-equal "bitcoin-regtest"
                    (node-status-snapshot-chain* status))
      (assert-equal 0
                    (node-status-snapshot-best-height* status))
      (assert-equal 1296688602
                    (node-status-snapshot-best-header-time* status))
      (assert-true (>= (node-status-snapshot-header-sync-lag* status)
                       0))
      (assert-equal 1
                    (node-status-snapshot-header-count* status))
      (assert-true
        (same-header? (chain-config-genesis-header* bitcoin-regtest-chain*)
                      (node-best-header* n)))
      (node-close* n)))

  (test "ingests linked valid headers"
    (let* ((dir (test-data-dir))
           (n (node-open* bitcoin-regtest-chain* dir))
           (h0 (chain-config-genesis-header* bitcoin-regtest-chain*))
           (h1 (mine-next (list h0) 1296688602))
           (h2 (mine-next (list h0 h1) 1296689202)))
      (assert-true
        (block-header-valid-after?
          bitcoin-regtest-consensus-params
          (list h0)
          h1))
      (let* ((inserted (node-ingest-headers* n (list h1 h2)))
             (status (node-status* n)))
        (assert-equal 2 inserted)
        (assert-equal 2
                      (node-status-snapshot-best-height* status))
        (assert-equal 3
                      (node-status-snapshot-header-count* status))
        (assert-true (same-header? h2 (node-best-header* n)))
        (node-close* n))))

  (test "persists headers across opens"
    (let* ((dir (test-data-dir))
           (first (node-open* bitcoin-regtest-chain* dir))
           (h0 (chain-config-genesis-header* bitcoin-regtest-chain*))
           (h1 (mine-next (list h0) 1296688602)))
      (node-ingest-headers* first (list h1))
      (node-close* first)
      (let* ((second (node-open* bitcoin-regtest-chain* dir))
             (status (node-status* second)))
        (assert-equal 1
                      (node-status-snapshot-best-height* status))
        (assert-equal 2
                      (node-status-snapshot-header-count* status))
        (assert-true (same-header? h1 (node-best-header* second)))
        (node-close* second))))

  (test "rejects unconnected headers"
    (let* ((dir (test-data-dir))
           (n (node-open* bitcoin-regtest-chain* dir))
           (orphan (mine-next '() 1296688602)))
      (assert-error (node-ingest-headers* n (list orphan)))
      (node-close* n)))

  (test "persists peers across opens"
    (let* ((dir (test-data-dir))
           (first (node-open* bitcoin-regtest-chain* dir))
           (peer (node-add-peer* first "127.0.0.1" 18444)))
      (assert-equal "127.0.0.1" (node-peer-address* peer))
      (assert-equal 18444 (node-peer-port* peer))
      (node-close* first)
      (let* ((second (node-open* bitcoin-regtest-chain* dir))
             (peers (node-peers* second)))
        (assert-equal 1 (length peers))
        (assert-equal "127.0.0.1" (node-peer-address* (car peers)))
        (assert-true (node-remove-peer* second "127.0.0.1" 18444))
        (assert-equal 0 (length (node-peers* second)))
        (node-close* second))))

  (test "parses bracketed IPv6 peers through CLI"
    (let ((dir (test-data-dir)))
      (run-peers* (list "add"
                        "[2001:db8::1]:38333"
                        "--chain"
                        "bitcoin-signet"
                        "--data-dir"
                        dir))
      (run-peers* (list "add"
                        "[2001:db8::2]"
                        "--chain"
                        "bitcoin-signet"
                        "--data-dir"
                        dir))
      (let* ((n (node-open* bitcoin-signet-chain* dir))
             (peers (node-peers* n))
             (first (find-peer-by-address peers "2001:db8::1"))
             (second (find-peer-by-address peers "2001:db8::2")))
        (assert-true first)
        (assert-true second)
        (assert-equal 38333 (node-peer-port* first))
        (assert-equal 38333 (node-peer-port* second))
        (node-close* n))))

  (test "resolves configured seed peers"
    (let* ((dir (test-data-dir))
           (chain (test-chain '(("seed-one.example" . 18444)
                                ("seed-two.example" . 18445))
                              '()))
           (resolved '())
           (resolver
             (lambda (host port timeout-ms)
               (set! resolved (cons (list host port timeout-ms) resolved))
               (cond ((string=? host "seed-one.example")
                      '("203.0.113.10" "203.0.113.11"))
                     ((string=? host "seed-two.example")
                      (list (cons "203.0.113.12" 18446)))
                     (else
                      '()))))
           (n (node-open* chain dir)))
      (assert-equal 0
                    (node-status-snapshot-peer-count*
                      (node-status* n)))
      (assert-equal 3
                    (node-bootstrap-discovered-peers*
                      n
                      resolver
                      2500
                      2
                      4))
      (let ((peers (node-peers* n)))
        (assert-equal 3 (length peers))
        (let ((first (find-peer-by-address peers "203.0.113.10"))
              (second (find-peer-by-address peers "203.0.113.12")))
          (assert-equal "discovered" (node-peer-source* first))
          (assert-equal "seed-one.example" (node-peer-seed-host* first))
          (assert-equal 18446 (node-peer-port* second))
          (assert-equal "seed-two.example" (node-peer-seed-host* second))))
      (assert-equal 2 (length resolved))
      (assert-equal 0
                    (node-bootstrap-discovered-peers*
                      n
                    resolver
                    2500
                    2
                    4))
      (node-close* n)))

  (test "skips unroutable discovered peers"
    (let* ((dir (test-data-dir))
           (chain (test-chain '(("seed.example" . 18444)) '()))
           (n (node-open* chain dir)))
      (assert-equal
        2
        (node-bootstrap-discovered-peers*
          n
          (lambda (host port timeout-ms)
            '("10.0.0.1"
              "100.64.254.152"
              "127.0.0.1"
              "169.254.10.20"
              "172.16.0.1"
              "192.168.1.1"
              "224.0.0.1"
              "fc00::1"
              "fe80::1"
              "::1"
              "93.184.216.34"
              "2606:2800:220:1:248:1893:25c8:1946"))
          100
          1
          2))
      (let ((peers (node-peers* n)))
        (assert-equal 2 (length peers))
        (assert-true (find-peer-by-address peers "93.184.216.34"))
        (assert-true
          (find-peer-by-address peers
                                "2606:2800:220:1:248:1893:25c8:1946"))
        (assert-false (find-peer-by-address peers "100.64.254.152")))
      (node-close* n)))

  (test "keeps manual and discovered peer sources separate"
    (let* ((dir (test-data-dir))
           (chain (test-chain '(("seed.example" . 18444)) '()))
           (n (node-open* chain dir)))
      (node-add-peer* n "203.0.113.20" 18444)
      (assert-equal
        1
        (node-bootstrap-discovered-peers*
          n
          (lambda (host port timeout-ms)
            '("203.0.113.20" "203.0.113.21"))
          100
          1
          8))
      (let* ((peers (node-peers* n))
             (manual (find-peer-by-address peers "203.0.113.20"))
             (discovered (find-peer-by-address peers "203.0.113.21")))
        (assert-equal "manual" (node-peer-source* manual))
        (assert-equal "" (node-peer-seed-host* manual))
        (assert-equal "discovered" (node-peer-source* discovered))
        (assert-equal "seed.example" (node-peer-seed-host* discovered)))
      (node-close* n)))

  (test "builds a database backed header locator"
    (let* ((dir (test-data-dir))
           (n (node-open* bitcoin-regtest-chain* dir))
           (h0 (chain-config-genesis-header* bitcoin-regtest-chain*))
           (h1 (mine-next (list h0) 1296688602))
           (h2 (mine-next (list h0 h1) 1296689202))
           (h3 (mine-next (list h0 h1 h2) 1296689802)))
      (node-ingest-headers* n (list h1 h2 h3))
      (let ((locator (node-header-locator* n)))
        (assert-equal 4 (length locator))
        (assert-equal (block-header-hash h3) (car locator))
        (assert-equal (block-header-hash h0) (car (reverse locator))))
      (node-close* n)))

  (test "stores and validates downloaded blocks"
    (let* ((dir (test-data-dir))
           (n (node-open* bitcoin-regtest-chain* dir))
           (h0 (chain-config-genesis-header* bitcoin-regtest-chain*))
           (b1 (make-coinbase-block (list h0) 1 1296688602))
           (h1 (block-header-field b1)))
      (node-ingest-headers* n (list h1))
      (let ((info (node-store-block* n b1)))
        (assert-equal "downloaded" (node-block-info-status* info)))
      (assert-equal 1 (node-validate-blocks* n))
      (let ((status (node-status* n)))
        (assert-equal 1 (node-status-snapshot-block-count* status))
        (assert-equal 1 (node-status-snapshot-validated-block-count* status))
        (assert-equal 1 (node-status-snapshot-best-block-height* status))
        (assert-equal 0 (node-status-snapshot-peer-count* status))
        (assert-equal 0 (node-status-snapshot-pending-block-count* status)))
      (node-close* n)))

  (test "resumes validation from persisted UTXO state"
    (let* ((dir (test-data-dir))
           (first (node-open* bitcoin-regtest-chain* dir))
           (h0 (chain-config-genesis-header* bitcoin-regtest-chain*))
           (blocks (make-coinbase-chain h0 2 1296688602))
           (b1 (car blocks))
           (b2 (cadr blocks)))
      (node-ingest-headers* first
                            (list (block-header-field b1)
                                  (block-header-field b2)))
      (node-store-block* first b1)
      (assert-equal 1 (node-validate-blocks* first))
      (node-close* first)
      (let ((second (node-open* bitcoin-regtest-chain* dir)))
        (node-store-block* second b2)
        (assert-equal 1 (node-validate-blocks* second))
        (let ((status (node-status* second)))
          (assert-equal 2 (node-status-snapshot-validated-block-count* status))
          (assert-equal 2 (node-status-snapshot-best-block-height* status)))
        (node-close* second))))

  (test "resumes interrupted validation after missing block download"
    (let* ((dir (test-data-dir))
           (n (node-open* bitcoin-regtest-chain* dir))
           (h0 (chain-config-genesis-header* bitcoin-regtest-chain*))
           (blocks (make-coinbase-chain h0 2 1296688602))
           (b1 (car blocks))
           (b2 (cadr blocks)))
      (node-ingest-headers* n
                            (list (block-header-field b1)
                                  (block-header-field b2)))
      (node-store-block* n b1)
      (assert-equal 1 (node-validate-blocks* n))
      (assert-equal 1
                    (node-status-snapshot-pending-block-count*
                      (node-status* n)))
      (node-store-block* n b2)
      (assert-equal 1 (node-validate-blocks* n))
      (assert-equal 0
                    (node-status-snapshot-pending-block-count*
                      (node-status* n)))
      (node-close* n)))

  (test "scores peer failures during bounded sync"
    (let* ((dir (test-data-dir))
           (n (node-open* bitcoin-regtest-chain* dir)))
      (assert-error
        (node-sync-with-peer*
          n
          "127.0.0.1"
          18444
          (lambda () (error "simulated read failure"))
          (lambda (envelope) #t)
          1
          1))
      (let ((peer (car (node-peers* n))))
        (assert-equal -1 (node-peer-score* peer))
        (assert-equal 1 (node-peer-failures* peer))
        (assert-equal "failure" (node-peer-last-result* peer))
        (assert-equal "handshake failed" (node-peer-last-error* peer)))
      (node-close* n)))

  (test "records peer health results and clears stale errors"
    (let* ((dir (test-data-dir))
           (n (node-open* bitcoin-regtest-chain* dir))
           (closed 0)
           (good-transport
             (lambda (peer)
               (list (lambda () (error "unexpected read"))
                     (lambda (envelope) #t)
                     (lambda ()
                       (set! closed (+ closed 1)))))))
      (let ((failed (node-test-peer*
                      n
                      "health.example"
                      18444
                      (lambda (peer)
                        (error "simulated test failure")))))
        (assert-equal "failure" (node-peer-last-result* failed))
        (assert-equal "test failed" (node-peer-last-error* failed)))
      (let ((passed (node-test-peer* n "health.example" 18444 good-transport)))
        (assert-equal "success" (node-peer-last-result* passed))
        (assert-equal "" (node-peer-last-error* passed))
        (assert-equal 1 closed))
      (node-close* n)))

  (test "falls back to the next persisted peer"
    (let* ((dir (test-data-dir))
           (n (node-open* bitcoin-regtest-chain* dir))
           (closed 0)
           (close-good (lambda ()
                         (set! closed (+ closed 1))))
           (connect-peer
             (lambda (peer)
               (cond ((string=? "bad.example" (node-peer-address* peer))
                      (error "simulated connect failure"))
                     (else
                      (empty-sync-transport bitcoin-regtest-chain*
                                            close-good))))))
      (node-add-peer* n "bad.example" 18444)
      (node-add-peer* n "good.example" 18444)
      (let ((status (node-sync-with-peers* n connect-peer 2 0 8 4)))
        (assert-equal 0 (node-status-snapshot-pending-block-count* status))
        (assert-equal 1 closed)
        (let* ((peers (node-peers* n))
               (bad (find-peer-by-address peers "bad.example"))
               (good (find-peer-by-address peers "good.example")))
          (assert-equal 1 (node-peer-failures* bad))
          (assert-equal "failure" (node-peer-last-result* bad))
          (assert-equal "connect failed: simulated connect failure"
                        (node-peer-last-error* bad))
          (assert-equal 1 (node-peer-score* good))
          (assert-equal "success" (node-peer-last-result* good))))
      (node-close* n)))

  (test "retries another peer after handshake failure"
    (let* ((dir (test-data-dir))
           (n (node-open* bitcoin-regtest-chain* dir))
           (closed 0)
           (connect-peer
             (lambda (peer)
               (if (string=? "handshake-bad.example"
                             (node-peer-address* peer))
                   (list
                     (lambda () (error "simulated handshake timeout"))
                     (lambda (envelope) #t)
                     (lambda ()
                       (set! closed (+ closed 1))))
                   (empty-sync-transport bitcoin-regtest-chain*
                                         (lambda ()
                                           (set! closed (+ closed 1))))))))
      (node-add-peer* n "handshake-bad.example" 18444)
      (node-add-peer* n "handshake-good.example" 18444)
      (let ((status (node-sync-with-peers* n connect-peer 2 0 8 4)))
        (assert-equal "idle" (node-status-snapshot-sync-stage* status))
        (assert-equal "" (node-status-snapshot-sync-last-error* status)))
      (let* ((peers (node-peers* n))
             (bad (find-peer-by-address peers "handshake-bad.example"))
             (good (find-peer-by-address peers "handshake-good.example")))
        (assert-equal 2 closed)
        (assert-equal "handshake failed" (node-peer-last-error* bad))
        (assert-equal "success" (node-peer-last-result* good)))
      (node-close* n)))

  (test "honors the configured peer retry limit"
    (let* ((dir (test-data-dir))
           (n (node-open* bitcoin-regtest-chain* dir))
           (attempts 0)
           (connect-peer
             (lambda (peer)
               (set! attempts (+ attempts 1))
               (if (<= attempts 2)
                   (error "simulated connect failure")
                   (empty-sync-transport bitcoin-regtest-chain*
                                         (lambda () #t))))))
      (node-add-peer* n "retry.example" 18444)
      (node-sync-with-peers* n connect-peer 1 2 8 4)
      (assert-equal 3 attempts)
      (let ((peer (car (node-peers* n))))
        (assert-equal 2 (node-peer-failures* peer))
        (assert-equal "success" (node-peer-last-result* peer)))
      (node-close* n)))

  (test "diversifies bounded peer attempts across network buckets"
    (let* ((dir (test-data-dir))
           (n (node-open* bitcoin-regtest-chain* dir))
           (attempted '())
           (connect-peer
             (lambda (peer)
               (set! attempted
                     (append attempted (list (node-peer-address* peer))))
               (if (string=? "103.0.0.1" (node-peer-address* peer))
                   (empty-sync-transport bitcoin-regtest-chain*
                                         (lambda () #t))
                   (error "simulated connect failure")))))
      (node-add-peer* n "101.0.0.1" 18444)
      (node-add-peer* n "101.0.1.1" 18444)
      (node-add-peer* n "101.0.2.1" 18444)
      (node-add-peer* n "102.0.0.1" 18444)
      (node-add-peer* n "103.0.0.1" 18444)
      (node-sync-with-peers* n connect-peer 3 0 8 4)
      (assert-equal '("101.0.0.1" "102.0.0.1" "103.0.0.1")
                    attempted)
      (node-close* n)))

  (test "resumes header sync from persisted locator"
    (let* ((dir (test-data-dir))
           (first (node-open* bitcoin-regtest-chain* dir))
           (h0 (chain-config-genesis-header* bitcoin-regtest-chain*))
           (h1 (mine-next (list h0) 1296688602))
           (first-writes '()))
      (node-sync-with-peer*
        first
        "headers.example"
        18444
        (one-envelope-reader
          (list (remote-version-envelope bitcoin-regtest-chain*)
                (p2p-envelope magic: (chain-config-magic* bitcoin-regtest-chain*)
                              command: "verack"
                              payload: (verack-message))
                (p2p-envelope magic: (chain-config-magic* bitcoin-regtest-chain*)
                              command: "headers"
                              payload: (headers-message-serialize (list h1)))))
        (lambda (envelope)
          (set! first-writes (append first-writes (list envelope))))
        8
        0)
      (assert-equal 2
                    (node-status-snapshot-header-count*
                      (node-status* first)))
      (node-close* first)
      (let* ((second (node-open* bitcoin-regtest-chain* dir))
             (second-writes '()))
        (node-sync-with-peer*
          second
          "headers.example"
          18444
          (one-envelope-reader (empty-sync-envelopes bitcoin-regtest-chain*))
          (lambda (envelope)
            (set! second-writes (append second-writes (list envelope))))
          8
          0)
        (let* ((request (caddr second-writes))
               (payload (getheaders-message-parse
                          (p2p-envelope-payload request))))
          (assert-equal "getheaders" (p2p-envelope-command request))
          (assert-equal (block-header-hash h1)
                        (car (getheaders-message-locator-hashes payload))))
        (node-close* second))))

  (test "recovers from mid-download peer disconnect"
    (let* ((dir (test-data-dir))
           (n (node-open* bitcoin-regtest-chain* dir))
           (h0 (chain-config-genesis-header* bitcoin-regtest-chain*))
           (b1 (make-coinbase-block (list h0) 1 1296688602))
           (h1 (block-header-field b1))
           (first-writes 0)
           (second-writes 0))
      (node-ingest-headers* n (list h1))
      (node-add-peer* n "disconnect.example" 18444)
      (node-add-peer* n "recover.example" 18444)
      (define (connect-peer peer)
        (if (string=? "disconnect.example"
                      (node-peer-address* peer))
            (let ((remaining (empty-sync-envelopes
                               bitcoin-regtest-chain*)))
              (list
                (lambda ()
                  (if (null? remaining)
                      (error "simulated mid-download disconnect")
                      (let ((envelope (car remaining)))
                        (set! remaining (cdr remaining))
                        envelope)))
                (lambda (envelope)
                  (set! first-writes (+ first-writes 1)))
                (lambda () #t)))
            (list
              (one-envelope-reader
                (append
                  (empty-sync-envelopes bitcoin-regtest-chain*)
                  (list (p2p-envelope
                          magic: (chain-config-magic*
                                   bitcoin-regtest-chain*)
                          command: "block"
                          payload: (block-message b1)))))
              (lambda (envelope)
                (set! second-writes (+ second-writes 1)))
              (lambda () #t))))
      (let ((status (node-sync-with-peers* n connect-peer 2 0 8 4)))
        (assert-equal 1
                      (node-status-snapshot-block-count* status))
        (assert-equal 0
                      (node-status-snapshot-requested-block-count*
                        status))
        (assert-equal 0
                      (node-status-snapshot-failed-block-count*
                        status)))
      (assert-true (> first-writes 0))
      (assert-true (> second-writes 0))
      (let* ((peers (node-peers* n))
             (bad (find-peer-by-address peers "disconnect.example"))
             (good (find-peer-by-address peers "recover.example")))
        (assert-equal 1 (node-peer-failures* bad))
        (assert-equal "block download failed" (node-peer-last-error* bad))
        (assert-equal "success" (node-peer-last-result* good)))
      (node-close* n)))

  (test "rolls validation forward onto a stronger fork"
    (let* ((dir (test-data-dir))
           (n (node-open* bitcoin-regtest-chain* dir))
           (h0 (chain-config-genesis-header* bitcoin-regtest-chain*))
           (old-blocks (make-coinbase-chain h0 2 1296688602))
           (new-blocks (make-coinbase-chain h0 3 1296698602)))
      (node-ingest-headers* n
                            (map block-header-field old-blocks))
      (for-each (lambda (b) (node-store-block* n b)) old-blocks)
      (assert-equal 2 (node-validate-blocks* n))
      (node-ingest-headers* n
                            (map block-header-field new-blocks))
      (for-each (lambda (b) (node-store-block* n b)) new-blocks)
      (assert-equal 3 (node-validate-blocks* n))
      (let ((status (node-status* n)))
        (assert-equal 3 (node-status-snapshot-best-height* status))
        (assert-equal 3 (node-status-snapshot-best-block-height* status))
        (assert-equal 3
                      (node-status-snapshot-validated-block-count* status)))
      (node-close* n)))

  (test "downloads missing blocks with getdata"
    (let* ((dir (test-data-dir))
           (n (node-open* bitcoin-regtest-chain* dir))
           (h0 (chain-config-genesis-header* bitcoin-regtest-chain*))
           (b1 (make-coinbase-block (list h0) 1 1296688602))
           (h1 (block-header-field b1))
           (writes '()))
      (node-ingest-headers* n (list h1))
      (assert-equal
        1
        (node-download-blocks*
          n
          (one-envelope-reader
            (list (p2p-envelope magic: (chain-config-magic* bitcoin-regtest-chain*)
                                command: "block"
                                payload: (block-message b1))))
          (lambda (envelope)
            (set! writes (cons envelope writes)))
          4
          8))
      (assert-equal 1 (length writes))
      (let* ((request (car writes))
             (items (inventory-message-parse (p2p-envelope-payload request))))
        (assert-equal "getdata" (p2p-envelope-command request))
        (assert-equal 1 (length items))
        (assert-equal inv-block (inventory-vector-type (car items)))
        (assert-equal (block-header-hash h1)
                      (inventory-vector-hash (car items))))
      (assert-equal 1
                    (node-status-snapshot-block-count* (node-status* n)))
      (node-close* n)))

  (test "persists and reports sync stages"
    (let* ((dir (test-data-dir))
           (n (node-open* bitcoin-regtest-chain* dir))
           (header-stage-seen #f)
           (envelopes (empty-sync-envelopes bitcoin-regtest-chain*))
           (read-count 0)
           (reader
             (lambda ()
               (set! read-count (+ read-count 1))
               (if (< read-count 3)
                   (assert-equal "handshake"
                                 (node-status-snapshot-sync-stage*
                                   (node-status* n)))
                   (begin
                     (assert-equal "header-sync"
                                   (node-status-snapshot-sync-stage*
                                     (node-status* n)))
                     (set! header-stage-seen #t)))
               (when (null? envelopes)
                 (error "stage reader exhausted"))
               (let ((envelope (car envelopes)))
                 (set! envelopes (cdr envelopes))
                 envelope))))
      (assert-equal "idle"
                    (node-status-snapshot-sync-stage*
                      (node-status* n)))
      (node-sync-with-peer* n
                            "stage.example"
                            18444
                            reader
                            (lambda (envelope) #t)
                            8
                            4)
      (assert-true header-stage-seen)
      (assert-equal "idle"
                    (node-status-snapshot-sync-stage*
                      (node-status* n)))
      (node-close* n)))

  (test "records actionable sync and run attempt metadata"
    (let* ((dir (test-data-dir))
           (n (node-open* bitcoin-regtest-chain* dir)))
      (assert-error
        (node-sync-with-peer*
          n
          "metadata.example"
          18444
          (lambda () (error "simulated handshake timeout"))
          (lambda (envelope) #t)
          1
          1))
      (let ((status (node-status* n))
            (peer (car (node-peers* n))))
        (assert-equal "failed" (node-status-snapshot-sync-stage* status))
        (assert-equal "handshake"
                      (node-status-snapshot-sync-failed-stage* status))
        (assert-equal "handshake failed"
                      (node-status-snapshot-sync-last-error* status))
        (assert-equal "metadata.example:18444 handshake failed"
                      (node-status-snapshot-last-peer-error* status))
        (assert-equal "handshake failed" (node-peer-last-error* peer)))
      (node-record-run-attempt* n "failure" "run failed")
      (let ((status (node-status* n)))
        (assert-equal 1 (node-status-snapshot-run-attempts* status))
        (assert-equal "failure" (node-status-snapshot-run-last-result* status))
        (assert-equal "run failed" (node-status-snapshot-run-last-error* status)))
      (node-record-run-attempt* n "success" "")
      (let ((status (node-status* n)))
        (assert-equal 2 (node-status-snapshot-run-attempts* status))
        (assert-equal "success" (node-status-snapshot-run-last-result* status))
        (assert-equal "" (node-status-snapshot-run-last-error* status)))
      (node-close* n)))

  (test "records direct peer connect failure metadata"
    (let* ((dir (test-data-dir))
           (n (node-open* bitcoin-regtest-chain* dir))
           (status (node-sync-configured-peer*
                     n
                     "direct.example"
                     18444
                     (lambda (peer)
                       (error "p2p-socket-connect-timeout: connection refused"))
                     1
                     0))
           (peer (car (node-peers* n))))
        (assert-equal "failed" (node-status-snapshot-sync-stage* status))
        (assert-equal "connect"
                      (node-status-snapshot-sync-failed-stage* status))
        (assert-equal
          "connect failed: p2p-socket-connect-timeout: connection refused"
          (node-status-snapshot-sync-last-error* status))
        (assert-equal
          "direct.example:18444 connect failed: p2p-socket-connect-timeout: connection refused"
          (node-status-snapshot-last-peer-error* status))
        (assert-equal "manual" (node-peer-source* peer))
        (assert-equal "failure" (node-peer-last-result* peer))
        (assert-equal
          "connect failed: p2p-socket-connect-timeout: connection refused"
          (node-peer-last-error* peer))
      (node-close* n)))

  (test "preserves discovered peer metadata across failed sync attempts"
    (let* ((dir (test-data-dir))
           (chain (test-chain '(("seed.example" . 18444)) '()))
           (n (node-open* chain dir)))
      (assert-equal
        1
        (node-bootstrap-discovered-peers*
          n
