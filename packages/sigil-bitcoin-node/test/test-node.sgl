;; Rules for a chain that does not rank by proof-of-work. The comparator is
;; deliberately inverted so a changed tip selection is observable: the chain
;; with the least accumulated work wins.
(define %shortest-chain-rules
  (header-rules accept?: (header-rules-accept? bitcoin-header-rules)
                chain-work: (header-rules-chain-work bitcoin-header-rules)
                better-chain?: (lambda (candidate incumbent)
                                 (< (chain-candidate-work candidate)
                                    (chain-candidate-work incumbent)))))

;; Rules that accept every header, standing in for a chain whose acceptance
;; test is something other than hash proof-of-work.
(define %accept-any-header-rules
  (header-rules accept?: (lambda (params previous-headers header) #t)
                chain-work: (header-rules-chain-work bitcoin-header-rules)
                better-chain?: (header-rules-better-chain?
                                 bitcoin-header-rules)))

;; A fake chain whose ranking key is not in the header at all: it is the size
;; of the first coinbase input script, and smaller is better. Nothing about it
;; is Bitcoin, and nothing about it comes from another project; it exists here
;; to show the seam can express a body-derived key plus a tip-replacement rule.
(define (%body-key b)
  (bytevector-length
    (txin-script-sig (car (transaction-inputs (car (block-transactions b)))))))

;; Before the body arrives the key is unknown, so the chain rates the header
;; optimistically. That pulls the body in; the real key then settles the rank.
(define (%body-ranked-work header b previous-work)
  (+ previous-work (if b (%body-key b) 0)))

(define (%body-ranked-better? candidate incumbent)
  (cond
    ;; A height a later block already builds on is settled. A better sibling
    ;; arriving afterwards must not reorganise it, however good its key.
    ((chain-candidate-extended? candidate) #f)
    ;; Any unsettled candidate beats a settled height, which is how selection
    ;; leaves genesis and follows the chain forward.
    ((chain-candidate-extended? incumbent) #t)
    ((< (chain-candidate-work candidate) (chain-candidate-work incumbent)) #t)
    ((> (chain-candidate-work candidate) (chain-candidate-work incumbent)) #f)
    ;; Equal keys break on the lower hash, so the choice does not depend on
    ;; which block was seen first.
    (else
     (< (bytevector-u8-ref (chain-candidate-hash candidate) 31)
        (bytevector-u8-ref (chain-candidate-hash incumbent) 31)))))

(define %body-ranked-rules
  (header-rules accept?: (header-rules-accept? bitcoin-header-rules)
                chain-work: %body-ranked-work
                better-chain?: %body-ranked-better?))

;; The same rule with the settled-height guard removed, so a test can show the
;; guard is what protects an extended height rather than some other accident.
(define %unguarded-body-ranked-rules
  (header-rules accept?: (header-rules-accept? bitcoin-header-rules)
                chain-work: %body-ranked-work
                better-chain?: (lambda (candidate incumbent)
                                 (or (chain-candidate-extended? incumbent)
                                     (< (chain-candidate-work candidate)
                                        (chain-candidate-work incumbent))))))

(define (rules-extensions rules)
  (list (cons 'consensus (list (cons 'rules rules)))))

(define (consensus-extensions entries)
  (list (cons 'consensus entries)))

;; A fake non-Bitcoin block profile. Emission is flat and larger than
;; Bitcoin's subsidy at the same height, and the coinbase input script runs
;; well past Bitcoin's 100-byte cap. It reuses Bitcoin's connector, which is
;; what a chain that changes only emission and coinbase layout needs.
(define %fake-subsidy-value 10000000000)
(define %fake-coinbase-script-len 240)

(define %fake-block-rules
  (block-rules connect: (block-rules-connect bitcoin-block-rules)
               subsidy: (lambda (height) %fake-subsidy-value)
               coinbase-script-bounds: (cons 2 512)))

(define (test-chain seed-peers extensions)
  (let ((genesis (chain-config-genesis-header* bitcoin-regtest-chain*)))
    (chain-config* name: "test-chain"
                   network-id: "test"
                   magic: (chain-config-magic* bitcoin-regtest-chain*)
                   default-port: 18444
                   seed-peers: seed-peers
                   protocol-version: 70015
                   services: 1
                   user-agent: "/test-chain:0.1.0/"
                   genesis-header: genesis
                   genesis-hash: (block-header-hash genesis)
                   consensus-params: bitcoin-regtest-consensus-params
                   extensions: extensions)))

(define (test-data-dir)
  (let ((dir (make-temp-directory)))
    (unless dir
      (error "test-data-dir: failed to create temp directory"))
    dir))

(define (same-header? left right)
  (equal? (block-header-serialize left)
          (block-header-serialize right)))

(define (test-row-ref row key)
  (let ((pair (assoc key row)))
    (if pair
        (cdr pair)
        (let ((sym-pair (assoc (string->symbol key) row)))
          (if sym-pair (cdr sym-pair) #f)))))

(define (test-arg-value args name default)
  (let loop ((xs args))
    (cond ((null? xs) default)
          ((and (string=? (car xs) name) (not (null? (cdr xs))))
           (cadr xs))
          (else
           (loop (cdr xs))))))

(define (mine-header previous-headers time bits)
  (let ((previous-hash (if (null? previous-headers)
                           %zero32
                           (block-header-hash
                             (car (reverse previous-headers))))))
    (let loop ((nonce 0))
      (let ((header (block-header version: 1
                                  previous-block: previous-hash
                                  merkle-root: %zero32
                                  time: time
                                  bits: bits
                                  nonce: nonce)))
        (if (block-header-proof-of-work-valid? header)
            header
            (loop (+ nonce 1)))))))

(define (mine-next previous-headers time)
  (mine-header previous-headers time #x207fffff))

(define (mine-next-after previous time)
  (mine-header (list previous) time #x207fffff))

;; A header Bitcoin rejects: wrong bits for the chain and no proof-of-work.
(define (unmined-next previous time)
  (block-header version: 1
                previous-block: (block-header-hash previous)
                merkle-root: %zero32
                time: time
                bits: #x1d00ffff
                nonce: 0))

(define (make-coinbase-tx height value)
  (transaction
    version: 1
    inputs: (list
      (txin previous-output: (outpoint txid: %zero32 index: #xffffffff)
            script-sig: (bytevector #x03 height)
            sequence: #xffffffff
            witness: '()))
    outputs: (list
      (txout value: value script-pubkey: #u8(#x51)))
    lock-time: 0))

(define (make-relay-tx n value)
  (transaction
    version: 1
    inputs: (list
      (txin previous-output: (outpoint txid: (make-bytevector 32 n)
                                      index: 0)
            script-sig: #u8()
            sequence: #xffffffff
            witness: '()))
    outputs: (list
      (txout value: value script-pubkey: #u8(#x51)))
    lock-time: 0))

(define (make-spend-tx previous-tx output-index value)
  (transaction
    version: 1
    inputs: (list
      (txin previous-output: (outpoint txid: (transaction-txid previous-tx)
                                      index: output-index)
            script-sig: #u8()
            sequence: #xffffffff
            witness: '()))
    outputs: (list
      (txout value: value script-pubkey: #u8(#x51)))
    lock-time: 0))

(define (make-duplicate-spend-tx previous-tx output-index value)
  (let ((op (outpoint txid: (transaction-txid previous-tx)
                      index: output-index)))
    (transaction
      version: 1
      inputs: (list
        (txin previous-output: op
              script-sig: #u8()
              sequence: #xffffffff
              witness: '())
        (txin previous-output: op
              script-sig: #u8()
              sequence: #xffffffff
              witness: '()))
      outputs: (list
        (txout value: value script-pubkey: #u8(#x51)))
      lock-time: 0)))

(define (mine-block previous-headers txs time)
  (let* ((previous (car (reverse previous-headers)))
         (previous-hash (block-header-hash previous))
         (root (merkle-root (map transaction-txid txs))))
    (let loop ((nonce 0))
      (let ((header (block-header version: 1
                                  previous-block: previous-hash
                                  merkle-root: root
                                  time: time
                                  bits: #x207fffff
                                  nonce: nonce)))
        (if (block-header-proof-of-work-valid? header)
            (block header-field: header transactions: txs)
            (loop (+ nonce 1)))))))

(define (make-coinbase-block previous-headers height time)
  (mine-block previous-headers
              (list (make-coinbase-tx height (block-subsidy height)))
              time))

;; A coinbase whose input script is padded to `script-len` bytes, which stays
;; inside Bitcoin's 2..100 byte coinbase bounds so the block still connects.
(define (make-padded-coinbase-tx height value script-len)
  (transaction
    version: 1
    inputs: (list
      (txin previous-output: (outpoint txid: %zero32 index: #xffffffff)
            script-sig: (make-bytevector script-len height)
            sequence: #xffffffff
            witness: '()))
    outputs: (list
      (txout value: value script-pubkey: #u8(#x51)))
    lock-time: 0))

(define (make-keyed-block previous-headers height time script-len)
  (mine-block previous-headers
              (list (make-padded-coinbase-tx height
                                             (block-subsidy height)
                                             script-len))
              time))

;; A block whose coinbase claims `value` and pads its input script to
;; `script-len`, so a test can leave Bitcoin's body bounds in either direction.
(define (make-profile-block previous-headers height time script-len value)
  (mine-block previous-headers
              (list (make-padded-coinbase-tx height value script-len))
              time))

(define (make-coinbase-chain genesis count start-time)
  (let loop ((headers (list genesis))
             (blocks '())
             (height 1)
             (time start-time))
    (if (> height count)
        (reverse blocks)
        (let ((b (make-coinbase-block headers height time)))
          (loop (append headers (list (block-header-field b)))
                (cons b blocks)
                (+ height 1)
                (+ time 600))))))

(define (store-blocks n blocks)
  (unless (null? blocks)
    (node-store-block* n (car blocks))
    (store-blocks n (cdr blocks))))

;; One bounded block-request round against a peer that goes quiet: the node
;; writes the `getdata`, records the attempt against every row it asked for
;; and returns without ever reading a reply. That recorded attempt is the
;; count the give-up path reads.
(define (request-blocks-from-silent-peer n)
  (node-download-blocks* n
                         (lambda () (error "the peer never answered"))
                         (lambda (envelope) #t)
                         0
                         8))

(define (prepare-mature-utxo-node n)
  (let* ((h0 (chain-config-genesis-header* bitcoin-regtest-chain*))
         (blocks (make-coinbase-chain h0 101 1296688602)))
    (node-ingest-headers* n (map block-header-field blocks))
    (store-blocks n blocks)
    (unless (= 101 (node-validate-blocks* n))
      (error "prepare-mature-utxo-node: validation failed"))
    blocks))

(define (headers-through blocks)
  (cons (chain-config-genesis-header* bitcoin-regtest-chain*)
        (map block-header-field blocks)))

(define (make-header-chain genesis count start-time)
  (let loop ((previous genesis)
             (out '())
             (height 1)
             (time start-time))
    (if (> height count)
        (reverse out)
        (let ((header (mine-next-after previous time)))
          (loop header
                (cons header out)
                (+ height 1)
                (+ time 600))))))

(define (inventory-hash-member? hash items)
  (cond ((null? items) #f)
        ((equal? hash (inventory-vector-hash (car items))) #t)
        (else (inventory-hash-member? hash (cdr items)))))

(define (repeat-item item count)
  (let loop ((remaining count) (out '()))
    (if (<= remaining 0)
        out
        (loop (- remaining 1) (cons item out)))))

;; Block inventory for hashes no node ever stored, one distinct hash per item.
(define (unknown-block-items count)
  (let loop ((i 0) (out '()))
    (if (>= i count)
        (reverse out)
        (loop (+ i 1)
              (cons (inventory-vector type: inv-block
                                      hash: (make-bytevector 32 (modulo i 256)))
                    out)))))

;; A getdata payload naming `count` copies of one item, built as bytes so a
;; test can declare far more items than it is worth allocating structs for.
(define (repeated-getdata-payload item count)
  (let* ((one (let ((payload (getdata-message (list item))))
                (bytevector-copy payload 1 (bytevector-length payload))))
         (out (make-bytevector (* 36 count) 0)))
    (let loop ((i 0))
      (if (>= i count)
          (bytevector-append (compact-size-encode count) out)
          (begin
            (bytevector-copy! out (* 36 i) one)
            (loop (+ i 1)))))))

(define (writes-with command writes)
  (filter (lambda (envelope)
            (string=? command (p2p-envelope-command envelope)))
          writes))

(define (notfound-items writes)
  (let ((responses (writes-with "notfound" writes)))
    (if (null? responses)
        '()
        (inventory-message-parse (p2p-envelope-payload (car responses))))))

;; Serve one inbound peer that sends `payload` as a getdata and then pings,
;; and return the envelopes this node wrote back.
(define (getdata-response-writes n address payload)
  (let ((writes '()))
    (node-serve-inbound-transport*
      n
      address
      18444
      (one-envelope-reader
        (list (remote-version-envelope bitcoin-regtest-chain*)
              (p2p-envelope
                magic: (chain-config-magic* bitcoin-regtest-chain*)
                command: "verack"
                payload: (verack-message))
              (p2p-envelope
                magic: (chain-config-magic* bitcoin-regtest-chain*)
                command: "getdata"
                payload: payload)
              (p2p-envelope
                magic: (chain-config-magic* bitcoin-regtest-chain*)
                command: "ping"
                payload: (ping-message #x2424242424242424))))
      (lambda (envelope)
        (set! writes (append writes (list envelope))))
      (lambda () #t)
      2
      8)
    writes))

(define (one-envelope-reader envelopes)
  (let ((remaining envelopes))
    (lambda ()
      (when (null? remaining)
        (error "one-envelope-reader: no envelopes left"))
      (let ((envelope (car remaining)))
        (set! remaining (cdr remaining))
        envelope))))

(define (remote-version-envelope chain)
  (let ((addr (network-address services: 1 ip: %ipv6-loopback port: 18444)))
    (p2p-envelope
      magic: (chain-config-magic* chain)
      command: "version"
      payload: (version-message-serialize
                 (version-message
                   version: 70015
                   services: 1
                   timestamp: 123456789
                   addr-recv: addr
                   addr-from: addr
                   nonce: 1
                   user-agent: "/peer:0.1.0/"
                   start-height: 0
                   relay?: #t)))))

(define (empty-sync-envelopes chain)
  (list (remote-version-envelope chain)
        (p2p-envelope magic: (chain-config-magic* chain)
                      command: "verack"
                      payload: (verack-message))
        (p2p-envelope magic: (chain-config-magic* chain)
                      command: "headers"
                      payload: (headers-message-serialize '()))))

(define (empty-sync-transport chain close-proc)
  (list (one-envelope-reader (empty-sync-envelopes chain))
        (lambda (envelope) #t)
        close-proc))

(define (find-peer-by-address peers address)
  (cond ((null? peers) #f)
        ((string=? (node-peer-address* (car peers)) address) (car peers))
        (else (find-peer-by-address (cdr peers) address))))

(define (find-mempool-entry-by-txid entries txid)
  (cond ((null? entries) #f)
        ((string=? (node-mempool-entry-txid* (car entries)) txid)
         (car entries))
        (else
         (find-mempool-entry-by-txid (cdr entries) txid))))

(test-group "chain configs"
  (test "exports header locator"
    (assert-true (procedure? node-header-locator*)))

  (test "exports header ingest"
    (assert-true (procedure? node-ingest-headers*)))

  (test "exports peer add"
    (assert-true (procedure? node-add-peer*)))

  (test "exports live probe entry point"
    (assert-true (procedure? run-probe*)))

  (test "exports header-sync entry point"
    (assert-true (procedure? run-header-sync*)))

  (test "exports inbound server entry points"
    (assert-true (procedure? node-serve-inbound-transport*))
    (assert-true (procedure? node-serve-inbound-socket*))
    (assert-true (procedure? run-listen*)))

  (test "looks up builtin chains"
    (assert-equal "bitcoin-mainnet"
                  (chain-config-name*
                    (chain-config-by-name* "mainnet")))
    (assert-equal "bitcoin-testnet"
                  (chain-config-name*
                    (chain-config-by-name* "testnet")))
    (assert-equal "bitcoin-testnet4"
                  (chain-config-name*
                    (chain-config-by-name* "testnet4")))
    (assert-equal "bitcoin-signet"
                  (chain-config-name*
                    (chain-config-by-name* "signet")))
    (assert-equal "bitcoin-regtest"
                  (chain-config-name*
                    (chain-config-by-name* "regtest")))
    (assert-equal 18444
                  (chain-config-default-port* bitcoin-regtest-chain*)))

  (test "keeps bitcoin bootstrap and mining defaults"
    (assert-true (> (length (chain-config-seed-peers*
                              bitcoin-mainnet-chain*))
                    0))
    (assert-equal '()
                  (chain-config-seed-peers* bitcoin-regtest-chain*))
    (assert-equal '()
                  (chain-config-mining-metadata*
                    bitcoin-mainnet-chain*)))

  (test "keeps testnet3 testnet4 and signet chain configs isolated"
    (assert-equal 18333
                  (chain-config-default-port* bitcoin-testnet-chain*))
    (assert-equal 48333
                  (chain-config-default-port* bitcoin-testnet4-chain*))
    (assert-equal 38333
                  (chain-config-default-port* bitcoin-signet-chain*))
    (assert-equal bitcoin-testnet-magic
                  (chain-config-magic* bitcoin-testnet-chain*))
    (assert-equal bitcoin-testnet4-magic
                  (chain-config-magic* bitcoin-testnet4-chain*))
    (assert-equal bitcoin-signet-magic
                  (chain-config-magic* bitcoin-signet-chain*))
    (assert-false
      (equal? (block-header-hash
                (chain-config-genesis-header* bitcoin-testnet-chain*))
              (block-header-hash
                (chain-config-genesis-header* bitcoin-testnet4-chain*))))
    (assert-false
      (equal? (block-header-hash
                (chain-config-genesis-header* bitcoin-testnet-chain*))
              (block-header-hash
                (chain-config-genesis-header* bitcoin-signet-chain*))))
    (assert-equal 1
                  (consensus-params-bip34-height
                    (chain-config-consensus-params* bitcoin-testnet4-chain*)))
    (assert-equal 1
                  (consensus-params-segwit-height
                    (chain-config-consensus-params* bitcoin-testnet4-chain*)))
    (assert-true (> (length (chain-config-seed-peers*
                              bitcoin-testnet4-chain*))
                    0))
    (assert-equal #x1e0377ae
                  (consensus-params-pow-limit-bits
                    (chain-config-consensus-params* bitcoin-signet-chain*)))
    (assert-equal 4032
                  (consensus-params-taproot-height
                    (chain-config-consensus-params* bitcoin-signet-chain*)))
    (assert-true (> (length (chain-config-seed-peers*
                              bitcoin-signet-chain*))
                    0))
    (assert-true (> (length (chain-config-extension*
                              bitcoin-signet-chain*
                              'signet
                              '()))
                    0))
    (assert-equal '((profile . structural)
                    (standard-script-checks . deferred))
                  (chain-config-extension*
                    bitcoin-signet-chain*
                    'validation
                    '()))
    (assert-equal '()
                  (chain-config-extension*
                    bitcoin-mainnet-chain*
                    'validation
                    '()))
    (assert-equal '()
                  (chain-config-extension*
                    bitcoin-testnet-chain*
                    'validation
                    '())))

  (test "looks up sigilcoin placeholder chain"
    (let ((chain (chain-config-by-name* "sigilcoin")))
      (assert-equal "sigilcoin"
                    (chain-config-name* chain))
      (assert-equal 19444
                    (chain-config-default-port* chain))
      (assert-equal '((rule . external)
                      (irc-channel . "#sigilcoin"))
                    (chain-config-mining-metadata* chain))))

  (test "declares sigilcoin header and block rules as externally owned"
    (let ((chain (chain-config-by-name* "sigilcoin")))
      (assert-equal '((rules . external) (block-rules . external))
                    (chain-config-extension* chain 'consensus '()))
      ;; The rules live in the SigilCoin project, so this repo cannot resolve
      ;; them and must not silently fall back to Bitcoin proof-of-work or to
      ;; Bitcoin's emission and coinbase bounds.
      (assert-error (chain-config-header-rules* chain))
      (assert-error (chain-config-block-rules* chain))))

  (test "resolves bitcoin block rules for chains without an override"
    (assert-true (eq? bitcoin-block-rules
                      (chain-config-block-rules* bitcoin-mainnet-chain*)))
    (assert-true (eq? bitcoin-block-rules
                      (chain-config-block-rules* bitcoin-regtest-chain*)))
    (assert-true (eq? bitcoin-block-rules
                      (chain-config-block-rules* (test-chain '() '()))))
    ;; A chain that only replaces header rules still gets Bitcoin bodies.
    (assert-true (eq? bitcoin-block-rules
                      (chain-config-block-rules*
                        (test-chain '()
                                    (rules-extensions
                                      %shortest-chain-rules))))))

  (test "resolves chain-supplied block rules"
    (let ((chain (test-chain
                   '()
                   (consensus-extensions
                     (list (cons 'block-rules %fake-block-rules))))))
      (assert-true (eq? %fake-block-rules
                        (chain-config-block-rules* chain)))
      (assert-error
        (chain-config-block-rules*
          (test-chain '()
                      (consensus-extensions
                        (list (cons 'block-rules 'not-a-rules-record))))))))

  (test "resolves bitcoin header rules for chains without an override"
    (assert-true (eq? bitcoin-header-rules
                      (chain-config-header-rules* bitcoin-mainnet-chain*)))
    (assert-true (eq? bitcoin-header-rules
                      (chain-config-header-rules* bitcoin-regtest-chain*)))
    (assert-true (eq? bitcoin-header-rules
                      (chain-config-header-rules* (test-chain '() '()))))
    (assert-equal '()
                  (chain-config-extension* bitcoin-mainnet-chain*
                                           'consensus
                                           '())))

  (test "resolves chain-supplied header rules"
    (let ((chain (test-chain '() (rules-extensions %shortest-chain-rules))))
      (assert-true (eq? %shortest-chain-rules
                        (chain-config-header-rules* chain)))
      (assert-error
        (chain-config-header-rules*
          (test-chain '() (rules-extensions 'not-a-rules-record))))))

  (test "keeps sigilcoin node runtime config chain-local"
    (let ((chain (chain-config-by-name* "sigilcoin")))
      (assert-equal 19444 (chain-config-default-port* chain))
      (assert-equal 70015 (chain-config-protocol-version chain))
      (assert-equal 1 (chain-config-services chain))
      (assert-equal "/sigilcoin-node:0.1.0/"
                    (chain-config-user-agent chain))
      (assert-true (> (length (chain-config-seed-peers* chain)) 0))
      (assert-equal 8333
                    (chain-config-default-port* bitcoin-mainnet-chain*))
      (assert-equal "/sigil-bitcoin-node:0.1.0/"
                    (chain-config-user-agent bitcoin-mainnet-chain*))))

  (test "attaches chain mining metadata without changing bitcoin"
    (let* ((metadata '((irc-channel . "#sigilcoin")
                       (claim-format . "sigilcoin-v1")))
           (chain (test-chain '() (list (cons 'mining metadata)))))
      (assert-equal '()
                    (chain-config-mining-metadata*
                      bitcoin-mainnet-chain*))
      (assert-equal metadata
                    (chain-config-mining-metadata* chain)))))

(test-group "node state"
  (test "initializes genesis header"
    (let* ((dir (test-data-dir))
           (n (node-open* bitcoin-regtest-chain* dir))
           (status (node-status* n)))
      (assert-equal "bitcoin-regtest"
                    (node-status-snapshot-chain* status))
      (assert-equal 0
                    (node-status-snapshot-best-height* status))
      (assert-equal 1296688602
                    (node-status-snapshot-best-header-time* status))
      (assert-true (>= (node-status-snapshot-header-sync-lag* status)
                       0))
      (assert-equal 1
                    (node-status-snapshot-header-count* status))
      (assert-true
        (same-header? (chain-config-genesis-header* bitcoin-regtest-chain*)
                      (node-best-header* n)))
      (node-close* n)))

  (test "exposes the renamed chain fields under their old names"
    (let* ((dir (test-data-dir))
           (n (node-open* bitcoin-regtest-chain* dir))
           (status (node-status* n)))
      ;; Neither field could stay named `chain`: `(sigil core)` exports a
      ;; `chain` threading macro, and a consumer that expands this library
      ;; before `define-struct` runs rewrites the field spec to its predicate.
      ;; The old accessor names survive as aliases.
      (assert-true (eq? bitcoin-regtest-chain* (node-config* n)))
      (assert-true (eq? (node-config* n) (node-chain* n)))
      (assert-equal "bitcoin-regtest"
                    (node-status-snapshot-chain-name* status))
      (assert-equal (node-status-snapshot-chain-name* status)
                    (node-status-snapshot-chain* status))
      (node-close* n)))

  (test "ingests linked valid headers"
    (let* ((dir (test-data-dir))
           (n (node-open* bitcoin-regtest-chain* dir))
           (h0 (chain-config-genesis-header* bitcoin-regtest-chain*))
           (h1 (mine-next (list h0) 1296688602))
           (h2 (mine-next (list h0 h1) 1296689202)))
      (assert-true
        (block-header-valid-after?
          bitcoin-regtest-consensus-params
          (list h0)
          h1))
      (let* ((inserted (node-ingest-headers* n (list h1 h2)))
             (status (node-status* n)))
        (assert-equal 2 inserted)
        (assert-equal 2
                      (node-status-snapshot-best-height* status))
        (assert-equal 3
                      (node-status-snapshot-header-count* status))
        (assert-true (same-header? h2 (node-best-header* n)))
        (node-close* n))))

  (test "keeps bitcoin tip selection for a chain without a rules override"
    (let* ((dir (test-data-dir))
           (chain (test-chain '() '()))
           (n (node-open* chain dir))
           (h0 (chain-config-genesis-header* chain))
           (h1 (mine-next (list h0) 1296688602))
           (h2 (mine-next (list h0 h1) 1296689202)))
      (assert-equal 2 (node-ingest-headers* n (list h1 h2)))
      (assert-equal 2
                    (node-status-snapshot-best-height* (node-status* n)))
      (assert-true (same-header? h2 (node-best-header* n)))
      (node-close* n)))

  (test "uses the chain fork-choice rule for tip selection"
    (let* ((dir (test-data-dir))
           (chain (test-chain '() (rules-extensions %shortest-chain-rules)))
           (n (node-open* chain dir))
           (h0 (chain-config-genesis-header* chain))
           (h1 (mine-next (list h0) 1296688602))
           (h2 (mine-next (list h0 h1) 1296689202)))
      (assert-equal 2 (node-ingest-headers* n (list h1 h2)))
      (let ((status (node-status* n)))
        ;; All three headers are stored, but the inverted comparator ranks
        ;; genesis above the longer chain Bitcoin would pick.
        (assert-equal 3
                      (node-status-snapshot-header-count* status))
        (assert-equal 0
                      (node-status-snapshot-best-height* status))
        (assert-true (same-header? h0 (node-best-header* n))))
      (node-close* n)))

  (test "ranks by a body-derived key that settles when the block validates"
    (let* ((dir (test-data-dir))
           (chain (test-chain '() (rules-extensions %body-ranked-rules)))
           (n (node-open* chain dir))
           (h0 (chain-config-genesis-header* chain))
           (long-block (make-keyed-block (list h0) 1 1296688602 40))
           (long-header (block-header-field long-block))
           (short-block (make-keyed-block (list h0) 1 1296689202 4))
           (short-header (block-header-field short-block)))
      ;; Only one block exists at height 1, so it takes the tip and its key
      ;; settles when its body validates.
      (assert-equal 1 (node-ingest-headers* n (list long-header)))
      (node-store-block* n long-block)
      (assert-equal 1 (node-validate-blocks* n))
      (assert-true (same-header? long-header (node-best-header* n)))
      (assert-equal 40 (node-status-snapshot-best-work* (node-status* n)))
      ;; A sibling arrives header-first. Its key is not in the header, so the
      ;; rank is the provisional one until its body is validated.
      (assert-equal 1 (node-ingest-headers* n (list short-header)))
      (assert-true (same-header? short-header (node-best-header* n)))
      (assert-equal 0 (node-status-snapshot-best-work* (node-status* n)))
      (node-store-block* n short-block)
      (assert-equal 1 (node-validate-blocks* n))
      ;; The settled key beats the incumbent's, so the shorter body keeps the
      ;; tip. Bitcoin's rule could not have expressed this: both headers carry
      ;; the same work.
      (assert-true (same-header? short-header (node-best-header* n)))
      (assert-equal 4 (node-status-snapshot-best-work* (node-status* n)))
      (assert-equal 1 (node-status-snapshot-best-height* (node-status* n)))
      (node-close* n)))

  (test "validates a non-bitcoin block profile end to end"
    (let* ((chain (test-chain
                    '()
                    (consensus-extensions
                      (list (cons 'rules %body-ranked-rules)
                            (cons 'block-rules %fake-block-rules)))))
           ;; The same chain minus the block-rules override, so the only
           ;; difference between the two nodes is the body seam.
           (control-chain (test-chain '()
                                      (rules-extensions %body-ranked-rules)))
           (n (node-open* chain (test-data-dir)))
           (control (node-open* control-chain (test-data-dir)))
           (h0 (chain-config-genesis-header* chain))
           (b (make-profile-block (list h0)
                                  1
                                  1296688602
                                  %fake-coinbase-script-len
                                  %fake-subsidy-value))
           (header (block-header-field b)))
      ;; Bitcoin's body rules reject this block twice over.
      (assert-true (> %fake-coinbase-script-len
                      (cdr bitcoin-coinbase-script-bounds)))
      (assert-true (> %fake-subsidy-value (block-subsidy 1)))
      (assert-equal 1 (node-ingest-headers* control (list header)))
      (node-store-block* control b)
      (assert-equal 0 (node-validate-blocks* control))
      (assert-equal 0 (node-status-snapshot-validated-block-count*
                        (node-status* control)))
      ;; The chain's own rules accept it, and the body-derived header work
      ;; settles through the existing mechanism once the body validates.
      (assert-equal 1 (node-ingest-headers* n (list header)))
      (assert-equal 0 (node-status-snapshot-best-work* (node-status* n)))
      (node-store-block* n b)
      (assert-equal 1 (node-validate-blocks* n))
      (assert-true (same-header? header (node-best-header* n)))
      (assert-equal 1 (node-status-snapshot-best-height* (node-status* n)))
      (assert-equal 1 (node-status-snapshot-validated-block-count*
                        (node-status* n)))
      (assert-equal %fake-coinbase-script-len
                    (node-status-snapshot-best-work* (node-status* n)))
      (node-close* n)
      (node-close* control)))

  (test "applies the chain's own subsidy ceiling when validating bodies"
    (let* ((chain (test-chain
                    '()
                    (consensus-extensions
                      (list (cons 'block-rules %fake-block-rules)))))
           (n (node-open* chain (test-data-dir)))
           (h0 (chain-config-genesis-header* chain))
           (b (make-profile-block (list h0)
                                  1
                                  1296688602
                                  %fake-coinbase-script-len
                                  (+ 1 %fake-subsidy-value)))
           (header (block-header-field b)))
      ;; Replacing the emission schedule is not a bypass: one satoshi over
      ;; the chain's own subsidy still fails.
      (assert-equal 1 (node-ingest-headers* n (list header)))
      (node-store-block* n b)
      (assert-equal 0 (node-validate-blocks* n))
      (assert-equal 0 (node-status-snapshot-validated-block-count*
                        (node-status* n)))
      (node-close* n)))

  (test "refuses to replace a tip height a later block already extends"
    (let* ((chain (test-chain '() (rules-extensions %body-ranked-rules)))
           (unguarded-chain (test-chain
                              '()
                              (rules-extensions
                                %unguarded-body-ranked-rules)))
           (h0 (chain-config-genesis-header* chain))
           (long-block (make-keyed-block (list h0) 1 1296688602 40))
           (long-header (block-header-field long-block))
           (child-block (make-keyed-block (list h0 long-header)
                                          2
                                          1296689202
                                          40))
           (child-header (block-header-field child-block))
           ;; A strictly better sibling of the settled height, arriving late.
           (short-block (make-keyed-block (list h0) 1 1296689802 4))
           (short-header (block-header-field short-block))
           (n (node-open* chain (test-data-dir)))
           (unguarded (node-open* unguarded-chain (test-data-dir))))
      (assert-equal 2 (node-ingest-headers* n (list long-header child-header)))
      (store-blocks n (list long-block child-block))
      (assert-equal 2 (node-validate-blocks* n))
      (assert-true (same-header? child-header (node-best-header* n)))
      ;; Height 1 is extended by the height 2 block, so the better sibling is
      ;; stored but must not become the tip.
      (assert-equal 1 (node-ingest-headers* n (list short-header)))
      (node-store-block* n short-block)
      (assert-equal 0 (node-validate-blocks* n))
      (assert-true (same-header? child-header (node-best-header* n)))
      (assert-equal 2 (node-status-snapshot-best-height* (node-status* n)))
      (assert-equal 4 (node-status-snapshot-header-count* (node-status* n)))
      ;; Without the settled-height guard the same key does take the tip, so
      ;; it is the candidate's extension state that refuses the reorg.
      (assert-equal 2 (node-ingest-headers* unguarded
                                            (list long-header child-header)))
      (store-blocks unguarded (list long-block child-block))
      (assert-equal 2 (node-validate-blocks* unguarded))
      (assert-true (same-header? child-header (node-best-header* unguarded)))
      (assert-equal 1 (node-ingest-headers* unguarded (list short-header)))
      (assert-true (same-header? short-header (node-best-header* unguarded)))
      (node-close* n)
      (node-close* unguarded)))

  (test "refuses to roll the active chain back onto a header with no body"
    ;; A header is only a promise of a block. On a chain whose ranking key is
    ;; not proof-of-work, making that promise is free, so a peer can invent a
    ;; sibling of the tip that outranks the validated chain and back it with
    ;; nothing. Which chain to DOWNLOAD must still follow it — that is what
    ;; makes a genuinely better sibling fetchable — but which chain is ACTIVE
    ;; must not.
    (let* ((chain (test-chain '() (rules-extensions %body-ranked-rules)))
           (n (node-open* chain (test-data-dir)))
           (h0 (chain-config-genesis-header* chain))
           (b1 (make-keyed-block (list h0) 1 1296688602 40))
           (h1 (block-header-field b1))
           (b2 (make-keyed-block (list h0 h1) 2 1296689202 40))
           (h2 (block-header-field b2))
           ;; A sibling of the tip height with a better key. Its body is built
           ;; here only so a later step can store it; the node is never given
           ;; it in this first phase.
           (ghost (make-keyed-block (list h0 h1) 2 1296689802 4))
           (ghost-header (block-header-field ghost)))
      (assert-equal 2 (node-ingest-headers* n (list h1 h2)))
      (store-blocks n (list b1 b2))
      (assert-equal 2 (node-validate-blocks* n))
      (assert-equal 2 (node-status-snapshot-validated-block-count*
                        (node-status* n)))
      (assert-equal 2 (node-status-snapshot-best-block-height*
                        (node-status* n)))
      ;; The bodyless header does take the best-header slot, and must.
      (assert-equal 1 (node-ingest-headers* n (list ghost-header)))
      (assert-true (same-header? ghost-header (node-best-header* n)))
      ;; That is all it takes. Nothing validated is discarded for it.
      (assert-equal 0 (node-validate-blocks* n))
      (assert-equal 2 (node-status-snapshot-validated-block-count*
                        (node-status* n)))
      (assert-equal 2 (node-status-snapshot-best-block-height*
                        (node-status* n)))
      (assert-equal (hex-encode (block-header-hash h2))
                    (node-status-snapshot-best-block-hash* (node-status* n)))
      ;; Reopening rebuilds the active-chain metadata, which must not be a
      ;; second route to the same rollback.
      (assert-equal 0 (node-validate-blocks* n))
      (assert-equal 2 (node-status-snapshot-validated-block-count*
                        (node-status* n)))
      ;; The body is what earns the reorganisation, and it still earns it:
      ;; storing it moves the active chain onto the better sibling.
      (node-store-block* n ghost)
      (assert-equal 1 (node-validate-blocks* n))
      (assert-true (same-header? ghost-header (node-best-header* n)))
      (assert-equal (hex-encode (block-header-hash ghost-header))
                    (node-status-snapshot-best-block-hash* (node-status* n)))
      (assert-equal 2 (node-status-snapshot-validated-block-count*
                        (node-status* n)))
      (node-close* n)))

  (test "gives up on a best header whose body never arrives"
    ;; Refusing the rollback keeps state safe but not live: while the
    ;; unbacked header holds the best-header slot, block download follows it
    ;; and never asks for the chain that can actually be validated. The
    ;; header's tenure in that slot is therefore bounded by how many times
    ;; its body has been asked for.
    (let* ((chain (test-chain '() (rules-extensions %body-ranked-rules)))
           (n (node-open* chain (test-data-dir)))
           (h0 (chain-config-genesis-header* chain))
           (b1 (make-keyed-block (list h0) 1 1296688602 40))
           (h1 (block-header-field b1))
           (b2 (make-keyed-block (list h0 h1) 2 1296689202 40))
           (h2 (block-header-field b2))
           (ghost (make-keyed-block (list h0 h1) 2 1296689802 4))
           (ghost-header (block-header-field ghost)))
      (assert-equal 2 (node-ingest-headers* n (list h1 h2)))
      (store-blocks n (list b1 b2))
      (assert-equal 2 (node-validate-blocks* n))
      (assert-equal 1 (node-ingest-headers* n (list ghost-header)))
      (assert-true (same-header? ghost-header (node-best-header* n)))
      ;; One silent peer is not a verdict: the tenure is bounded, not instant.
      (request-blocks-from-silent-peer n)
      (assert-true (same-header? ghost-header (node-best-header* n)))
      (let loop ((attempts 1))
        (cond ((not (same-header? ghost-header (node-best-header* n)))
               (assert-true (> attempts 1)))
              ((> attempts 32)
               (error "unbacked header never released the best-header slot"))
              (else
               (request-blocks-from-silent-peer n)
               (loop (+ attempts 1)))))
      ;; The slot goes back to the chain the node can validate.
      (assert-true (same-header? h2 (node-best-header* n)))
      (assert-equal 2 (node-status-snapshot-best-height* (node-status* n)))
      ;; Deprioritised, never condemned. Marking the branch invalid would let
      ;; anyone retire a competitor by withholding its blocks, so the header
      ;; stays stored and stays valid.
      (assert-equal 4 (node-status-snapshot-header-count* (node-status* n)))
      ;; And a body that turns up late still wins: the give-up is read from
      ;; the blocks table on every ranking pass, so storing the block ends it.
      (node-store-block* n ghost)
      (assert-true (same-header? ghost-header (node-best-header* n)))
      (assert-equal 1 (node-validate-blocks* n))
      (assert-equal (hex-encode (block-header-hash ghost-header))
                    (node-status-snapshot-best-block-hash* (node-status* n)))
      (node-close* n)))

  (test "uses the chain header acceptance rule when ingesting"
    (let* ((dir (test-data-dir))
           (default-chain (test-chain '() '()))
           (custom-chain (test-chain '()
                                     (rules-extensions
                                       %accept-any-header-rules)))
           (h0 (chain-config-genesis-header* default-chain))
           (bad (unmined-next h0 1296688602))
           (default-node (node-open* default-chain (test-data-dir)))
           (custom-node (node-open* custom-chain dir)))
      (assert-false (block-header-valid-after?
                      bitcoin-regtest-consensus-params
                      (list h0)
                      bad))
      (assert-error (node-ingest-headers* default-node (list bad)))
      (assert-equal 0
                    (node-status-snapshot-best-height*
                      (node-status* default-node)))
      (assert-equal 1 (node-ingest-headers* custom-node (list bad)))
      (assert-equal 1
                    (node-status-snapshot-best-height*
                      (node-status* custom-node)))
      (assert-true (same-header? bad (node-best-header* custom-node)))
      (node-close* default-node)
      (node-close* custom-node)))

