  (test "serves stored block bodies for inbound getdata"
    (let* ((dir (test-data-dir))
           (n (node-open* bitcoin-regtest-chain* dir))
           (h0 (chain-config-genesis-header* bitcoin-regtest-chain*))
           (b1 (make-coinbase-block (list h0) 1 1296688602))
           (h1 (block-header-field b1))
           (b2 (make-coinbase-block (list h0 h1) 2 1296689202))
           (h2 (block-header-field b2))
           (writes '()))
      (node-ingest-headers* n (list h1 h2))
      (node-store-block* n b1)
      (node-store-block* n b2)
      (node-serve-inbound-transport*
        n
        "198.51.100.20"
        18444
        (one-envelope-reader
          (list (remote-version-envelope bitcoin-regtest-chain*)
                (p2p-envelope
                  magic: (chain-config-magic* bitcoin-regtest-chain*)
                  command: "verack"
                  payload: (verack-message))
                (p2p-envelope
                  magic: (chain-config-magic* bitcoin-regtest-chain*)
                  command: "getdata"
                  payload: (getdata-message
                             (list (inventory-vector
                                     type: inv-block
                                     hash: (block-header-hash h1))
                                   (inventory-vector
                                     type: inv-witness-block
                                     hash: (block-header-hash h2)))))
                (p2p-envelope
                  magic: (chain-config-magic* bitcoin-regtest-chain*)
                  command: "ping"
                  payload: (ping-message #x2020202020202020))))
        (lambda (envelope)
          (set! writes (append writes (list envelope))))
        (lambda () #t)
        2
        8)
      (let ((bodies (filter
                      (lambda (envelope)
                        (string=? "block" (p2p-envelope-command envelope)))
                      writes)))
        (assert-equal 2 (length bodies))
        ;; The peer gets back exactly the bytes this node stored.
        (assert-equal (block-message b1)
                      (p2p-envelope-payload (car bodies)))
        (assert-equal (block-message b2)
                      (p2p-envelope-payload (cadr bodies)))
        (assert-true (same-header? h1
                                   (block-header-field
                                     (block-message-parse
                                       (p2p-envelope-payload (car bodies)))))))
      (assert-equal 0
                    (length (filter
                              (lambda (envelope)
                                (string=? "notfound"
                                          (p2p-envelope-command envelope)))
                              writes)))
      (node-close* n)))

  (test "answers inbound getdata with notfound for bodies it will not serve"
    (let* ((dir (test-data-dir))
           (n (node-open* bitcoin-regtest-chain* dir))
           (h0 (chain-config-genesis-header* bitcoin-regtest-chain*))
           ;; A header whose body was never downloaded.
           (pending-b1 (make-coinbase-block (list h0) 1 1296688602))
           (pending-h1 (block-header-field pending-b1))
           ;; A body this node holds but has condemned.
           (bad-b1 (mine-block (list h0)
                               (list (make-coinbase-tx
                                       1
                                       (+ 1 (block-subsidy 1))))
                               1296698602))
           (bad-h1 (block-header-field bad-b1))
           (unknown-hash (make-bytevector 32 #x7a))
           (tx (make-coinbase-tx 9 5000000000))
           (writes '()))
      ;; Condemn the bad body first: validation only walks the best chain, so
      ;; the header without a body is added afterwards.
      (node-ingest-headers* n (list bad-h1))
      (node-store-block* n bad-b1)
      (assert-equal 0 (node-validate-blocks* n))
      (node-ingest-headers* n (list pending-h1))
      (let ((bad-row (sqlite-query-row
                       (node-db* n)
                       "SELECT status, block_hex FROM blocks WHERE hash = ?"
                       (hex-encode (block-header-hash bad-h1)))))
        (assert-equal "invalid" (test-row-ref bad-row "status"))
        ;; The node still holds those bytes; it refuses them on status.
        (assert-true (string? (test-row-ref bad-row "block_hex"))))
      (node-serve-inbound-transport*
        n
        "198.51.100.21"
        18444
        (one-envelope-reader
          (list (remote-version-envelope bitcoin-regtest-chain*)
                (p2p-envelope
                  magic: (chain-config-magic* bitcoin-regtest-chain*)
                  command: "verack"
                  payload: (verack-message))
                (p2p-envelope
                  magic: (chain-config-magic* bitcoin-regtest-chain*)
                  command: "getdata"
                  payload: (getdata-message
                             (list (inventory-vector
                                     type: inv-block
                                     hash: unknown-hash)
                                   (inventory-vector
                                     type: inv-block
                                     hash: (block-header-hash pending-h1))
                                   (inventory-vector
                                     type: inv-block
                                     hash: (block-header-hash bad-h1))
                                   ;; An inventory type this node never serves.
                                   (inventory-vector
                                     type: inv-tx
                                     hash: (transaction-txid tx)))))
                (p2p-envelope
                  magic: (chain-config-magic* bitcoin-regtest-chain*)
                  command: "ping"
                  payload: (ping-message #x2121212121212121))))
        (lambda (envelope)
          (set! writes (append writes (list envelope))))
        (lambda () #t)
        2
        8)
      (assert-equal 0
                    (length (filter
                              (lambda (envelope)
                                (string=? "block"
                                          (p2p-envelope-command envelope)))
                              writes)))
      (let* ((response (car (filter
                              (lambda (envelope)
                                (string=? "notfound"
                                          (p2p-envelope-command envelope)))
                              writes)))
             (items (inventory-message-parse
                      (p2p-envelope-payload response))))
        (assert-equal 4 (length items))
        (assert-true (inventory-hash-member? unknown-hash items))
        (assert-true (inventory-hash-member? (block-header-hash pending-h1)
                                             items))
        (assert-true (inventory-hash-member? (block-header-hash bad-h1) items))
        (assert-true (inventory-hash-member? (transaction-txid tx) items)))
      (node-close* n)))

  (test "caps the body bytes one inbound getdata can buy"
    (let* ((dir (test-data-dir))
           (n (node-open* bitcoin-regtest-chain* dir))
           (h0 (chain-config-genesis-header* bitcoin-regtest-chain*))
           ;; Three siblings of about 1.5 MiB each: two fit the 4 MiB response
           ;; budget and the third does not.
           (big1 (make-keyed-block (list h0) 1 1296688602 1500000))
           (big2 (make-keyed-block (list h0) 1 1296689202 1500000))
           (big3 (make-keyed-block (list h0) 1 1296689802 1500000))
           (blocks (list big1 big2 big3))
           (block-items (map (lambda (b)
                               (inventory-vector
                                 type: inv-block
                                 hash: (block-header-hash
                                         (block-header-field b))))
                             blocks))
           ;; 128 items: the three siblings, then 125 more copies of the
           ;; over-budget third.
           (over-budget-payload
             (getdata-message
               (append block-items
                       (repeat-item (caddr block-items) 125))))
           ;; The same request whose tail is hashes this node has never seen.
           ;; Neither tail is servable, so the over-budget one must not cost
           ;; more: bodies that will not be sent are never read.
           (unknown-payload
             (getdata-message
               (append (list (car block-items) (cadr block-items))
                       (unknown-block-items 126)))))
      (node-ingest-headers* n (map block-header-field blocks))
      (store-blocks n blocks)
      (let* ((unknown-start (current-jiffy))
             (unknown-writes (getdata-response-writes n
                                                     "198.51.100.22"
                                                     unknown-payload))
             (unknown-cost (- (current-jiffy) unknown-start))
             (over-budget-start (current-jiffy))
             (over-budget-writes (getdata-response-writes n
                                                          "198.51.100.25"
                                                          over-budget-payload))
             (over-budget-cost (- (current-jiffy) over-budget-start)))
        (assert-equal 2 (length (writes-with "block" over-budget-writes)))
        (let ((items (notfound-items over-budget-writes)))
          ;; One `notfound` item, not 126: the duplicates collapse and the
          ;; loop stops at the first body that overruns the budget.
          (assert-equal 1 (length items))
          (assert-equal (block-header-hash (block-header-field big3))
                        (inventory-vector-hash (car items))))
        (assert-equal 2 (length (writes-with "block" unknown-writes)))
        (assert-equal 126 (length (notfound-items unknown-writes)))
        ;; Work done, not just output: 125 refused 1.5 MiB bodies cost no more
        ;; than 126 hashes that never touch a body at all.
        (assert-true (<= over-budget-cost
                         (* 2 (if (> unknown-cost 1) unknown-cost 1)))))
      (node-close* n)))

  (test "answers an oversized inbound getdata instead of dropping the peer"
    ;; `run-listen` guards its whole accept loop, so a raise here would take
    ;; the listener down with the peer. A count above the per-request cap is
    ;; legal on the wire — this node's own peers batch requests — so the
    ;; prefix is served and the rest of the parsed batch is refused.
    (let* ((dir (test-data-dir))
           (n (node-open* bitcoin-regtest-chain* dir))
           (h0 (chain-config-genesis-header* bitcoin-regtest-chain*))
           (b1 (make-coinbase-block (list h0) 1 1296688602))
           (h1 (block-header-field b1)))
      (node-ingest-headers* n (list h1))
      (node-store-block* n b1)
      (let ((writes (getdata-response-writes
                      n
                      "198.51.100.23"
                      (getdata-message
                        (cons (inventory-vector type: inv-block
                                                hash: (block-header-hash h1))
                              (unknown-block-items 200))))))
        (assert-equal 1 (length (writes-with "block" writes)))
        ;; 128 items are answered: one body, 127 refusals. The tail past the
        ;; cap is left for the peer to ask again for.
        (assert-equal 127 (length (notfound-items writes)))
        ;; The connection survives: the ping after the getdata is still
        ;; answered, and the node finishes the peer cleanly.
        (assert-equal 1 (length (writes-with "pong" writes)))
        (assert-equal "idle"
                      (node-status-snapshot-sync-stage* (node-status* n))))
      (node-close* n)))

  (test "serves a duplicated inbound getdata item once"
    (let* ((dir (test-data-dir))
           (n (node-open* bitcoin-regtest-chain* dir))
           (h0 (chain-config-genesis-header* bitcoin-regtest-chain*))
           (b1 (make-coinbase-block (list h0) 1 1296688602))
           (h1 (block-header-field b1)))
      (node-ingest-headers* n (list h1))
      (node-store-block* n b1)
      (let ((writes (getdata-response-writes
                      n
                      "198.51.100.26"
                      (getdata-message
                        (repeat-item (inventory-vector
                                       type: inv-block
                                       hash: (block-header-hash h1))
                                     128)))))
        (assert-equal 1 (length (writes-with "block" writes)))
        (assert-equal 0 (length (writes-with "notfound" writes))))
      (node-close* n)))

  (test "bounds the work a huge inbound getdata item count can buy"
    (let* ((dir (test-data-dir))
           (n (node-open* bitcoin-regtest-chain* dir))
           (h0 (chain-config-genesis-header* bitcoin-regtest-chain*))
           (b1 (make-coinbase-block (list h0) 1 1296688602))
           (h1 (block-header-field b1))
           (item (inventory-vector type: inv-block
                                   hash: (block-header-hash h1)))
           ;; A wire-legal 1.8 MB payload naming 50000 items, and the same
           ;; request cut to the per-request cap.
           (huge-payload (repeated-getdata-payload item 50000))
           (capped-payload (repeated-getdata-payload item 128)))
      (node-ingest-headers* n (list h1))
      (node-store-block* n b1)
      (let* ((capped-start (current-jiffy))
             (capped-writes (getdata-response-writes n
                                                    "198.51.100.27"
                                                    capped-payload))
             (capped-cost (- (current-jiffy) capped-start))
             (huge-start (current-jiffy))
             (huge-writes (getdata-response-writes n
                                                   "198.51.100.28"
                                                   huge-payload))
             (huge-cost (- (current-jiffy) huge-start)))
        (assert-equal 1 (length (writes-with "block" capped-writes)))
        (assert-equal 1 (length (writes-with "block" huge-writes)))
        (assert-equal 0 (length (writes-with "notfound" huge-writes)))
        ;; Only the first 128 vectors are ever parsed, so 50000 named items
        ;; cost about what 128 do.
        (assert-true (<= huge-cost
                         (* 2 (if (> capped-cost 1) capped-cost 1)))))
      (node-close* n)))

  (test "rejects a malformed inbound getdata"
    (define (serve-getdata address payload)
      (let* ((dir (test-data-dir))
             (n (node-open* bitcoin-regtest-chain* dir))
             (h0 (chain-config-genesis-header* bitcoin-regtest-chain*))
             (b1 (make-coinbase-block (list h0) 1 1296688602)))
        (node-ingest-headers* n (list (block-header-field b1)))
        (node-store-block* n b1)
        (guard (err (else (node-close* n) (raise err)))
          (node-serve-inbound-transport*
            n
            address
            18444
            (one-envelope-reader
              (list (remote-version-envelope bitcoin-regtest-chain*)
                    (p2p-envelope
                      magic: (chain-config-magic* bitcoin-regtest-chain*)
                      command: "verack"
                      payload: (verack-message))
                    (p2p-envelope
                      magic: (chain-config-magic* bitcoin-regtest-chain*)
                      command: "getdata"
                      payload: payload)
                    (p2p-envelope
                      magic: (chain-config-magic* bitcoin-regtest-chain*)
                      command: "ping"
                      payload: (ping-message #x2323232323232323))))
            (lambda (envelope) #t)
            (lambda () #t)
            2
            8))
        (node-close* n)))
    (let ((one-item (getdata-message
                      (list (inventory-vector
                              type: inv-block
                              hash: (make-bytevector 32 #x11))))))
      ;; A count of one with no inventory vector behind it.
      (assert-error (serve-getdata "198.51.100.24" #u8(#x01)))
      ;; One vector too few for the declared count.
      (assert-error
        (serve-getdata "198.51.100.29"
                       (bytevector-append #u8(#x02)
                                          (bytevector-copy one-item 1))))
      ;; Trailing bytes past the declared count.
      (assert-error
        (serve-getdata "198.51.100.30"
                       (bytevector-append one-item #u8(#x00))))
      ;; A count encoded wider than it needs to be.
      (assert-error
        (serve-getdata "198.51.100.31"
                       (bytevector-append #u8(#xfd #x01 #x00)
                                          (bytevector-copy one-item 1))))
      ;; A count past what the wire format allows at all.
      (assert-error
        (serve-getdata "198.51.100.32"
                       (bytevector-append (compact-size-encode 50001)
                                          (bytevector-copy one-item 1))))))

  (test "recovers from mid-download peer disconnect"
    (let* ((dir (test-data-dir))
           (n (node-open* bitcoin-regtest-chain* dir))
           (h0 (chain-config-genesis-header* bitcoin-regtest-chain*))
           (b1 (make-coinbase-block (list h0) 1 1296688602))
           (h1 (block-header-field b1))
           (first-writes 0)
           (second-writes 0))
      (node-ingest-headers* n (list h1))
      (node-add-peer* n "disconnect.example" 18444)
      (node-add-peer* n "recover.example" 18444)
      (define (connect-peer peer)
        (if (string=? "disconnect.example"
                      (node-peer-address* peer))
            (let ((remaining (empty-sync-envelopes
                               bitcoin-regtest-chain*)))
              (list
                (lambda ()
                  (if (null? remaining)
                      (error "simulated mid-download disconnect")
                      (let ((envelope (car remaining)))
                        (set! remaining (cdr remaining))
                        envelope)))
                (lambda (envelope)
                  (set! first-writes (+ first-writes 1)))
                (lambda () #t)))
            (list
              (one-envelope-reader
                (append
                  (empty-sync-envelopes bitcoin-regtest-chain*)
                  (list (p2p-envelope
                          magic: (chain-config-magic*
                                   bitcoin-regtest-chain*)
                          command: "block"
                          payload: (block-message b1)))))
              (lambda (envelope)
                (set! second-writes (+ second-writes 1)))
              (lambda () #t))))
      (let ((status (node-sync-with-peers* n connect-peer 2 0 8 4)))
        (assert-equal 1
                      (node-status-snapshot-block-count* status))
        (assert-equal 0
                      (node-status-snapshot-requested-block-count*
                        status))
        (assert-equal 0
                      (node-status-snapshot-failed-block-count*
                        status)))
      (assert-true (> first-writes 0))
      (assert-true (> second-writes 0))
      (let* ((peers (node-peers* n))
             (bad (find-peer-by-address peers "disconnect.example"))
             (good (find-peer-by-address peers "recover.example")))
        (assert-equal 1 (node-peer-failures* bad))
        (assert-equal
          "block download failed: simulated mid-download disconnect"
          (node-peer-last-error* bad))
        (assert-equal "success" (node-peer-last-result* good)))
      (node-close* n)))

  (test "validates progress yielded after block download disconnect"
    (let* ((dir (test-data-dir))
           (n (node-open* bitcoin-regtest-chain* dir))
           (h0 (chain-config-genesis-header* bitcoin-regtest-chain*))
           (b1 (make-coinbase-block (list h0) 1 1296688602))
           (h1 (block-header-field b1))
           (b2 (make-coinbase-block (list h0 h1) 2 1296689202))
           (h2 (block-header-field b2))
           (writes 0))
      (node-ingest-headers* n (list h1 h2))
      (node-add-peer* n "yield-disconnect.example" 18444)
      (define (connect-peer peer)
        (let ((remaining
                (append
                  (empty-sync-envelopes bitcoin-regtest-chain*)
                  (list (p2p-envelope
                          magic: (chain-config-magic*
                                   bitcoin-regtest-chain*)
                          command: "block"
                          payload: (block-message b1))))))
          (list
            (lambda ()
              (if (null? remaining)
                  (error "simulated post-progress disconnect")
                  (let ((envelope (car remaining)))
                    (set! remaining (cdr remaining))
                    envelope)))
            (lambda (envelope)
              (set! writes (+ writes 1)))
            (lambda () #t))))
      (let ((status (node-fetch-blocks-with-peers*
                      n
                      connect-peer
                      1
                      0
                      8
                      2)))
        (assert-equal 1
                      (node-status-snapshot-block-count* status))
        (assert-equal 1
                      (node-status-snapshot-validated-block-count* status))
        (assert-equal 1
                      (node-status-snapshot-best-block-height* status)))
      (assert-true (> writes 0))
      (node-close* n)))

  (test "block fetch rotates when first peer has only fresh requests"
    (let* ((dir (test-data-dir))
           (n (node-open* bitcoin-regtest-chain* dir))
           (h0 (chain-config-genesis-header* bitcoin-regtest-chain*))
           (b1 (make-coinbase-block (list h0) 1 1296688602))
           (h1 (block-header-field b1))
           (attempted '())
           (first-writes 0)
           (second-writes 0))
      (node-ingest-headers* n (list h1))
      (node-add-peer* n "first.example" 18444)
      (node-add-peer* n "second.example" 18444)
      (node-download-blocks*
        n
        (lambda () (error "unexpected read"))
        (lambda (envelope) #t)
        0
        1)
      (sqlite-run
        (node-db* n)
        "UPDATE blocks SET requested_by = 'first.example:18444', requested_at = 9999999999 WHERE status = 'requested'")
      (define (connect-peer peer)
        (let ((address (node-peer-address* peer)))
          (set! attempted (append attempted (list address)))
          (if (string=? "second.example" address)
              (list
                (one-envelope-reader
                  (append
                    (empty-sync-envelopes bitcoin-regtest-chain*)
                    (list
                      (p2p-envelope
                        magic: (chain-config-magic* bitcoin-regtest-chain*)
                        command: "block"
                        payload: (block-message b1)))))
                (lambda (envelope)
                  (set! second-writes (+ second-writes 1)))
                (lambda () #t))
              (list
                (one-envelope-reader
                  (empty-sync-envelopes bitcoin-regtest-chain*))
                (lambda (envelope)
                  (set! first-writes (+ first-writes 1)))
                (lambda () #t)))))
      (let ((status (node-status* n)))
        (assert-equal 1
                      (node-status-snapshot-requested-block-count*
                        status))
        (assert-equal 0 (node-status-snapshot-block-count* status)))
      (set! attempted '())
      (let ((status
              (node-fetch-blocks-with-peers* n connect-peer 2 0 8 1)))
        (assert-equal 1 (node-status-snapshot-block-count* status))
        (assert-equal 0
                      (node-status-snapshot-requested-block-count*
                        status)))
      (assert-equal '("first.example" "second.example") attempted)
      (assert-true (> first-writes 0))
      (assert-true (> second-writes 0))
      (node-close* n)))

  (test "block fetch stales requested blocks after exhausted no-progress peers"
    (let* ((dir (test-data-dir))
           (n (node-open* bitcoin-regtest-chain* dir))
           (h0 (chain-config-genesis-header* bitcoin-regtest-chain*))
           (h1 (mine-next (list h0) 1296688602))
           (attempted '())
           (writes 0))
      (node-ingest-headers* n (list h1))
      (node-add-peer* n "stalled.example" 18444)
      (node-download-blocks*
        n
        (lambda () (error "unexpected read"))
        (lambda (envelope) #t)
        0
        1)
      (sqlite-run
        (node-db* n)
        "UPDATE blocks SET requested_by = 'stalled.example:18444', requested_at = 9999999999 WHERE status = 'requested'")
      (define (connect-peer peer)
        (set! attempted
              (append attempted (list (node-peer-address* peer))))
        (list
          (one-envelope-reader
            (empty-sync-envelopes bitcoin-regtest-chain*))
          (lambda (envelope)
            (set! writes (+ writes 1)))
          (lambda () #t)))
      (let ((status
              (node-fetch-blocks-with-peers* n connect-peer 1 0 8 1)))
        (assert-equal 1
                      (node-status-snapshot-requested-block-count*
                        status))
        (assert-equal 0 (node-status-snapshot-block-count* status)))
      (assert-equal '("stalled.example") attempted)
      (assert-true (> writes 0))
      (let ((row (sqlite-query-row
                   (node-db* n)
                   "SELECT requested_at, request_count FROM blocks WHERE status = 'requested'")))
        (assert-equal 1 (test-row-ref row "requested_at"))
        (assert-equal 1 (test-row-ref row "request_count")))
      (node-close* n)))

  (test "rolls validation forward onto a stronger fork"
    (let* ((dir (test-data-dir))
           (n (node-open* bitcoin-regtest-chain* dir))
           (h0 (chain-config-genesis-header* bitcoin-regtest-chain*))
           (old-blocks (make-coinbase-chain h0 2 1296688602))
           (new-blocks (make-coinbase-chain h0 3 1296698602)))
      (node-ingest-headers* n
                            (map block-header-field old-blocks))
      (for-each (lambda (b) (node-store-block* n b)) old-blocks)
      (assert-equal 2 (node-validate-blocks* n))
      (node-ingest-headers* n
                            (map block-header-field new-blocks))
      (for-each (lambda (b) (node-store-block* n b)) new-blocks)
      (assert-equal 3 (node-validate-blocks* n))
      (let ((status (node-status* n)))
        (assert-equal 3 (node-status-snapshot-best-height* status))
        (assert-equal 3 (node-status-snapshot-best-block-height* status))
        (assert-equal
          (hex-encode
            (block-header-hash (block-header-field (caddr new-blocks))))
          (node-status-snapshot-best-block-hash* status))
        (assert-equal 3
                      (node-status-snapshot-validated-block-count* status)))
      (node-close* n)))

  (test "downloads missing blocks with getdata"
    (let* ((dir (test-data-dir))
           (n (node-open* bitcoin-regtest-chain* dir))
           (h0 (chain-config-genesis-header* bitcoin-regtest-chain*))
           (b1 (make-coinbase-block (list h0) 1 1296688602))
           (h1 (block-header-field b1))
           (writes '()))
      (node-ingest-headers* n (list h1))
      (assert-equal
        1
        (node-download-blocks*
          n
          (one-envelope-reader
            (list (p2p-envelope magic: (chain-config-magic* bitcoin-regtest-chain*)
                                command: "block"
                                payload: (block-message b1))))
          (lambda (envelope)
            (set! writes (cons envelope writes)))
          4
          8))
      (assert-equal 1 (length writes))
      (let* ((request (car writes))
             (items (inventory-message-parse (p2p-envelope-payload request))))
        (assert-equal "getdata" (p2p-envelope-command request))
        (assert-equal 1 (length items))
        (assert-equal inv-block (inventory-vector-type (car items)))
        (assert-equal (block-header-hash h1)
                      (inventory-vector-hash (car items))))
      (assert-equal 1
                    (node-status-snapshot-block-count* (node-status* n)))
      (node-close* n)))

  (test "downloads missing blocks only from the best header chain"
    (let* ((dir (test-data-dir))
           (n (node-open* bitcoin-regtest-chain* dir))
           (h0 (chain-config-genesis-header* bitcoin-regtest-chain*))
           (stale-b1 (make-coinbase-block (list h0) 1 1296688602))
           (stale-h1 (block-header-field stale-b1))
           (best-b1 (make-coinbase-block (list h0) 1 1296698602))
           (best-h1 (block-header-field best-b1))
           (best-b2 (make-coinbase-block (list h0 best-h1) 2 1296699202))
           (best-h2 (block-header-field best-b2))
           (writes '()))
      (node-ingest-headers* n (list stale-h1 best-h1 best-h2))
      (let ((status (node-status* n)))
        (assert-equal 2 (node-status-snapshot-pending-block-count* status))
        (assert-equal 0 (node-status-snapshot-requested-block-count* status)))
      (assert-equal
        0
        (node-download-blocks*
          n
          (lambda () (error "unexpected read"))
          (lambda (envelope)
            (set! writes (cons envelope writes)))
          0
          8))
      (assert-equal 1 (length writes))
      (let ((items (inventory-message-parse
                     (p2p-envelope-payload (car writes)))))
        (assert-equal 2 (length items))
        (assert-true
          (inventory-hash-member? (block-header-hash best-h1) items))
        (assert-true
          (inventory-hash-member? (block-header-hash best-h2) items))
        (assert-false
          (inventory-hash-member? (block-header-hash stale-h1) items)))
      (let ((status (node-status* n)))
        (assert-equal 0 (node-status-snapshot-pending-block-count* status))
        (assert-equal 2 (node-status-snapshot-requested-block-count* status)))
      (node-close* n)))

  (test "stores out-of-batch known blocks without failing requested gaps"
    (let* ((dir (test-data-dir))
           (n (node-open* bitcoin-regtest-chain* dir))
