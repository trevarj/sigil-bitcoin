                18444
                (one-envelope-reader
                  (list (remote-version-envelope bitcoin-regtest-chain*)
                        (p2p-envelope
                          magic: (chain-config-magic* bitcoin-regtest-chain*)
                          command: "verack"
                          payload: (verack-message))
                        (p2p-envelope
                          magic: (chain-config-magic* bitcoin-regtest-chain*)
                          command: "getaddr"
                          payload: (getaddr-message))
                        (p2p-envelope
                          magic: (chain-config-magic* bitcoin-regtest-chain*)
                          command: "getheaders"
                          payload: (getheaders-message-serialize
                                     (getheaders-message
                                       version: 70015
                                       locator-hashes: (list
                                                         (block-header-hash h0))
                                       stop-hash: %zero32)))
                        (p2p-envelope
                          magic: (chain-config-magic* bitcoin-regtest-chain*)
                          command: "inv"
                          payload: (inv-message (list tx-item)))))
                (lambda (envelope)
                  (set! writes (append writes (list envelope))))
                (lambda ()
                  (set! closed (+ closed 1)))
                3
                8)))
        (assert-equal "idle" (node-status-snapshot-sync-stage* status))
        (assert-equal 1 closed))
      (let ((commands (map p2p-envelope-command writes)))
        (assert-true (member "version" commands))
        (assert-true (member "verack" commands))
        (assert-true (member "addrv2" commands))
        (assert-true (member "headers" commands))
        (assert-true (member "getdata" commands)))
      (let* ((addr-response
               (car (filter
                      (lambda (envelope)
                        (string=? "addrv2" (p2p-envelope-command envelope)))
                      writes)))
             (addresses (addrv2-message-parse
                          (p2p-envelope-payload addr-response))))
        (assert-true (>= (length addresses) 2))
        (let ((ipv6-addresses
                (filter
                  (lambda (address)
                    (= addrv2-network-ipv6
                       (p2p-address-network-id address)))
                  addresses)))
          (assert-equal 1 (length ipv6-addresses))
          (assert-equal #u8(#x20 #x01 #x0d #xb8
                            #x00 #x00 #x00 #x00
                            #x00 #x00 #x00 #x00
                            #x00 #x00 #x00 #x02)
                        (p2p-address-address (car ipv6-addresses)))))
      (let* ((header-response
               (car (filter
                      (lambda (envelope)
                        (string=? "headers" (p2p-envelope-command envelope)))
                      writes)))
             (headers (headers-message-parse
                        (p2p-envelope-payload header-response))))
        (assert-equal 2 (length headers))
        (assert-equal (block-header-hash h1)
                      (block-header-hash (car headers)))
        (assert-equal (block-header-hash h2)
                      (block-header-hash (cadr headers))))
      (let* ((getdata-response
               (car (filter
                      (lambda (envelope)
                        (string=? "getdata" (p2p-envelope-command envelope)))
                      writes)))
             (items (inventory-message-parse
                      (p2p-envelope-payload getdata-response))))
        (assert-equal 1 (length items))
        (assert-equal inv-tx (inventory-vector-type (car items))))
      (let* ((peer (find-peer-by-address (node-peers* n) "198.51.100.7"))
             (entry (car (node-mempool* n))))
        (assert-equal "inbound" (node-peer-source* peer))
        (assert-equal "success" (node-peer-last-result* peer))
        (assert-equal "requested" (node-mempool-entry-status* entry)))
      (node-close* n)))

  (test "inbound getheaders honors stop hash"
    (let* ((dir (test-data-dir))
