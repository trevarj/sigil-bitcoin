  (test "bounded peer sync yields progress after header timeout"
    (let* ((dir (test-data-dir))
           (n (node-open* bitcoin-regtest-chain* dir))
           (h0 (chain-config-genesis-header* bitcoin-regtest-chain*))
           (b1 (make-coinbase-block (list h0) 1 1296688602))
           (h1 (block-header-field b1))
           (full-batch (repeat-item h1 p2p-max-headers-per-message))
           (writes '()))
      (node-add-peer* n "progress.example" 18444)
      (let ((status
              (node-sync-with-peers*
                n
                (lambda (peer)
                  (let ((remaining
                          (list
                            (remote-version-envelope bitcoin-regtest-chain*)
                            (p2p-envelope magic: (chain-config-magic*
                                                   bitcoin-regtest-chain*)
                                          command: "verack"
                                          payload: (verack-message))
                            (p2p-envelope magic: (chain-config-magic*
                                                   bitcoin-regtest-chain*)
                                          command: "headers"
                                          payload: (headers-message-serialize
                                                     full-batch)))))
                    (list
                      (lambda ()
                        (if (null? remaining)
                            (error "simulated header timeout")
                            (let ((envelope (car remaining)))
                              (set! remaining (cdr remaining))
                              envelope)))
                      (lambda (envelope)
                        (set! writes (append writes (list envelope))))
                      (lambda () #t))))
                1
                0
                8
                0)))
        (assert-equal "idle" (node-status-snapshot-sync-stage* status))
        (assert-equal "" (node-status-snapshot-sync-last-error* status))
        (assert-equal 2 (node-status-snapshot-header-count* status))
        (assert-equal 0 (node-status-snapshot-block-count* status)))
      (let ((peer (find-peer-by-address (node-peers* n) "progress.example")))
        (assert-equal "success" (node-peer-last-result* peer))
        (assert-equal "" (node-peer-last-error* peer)))
      (assert-true (member "getheaders" (map p2p-envelope-command writes)))
      (node-close* n)))

