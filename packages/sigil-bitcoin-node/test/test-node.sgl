  (test "rejects missing and immature mempool inputs"
    (let* ((dir (test-data-dir))
           (n (node-open* bitcoin-regtest-chain* dir))
           (missing (make-relay-tx 3 1000))
           (h0 (chain-config-genesis-header* bitcoin-regtest-chain*))
           (b1 (make-coinbase-block (list h0) 1 1296688602))
           (funding-tx (car (block-transactions b1)))
           (immature (make-spend-tx funding-tx 0 1000)))
      (let ((entry (node-store-transaction* n missing "relay.example:18444")))
        (assert-equal "rejected" (node-mempool-entry-status* entry))
