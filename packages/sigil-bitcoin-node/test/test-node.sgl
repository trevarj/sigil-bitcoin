  (test "requests and stores announced transactions"
    (let* ((dir (test-data-dir))
           (n (node-open* bitcoin-regtest-chain* dir))
           (blocks (prepare-mature-utxo-node n))
           (funding-tx (car (block-transactions (car blocks))))
           (tx (make-spend-tx funding-tx 0 4999990000))
           (txid (transaction-txid tx))
           (tx-item (inventory-vector type: inv-tx hash: txid))
           (block-item (inventory-vector type: inv-block hash: %zero32))
           (writes '()))
      (assert-equal
        1
        (node-request-transactions*
          n
          (list tx-item tx-item block-item)
          "relay.example:18444"
          (lambda (envelope)
            (set! writes (append writes (list envelope))))
          8))
      (assert-equal 1 (length writes))
      (let* ((request (car writes))
             (items (inventory-message-parse (p2p-envelope-payload request))))
        (assert-equal "getdata" (p2p-envelope-command request))
        (assert-equal 1 (length items))
        (assert-equal inv-tx (inventory-vector-type (car items)))
        (assert-equal txid (inventory-vector-hash (car items))))
      (let ((entry (node-store-transaction* n tx "relay.example:18444")))
        (assert-equal (hex-encode txid) (node-mempool-entry-txid* entry))
        (assert-equal "available" (node-mempool-entry-status* entry)))
      (assert-equal 1
                    (node-status-snapshot-mempool-count*
                      (node-status* n)))
      (assert-equal
        0
        (node-request-transactions*
          n
          (list tx-item)
          "relay.example:18444"
          (lambda (envelope)
            (set! writes (append writes (list envelope))))
          8))
      (assert-equal 1 (length writes))
      (node-close* n)))

