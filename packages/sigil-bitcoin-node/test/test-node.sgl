      (node-store-block* n b1)
      (assert-equal 1 (node-validate-blocks* n))
      (let ((entry (node-store-transaction* n immature "relay.example:18444")))
        (assert-equal "rejected" (node-mempool-entry-status* entry))
        (assert-equal "immature-coinbase"
                      (node-mempool-entry-last-error* entry)))
      (assert-equal 0
                    (node-status-snapshot-mempool-count*
                      (node-status* n)))
      (node-close* n)))

  (test "rejects mempool conflicts duplicate inputs and overspends"
    (let* ((dir (test-data-dir))
           (n (node-open* bitcoin-regtest-chain* dir))
           (blocks (prepare-mature-utxo-node n))
           (funding-tx (car (block-transactions (car blocks))))
           (accepted (make-spend-tx funding-tx 0 4999990000))
           (conflict (make-spend-tx funding-tx 0 4999980000))
           (duplicate (make-duplicate-spend-tx
                        (car (block-transactions (cadr blocks)))
                        0
                        1000))
           (overspend (make-spend-tx
                        (car (block-transactions (cadr blocks)))
                        0
                        5000000001)))
      (let ((entry (node-store-transaction* n accepted "relay.example:18444")))
        (assert-equal "available" (node-mempool-entry-status* entry)))
      (let ((entry (node-store-transaction* n conflict "relay.example:18444")))
        (assert-equal "rejected" (node-mempool-entry-status* entry))
        (assert-equal "mempool-conflict"
                      (node-mempool-entry-last-error* entry)))
      (let ((entry (node-store-transaction* n duplicate "relay.example:18444")))
        (assert-equal "rejected" (node-mempool-entry-status* entry))
        (assert-equal "duplicate-input"
                      (node-mempool-entry-last-error* entry)))
      (let ((entry (node-store-transaction* n overspend "relay.example:18444")))
        (assert-equal "rejected" (node-mempool-entry-status* entry))
        (assert-equal "spends-more-than-inputs"
                      (node-mempool-entry-last-error* entry)))
      (assert-equal 1
                    (node-status-snapshot-mempool-count*
                      (node-status* n)))
      (node-close* n)))

  (test "accepts children of available mempool parents"
    (let* ((dir (test-data-dir))
           (n (node-open* bitcoin-regtest-chain* dir))
           (blocks (prepare-mature-utxo-node n))
           (funding-tx (car (block-transactions (car blocks))))
           (parent (make-spend-tx funding-tx 0 4999990000))
           (child (make-spend-tx parent 0 4999980000))
           (bad-index (make-spend-tx parent 1 1000))
           (conflict (make-spend-tx parent 0 4999970000)))
      (let ((entry (node-store-transaction* n parent "relay.example:18444")))
        (assert-equal "available" (node-mempool-entry-status* entry)))
      (let ((entry (node-store-transaction* n child "relay.example:18444")))
        (assert-equal "available" (node-mempool-entry-status* entry)))
      (let ((entry (node-store-transaction* n bad-index "relay.example:18444")))
        (assert-equal "rejected" (node-mempool-entry-status* entry))
        (assert-equal "missing-input"
                      (node-mempool-entry-last-error* entry)))
      (let ((entry (node-store-transaction* n conflict "relay.example:18444")))
        (assert-equal "rejected" (node-mempool-entry-status* entry))
        (assert-equal "mempool-conflict"
                      (node-mempool-entry-last-error* entry)))
      (assert-equal 2
                    (node-status-snapshot-mempool-count*
                      (node-status* n)))
      (node-close* n)))

  (test "marks mempool transactions confirmed by validated blocks"
    (let* ((dir (test-data-dir))
           (n (node-open* bitcoin-regtest-chain* dir))
           (blocks (prepare-mature-utxo-node n))
           (headers (headers-through blocks))
           (funding-tx (car (block-transactions (car blocks))))
           (tx (make-spend-tx funding-tx 0 4999990000))
           (fee 10000)
           (coinbase (make-coinbase-tx 102
                                      (+ (block-subsidy 102) fee)))
           (b102 (mine-block headers
                             (list coinbase tx)
                             1296749202)))
      (let ((entry (node-store-transaction* n tx "relay.example:18444")))
        (assert-equal "available" (node-mempool-entry-status* entry)))
      (node-ingest-headers* n (list (block-header-field b102)))
      (node-store-block* n b102)
      (assert-equal 1 (node-validate-blocks* n))
      (let ((entry (car (node-mempool* n))))
        (assert-equal "confirmed" (node-mempool-entry-status* entry))
        (assert-true
          (string-find (node-mempool-entry-last-error* entry) "block:")))
      (assert-equal 0
                    (node-status-snapshot-mempool-count*
                      (node-status* n)))
      (node-close* n)))

  (test "marks mempool conflicts when blocks spend their inputs"
    (let* ((dir (test-data-dir))
           (n (node-open* bitcoin-regtest-chain* dir))
           (blocks (prepare-mature-utxo-node n))
           (headers (headers-through blocks))
           (funding-tx (car (block-transactions (car blocks))))
           (mempool-tx (make-spend-tx funding-tx 0 4999990000))
           (block-tx (make-spend-tx funding-tx 0 4999980000))
           (fee 20000)
           (coinbase (make-coinbase-tx 102
                                      (+ (block-subsidy 102) fee)))
           (b102 (mine-block headers
                             (list coinbase block-tx)
                             1296749202)))
      (let ((entry (node-store-transaction* n mempool-tx "relay.example:18444")))
        (assert-equal "available" (node-mempool-entry-status* entry)))
      (node-ingest-headers* n (list (block-header-field b102)))
      (node-store-block* n b102)
      (assert-equal 1 (node-validate-blocks* n))
      (let ((entry (car (node-mempool* n))))
        (assert-equal "conflicted" (node-mempool-entry-status* entry))
        (assert-true
          (string-find (node-mempool-entry-last-error* entry) "block:")))
      (assert-equal 0
                    (node-status-snapshot-mempool-count*
                      (node-status* n)))
      (node-close* n)))

  (test "restores mempool entries when a reorg rolls off block effects"
    (let* ((dir (test-data-dir))
           (n (node-open* bitcoin-regtest-chain* dir))
           (blocks (prepare-mature-utxo-node n))
           (headers (headers-through blocks))
           (funding-a (car (block-transactions (car blocks))))
           (funding-b (car (block-transactions (cadr blocks))))
           (confirmed-tx (make-spend-tx funding-a 0 4999990000))
           (conflicted-tx (make-spend-tx funding-b 0 4999990000))
           (block-conflict-tx (make-spend-tx funding-b 0 4999980000))
           (fee-a 10000)
           (fee-b 20000)
           (old-coinbase (make-coinbase-tx
                           102
                           (+ (block-subsidy 102) fee-a fee-b)))
           (old-b102 (mine-block headers
                                 (list old-coinbase
                                       confirmed-tx
                                       block-conflict-tx)
                                 1296749202))
           (fork-b102 (make-coinbase-block headers 102 1296750202))
           (fork-b103 (make-coinbase-block
                        (append headers (list (block-header-field fork-b102)))
                        103
                        1296750802)))
      (assert-equal "available"
                    (node-mempool-entry-status*
                      (node-store-transaction*
                        n
                        confirmed-tx
                        "relay.example:18444")))
      (assert-equal "available"
                    (node-mempool-entry-status*
                      (node-store-transaction*
                        n
                        conflicted-tx
                        "relay.example:18444")))
      (node-ingest-headers* n (list (block-header-field old-b102)))
      (node-store-block* n old-b102)
      (assert-equal 1 (node-validate-blocks* n))
      (let* ((entries (node-mempool* n))
             (confirmed (find-mempool-entry-by-txid
                          entries
                          (hex-encode (transaction-txid confirmed-tx))))
             (conflicted (find-mempool-entry-by-txid
                           entries
                           (hex-encode (transaction-txid conflicted-tx)))))
        (assert-equal "confirmed" (node-mempool-entry-status* confirmed))
        (assert-equal "conflicted" (node-mempool-entry-status* conflicted)))
      (node-ingest-headers* n
                            (list (block-header-field fork-b102)
                                  (block-header-field fork-b103)))
      (node-store-block* n fork-b102)
      (node-store-block* n fork-b103)
      (assert-equal 2 (node-validate-blocks* n))
      (let* ((entries (node-mempool* n))
             (confirmed (find-mempool-entry-by-txid
                          entries
                          (hex-encode (transaction-txid confirmed-tx))))
             (conflicted (find-mempool-entry-by-txid
                           entries
                           (hex-encode (transaction-txid conflicted-tx)))))
        (assert-equal "available" (node-mempool-entry-status* confirmed))
        (assert-equal "" (node-mempool-entry-last-error* confirmed))
        (assert-equal "available" (node-mempool-entry-status* conflicted))
        (assert-equal "" (node-mempool-entry-last-error* conflicted))
        (assert-equal 2
                      (node-status-snapshot-mempool-count*
                        (node-status* n))))
      (node-close* n)))

  (test "handles transaction relay envelopes"
    (let* ((dir (test-data-dir))
           (n (node-open* bitcoin-regtest-chain* dir))
           (blocks (prepare-mature-utxo-node n))
           (funding-tx (car (block-transactions (car blocks))))
           (tx (make-spend-tx funding-tx 0 4999990000))
           (txid (transaction-txid tx))
           (tx-item (inventory-vector type: inv-tx hash: txid))
           (writes '()))
      (assert-equal
        1
        (node-handle-transaction-relay*
          n
          (p2p-envelope magic: (chain-config-magic* bitcoin-regtest-chain*)
                        command: "inv"
                        payload: (inv-message (list tx-item)))
          "relay.example:18444"
          (lambda (envelope)
            (set! writes (append writes (list envelope))))
          8))
      (assert-equal 1 (length writes))
      (let ((status (node-status* n)))
        (assert-equal 0 (node-status-snapshot-mempool-count* status))
        (assert-equal 1
                      (node-status-snapshot-requested-transaction-count*
                        status))
        (assert-equal 0
                      (node-status-snapshot-failed-transaction-count*
                        status)))
      (assert-equal
        1
        (node-handle-transaction-relay*
          n
          (p2p-envelope magic: (chain-config-magic* bitcoin-regtest-chain*)
                        command: "notfound"
                        payload: (notfound-message (list tx-item)))
          "relay.example:18444"
          (lambda (envelope) #t)
          8))
      (let ((entry (car (node-mempool* n))))
        (assert-equal "failed" (node-mempool-entry-status* entry))
        (assert-equal "notfound" (node-mempool-entry-last-error* entry)))
      (let ((status (node-status* n)))
        (assert-equal 0 (node-status-snapshot-mempool-count* status))
        (assert-equal 0
                      (node-status-snapshot-requested-transaction-count*
                        status))
        (assert-equal 1
                      (node-status-snapshot-failed-transaction-count*
                        status)))
      (assert-equal
        1
        (node-handle-transaction-relay*
          n
          (p2p-envelope magic: (chain-config-magic* bitcoin-regtest-chain*)
                        command: "tx"
                        payload: (tx-message tx))
          "relay.example:18444"
          (lambda (envelope) #t)
          8))
      (let ((entry (car (node-mempool* n))))
        (assert-equal "available" (node-mempool-entry-status* entry))
        (assert-equal "" (node-mempool-entry-last-error* entry)))
      (assert-equal 1
                    (node-status-snapshot-mempool-count*
                      (node-status* n)))
      (assert-equal 0
                    (node-status-snapshot-requested-transaction-count*
                      (node-status* n)))
      (assert-equal 0
                    (node-status-snapshot-failed-transaction-count*
                      (node-status* n)))
      (node-close* n)))

  (test "does not immediately re-request fresh transactions from same peer"
    (let* ((dir (test-data-dir))
           (n (node-open* bitcoin-regtest-chain* dir))
           (tx (make-coinbase-tx 12 5000000000))
           (tx-item (inventory-vector type: inv-tx
                                      hash: (transaction-txid tx)))
           (writes '()))
      (assert-equal
        1
        (node-request-transactions*
          n
          (list tx-item)
          "relay.example:18444"
          (lambda (envelope)
            (set! writes (append writes (list envelope))))
          8))
      (assert-equal
        0
        (node-request-transactions*
          n
          (list tx-item)
          "relay.example:18444"
          (lambda (envelope)
            (set! writes (append writes (list envelope))))
          8))
      (assert-equal 1 (length writes))
      (let ((status (node-status* n)))
        (assert-equal 1
                      (node-status-snapshot-requested-transaction-count*
                        status))
        (assert-equal 0
                      (node-status-snapshot-failed-transaction-count*
                        status)))
      (let ((row (sqlite-query-row
                   (node-db* n)
                   "SELECT updated_at, request_count FROM mempool WHERE txid = ?"
                   (hex-encode (transaction-txid tx)))))
        (assert-true (> (test-row-ref row "updated_at") 0))
        (assert-equal 1 (test-row-ref row "request_count")))
      (node-close* n)))

