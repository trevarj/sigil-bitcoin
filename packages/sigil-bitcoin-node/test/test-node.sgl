  (test "resumes validation from persisted UTXO state"
    (let* ((dir (test-data-dir))
           (first (node-open* bitcoin-regtest-chain* dir))
           (h0 (chain-config-genesis-header* bitcoin-regtest-chain*))
           (blocks (make-coinbase-chain h0 2 1296688602))
           (b1 (car blocks))
           (b2 (cadr blocks)))
      (node-ingest-headers* first
                            (list (block-header-field b1)
                                  (block-header-field b2)))
      (node-store-block* first b1)
      (assert-equal 1 (node-validate-blocks* first))
      (node-close* first)
      (let ((second (node-open* bitcoin-regtest-chain* dir)))
        (node-store-block* second b2)
        (assert-equal 1 (node-validate-blocks* second))
        (let ((status (node-status* second)))
          (assert-equal 2 (node-status-snapshot-validated-block-count* status))
          (assert-equal 2 (node-status-snapshot-best-block-height* status))
          (assert-equal (hex-encode (block-header-hash (block-header-field b2)))
                        (node-status-snapshot-best-block-hash* status)))
        (node-close* second))))

  (test "bounded validation batches resume from active chain tip"
    (let* ((dir (test-data-dir))
           (n (node-open* bitcoin-regtest-chain* dir))
           (h0 (chain-config-genesis-header* bitcoin-regtest-chain*))
           (blocks (make-coinbase-chain h0 3 1296688602)))
      (node-ingest-headers* n (map block-header-field blocks))
      (store-blocks n blocks)
      (assert-equal 1 (node-validate-blocks* n 1))
      (let ((status (node-status* n)))
        (assert-equal 1 (node-status-snapshot-validated-block-count* status))
        (assert-equal 1 (node-status-snapshot-best-block-height* status)))
      (assert-equal 1 (node-validate-blocks* n 1))
      (let ((status (node-status* n)))
        (assert-equal 2 (node-status-snapshot-validated-block-count* status))
        (assert-equal 2 (node-status-snapshot-best-block-height* status)))
      (assert-equal 1 (node-validate-blocks* n 1))
      (let ((status (node-status* n)))
        (assert-equal 3 (node-status-snapshot-validated-block-count* status))
        (assert-equal 3 (node-status-snapshot-best-block-height* status)))
      (node-close* n)))

  (test "rebuilds active chain tip metadata for upgraded databases"
    (let* ((dir (test-data-dir))
           (first (node-open* bitcoin-regtest-chain* dir))
           (h0 (chain-config-genesis-header* bitcoin-regtest-chain*))
           (blocks (make-coinbase-chain h0 2 1296688602))
           (b1 (car blocks))
           (b2 (cadr blocks)))
      (node-ingest-headers* first
                            (list (block-header-field b1)
                                  (block-header-field b2)))
      (node-store-block* first b1)
      (node-store-block* first b2)
      (assert-equal 2 (node-validate-blocks* first))
      ;; Simulate an older DB created before active-chain-tip metadata existed.
      (sqlite-run (node-db* first)
                  "DELETE FROM metadata WHERE key = ? OR key = ?"
                  "active-chain-tip-hash"
                  "active-chain-tip-height")
      (node-close* first)
      (let ((second (node-open* bitcoin-regtest-chain* dir)))
        (let ((status (node-status* second)))
          (assert-equal 2 (node-status-snapshot-validated-block-count* status))
          (assert-equal 2 (node-status-snapshot-best-block-height* status))
          (assert-equal (hex-encode
                          (block-header-hash (block-header-field b2)))
                        (node-status-snapshot-best-block-hash* status)))
        (node-close* second))))

