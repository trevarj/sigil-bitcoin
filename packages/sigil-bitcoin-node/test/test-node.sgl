          (one-envelope-reader
            (list (p2p-envelope
                    magic: (chain-config-magic* bitcoin-regtest-chain*)
                    command: "version"
                    payload: #u8(#x01 #x02))))
          (lambda (envelope) #t)
          1
          1))
      (let ((status (node-status* n))
            (peer (car (node-peers* n))))
        (assert-equal "failed" (node-status-snapshot-sync-stage* status))
        (assert-equal "handshake"
                      (node-status-snapshot-sync-failed-stage* status))
        (assert-true
          (string-find (node-status-snapshot-sync-last-error* status)
                       "version-message-parse: truncated input"))
        (assert-true
          (string-find (node-peer-last-error* peer)
                       "version-message-parse: truncated input")))
      (node-close* n)))

  (test "run progress snapshot changes when sync state advances"
    (let* ((dir (test-data-dir))
           (n (node-open* bitcoin-regtest-chain* dir))
