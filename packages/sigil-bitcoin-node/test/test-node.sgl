  (test "reports block request and download stages"
    (let* ((dir (test-data-dir))
           (n (node-open* bitcoin-regtest-chain* dir))
           (h0 (chain-config-genesis-header* bitcoin-regtest-chain*))
           (b1 (make-coinbase-block (list h0) 1 1296688602))
           (h1 (block-header-field b1))
           (request-stage-seen #f)
           (download-stage-seen #f))
      (node-ingest-headers* n (list h1))
      (assert-equal
        1
        (node-download-blocks*
          n
          (lambda ()
            (assert-equal "block-download"
                          (node-status-snapshot-sync-stage*
                            (node-status* n)))
            (set! download-stage-seen #t)
            (p2p-envelope magic: (chain-config-magic* bitcoin-regtest-chain*)
                          command: "block"
                          payload: (block-message b1)))
          (lambda (envelope)
            (assert-equal "block-request"
                          (node-status-snapshot-sync-stage*
                            (node-status* n)))
            (set! request-stage-seen #t))
          4
          8))
      (assert-true request-stage-seen)
      (assert-true download-stage-seen)
      (assert-equal "idle"
                    (node-status-snapshot-sync-stage*
                      (node-status* n)))
      (node-close* n)))

  (test "marks notfound block downloads failed"
    (let* ((dir (test-data-dir))
           (n (node-open* bitcoin-regtest-chain* dir))
           (h0 (chain-config-genesis-header* bitcoin-regtest-chain*))
           (h1 (mine-next (list h0) 1296688602))
           (item (inventory-vector type: inv-block
                                   hash: (block-header-hash h1)))
           (writes '()))
      (node-ingest-headers* n (list h1))
      (assert-equal
        0
        (node-download-blocks*
          n
          (one-envelope-reader
            (list (p2p-envelope magic: (chain-config-magic* bitcoin-regtest-chain*)
                                command: "notfound"
                                payload: (notfound-message (list item)))))
          (lambda (envelope)
            (set! writes (cons envelope writes)))
          4
          8))
      (let ((status (node-status* n)))
        (assert-equal 0 (node-status-snapshot-pending-block-count* status))
        (assert-equal 0 (node-status-snapshot-requested-block-count* status))
        (assert-equal 1 (node-status-snapshot-failed-block-count* status))
        (assert-equal 0 (node-status-snapshot-block-count* status)))
      (assert-equal 1 (length writes))
      (node-close* n)))

  (test "retries stale failed blocks from the same peer"
    (let* ((dir (test-data-dir))
           (n (node-open* bitcoin-regtest-chain* dir))
           (h0 (chain-config-genesis-header* bitcoin-regtest-chain*))
           (h1 (mine-next (list h0) 1296688602))
           (item (inventory-vector type: inv-block
                                   hash: (block-header-hash h1)))
           (writes '()))
      (node-ingest-headers* n (list h1))
      (assert-equal
        0
        (node-download-blocks*
          n
          (one-envelope-reader
            (list (p2p-envelope magic: (chain-config-magic* bitcoin-regtest-chain*)
                                command: "notfound"
                                payload: (notfound-message (list item)))))
          (lambda (envelope)
            (set! writes (cons envelope writes)))
          4
          8))
      (assert-equal
        0
        (node-download-blocks*
          n
          (lambda () (error "unexpected read"))
          (lambda (envelope)
            (set! writes (cons envelope writes)))
          0
          8))
      (assert-equal 1 (length writes))
      (sqlite-run (node-db* n)
                  "UPDATE blocks SET requested_at = 1 WHERE hash = ?"
                  (hex-encode (block-header-hash h1)))
      (assert-equal
        0
        (node-download-blocks*
          n
          (lambda () (error "unexpected read"))
          (lambda (envelope)
            (set! writes (cons envelope writes)))
          0
          8))
      (assert-equal 2 (length writes))
      (let ((items (inventory-message-parse
                     (p2p-envelope-payload (car writes)))))
        (assert-equal 1 (length items))
        (assert-true
          (inventory-hash-member? (block-header-hash h1) items)))
      (node-close* n)))

  (test "marks unexpected block downloads failed"
    (let* ((dir (test-data-dir))
           (n (node-open* bitcoin-regtest-chain* dir))
           (h0 (chain-config-genesis-header* bitcoin-regtest-chain*))
           (requested (make-coinbase-block (list h0) 1 1296688602))
           (unexpected (make-coinbase-block (list h0) 1 1296698602))
           (writes '()))
      (node-ingest-headers* n (list (block-header-field requested)))
      (assert-error
        (node-download-blocks*
          n
          (one-envelope-reader
            (list (p2p-envelope magic: (chain-config-magic* bitcoin-regtest-chain*)
                                command: "block"
                                payload: (block-message unexpected))))
          (lambda (envelope)
            (set! writes (cons envelope writes)))
          4
          8))
      (let ((status (node-status* n)))
        (assert-equal "failed" (node-status-snapshot-sync-stage* status))
        (assert-equal "block-download"
                      (node-status-snapshot-sync-failed-stage* status))
        (assert-true
          (string-find (node-status-snapshot-sync-last-error* status)
                       "node-store-block: block header is unknown"))
        (assert-equal 0 (node-status-snapshot-pending-block-count* status))
        (assert-equal 0 (node-status-snapshot-requested-block-count* status))
        (assert-equal 1 (node-status-snapshot-failed-block-count* status))
        (assert-equal 0 (node-status-snapshot-block-count* status)))
      (assert-equal 1 (length writes))
      (node-close* n)))

  (test "resumes requested downloads after reopening"
    (let* ((dir (test-data-dir))
           (first (node-open* bitcoin-regtest-chain* dir))
           (h0 (chain-config-genesis-header* bitcoin-regtest-chain*))
           (b1 (make-coinbase-block (list h0) 1 1296688602))
           (h1 (block-header-field b1))
           (writes '()))
      (node-ingest-headers* first (list h1))
      (assert-equal
        0
        (node-download-blocks*
          first
          (lambda () (error "unexpected read"))
          (lambda (envelope)
            (set! writes (cons envelope writes)))
          0
          8))
      (let ((status (node-status* first)))
        (assert-equal 0 (node-status-snapshot-pending-block-count* status))
        (assert-equal 1 (node-status-snapshot-requested-block-count* status))
        (assert-equal 0 (node-status-snapshot-failed-block-count* status)))
      (let ((row (sqlite-query-row
                   (node-db* first)
                   "SELECT requested_at, request_count FROM blocks WHERE hash = ?"
                   (hex-encode (block-header-hash h1)))))
        (assert-true (> (test-row-ref row "requested_at") 0))
        (assert-equal 1 (test-row-ref row "request_count")))
      (sqlite-run (node-db* first)
                  "UPDATE blocks SET requested_at = 1 WHERE hash = ?"
                  (hex-encode (block-header-hash h1)))
      (node-close* first)
      (let ((second (node-open* bitcoin-regtest-chain* dir)))
        (let ((status (node-status* second)))
          (assert-equal 1 (node-status-snapshot-requested-block-count* status)))
        (assert-equal
          1
          (node-download-blocks*
            second
            (one-envelope-reader
              (list (p2p-envelope magic: (chain-config-magic* bitcoin-regtest-chain*)
                                  command: "block"
                                  payload: (block-message b1))))
            (lambda (envelope) #t)
            4
            8))
        (let ((status (node-status* second)))
          (assert-equal 0 (node-status-snapshot-requested-block-count* status))
          (assert-equal 0 (node-status-snapshot-failed-block-count* status))
          (assert-equal 1 (node-status-snapshot-block-count* status)))
        (node-close* second))))

  (test "does not immediately re-request a fresh pending block from the same peer"
    (let* ((dir (test-data-dir))
           (n (node-open* bitcoin-regtest-chain* dir))
           (h0 (chain-config-genesis-header* bitcoin-regtest-chain*))
           (h1 (mine-next (list h0) 1296688602))
           (writes '()))
      (node-ingest-headers* n (list h1))
      (assert-equal
        0
        (node-download-blocks*
          n
          (lambda () (error "unexpected read"))
          (lambda (envelope)
            (set! writes (cons envelope writes)))
          0
          8))
      (assert-equal 1 (length writes))
      (assert-equal
        0
        (node-download-blocks*
          n
          (lambda () (error "unexpected read"))
          (lambda (envelope)
            (set! writes (cons envelope writes)))
          0
          8))
      (assert-equal 1 (length writes))
      (let ((status (node-status* n)))
        (assert-equal 0 (node-status-snapshot-pending-block-count* status))
        (assert-equal 1 (node-status-snapshot-requested-block-count* status)))
      (node-close* n)))

  (test "retries block requests after a download transport error"
    (let* ((dir (test-data-dir))
           (n (node-open* bitcoin-regtest-chain* dir))
           (h0 (chain-config-genesis-header* bitcoin-regtest-chain*))
           (h1 (mine-next (list h0) 1296688602))
           (writes '()))
      (node-ingest-headers* n (list h1))
      (assert-error
        (node-download-blocks*
          n
          (lambda () (error "mock read timeout"))
          (lambda (envelope)
            (set! writes (cons envelope writes)))
          4
          1))
      (assert-equal 1 (length writes))
      (let ((row (sqlite-query-row
                   (node-db* n)
                   "SELECT requested_at, request_count FROM blocks WHERE hash = ?"
                   (hex-encode (block-header-hash h1)))))
        (assert-equal 1 (test-row-ref row "requested_at"))
        (assert-equal 1 (test-row-ref row "request_count")))
      (assert-equal
        0
        (node-download-blocks*
          n
          (lambda () (error "unexpected read"))
          (lambda (envelope)
            (set! writes (cons envelope writes)))
          0
          1))
      (assert-equal 2 (length writes))
      (let ((items (inventory-message-parse
                     (p2p-envelope-payload (car writes)))))
        (assert-equal 1 (length items))
        (assert-true
          (inventory-hash-member? (block-header-hash h1) items)))
      (node-close* n)))

  (test "retries block requests after non-block chatter exhausts read budget"
    (let* ((dir (test-data-dir))
           (n (node-open* bitcoin-regtest-chain* dir))
           (h0 (chain-config-genesis-header* bitcoin-regtest-chain*))
           (h1 (mine-next (list h0) 1296688602))
           (writes '()))
      (node-ingest-headers* n (list h1))
      (assert-equal
        0
        (node-download-blocks*
          n
          (one-envelope-reader
            (list (p2p-envelope magic: (chain-config-magic* bitcoin-regtest-chain*)
                                command: "ping"
                                payload: (ping-message 7))))
          (lambda (envelope)
            (set! writes (cons envelope writes)))
          1
          1))
      (assert-equal 1 (length writes))
      (let ((row (sqlite-query-row
                   (node-db* n)
                   "SELECT requested_at, request_count FROM blocks WHERE hash = ?"
                   (hex-encode (block-header-hash h1)))))
        (assert-equal 1 (test-row-ref row "requested_at"))
        (assert-equal 1 (test-row-ref row "request_count")))
      (assert-equal
        0
        (node-download-blocks*
          n
          (lambda () (error "unexpected read"))
          (lambda (envelope)
            (set! writes (cons envelope writes)))
          0
          1))
      (assert-equal 2 (length writes))
      (let ((items (inventory-message-parse
                     (p2p-envelope-payload (car writes)))))
        (assert-equal 1 (length items))
        (assert-true
          (inventory-hash-member? (block-header-hash h1) items)))
      (node-close* n)))

  (test "retries the missing tail of a partially received block batch"
    (let* ((dir (test-data-dir))
           (n (node-open* bitcoin-regtest-chain* dir))
           (h0 (chain-config-genesis-header* bitcoin-regtest-chain*))
           (b1 (make-coinbase-block (list h0) 1 1296688602))
           (h1 (block-header-field b1))
           (b2 (make-coinbase-block (list h0 h1) 2 1296689202))
           (h2 (block-header-field b2))
           (writes '()))
      (node-ingest-headers* n (list h1 h2))
      (assert-equal
        1
        (node-download-blocks*
          n
          (one-envelope-reader
            (list (p2p-envelope magic: (chain-config-magic* bitcoin-regtest-chain*)
                                command: "block"
                                payload: (block-message b1))))
          (lambda (envelope)
            (set! writes (cons envelope writes)))
          1
          2))
      (assert-equal 1 (length writes))
      (let ((status (node-status* n)))
        (assert-equal 0 (node-status-snapshot-pending-block-count* status))
        (assert-equal 1 (node-status-snapshot-requested-block-count* status))
        (assert-equal 1 (node-status-snapshot-block-count* status)))
      (assert-equal
        0
        (node-download-blocks*
          n
          (lambda () (error "unexpected read"))
          (lambda (envelope)
            (set! writes (cons envelope writes)))
          0
          2))
      (assert-equal 2 (length writes))
      (let ((items (inventory-message-parse
                     (p2p-envelope-payload (car writes)))))
        (assert-equal 1 (length items))
        (assert-true
          (inventory-hash-member? (block-header-hash h2) items))
        (assert-false
          (inventory-hash-member? (block-header-hash h1) items)))
      (let ((row (sqlite-query-row
                   (node-db* n)
                   "SELECT request_count FROM blocks WHERE hash = ?"
                   (hex-encode (block-header-hash h2)))))
        (assert-equal 2 (test-row-ref row "request_count")))
      (node-close* n)))

  (test "retries requested validation gaps before a downloaded tail"
    (let* ((dir (test-data-dir))
           (n (node-open* bitcoin-regtest-chain* dir))
           (h0 (chain-config-genesis-header* bitcoin-regtest-chain*))
           (b1 (make-coinbase-block (list h0) 1 1296688602))
           (h1 (block-header-field b1))
           (b2 (make-coinbase-block (list h0 h1) 2 1296689202))
           (h2 (block-header-field b2))
           (writes '()))
      (node-ingest-headers* n (list h1 h2))
      (node-download-blocks*
        n
        (lambda () (error "unexpected read"))
        (lambda (envelope)
          (set! writes (cons envelope writes)))
        0
        1)
      (node-store-block* n b2)
      (let ((status (node-status* n)))
        (assert-equal 1 (node-status-snapshot-requested-block-count* status))
        (assert-equal 1 (node-status-snapshot-block-count* status))
        (assert-equal 0 (node-status-snapshot-validated-block-count* status)))
      (assert-equal
        0
        (node-download-blocks*
          n
          (lambda () (error "unexpected read"))
          (lambda (envelope)
            (set! writes (cons envelope writes)))
          0
          1))
      (assert-equal 2 (length writes))
      (let ((items (inventory-message-parse
                     (p2p-envelope-payload (car writes)))))
        (assert-equal 1 (length items))
        (assert-true
          (inventory-hash-member? (block-header-hash h1) items))
        (assert-false
          (inventory-hash-member? (block-header-hash h2) items)))
      (let ((row (sqlite-query-row
                   (node-db* n)
                   "SELECT requested_at, request_count FROM blocks WHERE hash = ?"
                   (hex-encode (block-header-hash h1)))))
        (assert-true (> (test-row-ref row "requested_at") 1))
        (assert-equal 2 (test-row-ref row "request_count")))
      (node-close* n)))

  (test "reports pending requested and failed block stages separately"
    (let* ((dir (test-data-dir))
           (n (node-open* bitcoin-regtest-chain* dir))
           (h0 (chain-config-genesis-header* bitcoin-regtest-chain*))
           (h1 (mine-next (list h0) 1296688602))
           (h2 (mine-next (list h0 h1) 1296689202)))
      (node-ingest-headers* n (list h1 h2))
      (let ((status (node-status* n)))
        (assert-equal 2 (node-status-snapshot-pending-block-count* status))
        (assert-equal 0 (node-status-snapshot-requested-block-count* status))
        (assert-equal 0 (node-status-snapshot-failed-block-count* status)))
      (node-download-blocks*
        n
        (lambda () (error "unexpected read"))
        (lambda (envelope) #t)
        0
        1)
      (let ((status (node-status* n)))
        (assert-equal 1 (node-status-snapshot-pending-block-count* status))
        (assert-equal 1 (node-status-snapshot-requested-block-count* status))
        (assert-equal 0 (node-status-snapshot-failed-block-count* status)))
      (node-close* n))))
