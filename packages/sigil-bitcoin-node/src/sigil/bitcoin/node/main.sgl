;;; (sigil bitcoin node main) — CLI for the header-sync node

(define-library (sigil bitcoin node main)
  (import (sigil core)
          (sigil string)
          (sigil time)
          (sigil process)
          (sigil socket)
          (sigil bitcoin node)
          (sigil bitcoin p2p))
  (export main
          run-peers
          run-loop
          run-probe)
  (begin

    (define (usage)
      (println "usage:")
      (println "  sigil-bitcoin-node status [--chain CHAIN] [--data-dir DIR]")
      (println "  sigil-bitcoin-node peers bootstrap [--chain CHAIN] [--data-dir DIR] [--resolve-timeout N] [--max-seeds N] [--max-addresses N]")
      (println "  sigil-bitcoin-node peers add HOST[:PORT]|[IPv6]:PORT [--chain CHAIN] [--data-dir DIR]")
      (println "  sigil-bitcoin-node peers list [--chain CHAIN] [--data-dir DIR]")
      (println "  sigil-bitcoin-node peers summary [--chain CHAIN] [--data-dir DIR]")
      (println "  sigil-bitcoin-node peers remove HOST[:PORT]|[IPv6]:PORT [--chain CHAIN] [--data-dir DIR]")
      (println "  sigil-bitcoin-node peers test HOST[:PORT]|[IPv6]:PORT [--chain CHAIN] [--data-dir DIR] [--resolve-timeout N] [--connect-timeout N] [--read-timeout N]")
      (println "  sigil-bitcoin-node header-sync --peer HOST[:PORT]|[IPv6]:PORT [--chain CHAIN] [--data-dir DIR] [--max-steps N] [--resolve-timeout N] [--connect-timeout N] [--read-timeout N]")
      (println "  sigil-bitcoin-node sync [--peer HOST[:PORT]|[IPv6]:PORT] [--chain CHAIN] [--data-dir DIR] [--max-steps N] [--max-blocks N] [--max-peers N] [--max-retries N] [--resolve-timeout N] [--connect-timeout N] [--read-timeout N]")
      (println "  sigil-bitcoin-node run [--peer HOST[:PORT]|[IPv6]:PORT] [--chain CHAIN] [--data-dir DIR] [--max-steps N] [--max-blocks N] [--iterations N|0] [--max-peers N] [--max-retries N] [--retry-delay N] [--resolve-timeout N] [--connect-timeout N] [--read-timeout N]")
      (println "  sigil-bitcoin-node probe [--peer HOST[:PORT]|[IPv6]:PORT] [--chain CHAIN] [--data-dir DIR] [--max-steps N] [--max-blocks N] [--max-peers N] [--resolve-timeout N] [--connect-timeout N] [--read-timeout N] [--max-seeds N] [--max-addresses N]")
      (println "")
      (println "chains: bitcoin-mainnet, bitcoin-testnet, bitcoin-testnet4, bitcoin-signet, bitcoin-regtest, sigilcoin"))

    (define (arg-value args name default)
      (let loop ((xs args))
        (cond ((null? xs) default)
              ((and (string=? (car xs) name) (not (null? (cdr xs))))
               (cadr xs))
              (else
               (loop (cdr xs))))))

    (define (arg-values args name)
      (let loop ((xs args) (out '()))
        (cond ((null? xs) (reverse out))
              ((and (string=? (car xs) name) (not (null? (cdr xs))))
               (loop (cddr xs) (cons (cadr xs) out)))
              (else
               (loop (cdr xs) out)))))

    (define (string-prefix? prefix text)
      (let ((len (string-length prefix)))
        (and (<= len (string-length text))
             (string=? prefix (substring text 0 len)))))

    (define (find-char text ch start)
      (let loop ((i start))
        (cond ((>= i (string-length text)) #f)
              ((char=? ch (string-ref text i)) i)
              (else (loop (+ i 1))))))

    (define (parse-port text context)
      (let ((port (string->number text)))
        (unless port
          (error (string-append context ": peer port must be a number")))
        port))

    (define (parse-bracketed-peer text default-port context)
      (let ((close (find-char text #\] 1)))
        (unless close
          (error (string-append context ": expected closing ] in IPv6 peer")))
        (let ((host (substring text 1 close))
              (rest (substring text (+ close 1) (string-length text))))
          (cond ((string=? rest "")
                 (cons host default-port))
                ((string-prefix? ":" rest)
                 (cons host
                       (parse-port (substring rest 1 (string-length rest))
                                   context)))
                (else
                 (error (string-append context
                                       ": expected [IPv6] or [IPv6]:PORT")))))))

    (define (parse-peer text default-port)
      (let ((context "peer"))
        (if (string-prefix? "[" text)
            (parse-bracketed-peer text default-port context)
            (let ((parts (string-split text ":")))
              (cond ((= 1 (length parts))
                     (cons (car parts) default-port))
                    ((= 2 (length parts))
                     (cons (car parts) (parse-port (cadr parts) context)))
                    (else
                     (error (string-append
                              context
                              ": IPv6 peers must use [IPv6] or [IPv6]:PORT"))))))))

    (define (status-number args name default)
      (let ((value (string->number (arg-value args name default))))
        (unless value
          (error (string-append "expected numeric value for " name)))
        value))

    (define (print-status status)
      (println "chain: ~a" (node-status-snapshot-chain status))
      (println "best-height: ~a" (node-status-snapshot-best-height status))
      (println "best-hash: ~a" (node-status-snapshot-best-hash status))
      (println "best-work: ~a" (node-status-snapshot-best-work status))
      (println "best-header-time: ~a" (node-status-snapshot-best-header-time status))
      (println "header-sync-lag: ~a" (node-status-snapshot-header-sync-lag status))
      (println "headers: ~a" (node-status-snapshot-header-count status))
      (println "blocks: ~a" (node-status-snapshot-block-count status))
      (println "validated-blocks: ~a" (node-status-snapshot-validated-block-count status))
      (println "best-block-height: ~a" (node-status-snapshot-best-block-height status))
      (println "peers: ~a" (node-status-snapshot-peer-count status))
      (println "pending-blocks: ~a" (node-status-snapshot-pending-block-count status))
      (println "requested-blocks: ~a" (node-status-snapshot-requested-block-count status))
      (println "failed-blocks: ~a" (node-status-snapshot-failed-block-count status))
      (println "sync-stage: ~a" (node-status-snapshot-sync-stage status))
      (println "sync-failed-stage: ~a" (node-status-snapshot-sync-failed-stage status))
      (println "sync-last-error: ~a" (node-status-snapshot-sync-last-error status))
      (println "run-attempts: ~a" (node-status-snapshot-run-attempts status))
      (println "run-last-result: ~a" (node-status-snapshot-run-last-result status))
      (println "run-last-error: ~a" (node-status-snapshot-run-last-error status))
      (println "last-peer-error: ~a" (node-status-snapshot-last-peer-error status))
      (println "sync-progress: ~a/~a"
               (node-status-snapshot-best-block-height status)
               (node-status-snapshot-best-height status)))

    (define (print-peer peer)
      (println "~a:~a source=~a seed=~a score=~a failures=~a last-seen=~a last-attempt=~a last-result=~a last-error=~a"
               (node-peer-address peer)
               (node-peer-port peer)
               (node-peer-source peer)
               (node-peer-seed-host peer)
               (node-peer-score peer)
               (node-peer-failures peer)
               (node-peer-last-seen peer)
               (node-peer-last-attempt peer)
               (node-peer-last-result peer)
               (node-peer-last-error peer)))

    (define (peer-error-category peer)
      (let ((result (node-peer-last-result peer))
            (err (node-peer-last-error peer)))
        (cond ((string=? result "success") "success")
              ((string=? result "") "untried")
              ((string-find err "connection refused") "connect-refused")
              ((string-find err "timed out") "connect-timeout")
              ((string-find err "DNS") "dns-failed")
              (else "other-failed"))))

    (define (count-peers-by-category peers category)
      (let loop ((xs peers) (count 0))
        (cond ((null? xs) count)
              ((string=? category (peer-error-category (car xs)))
               (loop (cdr xs) (+ count 1)))
              (else
               (loop (cdr xs) count)))))

    (define (count-peers-by-source peers source)
      (let loop ((xs peers) (count 0))
        (cond ((null? xs) count)
              ((string=? source (node-peer-source (car xs)))
               (loop (cdr xs) (+ count 1)))
              (else
               (loop (cdr xs) count)))))

    (define (print-peer-summary peers)
      (println "peer-summary:")
      (println "total: ~a" (length peers))
      (println "manual: ~a" (count-peers-by-source peers "manual"))
      (println "discovered: ~a" (count-peers-by-source peers "discovered"))
      (println "untried: ~a" (count-peers-by-category peers "untried"))
      (println "success: ~a" (count-peers-by-category peers "success"))
      (println "connect-refused: ~a"
               (count-peers-by-category peers "connect-refused"))
      (println "connect-timeout: ~a"
               (count-peers-by-category peers "connect-timeout"))
      (println "dns-failed: ~a" (count-peers-by-category peers "dns-failed"))
      (println "other-failed: ~a"
               (count-peers-by-category peers "other-failed")))

    (define (fd-list-contains? fd xs)
      (cond ((null? xs) #f)
            ((= fd (car xs)) #t)
            (else (fd-list-contains? fd (cdr xs)))))

    (define (resolve-seed-host host port timeout-ms)
      (let ((fd (%resolve-start host)))
        (if fd
            (let ((ready (fd-select (list fd) '() timeout-ms)))
              (if (and ready (fd-list-contains? fd (car ready)))
                  (let ((addresses (%resolve-take fd)))
                    (if addresses addresses '()))
                  (begin
                    (%resolve-cancel fd)
                    (error "resolve-seed-host: DNS resolve timed out"))))
            (error "resolve-seed-host: DNS resolver unavailable"))))

    (define (with-node args proc)
      (let* ((chain-name (arg-value args "--chain" "bitcoin-mainnet"))
             (data-dir (arg-value args "--data-dir" ".sigil-bitcoin-node"))
             (chain (chain-config-by-name chain-name))
             (n (node-open chain data-dir)))
        (guard (err
                (else
                 (node-close n)
                 (error "with-node: command failed")))
          (let ((result (proc n)))
            (node-close n)
            result))))

    (define (run-status args)
      (with-node args
        (lambda (n)
          (print-status (node-status n)))))

    ;;; Run a `peers` CLI subcommand with parsed argument strings.
    ;;;
    ;;; ```scheme
    ;;; (run-peers '("summary" "--chain" "bitcoin-regtest"))
    ;;; ```
    (define (run-peers args)
      (: list? -> any?)
      (if (null? args)
          (begin
            (usage)
            (error "peers: missing subcommand"))
          (let ((subcommand (car args))
                (rest (cdr args)))
            (with-node rest
              (lambda (n)
                (cond ((string=? subcommand "add")
                       (when (null? rest)
                         (error "peers add: missing HOST:PORT"))
                       (let* ((peer (parse-peer (car rest)
                                                (chain-config-default-port
                                                  (node-chain n))))
                              (saved (node-add-peer n (car peer) (cdr peer))))
                         (print-peer saved)))
                      ((string=? subcommand "bootstrap")
                       (let ((resolve-timeout
                               (status-number rest "--resolve-timeout" "2000"))
                             (max-seeds
                               (status-number rest "--max-seeds" "8"))
                             (max-addresses
                               (status-number rest "--max-addresses" "16")))
                         (println "bootstrapped-peers: ~a"
                                  (node-bootstrap-discovered-peers
                                    n
                                    resolve-seed-host
                                    resolve-timeout
                                    max-seeds
                                    max-addresses))))
                      ((string=? subcommand "list")
                       (for-each print-peer (node-peers n)))
                      ((string=? subcommand "summary")
                       (print-peer-summary (node-peers n)))
                      ((string=? subcommand "remove")
                       (when (null? rest)
                         (error "peers remove: missing HOST:PORT"))
                       (let ((peer (parse-peer (car rest)
                                               (chain-config-default-port
                                                 (node-chain n)))))
                         (node-remove-peer n (car peer) (cdr peer))
                         (println "removed ~a:~a" (car peer) (cdr peer))))
                      ((string=? subcommand "test")
                       (when (null? rest)
                         (error "peers test: missing HOST:PORT"))
                       (let* ((peer (parse-peer (car rest)
                                                (chain-config-default-port
                                                  (node-chain n))))
                              (timeouts (peer-timeouts rest))
                              (tested (node-test-peer n
                                                      (car peer)
                                                      (cdr peer)
                                                      (connect-node-peer-with-timeouts
                                                        (car timeouts)
                                                        (cadr timeouts)
                                                        (caddr timeouts)))))
                         (print-peer tested)))
                      (else
                       (usage)
                       (error (string-append "peers: unknown subcommand "
                                             subcommand)))))))))

    (define (exception-message-or err fallback)
      (let ((message (exception-message err)))
        (if (string? message) message fallback)))

    (define (try-connect-peer-address address port timeout-ms)
      (guard (err
              (else
               (list 'error (exception-message-or err "transport unavailable"))))
        (let ((sock (p2p-socket-connect-timeout address port timeout-ms)))
          (if sock
              (list 'socket sock)
              (list 'error "transport unavailable")))))

    (define (connect-peer-socket host port resolve-timeout connect-timeout)
      (let loop ((addresses (resolve-seed-host host port resolve-timeout))
                 (last-error "no resolved addresses"))
        (cond ((null? addresses)
               (error (string-append "connect-peer-socket: " last-error)))
              (else
               (let ((result (try-connect-peer-address
                                (car addresses)
                                port
                                connect-timeout)))
                 (if (eq? (car result) 'socket)
                     (cadr result)
                     (loop (cdr addresses) (cadr result))))))))

    (define (with-peer-socket n peer resolve-timeout connect-timeout read-timeout proc)
      (let ((sock (connect-peer-socket (car peer)
                                       (cdr peer)
                                       resolve-timeout
                                       connect-timeout)))
        (guard (err
                (else
                 (socket-close sock)
                 (error "with-peer-socket: peer transport failed")))
          (let ((result
                  (proc
                    (lambda () (p2p-socket-read-envelope-timeout sock read-timeout))
                    (lambda (envelope)
                      (p2p-socket-write-envelope sock envelope)))))
            (socket-close sock)
            result))))

    (define (connect-node-peer-with-timeouts resolve-timeout connect-timeout read-timeout)
      (lambda (peer)
        (let ((sock (connect-peer-socket (node-peer-address peer)
                                         (node-peer-port peer)
                                         resolve-timeout
                                         connect-timeout)))
          (list
            (lambda () (p2p-socket-read-envelope-timeout sock read-timeout))
            (lambda (envelope)
              (p2p-socket-write-envelope sock envelope))
            (lambda () (socket-close sock))))))

    (define connect-node-peer
      (connect-node-peer-with-timeouts 2000 5000 5000))

    (define (peer-timeouts args)
      (list
        (status-number args "--resolve-timeout" "2000")
        (status-number args "--connect-timeout" "5000")
        (status-number args "--read-timeout" "5000")))

    (define (run-header-sync args)
      (let ((peer-text (arg-value args "--peer" #f)))
        (unless peer-text
          (usage)
          (error "header-sync: missing --peer"))
        (with-node args
          (lambda (n)
            (let* ((chain (node-chain n))
                   (peer (parse-peer peer-text
                                     (chain-config-default-port chain)))
                   (host (car peer))
                   (port (cdr peer))
                   (max-steps (status-number args "--max-steps" "64"))
                   (timeouts (peer-timeouts args)))
              (node-add-peer n host port)
              (with-peer-socket n
                                peer
                                (car timeouts)
                                (cadr timeouts)
                                (caddr timeouts)
                (lambda (read-envelope write-envelope)
                  (print-status
                    (node-sync-headers n
                                       read-envelope
                                       write-envelope
                                       max-steps)))))))))

    (define (sync-configured-peer-texts n peer-texts connect-peer max-steps max-blocks command)
      (let loop ((texts peer-texts))
        (if (null? texts)
            (error (string-append command ": peer sync failed"))
            (let* ((peer (parse-peer
                           (car texts)
                           (chain-config-default-port (node-chain n))))
                   (status (node-sync-configured-peer
                             n
                             (car peer)
                             (cdr peer)
                             connect-peer
                             max-steps
                             max-blocks)))
              (if (string=? "failed"
                            (node-status-snapshot-sync-stage status))
                  (loop (cdr texts))
                  status)))))

    (define (sync-node-once n args command)
      (let* ((peer-texts (arg-values args "--peer"))
             (max-steps (status-number args "--max-steps" "64"))
             (max-blocks (status-number args "--max-blocks" "16"))
             (max-peers (status-number args "--max-peers" "8"))
             (max-retries (status-number args "--max-retries" "0"))
             (timeouts (peer-timeouts args)))
        (if (not (null? peer-texts))
            (sync-configured-peer-texts
              n
              peer-texts
              (connect-node-peer-with-timeouts
                (car timeouts)
                (cadr timeouts)
                (caddr timeouts))
              max-steps
              max-blocks
              command)
            (node-sync-with-peers n
                                  (connect-node-peer-with-timeouts
                                    (car timeouts)
                                    (cadr timeouts)
                                    (caddr timeouts))
                                  max-peers
                                  max-retries
                                  max-steps
                                  max-blocks))))

    (define (run-sync-once args command)
      (with-node args
        (lambda (n)
          (print-status (sync-node-once n args command)))))

    (define (run-sync-attempt n args command)
      (guard (err (else #f))
        (sync-node-once n args command)
        #t))

    (define (run-loop-sync-attempt n args)
      (guard (err
              (else
               (node-record-run-failure n)
               (print-status (node-status n))
               #f))
        (sync-node-once n args "run")
        (node-record-run-attempt n "success" "")
        (print-status (node-status n))
        #t))

    (define (iteration-limit-reached? iterations completed)
      (and (> iterations 0)
           (>= completed iterations)))

    (define (run-loop args)
      (with-node args
        (lambda (n)
          (let ((iterations (status-number args "--iterations" "1"))
                (max-retries (status-number args "--max-retries" "3"))
                (retry-delay (status-number args "--retry-delay" "0")))
            (let loop ((completed 0) (retries 0) (last #f))
              (if (iteration-limit-reached? iterations completed)
                  last
                  (if (run-loop-sync-attempt n args)
                      (loop (+ completed 1) 0 #t)
                      (begin
                        (if (>= retries max-retries)
                            (error "run: max retries exceeded")
                            (begin
                              (when (> retry-delay 0)
                                (sleep retry-delay))
                              (loop completed (+ retries 1) last)))))))))))

    (define (maybe-bootstrap-probe-peers n args)
      (if (or (arg-value args "--peer" #f)
              (> (node-status-snapshot-peer-count (node-status n)) 0))
          0
          (let ((resolve-timeout
                  (status-number args "--resolve-timeout" "2000"))
                (max-seeds
                  (status-number args "--max-seeds" "8"))
                (max-addresses
                  (status-number args "--max-addresses" "16")))
            (node-bootstrap-discovered-peers n
                                            resolve-seed-host
                                            resolve-timeout
                                            max-seeds
                                            max-addresses))))

    (define (run-probe args)
      (with-node args
        (lambda (n)
          (let ((bootstrapped (maybe-bootstrap-probe-peers n args)))
            (println "bootstrapped-peers: ~a" bootstrapped)
            (guard (err
                    (else
                     (print-status (node-status n))
                     (error "probe: sync failed")))
              (print-status (sync-node-once n args "probe")))))))

    (define (after-arg-separator args)
      (cond ((null? args) '())
            ((string=? (car args) "--") (cdr args))
            (else (after-arg-separator (cdr args)))))

    (define (application-args raw-args)
      (if (and (not (null? raw-args))
               (string=? (car raw-args) "run"))
          (after-arg-separator raw-args)
          raw-args))

    (define (main)
      (: -> void?)
      (let ((args (application-args (cdr (command-line)))))
        (cond ((null? args)
               (usage))
              ((string=? (car args) "status")
               (run-status (cdr args)))
              ((string=? (car args) "peers")
               (run-peers (cdr args)))
              ((string=? (car args) "header-sync")
               (run-header-sync (cdr args)))
              ((string=? (car args) "sync")
               (run-sync-once (cdr args) "sync"))
              ((string=? (car args) "run")
               (run-loop (cdr args)))
              ((string=? (car args) "probe")
               (run-probe (cdr args)))
              (else
               (usage)
               (error (string-append "unknown command: " (car args)))))))))
