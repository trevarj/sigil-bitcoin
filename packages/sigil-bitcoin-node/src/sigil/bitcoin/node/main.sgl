;;; (sigil bitcoin node main) — CLI for the header-sync node

(define-library (sigil bitcoin node main)
  (import (sigil core)
          (sigil string)
          (sigil time)
          (sigil socket)
          (sigil bitcoin node)
          (sigil bitcoin p2p))
  (export main)
  (begin

    (define (usage)
      (println "usage:")
      (println "  sigil-bitcoin-node status [--chain CHAIN] [--data-dir DIR]")
      (println "  sigil-bitcoin-node peers bootstrap [--chain CHAIN] [--data-dir DIR] [--resolve-timeout N] [--max-seeds N] [--max-addresses N]")
      (println "  sigil-bitcoin-node peers add HOST:PORT [--chain CHAIN] [--data-dir DIR]")
      (println "  sigil-bitcoin-node peers list [--chain CHAIN] [--data-dir DIR]")
      (println "  sigil-bitcoin-node peers remove HOST:PORT [--chain CHAIN] [--data-dir DIR]")
      (println "  sigil-bitcoin-node peers test HOST:PORT [--chain CHAIN] [--data-dir DIR] [--resolve-timeout N] [--connect-timeout N] [--read-timeout N]")
      (println "  sigil-bitcoin-node header-sync --peer HOST:PORT [--chain CHAIN] [--data-dir DIR] [--max-steps N] [--resolve-timeout N] [--connect-timeout N] [--read-timeout N]")
      (println "  sigil-bitcoin-node sync [--peer HOST:PORT] [--chain CHAIN] [--data-dir DIR] [--max-steps N] [--max-blocks N] [--max-peers N] [--max-retries N] [--resolve-timeout N] [--connect-timeout N] [--read-timeout N]")
      (println "  sigil-bitcoin-node run [--peer HOST:PORT] [--chain CHAIN] [--data-dir DIR] [--max-steps N] [--max-blocks N] [--iterations N] [--max-peers N] [--max-retries N] [--retry-delay N] [--resolve-timeout N] [--connect-timeout N] [--read-timeout N]")
      (println "")
      (println "chains: bitcoin-mainnet, bitcoin-testnet, bitcoin-regtest, sigilcoin"))

    (define (arg-value args name default)
      (let loop ((xs args))
        (cond ((null? xs) default)
              ((and (string=? (car xs) name) (not (null? (cdr xs))))
               (cadr xs))
              (else
               (loop (cdr xs))))))

    (define (parse-peer text default-port)
      (let ((parts (string-split text ":")))
        (cond ((= 1 (length parts))
               (cons (car parts) default-port))
              ((= 2 (length parts))
               (let ((port (string->number (cadr parts))))
                 (unless port
                   (error "header-sync: peer port must be a number"))
                 (cons (car parts) port)))
              (else
               (error "header-sync: expected HOST or HOST:PORT")))))

    (define (status-number args name default)
      (let ((value (string->number (arg-value args name default))))
        (unless value
          (error (string-append "expected numeric value for " name)))
        value))

    (define (print-status status)
      (println "chain: ~a" (node-status-snapshot-chain status))
      (println "best-height: ~a" (node-status-snapshot-best-height status))
      (println "best-hash: ~a" (node-status-snapshot-best-hash status))
      (println "best-work: ~a" (node-status-snapshot-best-work status))
      (println "headers: ~a" (node-status-snapshot-header-count status))
      (println "blocks: ~a" (node-status-snapshot-block-count status))
      (println "validated-blocks: ~a" (node-status-snapshot-validated-block-count status))
      (println "best-block-height: ~a" (node-status-snapshot-best-block-height status))
      (println "peers: ~a" (node-status-snapshot-peer-count status))
      (println "pending-blocks: ~a" (node-status-snapshot-pending-block-count status))
      (println "requested-blocks: ~a" (node-status-snapshot-requested-block-count status))
      (println "failed-blocks: ~a" (node-status-snapshot-failed-block-count status))
      (println "sync-stage: ~a" (node-status-snapshot-sync-stage status))
      (println "sync-progress: ~a/~a"
               (node-status-snapshot-best-block-height status)
               (node-status-snapshot-best-height status)))

    (define (print-peer peer)
      (println "~a:~a source=~a seed=~a score=~a failures=~a last-seen=~a last-attempt=~a last-result=~a last-error=~a"
               (node-peer-address peer)
               (node-peer-port peer)
               (node-peer-source peer)
               (node-peer-seed-host peer)
               (node-peer-score peer)
               (node-peer-failures peer)
               (node-peer-last-seen peer)
               (node-peer-last-attempt peer)
               (node-peer-last-result peer)
               (node-peer-last-error peer)))

    (define (fd-list-contains? fd xs)
      (cond ((null? xs) #f)
            ((= fd (car xs)) #t)
            (else (fd-list-contains? fd (cdr xs)))))

    (define (resolve-seed-host host port timeout-ms)
      (let ((fd (%resolve-start host)))
        (if fd
            (let ((ready (fd-select (list fd) '() timeout-ms)))
              (if (and ready (fd-list-contains? fd (car ready)))
                  (let ((addresses (%resolve-take fd)))
                    (if addresses addresses '()))
                  (begin
                    (%resolve-cancel fd)
                    (error "resolve-seed-host: DNS resolve timed out"))))
            (error "resolve-seed-host: DNS resolver unavailable"))))

    (define (with-node args proc)
      (let* ((chain-name (arg-value args "--chain" "bitcoin-mainnet"))
             (data-dir (arg-value args "--data-dir" ".sigil-bitcoin-node"))
             (chain (chain-config-by-name chain-name))
             (n (node-open chain data-dir)))
        (guard (err
                (else
                 (node-close n)
                 (error "with-node: command failed")))
          (let ((result (proc n)))
            (node-close n)
            result))))

    (define (run-status args)
      (with-node args
        (lambda (n)
          (print-status (node-status n)))))

    (define (run-peers args)
      (if (null? args)
          (begin
            (usage)
            (error "peers: missing subcommand"))
          (let ((subcommand (car args))
                (rest (cdr args)))
            (with-node rest
              (lambda (n)
                (cond ((string=? subcommand "add")
                       (when (null? rest)
                         (error "peers add: missing HOST:PORT"))
                       (let* ((peer (parse-peer (car rest)
                                                (chain-config-default-port
                                                  (node-chain n))))
                              (saved (node-add-peer n (car peer) (cdr peer))))
                         (print-peer saved)))
                      ((string=? subcommand "bootstrap")
                       (let ((resolve-timeout
                               (status-number rest "--resolve-timeout" "2000"))
                             (max-seeds
                               (status-number rest "--max-seeds" "8"))
                             (max-addresses
                               (status-number rest "--max-addresses" "16")))
                         (println "bootstrapped-peers: ~a"
                                  (node-bootstrap-discovered-peers
                                    n
                                    resolve-seed-host
                                    resolve-timeout
                                    max-seeds
                                    max-addresses))))
                      ((string=? subcommand "list")
                       (for-each print-peer (node-peers n)))
                      ((string=? subcommand "remove")
                       (when (null? rest)
                         (error "peers remove: missing HOST:PORT"))
                       (let ((peer (parse-peer (car rest)
                                               (chain-config-default-port
                                                 (node-chain n)))))
                         (node-remove-peer n (car peer) (cdr peer))
                         (println "removed ~a:~a" (car peer) (cdr peer))))
                      ((string=? subcommand "test")
                       (when (null? rest)
                         (error "peers test: missing HOST:PORT"))
                       (let* ((peer (parse-peer (car rest)
                                                (chain-config-default-port
                                                  (node-chain n))))
                              (timeouts (peer-timeouts rest))
                              (tested (node-test-peer n
                                                      (car peer)
                                                      (cdr peer)
                                                      (connect-node-peer-with-timeouts
                                                        (car timeouts)
                                                        (cadr timeouts)
                                                        (caddr timeouts)))))
                         (print-peer tested)))
                      (else
                       (usage)
                       (error (string-append "peers: unknown subcommand "
                                             subcommand)))))))))

    (define (selected-peer n args command)
      (let ((peer-text (arg-value args "--peer" #f)))
        (if peer-text
            (parse-peer peer-text (chain-config-default-port (node-chain n)))
            (let ((peers (node-peers n)))
              (if (null? peers)
                  (error (string-append command ": no peers configured; use peers add HOST:PORT"))
                  (let ((peer (car peers)))
                    (cons (node-peer-address peer)
                          (node-peer-port peer))))))))

    (define (try-connect-peer-address address port timeout-ms)
      (guard (err (else #f))
        (p2p-socket-connect-timeout address port timeout-ms)))

    (define (connect-peer-socket host port resolve-timeout connect-timeout)
      (let loop ((addresses (resolve-seed-host host port resolve-timeout)))
        (cond ((null? addresses)
               (error "connect-peer-socket: connection failed"))
              (else
               (let ((sock (try-connect-peer-address
                             (car addresses)
                             port
                             connect-timeout)))
                 (if sock
                     sock
                     (loop (cdr addresses))))))))

    (define (with-peer-socket n peer resolve-timeout connect-timeout read-timeout proc)
      (let ((sock (connect-peer-socket (car peer)
                                       (cdr peer)
                                       resolve-timeout
                                       connect-timeout)))
        (guard (err
                (else
                 (socket-close sock)
                 (error "with-peer-socket: peer transport failed")))
          (let ((result
                  (proc
                    (lambda () (p2p-socket-read-envelope-timeout sock read-timeout))
                    (lambda (envelope)
                      (p2p-socket-write-envelope sock envelope)))))
            (socket-close sock)
            result))))

    (define (connect-node-peer-with-timeouts resolve-timeout connect-timeout read-timeout)
      (lambda (peer)
        (let ((sock (connect-peer-socket (node-peer-address peer)
                                         (node-peer-port peer)
                                         resolve-timeout
                                         connect-timeout)))
          (list
            (lambda () (p2p-socket-read-envelope-timeout sock read-timeout))
            (lambda (envelope)
              (p2p-socket-write-envelope sock envelope))
            (lambda () (socket-close sock))))))

    (define connect-node-peer
      (connect-node-peer-with-timeouts 2000 5000 5000))

    (define (peer-timeouts args)
      (list
        (status-number args "--resolve-timeout" "2000")
        (status-number args "--connect-timeout" "5000")
        (status-number args "--read-timeout" "5000")))

    (define (run-header-sync args)
      (let ((peer-text (arg-value args "--peer" #f)))
        (unless peer-text
          (usage)
          (error "header-sync: missing --peer"))
        (with-node args
          (lambda (n)
            (let* ((chain (node-chain n))
                   (peer (parse-peer peer-text
                                     (chain-config-default-port chain)))
                   (host (car peer))
                   (port (cdr peer))
                   (max-steps (status-number args "--max-steps" "64"))
                   (timeouts (peer-timeouts args)))
              (node-add-peer n host port)
              (with-peer-socket n
                                peer
                                (car timeouts)
                                (cadr timeouts)
                                (caddr timeouts)
                (lambda (read-envelope write-envelope)
                  (print-status
                    (node-sync-headers n
                                       read-envelope
                                       write-envelope
                                       max-steps)))))))))

    (define (run-sync-once args command)
      (with-node args
        (lambda (n)
          (let* ((peer-text (arg-value args "--peer" #f))
                 (max-steps (status-number args "--max-steps" "64"))
                 (max-blocks (status-number args "--max-blocks" "16"))
                 (max-peers (status-number args "--max-peers" "8"))
                 (max-retries (status-number args "--max-retries" "0"))
                 (timeouts (peer-timeouts args)))
            (if peer-text
                (let ((peer (selected-peer n args command)))
                  (node-add-peer n (car peer) (cdr peer))
                  (with-peer-socket n
                                    peer
                                    (car timeouts)
                                    (cadr timeouts)
                                    (caddr timeouts)
                    (lambda (read-envelope write-envelope)
                      (print-status
                        (node-sync-with-peer n
                                             (car peer)
                                             (cdr peer)
                                             read-envelope
                                             write-envelope
                                             max-steps
                                             max-blocks)))))
                (print-status
                  (node-sync-with-peers n
                                        (connect-node-peer-with-timeouts
                                          (car timeouts)
                                          (cadr timeouts)
                                          (caddr timeouts))
                                        max-peers
                                        max-retries
                                        max-steps
                                        max-blocks)))))))

    (define (run-sync-attempt args command)
      (guard (err (else #f))
        (run-sync-once args command)
        #t))

    (define (run-loop args)
      (let ((iterations (status-number args "--iterations" "1"))
            (max-retries (status-number args "--max-retries" "3"))
            (retry-delay (status-number args "--retry-delay" "0")))
        (let loop ((remaining iterations) (retries 0) (last #f))
          (if (<= remaining 0)
              last
              (if (run-sync-attempt args "run")
                  (loop (- remaining 1) 0 #t)
                  (if (>= retries max-retries)
                      (error "run: max retries exceeded")
                      (begin
                        (when (> retry-delay 0)
                          (sleep retry-delay))
                        (loop remaining (+ retries 1) last))))))))

    (define (main)
      (: -> void?)
      (let ((args (cdr (command-line))))
        (cond ((null? args)
               (usage))
              ((string=? (car args) "status")
               (run-status (cdr args)))
              ((string=? (car args) "peers")
               (run-peers (cdr args)))
              ((string=? (car args) "header-sync")
               (run-header-sync (cdr args)))
              ((string=? (car args) "sync")
               (run-sync-once (cdr args) "sync"))
              ((string=? (car args) "run")
               (run-loop (cdr args)))
              (else
               (usage)
               (error (string-append "unknown command: " (car args)))))))))
