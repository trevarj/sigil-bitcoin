(import (sigil test)
        (sigil secp256k1)
        (sigil crypto)
        (sigil math))

(define %native-secp256k1? (procedure? secp256k1-seckey-verify?))

(define (scalar-byte n)
  (let ((out (make-bytevector 32 0)))
    (bytevector-u8-set! out 31 n)
    out))

(if %native-secp256k1?
  (begin
    (test-group "seckey-verify?"
  (test "random seckey is valid"
    (assert-true (secp256k1-seckey-verify? (random-bytes 32))))
  (test "all-zeros is invalid"
    (assert-false (secp256k1-seckey-verify? (make-bytevector 32 0)))))

(test-group "pubkey-create"
  (test "returns 33-byte compressed key"
    (let ((pk (secp256k1-pubkey-create (random-bytes 32))))
      (assert-equal 33 (bytevector-length pk))
      (assert-true (or (= 2 (bytevector-u8-ref pk 0))
                       (= 3 (bytevector-u8-ref pk 0)))))))

(test-group "pubkey-parse"
  (test "round-trips through parse"
    (let* ((sk (random-bytes 32))
           (pk (secp256k1-pubkey-create sk))
           (parsed (secp256k1-pubkey-parse pk)))
      (assert-true (bytevector? parsed))
      (assert-equal 64 (bytevector-length parsed)))))

(test-group "ecdsa"
  (test "sign returns 64-byte compact sig"
    (let ((sig (secp256k1-ecdsa-sign (random-bytes 32)
                                     (sha256-bytes "test"))))
      (assert-true (bytevector? sig))
      (assert-equal 64 (bytevector-length sig))))
  (test "round-trip: sign then verify succeeds"
    (let* ((sk (random-bytes 32))
           (pk (secp256k1-pubkey-create sk))
           (msg (sha256-bytes "round-trip"))
           (sig (secp256k1-ecdsa-sign sk msg)))
      (assert-true (secp256k1-ecdsa-verify sig msg pk))))
  (test "verify fails with wrong message"
    (let* ((sk (random-bytes 32))
           (pk (secp256k1-pubkey-create sk))
           (good (sha256-bytes "good"))
           (bad  (sha256-bytes "bad"))
           (sig (secp256k1-ecdsa-sign sk good)))
      (assert-false (secp256k1-ecdsa-verify sig bad pk))))
  (test "verify fails with wrong key"
    (let* ((sk-a (random-bytes 32))
           (sk-b (random-bytes 32))
           (pk-b (secp256k1-pubkey-create sk-b))
           (msg (sha256-bytes "key test"))
           (sig (secp256k1-ecdsa-sign sk-a msg)))
      (assert-false (secp256k1-ecdsa-verify sig msg pk-b)))))

(test-group "ecdsa-der"
  (test "compact -> DER -> compact roundtrip"
    (let* ((sk (random-bytes 32))
           (msg (sha256-bytes "der test"))
           (compact (secp256k1-ecdsa-sign sk msg))
           (der (secp256k1-ecdsa-signature-serialize-der compact))
           (compact2 (secp256k1-ecdsa-signature-parse-der der))
           (pk (secp256k1-pubkey-create sk)))
      (assert-true (secp256k1-ecdsa-verify compact2 msg pk)))))

(test-group "tweak-add"
  (test "seckey tweak then derive pubkey"
    (let* ((sk (random-bytes 32))
           (tweak (random-bytes 32))
           (sk2 (secp256k1-seckey-tweak-add sk tweak))
           (pk (secp256k1-pubkey-create sk2)))
      (assert-true (bytevector? sk2))
      (assert-equal 33 (bytevector-length pk))))
  (test "pubkey tweak returns compressed child public key"
    (let* ((sk (random-bytes 32))
           (tweak (random-bytes 32))
           (sk2 (secp256k1-seckey-tweak-add sk tweak))
           (pk (secp256k1-pubkey-create sk))
           (expected (secp256k1-pubkey-create sk2))
           (tweaked (secp256k1-pubkey-tweak-add pk tweak)))
      (assert-equal 33 (bytevector-length tweaked))
      (assert-equal expected tweaked))))

(test-group "public key point operations"
  (test "pubkey-xonly matches keypair x-only output"
    (let* ((sk (random-bytes 32))
           (kp (secp256k1-keypair-create sk))
           (pk (secp256k1-pubkey-create sk)))
      (assert-equal (secp256k1-keypair-xonly-pub kp)
                    (secp256k1-pubkey-xonly pk))))
  (test "pubkey-tweak-mul by one preserves the public key"
    (let ((pk (secp256k1-pubkey-create (random-bytes 32))))
      (assert-equal pk (secp256k1-pubkey-tweak-mul pk (scalar-byte 1)))))
  (test "pubkey-combine matches secret-key addition"
    (let* ((sk-a (random-bytes 32))
           (sk-b (random-bytes 32))
           (sk-sum (secp256k1-seckey-tweak-add sk-a sk-b))
           (pk-a (secp256k1-pubkey-create sk-a))
           (pk-b (secp256k1-pubkey-create sk-b)))
      (assert-equal (secp256k1-pubkey-create sk-sum)
                    (secp256k1-pubkey-combine pk-a pk-b))))
  (test "xonly tweak matches keypair x-only tweak"
    (let* ((sk (random-bytes 32))
           (kp (secp256k1-keypair-create sk))
           (xonly (secp256k1-keypair-xonly-pub kp))
           (tweak (sha256-bytes "public xonly tweak"))
           (pub-tweaked (secp256k1-xonly-pubkey-tweak-add xonly tweak))
           (kp-tweaked (secp256k1-keypair-xonly-tweak-add kp tweak)))
      (assert-equal (secp256k1-keypair-xonly-pub kp-tweaked)
                    (secp256k1-pubkey-xonly pub-tweaked)))))

(test-group "keypair"
  (test "create returns 96-byte keypair"
    (let ((kp (secp256k1-keypair-create (random-bytes 32))))
      (assert-equal 96 (bytevector-length kp))))
  (test "pub returns 33-byte compressed key"
    (let* ((kp (secp256k1-keypair-create (random-bytes 32)))
           (pk (secp256k1-keypair-pub kp)))
      (assert-equal 33 (bytevector-length pk))))
  (test "xonly-pub returns serialized 32-byte key"
    (let* ((kp (secp256k1-keypair-create (random-bytes 32)))
           (xonly (secp256k1-keypair-xonly-pub kp)))
      (assert-equal 32 (bytevector-length xonly))))
  (test "xonly-pub-with-parity returns cons"
    (let* ((kp (secp256k1-keypair-create (random-bytes 32)))
           (result (secp256k1-keypair-xonly-pub-with-parity kp)))
      (assert-equal 32 (bytevector-length (car result)))
      (assert-true (or (= 0 (cdr result)) (= 1 (cdr result))))))
  (test "xonly tweak returns a signable tweaked keypair"
    (let* ((kp (secp256k1-keypair-create (random-bytes 32)))
           (tweak (sha256-bytes "xonly tweak"))
           (tweaked (secp256k1-keypair-xonly-tweak-add kp tweak))
           (xonly (secp256k1-keypair-xonly-pub tweaked))
           (msg (sha256-bytes "tweaked keypair"))
           (sig (secp256k1-schnorrsig-sign32 tweaked msg)))
      (assert-equal 96 (bytevector-length tweaked))
      (assert-equal 32 (bytevector-length xonly))
      (assert-true (secp256k1-schnorrsig-verify sig msg xonly)))))

(test-group "schnorrsig"
  (test "sign32 returns 64-byte sig"
    (let* ((kp (secp256k1-keypair-create (random-bytes 32)))
           (sig (secp256k1-schnorrsig-sign32 kp (sha256-bytes "schnorr"))))
      (assert-equal 64 (bytevector-length sig))))
  (test "round-trip: sign32 then verify succeeds"
    (let* ((kp (secp256k1-keypair-create (random-bytes 32)))
           (result (secp256k1-keypair-xonly-pub-with-parity kp))
           (xonly (car result))
           (msg (sha256-bytes "schnorr test"))
           (sig (secp256k1-schnorrsig-sign32 kp msg)))
      (assert-true (secp256k1-schnorrsig-verify sig msg xonly))))
  (test "verify fails with wrong message"
    (let* ((kp (secp256k1-keypair-create (random-bytes 32)))
           (result (secp256k1-keypair-xonly-pub-with-parity kp))
           (xonly (car result))
           (good (sha256-bytes "good"))
           (bad  (sha256-bytes "bad"))
           (sig (secp256k1-schnorrsig-sign32 kp good)))
      (assert-false (secp256k1-schnorrsig-verify sig bad xonly)))))

(test-group "invalid inputs"
  (test "seckey-verify? rejects non-bytevector and wrong length"
    (assert-false (secp256k1-seckey-verify? "not a key"))
    (assert-false (secp256k1-seckey-verify? (make-bytevector 31 1)))
    (assert-false (secp256k1-seckey-verify? (make-bytevector 32 0))))

  (test "pubkey-create errors for wrong length and invalid scalar"
    (assert-error (secp256k1-pubkey-create (make-bytevector 31 1)))
    (assert-error (secp256k1-pubkey-create (make-bytevector 32 0))))

  (test "pubkey-parse rejects invalid types, lengths, and encodings"
    (assert-error (secp256k1-pubkey-parse "not a pubkey"))
    (assert-false (secp256k1-pubkey-parse (make-bytevector 32 2)))
    (assert-false (secp256k1-pubkey-parse (make-bytevector 33 0))))

  (test "tweak-add errors for bad key or tweak length"
    (let ((pk (secp256k1-pubkey-create (random-bytes 32))))
      (assert-error
        (secp256k1-pubkey-tweak-add (make-bytevector 33 0)
                                    (make-bytevector 32 1)))
      (assert-error
        (secp256k1-pubkey-tweak-add pk (make-bytevector 31 1)))
      (assert-error
        (secp256k1-seckey-tweak-add (make-bytevector 31 1)
                                    (make-bytevector 32 1)))
      (assert-error
        (secp256k1-seckey-tweak-add (random-bytes 32)
                                    (make-bytevector 31 1)))))

  (test "public key point operations reject invalid input"
    (let ((pk (secp256k1-pubkey-create (random-bytes 32))))
      (assert-error (secp256k1-pubkey-xonly (make-bytevector 33 0)))
      (assert-error (secp256k1-pubkey-tweak-mul pk (make-bytevector 31 1)))
      (assert-error (secp256k1-pubkey-tweak-mul pk (make-bytevector 32 0)))
      (assert-error (secp256k1-pubkey-combine pk (make-bytevector 33 0)))
      (assert-error
        (secp256k1-xonly-pubkey-tweak-add (make-bytevector 31 1)
                                          (make-bytevector 32 1)))
      (assert-error
        (secp256k1-xonly-pubkey-tweak-add (secp256k1-pubkey-xonly pk)
                                          (make-bytevector 31 1)))))

  (test "ecdsa rejects invalid input lengths and DER"
    (let* ((sk (random-bytes 32))
           (pk (secp256k1-pubkey-create sk))
           (msg (sha256-bytes "invalid ecdsa"))
           (sig (secp256k1-ecdsa-sign sk msg)))
      (assert-error (secp256k1-ecdsa-sign (make-bytevector 31 1) msg))
      (assert-error (secp256k1-ecdsa-sign sk (make-bytevector 31 1)))
      (assert-error (secp256k1-ecdsa-verify (make-bytevector 63 1) msg pk))
      (assert-error (secp256k1-ecdsa-verify sig (make-bytevector 31 1) pk))
      (assert-error
        (secp256k1-ecdsa-verify sig msg (make-bytevector 33 0)))
      (assert-error
        (secp256k1-ecdsa-signature-parse-der (make-bytevector 4 0)))
      (assert-error
        (secp256k1-ecdsa-signature-serialize-der (make-bytevector 63 1)))))

  (test "keypair and schnorr functions reject invalid lengths"
    (let* ((kp (secp256k1-keypair-create (random-bytes 32)))
           (msg (sha256-bytes "invalid schnorr"))
           (sig (secp256k1-schnorrsig-sign32 kp msg))
           (xonly (secp256k1-keypair-xonly-pub kp)))
      (assert-error (secp256k1-keypair-create (make-bytevector 31 1)))
      (assert-error (secp256k1-keypair-create (make-bytevector 32 0)))
      (assert-error (secp256k1-keypair-pub (make-bytevector 95 1)))
      (assert-error (secp256k1-keypair-xonly-pub (make-bytevector 95 1)))
      (assert-error
        (secp256k1-keypair-xonly-pub-with-parity (make-bytevector 95 1)))
      (assert-error
        (secp256k1-keypair-xonly-tweak-add (make-bytevector 95 1)
                                           (make-bytevector 32 1)))
      (assert-error
        (secp256k1-keypair-xonly-tweak-add kp (make-bytevector 31 1)))
      (assert-error
        (secp256k1-schnorrsig-sign32 (make-bytevector 95 1) msg))
      (assert-error
        (secp256k1-schnorrsig-sign32 kp (make-bytevector 31 1)))
      (assert-error
        (secp256k1-schnorrsig-verify (make-bytevector 63 1) msg xonly))
      (assert-error
        (secp256k1-schnorrsig-verify sig (make-bytevector 31 1) xonly))
      (assert-error
        (secp256k1-schnorrsig-verify sig msg (make-bytevector 31 1)))))))
  (test-group "sigil-secp256k1"
    (test-skip "native module is not linked in direct workspace runner"
      #t)))

(run-tests)
