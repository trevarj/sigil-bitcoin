;;; sigil-secp256k1 - secp256k1 ECDSA + Schnorr native bindings

(package
  name: "sigil-secp256k1"
  version: "0.1.0"
  sigil: "^0.15"
  description: "secp256k1 ECDSA + Schnorr native bindings"
  url: "https://codeberg.org/sigil/sigil-bitcoin"
  license: "BSD-3-Clause"

  dependencies: (list
    (from-path dir: "../../../sigil-crypto"
               package: "sigil-crypto"))

  dev-dependencies: (list
    (from-git url: "codeberg:sigil/sigil"
              package: "sigil-stdlib" version: "^0.15")
    (from-git url: "codeberg:sigil/sigil-ansi" version: "^0.13.1")
    (from-git url: "codeberg:sigil/sigil-json" version: "^0.13.1")
    (from-git url: "codeberg:sigil/sigil-version" version: "^0.13.1")
    (from-git url: "codeberg:sigil/sigil"
              package: "sigil-test" version: "^0.15")
    (from-git url: "codeberg:sigil/sigil"
              package: "sigil-test-runner" version: "^0.15"))

  libraries: (list
    (library
      name: 'sigil-secp256k1
      c-sources: '("native/secp256k1.c")
      c-flags: (with-sigil-c-flags '("-std=c99"
                                     "-Wall" "-Wextra"
                                     "-Wno-unused-parameter"))
      native-init: "sigil__init_sigil_secp256k1_module"
      link-flags: '("-lsecp256k1")))

  tasks: (list
    (task
      name: 'build
      description: "Build sigil-secp256k1 native bindings"
      steps: (list
        (compile-c-sources
          sources: '("native/secp256k1.c")
          flags: (with-sigil-c-flags '("-std=c99"
                                       "-Wall" "-Wextra"
                                       "-Wno-unused-parameter")))

        (create-static-library
          name: "sigil-secp256k1")

        (compile-sigil-modules
          sources: "src/**/*.sgl")))))
