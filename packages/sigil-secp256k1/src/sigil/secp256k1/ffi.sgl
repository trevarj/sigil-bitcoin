;;; (sigil secp256k1 ffi) — Low-level FFI Bindings to libsecp256k1
;;;
;;; Thin wrapper over the secp256k1 C library. All functions accept
;;; and return FFI pointers and fixnums. The high-level (sigil secp256k1)
;;; module wraps this with bytevector-based convenience.
;;;
;;; Struct sizes (pass c-alloc'd pointers):
;;;   pubkey       = 64 bytes
;;;   signature    = 64 bytes
;;;   keypair      = 96 bytes
;;;   xonly_pubkey = 64 bytes
;;;
;;; ```scheme
;;; (import (sigil secp256k1 ffi))
;;; ```

(define-library (sigil secp256k1 ffi)
  (import (sigil ffi))
  (export
    ;; Context flags
    secp256k1-context-none
    secp256k1-context-sign
    secp256k1-context-verify
    secp256k1-context-both
    ;; Serialization flags
    secp256k1-ec-compressed
    secp256k1-ec-uncompressed
    ;; Struct sizes
    secp256k1-pubkey-size
    secp256k1-signature-size
    secp256k1-keypair-size
    secp256k1-xonly-pubkey-size
    ;; Library handle
    secp256k1-lib
    ;; Context management
    secp256k1-context-create
    secp256k1-context-destroy
    ;; Key operations
    secp256k1-ec-seckey-verify
    secp256k1-ec-pubkey-create
    secp256k1-ec-pubkey-parse
    secp256k1-ec-pubkey-serialize
    secp256k1-ec-pubkey-tweak-add
    secp256k1-ec-seckey-tweak-add
    ;; ECDSA
    secp256k1-ecdsa-sign
    secp256k1-ecdsa-verify
    secp256k1-ecdsa-signature-parse-compact
    secp256k1-ecdsa-signature-serialize-compact
    secp256k1-ecdsa-signature-parse-der
    secp256k1-ecdsa-signature-serialize-der
    ;; Schnorr (BIP 340)
    secp256k1-schnorrsig-sign
    secp256k1-schnorrsig-verify
    ;; Keypair (BIP 340 / taproot)
    secp256k1-keypair-create
    secp256k1-keypair-pub
    secp256k1-keypair-xonly-pub)

  (begin

    ;; ============================================================
    ;; Constants
    ;; ============================================================

    (define secp256k1-context-none 0)
    (define secp256k1-context-sign 1)         ;; (1u << 0)
    (define secp256k1-context-verify 256)     ;; (1u << 8)
    (define secp256k1-context-both 257)       ;; sign | verify

    (define secp256k1-ec-compressed 258)      ;; ((1u << 1) | (1u << 8))
    (define secp256k1-ec-uncompressed 260)    ;; ((1u << 2) | (1u << 8))

    (define secp256k1-pubkey-size 64)
    (define secp256k1-signature-size 64)
    (define secp256k1-keypair-size 96)
    (define secp256k1-xonly-pubkey-size 64)

    ;; ============================================================
    ;; Library
    ;; ============================================================

    (define secp256k1-lib (c-library "libsecp256k1"))

    ;; ============================================================
    ;; Context
    ;; ============================================================

    (define secp256k1-context-create
      (c-function secp256k1-lib "secp256k1_context_create"
        (list ffi/uint) ffi/pointer))

    (define secp256k1-context-destroy
      (c-function secp256k1-lib "secp256k1_context_destroy"
        (list ffi/pointer) ffi/void))

    ;; ============================================================
    ;; Key Operations
    ;; ============================================================

    (define secp256k1-ec-seckey-verify
      (c-function secp256k1-lib "secp256k1_ec_seckey_verify"
        (list ffi/pointer ffi/pointer) ffi/int))

    (define secp256k1-ec-pubkey-create
      (c-function secp256k1-lib "secp256k1_ec_pubkey_create"
        (list ffi/pointer ffi/pointer ffi/pointer) ffi/int))

    (define secp256k1-ec-pubkey-parse
      (c-function secp256k1-lib "secp256k1_ec_pubkey_parse"
        (list ffi/pointer ffi/pointer ffi/pointer ffi/size-t) ffi/int))

    (define secp256k1-ec-pubkey-serialize
      (c-function secp256k1-lib "secp256k1_ec_pubkey_serialize"
        (list ffi/pointer ffi/pointer ffi/pointer ffi/pointer ffi/uint) ffi/int))

    (define secp256k1-ec-pubkey-tweak-add
      (c-function secp256k1-lib "secp256k1_ec_pubkey_tweak_add"
        (list ffi/pointer ffi/pointer ffi/pointer) ffi/int))

    (define secp256k1-ec-seckey-tweak-add
      (c-function secp256k1-lib "secp256k1_ec_seckey_tweak_add"
        (list ffi/pointer ffi/pointer ffi/pointer) ffi/int))

    ;; ============================================================
    ;; ECDSA
    ;; ============================================================

    (define secp256k1-ecdsa-sign
      (c-function secp256k1-lib "secp256k1_ecdsa_sign"
        (list ffi/pointer ffi/pointer ffi/pointer ffi/pointer
              ffi/pointer ffi/pointer) ffi/int))

    (define secp256k1-ecdsa-verify
      (c-function secp256k1-lib "secp256k1_ecdsa_verify"
        (list ffi/pointer ffi/pointer ffi/pointer ffi/pointer) ffi/int))

    (define secp256k1-ecdsa-signature-parse-compact
      (c-function secp256k1-lib "secp256k1_ecdsa_signature_parse_compact"
        (list ffi/pointer ffi/pointer ffi/pointer) ffi/int))

    (define secp256k1-ecdsa-signature-serialize-compact
      (c-function secp256k1-lib "secp256k1_ecdsa_signature_serialize_compact"
        (list ffi/pointer ffi/pointer ffi/pointer) ffi/int))

    (define secp256k1-ecdsa-signature-parse-der
      (c-function secp256k1-lib "secp256k1_ecdsa_signature_parse_der"
        (list ffi/pointer ffi/pointer ffi/pointer ffi/size-t) ffi/int))

    (define secp256k1-ecdsa-signature-serialize-der
      (c-function secp256k1-lib "secp256k1_ecdsa_signature_serialize_der"
        (list ffi/pointer ffi/pointer ffi/pointer ffi/pointer) ffi/int))

    ;; ============================================================
    ;; Schnorr (BIP 340)
    ;; ============================================================

    (define secp256k1-schnorrsig-sign
      (c-function secp256k1-lib "secp256k1_schnorrsig_sign"
        (list ffi/pointer ffi/pointer ffi/pointer ffi/pointer
              ffi/pointer) ffi/int))

    (define secp256k1-schnorrsig-verify
      (c-function secp256k1-lib "secp256k1_schnorrsig_verify"
        (list ffi/pointer ffi/pointer ffi/pointer ffi/size-t
              ffi/pointer) ffi/int))

    ;; ============================================================
    ;; Keypair (BIP 340 / taproot)
    ;; ============================================================

    (define secp256k1-keypair-create
      (c-function secp256k1-lib "secp256k1_keypair_create"
        (list ffi/pointer ffi/pointer ffi/pointer) ffi/int))

    (define secp256k1-keypair-pub
      (c-function secp256k1-lib "secp256k1_keypair_pub"
        (list ffi/pointer ffi/pointer ffi/pointer) ffi/int))

    (define secp256k1-keypair-xonly-pub
      (c-function secp256k1-lib "secp256k1_keypair_xonly_pub"
        (list ffi/pointer ffi/pointer ffi/pointer ffi/pointer) ffi/int))
    ))
