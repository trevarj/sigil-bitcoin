(import (sigil test)
        (sigil bitcoin script))

(define %pubkey-hash
  #u8(#x75 #x1e #x76 #xe8 #x19 #x91 #x96 #xd4 #x54 #x94
      #x1c #x45 #xd1 #xb3 #xa3 #x23 #xf1 #x43 #x3b #xd6))

(define %script-hash
  #u8(#x4d #x3b #x49 #x80 #xb3 #x9d #x47 #x37 #xb1 #x5d
      #x22 #x8d #x8c #x31 #xa6 #xbd #xfb #x7f #xd8 #xc7))

(define %sha256
  #u8(#x00 #x01 #x02 #x03 #x04 #x05 #x06 #x07
      #x08 #x09 #x0a #x0b #x0c #x0d #x0e #x0f
      #x10 #x11 #x12 #x13 #x14 #x15 #x16 #x17
      #x18 #x19 #x1a #x1b #x1c #x1d #x1e #x1f))

(define %xonly
  #u8(#x79 #xbe #x66 #x7e #xf9 #xdc #xbb #xac
      #x55 #xa0 #x62 #x95 #xce #x87 #x0b #x07
      #x02 #x9b #xfc #xdb #x2d #xce #x28 #xd9
      #x59 #xf2 #x81 #x5b #x16 #xf8 #x17 #x98))

(test-group "script byte constructors"
  (test "script-op emits one byte"
    (assert-equal #u8(#xac) (script-op op-checksig)))

  (test "script-append concatenates bytevectors"
    (assert-equal #u8(#x51 #x52 #x53)
                  (script-append (script-op op-1)
                                 (script-op op-2)
                                 (script-op op-3))))

  (test "pushdata direct length"
    (assert-equal #u8(#x03 #x01 #x02 #x03)
                  (script-push-data #u8(#x01 #x02 #x03))))

  (test "pushdata1 boundary"
    (let ((data (make-bytevector 76 #xaa)))
      (assert-equal 78 (bytevector-length (script-push-data data)))
      (assert-equal #x4c (bytevector-u8-ref (script-push-data data) 0))
      (assert-equal 76 (bytevector-u8-ref (script-push-data data) 1))))

  (test "pushdata2 boundary"
    (let ((data (make-bytevector 256 #xbb)))
      (assert-equal 259 (bytevector-length (script-push-data data)))
      (assert-equal #x4d (bytevector-u8-ref (script-push-data data) 0))
      (assert-equal 0 (bytevector-u8-ref (script-push-data data) 1))
      (assert-equal 1 (bytevector-u8-ref (script-push-data data) 2)))))

(test-group "script parsing"
  (test "parses opcodes and direct pushdata"
    (let ((chunks (script-parse
                    (script-append
                      (script-op op-dup)
                      (script-push-data #u8(#x01 #x02 #x03))
                      (script-op op-checksig)))))
      (assert-equal 3 (length chunks))
      (assert-equal op-dup (script-chunk-opcode (car chunks)))
      (assert-false (script-chunk-data (car chunks)))
      (assert-equal 3 (script-chunk-opcode (cadr chunks)))
      (assert-equal #u8(#x01 #x02 #x03) (script-chunk-data (cadr chunks)))
      (assert-equal op-checksig (script-chunk-opcode (caddr chunks)))))

  (test "parses PUSHDATA1 and PUSHDATA2"
    (let* ((data1 (make-bytevector 76 #xaa))
           (data2 (make-bytevector 256 #xbb))
           (chunks (script-parse
                     (script-append
                       (script-push-data data1)
                       (script-push-data data2)))))
      (assert-equal 2 (length chunks))
      (assert-equal op-pushdata1 (script-chunk-opcode (car chunks)))
      (assert-equal data1 (script-chunk-data (car chunks)))
      (assert-equal op-pushdata2 (script-chunk-opcode (cadr chunks)))
      (assert-equal data2 (script-chunk-data (cadr chunks)))))

  (test "rejects truncated pushdata"
    (assert-error (script-parse #u8(#x03 #x01 #x02)))
    (assert-error (script-parse #u8(#x4c)))
    (assert-error (script-parse #u8(#x4c #x02 #x01)))
    (assert-error (script-parse #u8(#x4d #x01)))
    (assert-error (script-parse #u8(#x4d #x02 #x00 #x01)))))

(test-group "script numbers and ASM"
  (test "encodes and decodes script numbers"
    (assert-equal #u8() (script-number-encode 0))
    (assert-equal #u8(#x01) (script-number-encode 1))
    (assert-equal #u8(#x81) (script-number-encode -1))
    (assert-equal #u8(#x80 #x00) (script-number-encode 128))
    (assert-equal #u8(#x80 #x80) (script-number-encode -128))
    (assert-equal 0 (script-number-decode #u8()))
    (assert-equal 1 (script-number-decode #u8(#x01)))
    (assert-equal -1 (script-number-decode #u8(#x81)))
    (assert-equal 128 (script-number-decode #u8(#x80 #x00)))
    (assert-equal -128 (script-number-decode #u8(#x80 #x80))))

  (test "formats standard scripts as ASM"
    (assert-equal
      (string-append
        "OP_DUP OP_HASH160 "
        "751e76e8199196d454941c45d1b3a323f1433bd6 "
        "OP_EQUALVERIFY OP_CHECKSIG")
      (script->asm (script-p2pkh %pubkey-hash)))
    (assert-equal "OP_1 OP_CHECKSIG"
                  (script-decompile
                    (script-append (script-op op-1)
                                   (script-op op-checksig))))))

(test-group "standard scriptPubKey templates"
  (test "P2PKH"
    (assert-equal
      #u8(#x76 #xa9 #x14 #x75 #x1e #x76 #xe8 #x19 #x91 #x96
          #xd4 #x54 #x94 #x1c #x45 #xd1 #xb3 #xa3 #x23 #xf1
          #x43 #x3b #xd6 #x88 #xac)
      (script-p2pkh %pubkey-hash)))

  (test "P2SH"
    (assert-equal
      #u8(#xa9 #x14 #x4d #x3b #x49 #x80 #xb3 #x9d #x47 #x37
          #xb1 #x5d #x22 #x8d #x8c #x31 #xa6 #xbd #xfb #x7f
          #xd8 #xc7 #x87)
      (script-p2sh %script-hash)))

  (test "P2WPKH"
    (assert-equal
      #u8(#x00 #x14 #x75 #x1e #x76 #xe8 #x19 #x91 #x96 #xd4
          #x54 #x94 #x1c #x45 #xd1 #xb3 #xa3 #x23 #xf1 #x43
          #x3b #xd6)
      (script-p2wpkh %pubkey-hash)))

  (test "P2WSH"
    (assert-equal
      #u8(#x00 #x20 #x00 #x01 #x02 #x03 #x04 #x05 #x06 #x07
          #x08 #x09 #x0a #x0b #x0c #x0d #x0e #x0f #x10 #x11
          #x12 #x13 #x14 #x15 #x16 #x17 #x18 #x19 #x1a #x1b
          #x1c #x1d #x1e #x1f)
      (script-p2wsh %sha256)))

  (test "P2TR"
    (assert-equal
      #u8(#x51 #x20 #x79 #xbe #x66 #x7e #xf9 #xdc #xbb #xac
          #x55 #xa0 #x62 #x95 #xce #x87 #x0b #x07 #x02 #x9b
          #xfc #xdb #x2d #xce #x28 #xd9 #x59 #xf2 #x81 #x5b
          #x16 #xf8 #x17 #x98)
      (script-p2tr %xonly))))

(test-group "standard scriptPubKey classification"
  (test "classifies standard outputs"
    (assert-equal 'p2pkh (script-classify (script-p2pkh %pubkey-hash)))
    (assert-equal 'p2sh (script-classify (script-p2sh %script-hash)))
    (assert-equal 'p2wpkh (script-classify (script-p2wpkh %pubkey-hash)))
    (assert-equal 'p2wsh (script-classify (script-p2wsh %sha256)))
    (assert-equal 'p2tr (script-classify (script-p2tr %xonly)))
    (assert-equal 'unknown (script-classify #u8(#x51 #xac))))

  (test "extracts standard payloads"
    (assert-equal %pubkey-hash
                  (script-standard-payload (script-p2pkh %pubkey-hash)))
    (assert-equal %script-hash
                  (script-standard-payload (script-p2sh %script-hash)))
    (assert-equal %pubkey-hash
                  (script-standard-payload (script-p2wpkh %pubkey-hash)))
    (assert-equal %sha256
                  (script-standard-payload (script-p2wsh %sha256)))
    (assert-equal %xonly
                  (script-standard-payload (script-p2tr %xonly)))
    (assert-false (script-standard-payload #u8(#x51 #xac))))

  (test "decodes witness programs"
    (let ((decoded (script-witness-program-decode (script-p2tr %xonly))))
      (assert-equal 1 (car decoded))
      (assert-equal %xonly (cadr decoded)))
    (assert-false (script-witness-program-decode (script-p2pkh %pubkey-hash)))))

(test-group "script validation"
  (test "standard templates reject wrong hash sizes"
    (assert-error (script-p2pkh (make-bytevector 19 0)))
    (assert-error (script-p2sh (make-bytevector 21 0)))
    (assert-error (script-p2wsh (make-bytevector 31 0)))
    (assert-error (script-p2tr (make-bytevector 33 0))))

  (test "witness program rejects invalid version and size"
    (assert-error (script-witness-program 17 #u8(#x01 #x02)))
    (assert-error (script-witness-program 0 #u8(#x01)))
    (assert-error (script-witness-program 0 (make-bytevector 41 0)))))

(run-tests)
