;;; (sigil bitcoin script) — Bitcoin script byte constructors

(define-library (sigil bitcoin script)
  (import (sigil struct)
          (sigil math))
  (export
    op-0 op-pushdata1 op-pushdata2 op-pushdata4
    op-1 op-2 op-3 op-4 op-5 op-6 op-7 op-8
    op-9 op-10 op-11 op-12 op-13 op-14 op-15 op-16
    op-if op-notif op-else op-endif op-verify
    op-ifdup op-dup op-size op-ripemd160 op-sha256 op-hash160
    op-hash256 op-equal op-equalverify op-swap
    op-add op-booland op-boolor op-checksig op-checksigverify
    op-checkmultisig op-checkmultisigverify
    op-checklocktimeverify op-checksequenceverify
    script-empty
    script-op
    script-append
    script-push-data
    script-witness-program
    script-p2pkh
    script-p2sh
    script-p2wpkh
    script-p2wsh
    script-p2tr
    script-chunk script-chunk?
    script-chunk-opcode script-chunk-data
    script-parse
    script-number-encode
    script-number-decode
    script->asm
    script-decompile
    script-witness-program-decode
    script-classify
    script-standard-payload)
  (begin

    (define op-0 #x00)
    (define op-pushdata1 #x4c)
    (define op-pushdata2 #x4d)
    (define op-pushdata4 #x4e)
    (define op-1 #x51)
    (define op-2 #x52)
    (define op-3 #x53)
    (define op-4 #x54)
    (define op-5 #x55)
    (define op-6 #x56)
    (define op-7 #x57)
    (define op-8 #x58)
    (define op-9 #x59)
    (define op-10 #x5a)
    (define op-11 #x5b)
    (define op-12 #x5c)
    (define op-13 #x5d)
    (define op-14 #x5e)
    (define op-15 #x5f)
    (define op-16 #x60)
    (define op-if #x63)
    (define op-notif #x64)
    (define op-else #x67)
    (define op-endif #x68)
    (define op-verify #x69)
    (define op-ifdup #x73)
    (define op-dup #x76)
    (define op-swap #x7c)
    (define op-size #x82)
    (define op-ripemd160 #xa6)
    (define op-sha256 #xa8)
    (define op-hash160 #xa9)
    (define op-hash256 #xaa)
    (define op-equal #x87)
    (define op-equalverify #x88)
    (define op-add #x93)
    (define op-booland #x9a)
    (define op-boolor #x9b)
    (define op-checksig #xac)
    (define op-checksigverify #xad)
    (define op-checkmultisig #xae)
    (define op-checkmultisigverify #xaf)
    (define op-checklocktimeverify #xb1)
    (define op-checksequenceverify #xb2)

    ;;; Empty script bytevector.
    (define script-empty #u8())

    ;;; Parsed script chunk. `data` is a bytevector for push operations and
    ;;; `#f` for non-push opcodes.
    (define-struct script-chunk
      (opcode integer?)
      (data any?))

    (define (require-bytevector who bytes)
      (unless (bytevector? bytes)
        (error (string-append who ": expected bytevector")))
      bytes)

    (define (require-bytevector-length who bytes len)
      (require-bytevector who bytes)
      (unless (= len (bytevector-length bytes))
        (error (string-append who ": expected "
                              (number->string len)
                              "-byte bytevector")))
      bytes)

    (define (require-u8 who value)
      (unless (and (integer? value) (<= 0 value 255))
        (error (string-append who ": expected byte value")))
      value)

    ;;; Return a one-byte script containing the given opcode.
    (define (script-op opcode)
      (: integer? -> bytevector?)
      (make-bytevector 1 (require-u8 "script-op" opcode)))

    ;;; Concatenate script bytevector fragments.
    (define (script-append . parts)
      (: bytevector? ... -> bytevector?)
      (let ((total 0))
        (do ((xs parts (cdr xs)))
            ((null? xs))
          (require-bytevector "script-append" (car xs))
          (set! total (+ total (bytevector-length (car xs)))))
        (let ((out (make-bytevector total 0))
              (offset 0))
          (do ((xs parts (cdr xs)))
              ((null? xs) out)
            (let ((part (car xs)))
              (bytevector-copy! out offset part)
              (set! offset (+ offset (bytevector-length part))))))))

    (define (le16-bytevector n)
      (let ((out (make-bytevector 2 0)))
        (bytevector-u8-set! out 0 (bitwise-and n #xff))
        (bytevector-u8-set! out 1 (bitwise-and (arithmetic-shift n -8) #xff))
        out))

    (define (le32-bytevector n)
      (let ((out (make-bytevector 4 0)))
        (bytevector-u8-set! out 0 (bitwise-and n #xff))
        (bytevector-u8-set! out 1 (bitwise-and (arithmetic-shift n -8) #xff))
        (bytevector-u8-set! out 2 (bitwise-and (arithmetic-shift n -16) #xff))
        (bytevector-u8-set! out 3 (bitwise-and (arithmetic-shift n -24) #xff))
        out))

    (define (le16-ref bytes offset)
      (bitwise-ior
        (bytevector-u8-ref bytes offset)
        (arithmetic-shift (bytevector-u8-ref bytes (+ offset 1)) 8)))

    (define (le32-ref bytes offset)
      (bitwise-ior
        (bytevector-u8-ref bytes offset)
        (arithmetic-shift (bytevector-u8-ref bytes (+ offset 1)) 8)
        (arithmetic-shift (bytevector-u8-ref bytes (+ offset 2)) 16)
        (arithmetic-shift (bytevector-u8-ref bytes (+ offset 3)) 24)))

    (define (bytes-prefix? bytes prefix)
      (and (>= (bytevector-length bytes) (bytevector-length prefix))
           (let loop ((i 0))
             (if (>= i (bytevector-length prefix))
                 #t
                 (and (= (bytevector-u8-ref bytes i)
                         (bytevector-u8-ref prefix i))
                      (loop (+ i 1)))))))

    (define (bytes-suffix? bytes suffix)
      (let ((blen (bytevector-length bytes))
            (slen (bytevector-length suffix)))
        (and (>= blen slen)
             (let loop ((i 0))
               (if (>= i slen)
                   #t
                   (and (= (bytevector-u8-ref bytes (+ (- blen slen) i))
                           (bytevector-u8-ref suffix i))
                        (loop (+ i 1))))))))

    (define (byte-list->bytevector bytes)
      (let* ((len (length bytes))
             (out (make-bytevector len 0)))
        (let loop ((xs bytes) (i 0))
          (if (null? xs)
              out
              (begin
                (bytevector-u8-set! out i (car xs))
                (loop (cdr xs) (+ i 1)))))))

    (define (last-item xs)
      (if (null? (cdr xs))
          (car xs)
          (last-item (cdr xs))))

    (define (replace-last xs value)
      (if (null? (cdr xs))
          (list value)
          (cons (car xs) (replace-last (cdr xs) value))))

    (define (join-strings strings sep)
      (cond ((null? strings) "")
            ((null? (cdr strings)) (car strings))
            (else
             (let loop ((xs (cdr strings))
                        (out (car strings)))
               (if (null? xs)
                   out
                   (loop (cdr xs) (string-append out sep (car xs))))))))

    (define (hex-encode-local bytes)
      (let* ((len (bytevector-length bytes))
             (hex "0123456789abcdef")
             (out (make-string (* 2 len))))
        (do ((i 0 (+ i 1)))
            ((>= i len) out)
          (let* ((b (bytevector-u8-ref bytes i))
                 (hi (arithmetic-shift b -4))
                 (lo (bitwise-and b #x0f)))
            (string-set! out (* 2 i) (string-ref hex hi))
            (string-set! out (+ 1 (* 2 i)) (string-ref hex lo))))))

    ;;; Encode a minimally-sized pushdata operation for a bytevector.
    (define (script-push-data data)
      (: bytevector? -> bytevector?)
      (require-bytevector "script-push-data" data)
      (let ((len (bytevector-length data)))
        (cond ((<= len 75)
               (script-append (script-op len) data))
              ((<= len #xff)
               (script-append (script-op op-pushdata1)
                              (script-op len)
                              data))
              ((<= len #xffff)
               (script-append (script-op op-pushdata2)
                              (le16-bytevector len)
                              data))
              ((<= len #xffffffff)
               (script-append (script-op op-pushdata4)
                              (le32-bytevector len)
                              data))
              (else
               (error "script-push-data: pushdata too large")))))

    ;;; Build a native witness program scriptPubKey.
    ;;;
    ;;; Version 0 is encoded as OP_0. Versions 1 through 16 use OP_1 through
    ;;; OP_16 followed by the witness program push.
    (define (script-witness-program version program)
      (: integer? bytevector? -> bytevector?)
      (require-bytevector "script-witness-program" program)
      (when (or (< version 0) (> version 16))
        (error "script-witness-program: witness version out of range"))
      (when (or (< (bytevector-length program) 2)
                (> (bytevector-length program) 40))
        (error "script-witness-program: witness program length out of range"))
      (script-append
        (script-op (if (= version 0) op-0 (+ #x50 version)))
        (script-push-data program)))

    ;;; Build a standard P2PKH scriptPubKey from a 20-byte public key hash.
    (define (script-p2pkh pubkey-hash)
      (: bytevector? -> bytevector?)
      (require-bytevector-length "script-p2pkh" pubkey-hash 20)
      (script-append
        (script-op op-dup)
        (script-op op-hash160)
        (script-push-data pubkey-hash)
        (script-op op-equalverify)
        (script-op op-checksig)))

    ;;; Build a standard P2SH scriptPubKey from a 20-byte script hash.
    (define (script-p2sh script-hash)
      (: bytevector? -> bytevector?)
      (require-bytevector-length "script-p2sh" script-hash 20)
      (script-append
        (script-op op-hash160)
        (script-push-data script-hash)
        (script-op op-equal)))

    ;;; Build a native P2WPKH scriptPubKey from a 20-byte public key hash.
    (define (script-p2wpkh pubkey-hash)
      (: bytevector? -> bytevector?)
      (require-bytevector-length "script-p2wpkh" pubkey-hash 20)
      (script-witness-program 0 pubkey-hash))

    ;;; Build a native P2WSH scriptPubKey from a 32-byte witness script hash.
    (define (script-p2wsh script-hash)
      (: bytevector? -> bytevector?)
      (require-bytevector-length "script-p2wsh" script-hash 32)
      (script-witness-program 0 script-hash))

    ;;; Build a native P2TR scriptPubKey from a 32-byte x-only public key.
    (define (script-p2tr xonly-pubkey)
      (: bytevector? -> bytevector?)
      (require-bytevector-length "script-p2tr" xonly-pubkey 32)
      (script-witness-program 1 xonly-pubkey))

    ;;; Parse raw script bytes into opcode/data chunks.
    ;;;
    ;;; Raises an error for truncated pushdata encodings.
    (define (script-parse script)
      (: bytevector? -> list?)
      (require-bytevector "script-parse" script)
      (let ((len (bytevector-length script)))
        (let loop ((offset 0) (chunks '()))
          (if (>= offset len)
              (reverse chunks)
              (let ((opcode (bytevector-u8-ref script offset)))
                (cond ((<= opcode 75)
                       (let ((start (+ offset 1))
                             (end (+ offset 1 opcode)))
                         (when (> end len)
                           (error "script-parse: truncated direct pushdata"))
                         (loop end
                               (cons (script-chunk opcode: opcode
                                                   data: (bytevector-copy script start end))
                                     chunks))))
                      ((= opcode op-pushdata1)
                       (when (> (+ offset 2) len)
                         (error "script-parse: truncated OP_PUSHDATA1 length"))
                       (let* ((size (bytevector-u8-ref script (+ offset 1)))
                              (start (+ offset 2))
                              (end (+ start size)))
                         (when (> end len)
                           (error "script-parse: truncated OP_PUSHDATA1 data"))
                         (loop end
                               (cons (script-chunk opcode: opcode
                                                   data: (bytevector-copy script start end))
                                     chunks))))
                      ((= opcode op-pushdata2)
                       (when (> (+ offset 3) len)
                         (error "script-parse: truncated OP_PUSHDATA2 length"))
                       (let* ((size (le16-ref script (+ offset 1)))
                              (start (+ offset 3))
                              (end (+ start size)))
                         (when (> end len)
                           (error "script-parse: truncated OP_PUSHDATA2 data"))
                         (loop end
                               (cons (script-chunk opcode: opcode
                                                   data: (bytevector-copy script start end))
                                     chunks))))
                      ((= opcode op-pushdata4)
                       (when (> (+ offset 5) len)
                         (error "script-parse: truncated OP_PUSHDATA4 length"))
                       (let* ((size (le32-ref script (+ offset 1)))
                              (start (+ offset 5))
                              (end (+ start size)))
                         (when (> end len)
                           (error "script-parse: truncated OP_PUSHDATA4 data"))
                         (loop end
                               (cons (script-chunk opcode: opcode
                                                   data: (bytevector-copy script start end))
                                     chunks))))
                      (else
                       (loop (+ offset 1)
                             (cons (script-chunk opcode: opcode data: #f)
                                   chunks)))))))))

    ;;; Encode an integer using Bitcoin Script's little-endian signed-magnitude
    ;;; number format.
    (define (script-number-encode n)
      (: integer? -> bytevector?)
      (unless (integer? n)
        (error "script-number-encode: expected integer"))
      (if (= n 0)
          #u8()
          (let ((negative? (< n 0))
                (value (if (< n 0) (- n) n)))
            (let loop ((v value) (bytes '()))
              (if (= v 0)
                  (let* ((ordered (reverse bytes))
                         (last (last-item ordered))
                         (encoded
                           (cond ((not (= 0 (bitwise-and last #x80)))
                                  (append ordered (list (if negative? #x80 0))))
                                 (negative?
                                  (replace-last ordered (bitwise-ior last #x80)))
                                 (else ordered))))
                    (byte-list->bytevector encoded))
                  (loop (quotient v 256)
                        (cons (remainder v 256) bytes)))))))

    ;;; Decode a Bitcoin Script little-endian signed-magnitude number.
    (define (script-number-decode bytes)
      (: bytevector? -> integer?)
      (require-bytevector "script-number-decode" bytes)
      (let ((len (bytevector-length bytes)))
        (if (= len 0)
            0
            (let* ((last (bytevector-u8-ref bytes (- len 1)))
                   (negative? (not (= 0 (bitwise-and last #x80)))))
              (let loop ((i 0) (value 0))
                (if (>= i len)
                    (if negative? (- value) value)
                    (let ((b (bytevector-u8-ref bytes i)))
                      (loop (+ i 1)
                            (+ value
                               (arithmetic-shift
                                 (if (= i (- len 1))
                                     (bitwise-and b #x7f)
                                     b)
                                 (* 8 i)))))))))))

    (define (small-int-opcode? opcode)
      (and (>= opcode op-1) (<= opcode op-16)))

    (define (opcode-name opcode)
      (cond ((= opcode op-0) "OP_0")
            ((= opcode op-pushdata1) "OP_PUSHDATA1")
            ((= opcode op-pushdata2) "OP_PUSHDATA2")
            ((= opcode op-pushdata4) "OP_PUSHDATA4")
            ((small-int-opcode? opcode)
             (string-append "OP_" (number->string (- opcode #x50))))
            ((= opcode op-if) "OP_IF")
            ((= opcode op-notif) "OP_NOTIF")
            ((= opcode op-else) "OP_ELSE")
            ((= opcode op-endif) "OP_ENDIF")
            ((= opcode op-verify) "OP_VERIFY")
            ((= opcode op-ifdup) "OP_IFDUP")
            ((= opcode op-dup) "OP_DUP")
            ((= opcode op-swap) "OP_SWAP")
            ((= opcode op-size) "OP_SIZE")
            ((= opcode op-ripemd160) "OP_RIPEMD160")
            ((= opcode op-sha256) "OP_SHA256")
            ((= opcode op-hash160) "OP_HASH160")
            ((= opcode op-hash256) "OP_HASH256")
            ((= opcode op-equal) "OP_EQUAL")
            ((= opcode op-equalverify) "OP_EQUALVERIFY")
            ((= opcode op-add) "OP_ADD")
            ((= opcode op-booland) "OP_BOOLAND")
            ((= opcode op-boolor) "OP_BOOLOR")
            ((= opcode op-checksig) "OP_CHECKSIG")
            ((= opcode op-checksigverify) "OP_CHECKSIGVERIFY")
            ((= opcode op-checkmultisig) "OP_CHECKMULTISIG")
            ((= opcode op-checkmultisigverify) "OP_CHECKMULTISIGVERIFY")
            ((= opcode op-checklocktimeverify) "OP_CHECKLOCKTIMEVERIFY")
            ((= opcode op-checksequenceverify) "OP_CHECKSEQUENCEVERIFY")
            (else
             (string-append "OP_UNKNOWN_" (hex-encode-local (script-op opcode))))))

    (define (script-chunk->asm chunk)
      (let ((opcode (script-chunk-opcode chunk))
            (data (script-chunk-data chunk)))
        (if (bytevector? data)
            (if (and (= opcode op-0) (= 0 (bytevector-length data)))
                "OP_0"
                (hex-encode-local data))
            (opcode-name opcode))))

    ;;; Decompile raw script bytes to a simple Bitcoin Core-style ASM string.
    (define (script->asm script)
      (: bytevector? -> string?)
      (join-strings
        (map script-chunk->asm (script-parse script))
        " "))

    ;;; Alias for callers that use decompiler terminology.
    (define (script-decompile script)
      (: bytevector? -> string?)
      (script->asm script))

    ;;; Decode a native witness program scriptPubKey.
    ;;;
    ;;; Returns `(version program)` for a valid witness program shape, otherwise
    ;;; `#f`. This validates only the script shape and witness program length;
    ;;; address-level Bech32 checksum rules live in `(sigil bitcoin encoding)`.
    (define (script-witness-program-decode script)
      (: bytevector? -> (any-of list? boolean?))
      (require-bytevector "script-witness-program-decode" script)
      (let ((len (bytevector-length script)))
        (if (< len 4)
            #f
            (let* ((version-op (bytevector-u8-ref script 0))
                   (version (cond ((= version-op op-0) 0)
                                  ((and (>= version-op op-1)
                                        (<= version-op op-16))
                                   (- version-op #x50))
                                  (else #f)))
                   (program-len (bytevector-u8-ref script 1)))
              (if (or (not version)
                      (not (= len (+ 2 program-len)))
                      (< program-len 2)
                      (> program-len 40))
                  #f
                  (list version (bytevector-copy script 2 len)))))))

    ;;; Classify a standard scriptPubKey.
    ;;;
    ;;; Returns one of `p2pkh`, `p2sh`, `p2wpkh`, `p2wsh`, `p2tr`, or
    ;;; `unknown`.
    (define (script-classify script)
      (: bytevector? -> symbol?)
      (require-bytevector "script-classify" script)
      (let ((len (bytevector-length script)))
        (cond ((and (= len 25)
                    (bytes-prefix? script #u8(#x76 #xa9 #x14))
                    (bytes-suffix? script #u8(#x88 #xac)))
               'p2pkh)
              ((and (= len 23)
                    (bytes-prefix? script #u8(#xa9 #x14))
                    (bytes-suffix? script #u8(#x87)))
               'p2sh)
              ((let ((witness (script-witness-program-decode script)))
                 (and witness
                      (= 0 (car witness))
                      (= 20 (bytevector-length (cadr witness)))))
               'p2wpkh)
              ((let ((witness (script-witness-program-decode script)))
                 (and witness
                      (= 0 (car witness))
                      (= 32 (bytevector-length (cadr witness)))))
               'p2wsh)
              ((let ((witness (script-witness-program-decode script)))
                 (and witness
                      (= 1 (car witness))
                      (= 32 (bytevector-length (cadr witness)))))
               'p2tr)
              (else 'unknown))))

    ;;; Extract the standard payload from a recognized scriptPubKey.
    ;;;
    ;;; For P2PKH/P2SH this is the 20-byte hash. For witness outputs this is
    ;;; the witness program. Returns `#f` for unknown scripts.
    (define (script-standard-payload script)
      (: bytevector? -> (any-of bytevector? boolean?))
      (case (script-classify script)
        ((p2pkh)
         (bytevector-copy script 3 23))
        ((p2sh)
         (bytevector-copy script 2 22))
        ((p2wpkh p2wsh p2tr)
         (cadr (script-witness-program-decode script)))
        (else #f)))))
