;;; (sigil bitcoin encoding) — Bitcoin address encoding formats

(define-library (sigil bitcoin encoding)
  (import (sigil crypto) (sigil math) (sigil bitcoin primitives))
  (export
    hex-encode hex-decode
    base58-encode base58-decode
    base58check-encode base58check-decode
    bech32-encode bech32-decode
    bech32m-encode bech32m-decode
    segwit-encode segwit-decode)
  (begin

    (define (char->hex c)
      (let ((i (char->integer c)))
        (cond ((<= 48 i 57)  (- i 48))
              ((<= 65 i 70)  (+ 10 (- i 65)))
              ((<= 97 i 102) (+ 10 (- i 97)))
              (else #f))))

    (define (hex-encode bytes)
      (let* ((len (bytevector-length bytes))
             (hex-chars "0123456789abcdef")
             (out (make-string (* 2 len))))
        (do ((i 0 (+ i 1)))
            ((>= i len) out)
          (let* ((b (bytevector-u8-ref bytes i))
                 (hi (arithmetic-shift b -4))
                 (lo (bitwise-and b #x0f)))
            (string-set! out (* 2 i)       (string-ref hex-chars hi))
            (string-set! out (+ 1 (* 2 i)) (string-ref hex-chars lo))))))

    (define (hex-decode str)
      (let ((len (string-length str)))
        (when (odd? len) (error "hex-decode: odd-length string"))
        (let ((out (make-bytevector (/ len 2) 0)))
          (do ((i 0 (+ i 2)))
              ((>= i len) out)
            (let ((hi (char->hex (string-ref str i)))
                  (lo (char->hex (string-ref str (+ i 1)))))
              (when (or (not hi) (not lo))
                (error "hex-decode: invalid hex character"))
              (bytevector-u8-set! out (/ i 2)
                (bitwise-ior (arithmetic-shift hi 4) lo)))))))

    (define %base58-alphabet "123456789ABCDEFGHJKLMNPQRSTUVWXYZabcdefghijkmnopqrstuvwxyz")

    (define (base58-char-value c)
      (let ((i (char->integer c)))
        (cond ((= i 49) 0)
              ((<= 50 i 57)  (- i 49))
              ((<= 65 i 72)  (+ 9 (- i 65)))
              ((<= 74 i 78)  (+ 17 (- i 74)))
              ((<= 80 i 90)  (+ 22 (- i 80)))
              ((<= 97 i 107) (+ 33 (- i 97)))
              ((<= 109 i 122) (+ 44 (- i 109)))
              (else #f))))

    (define (base58-encode bytes)
      (let ((len (bytevector-length bytes)))
        (let loop-zeros ((i 0))
          (if (and (< i len) (= 0 (bytevector-u8-ref bytes i)))
              (loop-zeros (+ i 1))
              (let* ((b (make-bytevector (- len i) 0))
                     (digitcount 0))
                (do ((j i (+ j 1)))
                    ((>= j len))
                  (bytevector-u8-set! b (- j i) (bytevector-u8-ref bytes j)))
                (let loop-div ((bv b) (digits '()))
                  (let check-zero ((k 0))
                    (if (>= k (bytevector-length bv))
                        (let* ((zeros-str (make-string i #\1))
                               (digits-str (list->string
                                 (map (lambda (d)
                                        (string-ref %base58-alphabet d))
                                      digits))))
                          (string-append zeros-str digits-str))
                        (if (= 0 (bytevector-u8-ref bv k))
                            (check-zero (+ k 1))
                            (let* ((blen (bytevector-length bv))
                                   (carry 0)
                                   (new-bv (make-bytevector blen 0))
                                   (new-len 0))
                              (do ((k 0 (+ k 1)))
                                  ((>= k blen))
                                (let ((n (+ (* 256 carry) (bytevector-u8-ref bv k))))
                                  (let ((q (quotient n 58))
                                        (r (remainder n 58)))
                                    (set! carry r)
                                    (when (or (> new-len 0) (> q 0))
                                      (bytevector-u8-set! new-bv new-len q)
                                      (set! new-len (+ new-len 1))))))
                              (let ((trimmed (bytevector-copy new-bv 0 new-len)))
                                (loop-div trimmed (cons carry digits)))))))))))))

    (define (base58-decode str)
      (let* ((slen (string-length str))
             (zeros 0))
        (let count-1s ((i 0))
          (if (and (< i slen) (char=? #\1 (string-ref str i)))
              (begin (set! zeros (+ zeros 1)) (count-1s (+ i 1)))
              'done))
        (let* ((result '())
               (chunk (make-bytevector 1 0)))
          (do ((i zeros (+ i 1)))
              ((>= i slen))
            (let ((val (base58-char-value (string-ref str i))))
              (when (not val) (error "base58-decode: invalid character"))
              (let* ((rlen (length result))
                     (carry val))
                (let mult-add ((j 0) (new-result '()))
                  (if (>= j rlen)
                      (begin
                        (when (> carry 0)
                          (set! new-result (cons carry new-result)))
                        (set! result (reverse new-result)))
                      (let* ((n (+ (* (list-ref result j) 58) carry))
                             (q (quotient n 256))
                             (r (remainder n 256)))
                        (set! carry q)
                        (mult-add (+ j 1) (cons r new-result))))))))
          (let* ((rlen (length result))
                 (out (make-bytevector (+ zeros rlen) 0)))
            (do ((i 0 (+ i 1)))
                ((>= i zeros))
              (bytevector-u8-set! out i 0))
            (do ((i 0 (+ i 1)))
                ((>= i rlen))
              (bytevector-u8-set! out (+ zeros i) (list-ref result (- rlen 1 i))))
            out))))

    (define (base58check-encode version payload)
      (let* ((vlen (bytevector-length payload))
             (full (make-bytevector (+ 1 vlen) 0)))
        (bytevector-u8-set! full 0 version)
        (do ((i 0 (+ i 1)))
            ((>= i vlen))
          (bytevector-u8-set! full (+ i 1) (bytevector-u8-ref payload i)))
        (let* ((hash (hash256 full))
               (with-cksum (make-bytevector (+ 1 vlen 4) 0)))
          (do ((i 0 (+ i 1)))
              ((>= i (+ 1 vlen)))
            (bytevector-u8-set! with-cksum i (bytevector-u8-ref full i)))
          (do ((i 0 (+ i 1)))
              ((>= i 4))
            (bytevector-u8-set! with-cksum (+ 1 vlen i) (bytevector-u8-ref hash i)))
          (base58-encode with-cksum))))

    (define (base58check-decode str)
      (let* ((raw (base58-decode str))
             (len (bytevector-length raw)))
        (when (< len 5) (error "base58check-decode: too short"))
        (let* ((dlen (- len 4))
               (payload (bytevector-copy raw 0 dlen))
               (cksum   (bytevector-copy raw dlen len))
               (expected (bytevector-copy (hash256 payload) 0 4)))
          (unless (equal? cksum expected)
            (error "base58check-decode: checksum mismatch"))
          (let ((version (bytevector-u8-ref payload 0))
                (data    (bytevector-copy payload 1)))
            (list version data)))))

    (define %bech32-charset "qpzry9x8gf2tvdw0s3jn54khce6mua7l")

    (define %bech32-gen #(#x3b6a57b2 #x26508e6d #x1ea119fa #x3d4233dd #x2a1462b3))

    (define %bech32m-const #x2bc830a3)

    (define (bech32-char-value c)
      (cond ((char=? c #\q) 0)  ((char=? c #\p) 1)  ((char=? c #\z) 2)
            ((char=? c #\r) 3)  ((char=? c #\y) 4)  ((char=? c #\9) 5)
            ((char=? c #\x) 6)  ((char=? c #\8) 7)  ((char=? c #\g) 8)
            ((char=? c #\f) 9)  ((char=? c #\2) 10) ((char=? c #\t) 11)
            ((char=? c #\v) 12) ((char=? c #\d) 13) ((char=? c #\w) 14)
            ((char=? c #\0) 15) ((char=? c #\s) 16) ((char=? c #\3) 17)
            ((char=? c #\j) 18) ((char=? c #\n) 19) ((char=? c #\5) 20)
            ((char=? c #\4) 21) ((char=? c #\k) 22) ((char=? c #\h) 23)
            ((char=? c #\c) 24) ((char=? c #\e) 25) ((char=? c #\6) 26)
            ((char=? c #\m) 27) ((char=? c #\u) 28) ((char=? c #\a) 29)
            ((char=? c #\7) 30) ((char=? c #\l) 31)
            ((char=? c #\Q) 0)  ((char=? c #\P) 1)  ((char=? c #\Z) 2)
            ((char=? c #\R) 3)  ((char=? c #\Y) 4)  ((char=? c #\9) 5)
            ((char=? c #\X) 6)  ((char=? c #\8) 7)  ((char=? c #\G) 8)
            ((char=? c #\F) 9)  ((char=? c #\2) 10) ((char=? c #\T) 11)
            ((char=? c #\V) 12) ((char=? c #\D) 13) ((char=? c #\W) 14)
            ((char=? c #\0) 15) ((char=? c #\S) 16) ((char=? c #\3) 17)
            ((char=? c #\J) 18) ((char=? c #\N) 19) ((char=? c #\5) 20)
            ((char=? c #\4) 21) ((char=? c #\K) 22) ((char=? c #\H) 23)
            ((char=? c #\C) 24) ((char=? c #\E) 25) ((char=? c #\6) 26)
            ((char=? c #\M) 27) ((char=? c #\U) 28) ((char=? c #\A) 29)
            ((char=? c #\7) 30) ((char=? c #\L) 31)
            (else #f)))

    (define (bech32-polymod values)
      (let ((chk 1))
        (do ((vs values (cdr vs)))
            ((null? vs) chk)
          (let* ((v (car vs))
                 (top (arithmetic-shift chk -25))
                 (chk5 (bitwise-xor
                         (arithmetic-shift (bitwise-and chk #x1ffffff) 5)
                         v)))
            (set! chk chk5)
            (do ((i 0 (+ i 1)))
                ((>= i 5))
              (when (not (zero? (bitwise-and top (arithmetic-shift 1 i))))
                (set! chk (bitwise-xor chk (vector-ref %bech32-gen i)))))))))

    (define (bech32-hrp-expand hrp)
      (let* ((len (string-length hrp))
             (result '()))
        (do ((i 0 (+ i 1)))
            ((>= i len))
          (let ((c (char->integer (string-ref hrp i))))
            (set! result (append result (list (arithmetic-shift c -5))))))
        (set! result (append result '(0)))
        (do ((i 0 (+ i 1)))
            ((>= i len))
          (let ((c (char->integer (string-ref hrp i))))
            (set! result (append result (list (bitwise-and c 31))))))
        result))

    (define (bech32-valid-hrp? hrp)
      (let ((len (string-length hrp))
            (ok #t))
        (do ((i 0 (+ i 1)))
            ((>= i len) ok)
          (let ((c (char->integer (string-ref hrp i))))
            (when (or (< c 33) (> c 126))
              (set! ok #f)
              (set! i len))))))

    (define (bech32-mixed-case? str)
      (and (not (string=? str (string-downcase str)))
           (not (string=? str (string-upcase str)))))

    (define (bech32-create-checksum hrp data const)
      (let* ((values (append (bech32-hrp-expand hrp) data '(0 0 0 0 0 0)))
             (polymod (bitwise-xor (bech32-polymod values) const))
             (v0 (bitwise-and (arithmetic-shift polymod -25) 31))
             (v1 (bitwise-and (arithmetic-shift polymod -20) 31))
             (v2 (bitwise-and (arithmetic-shift polymod -15) 31))
             (v3 (bitwise-and (arithmetic-shift polymod -10) 31))
             (v4 (bitwise-and (arithmetic-shift polymod -5)  31))
             (v5 (bitwise-and polymod 31)))
        (list v0 v1 v2 v3 v4 v5)))

    (define (bech32-encode hrp data)
      (let ((cksum (bech32-create-checksum hrp data 1)))
        (string-append
          hrp "1"
          (list->string
            (map (lambda (d) (string-ref %bech32-charset d))
                 (append data cksum))))))

    (define (bech32-decode str)
      (let* ((len (string-length str))
             (pos (let find-1 ((i (- len 1)))
                    (if (< i 0)
                        #f
                        (if (char=? #\1 (string-ref str i))
                            i
                            (find-1 (- i 1)))))))
        (if (or (not pos) (bech32-mixed-case? str))
            #f
            (let* ((hrp (substring str 0 pos))
                   (dlen (- len pos 1)))
              (if (or (< dlen 6)
                      (zero? (string-length hrp))
                      (not (bech32-valid-hrp? hrp))
                      (> len 90))
                  #f
                  (let ((data (make-bytevector dlen 0)))
                    (do ((i 0 (+ i 1)))
                        ((>= i dlen))
                      (let ((v (bech32-char-value (string-ref str (+ pos 1 i)))))
                        (if (not v)
                            (begin (set! data #f) (set! i dlen))
                            (bytevector-u8-set! data i v))))
                    (if (not data)
                        #f
                        (let* ((dlist (let loop ((i 0) (acc '()))
                                        (if (>= i dlen)
                                            (reverse acc)
                                            (loop (+ i 1)
                                                  (cons (bytevector-u8-ref data i) acc)))))
                               (values (append (bech32-hrp-expand (string-downcase hrp)) dlist)))
                          (let ((pm (bech32-polymod values)))
                            (if (= pm 1)
                                (list hrp (let loop ((i 0) (acc '()))
                                            (if (>= i (- dlen 6))
                                                (reverse acc)
                                                (loop (+ i 1)
                                                  (cons (bytevector-u8-ref data i) acc)))))
                                #f))))))))))

    (define (bech32m-encode hrp data)
      (let ((cksum (bech32-create-checksum hrp data %bech32m-const)))
        (string-append
          hrp "1"
          (list->string
            (map (lambda (d) (string-ref %bech32-charset d))
                 (append data cksum))))))

    (define (bech32m-decode str)
      (let* ((len (string-length str))
             (pos (let find-1 ((i (- len 1)))
                    (if (< i 0)
                        #f
                        (if (char=? #\1 (string-ref str i))
                            i
                            (find-1 (- i 1)))))))
        (if (or (not pos) (bech32-mixed-case? str))
            #f
            (let* ((hrp (substring str 0 pos))
                   (dlen (- len pos 1)))
              (if (or (< dlen 6)
                      (zero? (string-length hrp))
                      (not (bech32-valid-hrp? hrp))
                      (> len 90))
                  #f
                  (let ((data (make-bytevector dlen 0)))
                    (do ((i 0 (+ i 1)))
                        ((>= i dlen))
                      (let ((v (bech32-char-value (string-ref str (+ pos 1 i)))))
                        (if (not v)
                            (begin (set! data #f) (set! i dlen))
                            (bytevector-u8-set! data i v))))
                    (if (not data)
                        #f
                        (let* ((dlist (let loop ((i 0) (acc '()))
                                        (if (>= i dlen)
                                            (reverse acc)
                                            (loop (+ i 1)
                                                  (cons (bytevector-u8-ref data i) acc)))))
                               (values (append (bech32-hrp-expand (string-downcase hrp)) dlist)))
                          (let ((pm (bech32-polymod values)))
                            (if (= pm %bech32m-const)
                                (list hrp (let loop ((i 0) (acc '()))
                                            (if (>= i (- dlen 6))
                                                (reverse acc)
                                                (loop (+ i 1)
                                                  (cons (bytevector-u8-ref data i) acc)))))
                                #f))))))))))

    ;; ── 8-to-5 bit conversion ─────────────────────────────

    (define (convertbits data frombits tobits pad?)
      (define maxv (- (arithmetic-shift 1 tobits) 1))
      (define max-acc (- (arithmetic-shift 1 (+ frombits tobits -1)) 1))
      (let ((acc 0) (bits 0) (result '()))
        (let loop ((vs data))
          (if (null? vs)
              (if pad?
                  (begin
                    (when (> bits 0)
                      (set! result (append result
                        (list (bitwise-and
                                (arithmetic-shift acc (- tobits bits))
                                maxv)))))
                    result)
                  (if (or (>= bits frombits)
                          (not (zero?
                                 (bitwise-and
                                   (arithmetic-shift acc (- tobits bits))
                                   maxv))))
                      #f
                      result))
              (let ((v (car vs)))
                (when (or (< v 0) (not (zero? (arithmetic-shift v (- frombits)))))
                  (error "convertbits: value out of range"))
                (set! acc (bitwise-and
                            (bitwise-ior (arithmetic-shift acc frombits) v)
                            max-acc))
                (set! bits (+ bits frombits))
                (let inner ()
                  (when (>= bits tobits)
                    (set! bits (- bits tobits))
                    (set! result (append result
                      (list (bitwise-and
                              (arithmetic-shift acc (- bits))
                              maxv))))
                    (inner)))
                (set! acc (bitwise-and acc
                            (- (arithmetic-shift 1 bits) 1)))
                (loop (cdr vs)))))))

    ;; ── SegWit address encoding ────────────────────────────

    (define (segwit-scriptpubkey version program)
      (let* ((plen (bytevector-length program))
             (out (make-bytevector (+ 2 plen) 0)))
        (bytevector-u8-set! out 0 (if (= version 0) 0 version))
        (bytevector-u8-set! out 1 plen)
        (do ((i 0 (+ i 1)))
            ((>= i plen))
          (bytevector-u8-set! out (+ 2 i) (bytevector-u8-ref program i)))
        out))

    (define (segwit-encode hrp version program)
      (let* ((bytes (let ((vals '()))
                      (do ((i 0 (+ i 1)))
                          ((>= i (bytevector-length program)))
                        (set! vals (append vals
                          (list (bytevector-u8-ref program i)))))
                      vals))
             (data5 (convertbits bytes 8 5 #t))
             (data (cons version data5)))
        (if (not data5)
            (error "segwit-encode: convertbits failed")
            (if (= version 0)
                (bech32-encode hrp data)
                (bech32m-encode hrp data)))))

    (define (segwit-decode addr)
      (let ((upper (string-upcase addr)))
        (if (and (not (string=? addr (string-downcase addr)))
                 (not (string=? addr upper)))
            #f
            (let* ((decoded-bech32 (bech32-decode addr))
                   (decoded-bech32m (if decoded-bech32 #f (bech32m-decode addr)))
                   (result (or decoded-bech32 decoded-bech32m)))
              (if (not result)
                  #f
                  (let* ((hrp (car result))
                         (data (cadr result)))
                    (if (null? data)
                        #f
                        (let* ((version (car data))
                               (prog5 (cdr data)))
                          (if (or (< version 0) (> version 16))
                              #f
                              (if (and (= version 0) decoded-bech32m)
                                  #f
                                  (if (and (> version 0) decoded-bech32)
                                      #f
                                      (let ((converted (convertbits prog5 5 8 #f)))
                                        (if (or (not converted) (null? converted))
                                            #f
                                            (let ((plen (length converted)))
                                              (if (or (< plen 2) (> plen 40))
                                                  #f
                                                  (if (and (= version 0)
                                                           (not (or (= plen 20) (= plen 32))))
                                                      #f
                                                      (let ((prog-bv (make-bytevector plen 0)))
                                                        (do ((i 0 (+ i 1))
                                                             (rest converted (cdr rest)))
                                                            ((>= i plen))
                                                          (bytevector-u8-set! prog-bv i (car rest)))
                                                        (list (string-downcase hrp) version prog-bv))))))))))))))))))

    ))
