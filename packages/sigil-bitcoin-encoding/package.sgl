;;; sigil-bitcoin-encoding — Bitcoin address encoding formats
;;;
;;; Pure Sigil library providing hex, base58, base58check, bech32, and bech32m.

(package
  name: "sigil-bitcoin-encoding"
  version: "0.1.0"
  sigil: "^0.16"
  description: "Bitcoin encoding formats: hex, base58, base58check, bech32/bech32m"
  url: "https://codeberg.org/sigil/sigil-bitcoin"
  license: "BSD-3-Clause"

  dependencies: (list
    "sigil-bitcoin-primitives"
    "sigil-crypto")

  tasks: (list
    (task
      name: 'build
      description: "Build sigil-bitcoin-encoding"
      steps: (list
        (compile-sigil-modules
          sources: "src/**/*.sgl")))))
