(import (sigil test)
        (sigil bitcoin encoding)
        (sigil crypto))

;; ════════════════════════════════════════════════════════════
;; Hex Encoding — Bitcoin Core test vectors
;; ════════════════════════════════════════════════════════════

(test-group "hex-encode"
  (test "empty bytevector"
    (assert-equal "" (hex-encode #u8())))
  (test "deadbeef"
    (assert-equal "deadbeef" (hex-encode #u8(#xde #xad #xbe #xef))))
  (test "single byte 0xff"
    (assert-equal "ff" (hex-encode #u8(#xff))))
  (test "single byte 0x00"
    (assert-equal "00" (hex-encode #u8(#x00))))
  (test "all nibble values"
    (assert-equal "0123456789abcdef"
      (hex-encode #u8(#x01 #x23 #x45 #x67 #x89 #xab #xcd #xef)))))

(test-group "hex-decode"
  (test "empty string"
    (assert-equal #u8() (hex-decode "")))
  (test "deadbeef lowercase"
    (assert-equal #u8(#xde #xad #xbe #xef) (hex-decode "deadbeef")))
  (test "deadbeef uppercase"
    (assert-equal #u8(#xde #xad #xbe #xef) (hex-decode "DEADBEEF")))
  (test "deadbeef mixed case"
    (assert-equal #u8(#xde #xad #xbe #xef) (hex-decode "DeadBeef")))
  (test "zero bytes"
    (assert-equal #u8(#x00 #x00) (hex-decode "0000"))))

(test-group "hex-roundtrip"
  (test "random 32 bytes"
    (let ((bytes (random-bytes 32)))
      (assert-equal bytes (hex-decode (hex-encode bytes)))))
  (test "random 1 byte"
    (let ((bytes (random-bytes 1)))
      (assert-equal bytes (hex-decode (hex-encode bytes))))))

;; ════════════════════════════════════════════════════════════
;; Base58 — Bitcoin Core test vectors (base58_encode_decode.json)
;; ════════════════════════════════════════════════════════════

(test-group "base58-encode"
  (test "empty"
    (assert-equal "" (base58-encode #u8())))
  (test "0x61 -> 2g"
    (assert-equal "2g" (base58-encode #u8(#x61))))
  (test "0x626262 -> a3gV"
    (assert-equal "a3gV" (base58-encode #u8(#x62 #x62 #x62))))
  (test "0x636363 -> aPEr"
    (assert-equal "aPEr" (base58-encode #u8(#x63 #x63 #x63))))
  (test  "simple long string"
    (assert-equal "2cFupjhnEsSn59qHXstmK2ffpLv2"
      (base58-encode #u8(
        #x73 #x69 #x6d #x70 #x6c #x79 #x20 #x61 #x20 #x6c
        #x6f #x6e #x67 #x20 #x73 #x74 #x72 #x69 #x6e #x67))))
  (test "leading zeros: 0x00 -> 1"
    (assert-equal "1" (base58-encode #u8(#x00))))
  (test "leading zeros: 0x00 0x00 0x00 -> 111"
    (assert-equal "111" (base58-encode #u8(#x00 #x00 #x00))))
  (test "0x572e4794 -> 3EFU7m"
    (assert-equal "3EFU7m" (base58-encode #u8(#x57 #x2e #x47 #x94))))
  (test "twenty zero bytes -> twenty 1s"
    (assert-equal "11111111111111111111"
      (base58-encode (make-bytevector 20 0))))
  (test "rust-bitcoin: [0] -> 1"
    (assert-equal "1" (base58-encode #u8(#x00))))
  (test "rust-bitcoin: [1] -> 2"
    (assert-equal "2" (base58-encode #u8(#x01))))
  (test "rust-bitcoin: [58] -> 21"
    (assert-equal "21" (base58-encode #u8(#x3a))))
  (test "rust-bitcoin: [13, 36] -> 211"
    (assert-equal "211" (base58-encode #u8(#x0d #x24))))
  (test "rust-bitcoin: [0, 13, 36] -> 1211"
    (assert-equal "1211" (base58-encode #u8(#x00 #x0d #x24))))
  (test "rust-bitcoin: [0,0,0,0,13,36] -> 1111211"
    (assert-equal "1111211"
      (base58-encode #u8(#x00 #x00 #x00 #x00 #x0d #x24)))))

(test-group "base58-decode"
  (test "empty"
    (assert-equal #u8() (base58-decode "")))
  (test "2g -> 0x61"
    (assert-equal #u8(#x61) (base58-decode "2g")))
  (test "a3gV -> 0x626262"
    (assert-equal #u8(#x62 #x62 #x62) (base58-decode "a3gV")))
  (test "aPEr -> 0x636363"
    (assert-equal #u8(#x63 #x63 #x63) (base58-decode "aPEr")))
  (test "3EFU7m -> 0x572e4794"
    (assert-equal #u8(#x57 #x2e #x47 #x94) (base58-decode "3EFU7m")))
  (test "rust-bitcoin: 1 -> [0]"
    (assert-equal 1 (bytevector-length (base58-decode "1"))))
  (test "rust-bitcoin: 2 -> [1]"
    (assert-equal 1 (bytevector-length (base58-decode "2"))))
  (test "rust-bitcoin: 21 -> [58]"
    (assert-equal 1 (bytevector-length (base58-decode "21"))))
  (test "rust-bitcoin: 1211 -> [0, 13, 36]"
    (assert-equal 3 (bytevector-length (base58-decode "1211")))))

(test-group "base58-roundtrip"
  (test "random 32 bytes"
    (let ((bytes (random-bytes 32)))
      (assert-equal bytes (base58-decode (base58-encode bytes)))))
  (test "random 1 byte"
    (let ((bytes (random-bytes 1)))
      (assert-equal bytes (base58-decode (base58-encode bytes)))))
  (test "leading zeros preserved"
    (let ((bytes #u8(#x00 #x00 #x61)))
      (assert-equal bytes (base58-decode (base58-encode bytes))))))

;; ════════════════════════════════════════════════════════════
;; Base58Check — rust-bitcoin test vectors
;; ════════════════════════════════════════════════════════════

(test-group "base58check"
  (test "encode round-trip: rust-bitcoin address"
    (let* ((payload (hex-decode "00f8917303bfa8ef24f292e8fa1419b20460ba064d"))
           (encoded "1PfJpZsjreyVrqeoAfabrRwwjQyoSQMmHH"))
      (assert-equal encoded (base58check-encode 0 (bytevector-copy payload 1)))))
  (test "decode: rust-bitcoin address"
    (let* ((result (base58check-decode "1PfJpZsjreyVrqeoAfabrRwwjQyoSQMmHH"))
           (version (car result))
           (data (cadr result)))
      (assert-equal 0 version)
      (assert-equal 20 (bytevector-length data))))
  (test "encode empty payload"
    (let ((encoded (base58check-encode 0 #u8())))
      (assert-true (string? encoded))
      (assert-true (> (string-length encoded) 0)))))

;; ════════════════════════════════════════════════════════════
;; Bech32 — BIP 173 test vectors
;; ════════════════════════════════════════════════════════════

(test-group "bech32-encode-decode"
  (test "valid: A12UEL5L round-trips"
    (let ((decoded (bech32-decode "A12UEL5L")))
      (assert-true (list? decoded))
      (assert-equal "A" (car decoded))))
  (test "valid: a12uel5l round-trips"
    (let ((decoded (bech32-decode "a12uel5l")))
      (assert-true (list? decoded))
      (assert-equal "a" (car decoded))))
  (test "valid: ?1ezyfcl round-trips"
    (let ((decoded (bech32-decode "?1ezyfcl")))
      (assert-true (list? decoded))))
  (test "invalid: no separator"
    (assert-false (bech32-decode "pzry9x0s0muk")))
  (test "invalid: empty HRP"
    (assert-false (bech32-decode "1pzry9x0s0muk")))
  (test "invalid: too short checksum"
    (assert-false (bech32-decode "li1dgmt3"))))

;; ════════════════════════════════════════════════════════════
;; Bech32m — BIP 350 test vectors
;; ════════════════════════════════════════════════════════════

(test-group "bech32m-encode-decode"
  (test "valid: A1LQFN3A"
    (let ((decoded (bech32m-decode "A1LQFN3A")))
      (assert-true (list? decoded))
      (assert-equal "A" (car decoded))))
  (test "valid: ?1v759aa"
    (let ((decoded (bech32m-decode "?1v759aa")))
      (assert-true (list? decoded))))
  (test "invalid: no separator"
    (assert-false (bech32m-decode "qyrz8wqd2c9m")))
  (test "invalid: empty HRP"
    (assert-false (bech32m-decode "1qyrz8wqd2c9m")))
  (test "invalid: too short"
    (assert-false (bech32m-decode "in1muywd"))))

;; ════════════════════════════════════════════════════════════
;; SegWit Address — BIP 173 / BIP 350 address vectors
;; ════════════════════════════════════════════════════════════

(test-group "segwit-v0"
  ;; Round-trip encode/decode works correctly
  (test "encode then decode round-trips"
    (let* ((hrp "bc")
           (program (hex-decode "751e76e8199196d454941c45d1b3a323f1433bd6"))
           (addr (segwit-encode hrp 0 program))
           (decoded (segwit-decode addr)))
      (assert-equal "bc1qw508d6qejxtdg4y5r3zarvary0c5xw7kv8f3t4" addr)
      (assert-true (list? decoded))
      (let ((d-hrp (car decoded))
            (d-ver (cadr decoded))
            (d-prog (caddr decoded)))
        (assert-equal hrp d-hrp)
        (assert-equal 0 d-ver)
        (assert-equal program d-prog))))
  (test "decoded BIP173 address parses correctly"
    (let ((decoded (segwit-decode "BC1QW508D6QEJXTDG4Y5R3ZARVARY0C5XW7KV8F3T4")))
      (assert-true (list? decoded))
      (assert-equal "bc" (car decoded))
      (assert-equal 0 (cadr decoded)))))

(test-group "segwit-v1"
  (test "encode then decode round-trips (taproot)"
    (let* ((hrp "bc")
           (program (hex-decode "79be667ef9dcbbac55a06295ce870b07029bfcdb2dce28d959f2815b16f81798"))
           (addr (segwit-encode hrp 1 program))
           (decoded (segwit-decode addr)))
      (assert-equal "bc1p0xlxvlhemja6c4dqv22uapctqupfhlxm9h8z3k2e72q4k9hcz7vqzk5jj0" addr)
      (assert-true (list? decoded))
      (assert-equal hrp (car decoded))
      (assert-equal 1 (cadr decoded))
      (assert-equal program (caddr decoded))))
  (test "decoded BIP350 taproot address parses"
    (let ((decoded (segwit-decode "bc1p0xlxvlhemja6c4dqv22uapctqupfhlxm9h8z3k2e72q4k9hcz7vqzk5jj0")))
      (assert-true (list? decoded))
      (assert-equal "bc" (car decoded))
      (assert-equal 1 (cadr decoded))))
  (test "decoded BIP350 v16 address parses"
    (let ((decoded (segwit-decode "BC1SW50QGDZ25J")))
      (assert-true (list? decoded))
      (assert-equal "bc" (car decoded))
      (assert-equal 16 (cadr decoded))))
  (test "zeros x-only round-trips"
    (let* ((program (make-bytevector 32 0))
           (addr (segwit-encode "tb" 1 program))
           (decoded (segwit-decode addr)))
      (assert-true (list? decoded))
      (assert-equal program (caddr decoded)))))

(test-group "segwit-invalid"
  (test "invalid checksum (Bech32 when should be Bech32m) returns #f"
    (assert-false
      (segwit-decode "bc1p0xlxvlhemja6c4dqv22uapctqupfhlxm9h8z3k2e72q4k9hcz7vqh2y7hd")))
  (test "invalid checksum (Bech32m when should be Bech32) returns #f"
    (assert-false
      (segwit-decode "bc1qw508d6qejxtdg4y5r3zarvary0c5xw7kemeawh")))
  (test "invalid version >16 returns #f"
    (assert-false
      (segwit-decode "BC130XLXVLHEMJA6C4DQV22UAPCTQUPFHLXM9H8Z3K2E72Q4K9HCZ7VQ7ZWS8R")))
  (test "empty data section returns #f"
    (assert-false (segwit-decode "bc1gmk9yu"))))

(run-tests)
