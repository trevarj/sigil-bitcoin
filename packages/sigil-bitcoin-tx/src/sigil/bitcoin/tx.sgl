;;; (sigil bitcoin tx) — Bitcoin transaction facade

(define-library (sigil bitcoin tx)
  (import (sigil bitcoin tx types)
          (sigil bitcoin tx wire)
          (sigil bitcoin tx sighash))
  (export
    sighash-default
    sighash-all
    outpoint outpoint?
    outpoint-txid outpoint-index
    txin txin?
    txin-previous-output txin-script-sig txin-sequence txin-witness
    txout txout?
    txout-value txout-script-pubkey
    transaction transaction?
    transaction-version transaction-inputs transaction-outputs
    transaction-lock-time
    transaction-create
    transaction-add-input
    transaction-add-output
    transaction-set-input-script-sig
    transaction-set-input-witness
    compact-size-encode
    compact-size-decode
    transaction-has-witness?
    transaction-serialize
    transaction-parse-at
    transaction-parse
    transaction-base-serialize
    transaction-stripped-size
    transaction-total-size
    transaction-weight
    transaction-vsize
    transaction-output-value
    transaction-fee
    transaction-feerate
    transaction-txid
    transaction-wtxid
    transaction-sighash-legacy
    transaction-sighash-segwit-v0
    transaction-sighash-taproot-keypath
    transaction-sighash-taproot-scriptpath
    transaction-sign-p2pkh-input
    transaction-sign-p2wpkh-input
    transaction-sign-p2tr-keypath-input)
  (begin))
