;;; (sigil bitcoin tx) — Bitcoin transaction structs and serialization

(define-library (sigil bitcoin tx)
  (import (sigil struct)
          (sigil math)
          (sigil crypto)
          (sigil secp256k1)
          (sigil bitcoin primitives)
          (sigil bitcoin script)
          (sigil bitcoin keys))
  (export
    sighash-default
    sighash-all
    outpoint outpoint?
    outpoint-txid outpoint-index
    txin txin?
    txin-previous-output txin-script-sig txin-sequence txin-witness
    txout txout?
    txout-value txout-script-pubkey
    transaction transaction?
    transaction-version transaction-inputs transaction-outputs
    transaction-lock-time
    psbt psbt?
    psbt-unsigned-tx psbt-inputs psbt-outputs
    psbt-input psbt-input?
    psbt-input-witness-utxo psbt-input-partial-sigs
    psbt-input-sighash-type psbt-input-final-script-sig
    psbt-input-final-script-witness
    psbt-output psbt-output?
    compact-size-encode
    compact-size-decode
    transaction-has-witness?
    transaction-serialize
    transaction-parse
    transaction-base-serialize
    transaction-txid
    transaction-wtxid
    transaction-sighash-legacy
    transaction-sighash-segwit-v0
    transaction-sighash-taproot-keypath
    transaction-sign-p2wpkh-input
    psbt-create
    psbt-serialize
    psbt-parse
    psbt-sign-p2wpkh-input
    psbt-finalize-p2wpkh-input
    psbt-extract-transaction)
  (begin

    ;;; Standard Taproot `SIGHASH_DEFAULT` flag.
    (define sighash-default 0)

    ;;; Standard Bitcoin `SIGHASH_ALL` flag.
    (define sighash-all 1)

    (define %u32-max #xffffffff)
    (define %u64-max #xffffffffffffffff)

    ;;; Transaction outpoint identifying a previous output by txid and index.
    (define-struct outpoint
      (txid bytevector?)
      (index integer?))

    ;;; Transaction input with previous output, scriptSig, sequence, and witness.
    (define-struct txin
      (previous-output outpoint?)
      (script-sig bytevector?)
      (sequence integer?)
      (witness list?))

    ;;; Transaction output with satoshi value and scriptPubKey.
    (define-struct txout
      (value integer?)
      (script-pubkey bytevector?))

    ;;; Bitcoin transaction record.
    (define-struct transaction
      (version integer?)
      (inputs list?)
      (outputs list?)
      (lock-time integer?))

    ;;; PSBT input map subset supported by this package.
    (define-struct psbt-input
      (witness-utxo any?)
      (partial-sigs list?)
      (sighash-type any?)
      (final-script-sig bytevector?)
      (final-script-witness list?))

    ;;; PSBT output map placeholder.
    (define-struct psbt-output)

    ;;; Partially Signed Bitcoin Transaction record.
    (define-struct psbt
      (unsigned-tx transaction?)
      (inputs list?)
      (outputs list?))

    (define (require-bytevector who bytes)
      (unless (bytevector? bytes)
        (error (string-append who ": expected bytevector")))
      bytes)

    (define (require-bytevector-length who bytes len)
      (require-bytevector who bytes)
      (unless (= len (bytevector-length bytes))
        (error (string-append who ": expected "
                              (number->string len)
                              "-byte bytevector")))
      bytes)

    (define (require-uint who value max)
      (unless (and (integer? value) (<= 0 value max))
        (error (string-append who ": unsigned integer out of range")))
      value)

    (define (reverse-bytevector bytes)
      (require-bytevector "reverse-bytevector" bytes)
      (let* ((len (bytevector-length bytes))
             (out (make-bytevector len 0)))
        (do ((i 0 (+ i 1)))
            ((>= i len) out)
          (bytevector-u8-set! out i (bytevector-u8-ref bytes (- len 1 i))))))

    (define (ensure-available who bytes offset count)
      (require-bytevector who bytes)
      (when (or (< offset 0)
                (< count 0)
                (> (+ offset count) (bytevector-length bytes)))
        (error (string-append who ": truncated input"))))

    (define (read-byte bytes offset who)
      (ensure-available who bytes offset 1)
      (bytevector-u8-ref bytes offset))

    (define (u16-le n)
      (require-uint "u16-le" n #xffff)
      (let ((out (make-bytevector 2 0)))
        (bytevector-u8-set! out 0 (bitwise-and n #xff))
        (bytevector-u8-set! out 1 (bitwise-and (arithmetic-shift n -8) #xff))
        out))

    (define (u32-le n)
      (require-uint "u32-le" n %u32-max)
      (let ((out (make-bytevector 4 0)))
        (bytevector-u8-set! out 0 (bitwise-and n #xff))
        (bytevector-u8-set! out 1 (bitwise-and (arithmetic-shift n -8) #xff))
        (bytevector-u8-set! out 2 (bitwise-and (arithmetic-shift n -16) #xff))
        (bytevector-u8-set! out 3 (bitwise-and (arithmetic-shift n -24) #xff))
        out))

    (define (u64-le n)
      (require-uint "u64-le" n %u64-max)
      (let ((out (make-bytevector 8 0)))
        (do ((i 0 (+ i 1))
             (v n (quotient v 256)))
            ((>= i 8) out)
          (bytevector-u8-set! out i (remainder v 256)))))

    (define (read-u16-le bytes offset who)
      (ensure-available who bytes offset 2)
      (+ (bytevector-u8-ref bytes offset)
         (arithmetic-shift (bytevector-u8-ref bytes (+ offset 1)) 8)))

    (define (read-u32-le bytes offset who)
      (ensure-available who bytes offset 4)
      (+ (bytevector-u8-ref bytes offset)
         (arithmetic-shift (bytevector-u8-ref bytes (+ offset 1)) 8)
         (arithmetic-shift (bytevector-u8-ref bytes (+ offset 2)) 16)
         (arithmetic-shift (bytevector-u8-ref bytes (+ offset 3)) 24)))

    (define (read-u64-le bytes offset who)
      (ensure-available who bytes offset 8)
      (let ((n 0))
        (do ((i 7 (- i 1)))
            ((< i 0) n)
          (set! n (+ (arithmetic-shift n 8)
                     (bytevector-u8-ref bytes (+ offset i)))))))

    ;;; Encode a Bitcoin CompactSize unsigned integer.
    (define (compact-size-encode n)
      (: integer? -> bytevector?)
      (require-uint "compact-size-encode" n %u64-max)
      (cond ((< n #xfd)
             (make-bytevector 1 n))
            ((<= n #xffff)
             (bytevector-append #u8(#xfd) (u16-le n)))
            ((<= n %u32-max)
             (bytevector-append #u8(#xfe) (u32-le n)))
            (else
             (bytevector-append #u8(#xff) (u64-le n)))))

    (define (compact-size-decode-at bytes offset)
      (let ((tag (read-byte bytes offset "compact-size-decode")))
        (cond ((< tag #xfd)
               (list tag (+ offset 1)))
              ((= tag #xfd)
               (let ((n (read-u16-le bytes (+ offset 1) "compact-size-decode")))
                 (when (< n #xfd)
                   (error "compact-size-decode: non-canonical u16 encoding"))
                 (list n (+ offset 3))))
              ((= tag #xfe)
               (let ((n (read-u32-le bytes (+ offset 1) "compact-size-decode")))
                 (when (<= n #xffff)
                   (error "compact-size-decode: non-canonical u32 encoding"))
                 (list n (+ offset 5))))
              (else
               (let ((n (read-u64-le bytes (+ offset 1) "compact-size-decode")))
                 (when (<= n %u32-max)
                   (error "compact-size-decode: non-canonical u64 encoding"))
                 (list n (+ offset 9)))))))

    ;;; Decode a CompactSize integer from a bytevector.
    ;;;
    ;;; Returns `(value . next-offset)`.
    (define (compact-size-decode bytes)
      (: bytevector? -> integer?)
      (let ((result (compact-size-decode-at bytes 0)))
        (unless (= (cadr result) (bytevector-length bytes))
          (error "compact-size-decode: trailing bytes"))
        (car result)))

    (define (bytes-with-length bytes)
      (require-bytevector "bytes-with-length" bytes)
      (bytevector-append
        (compact-size-encode (bytevector-length bytes))
        bytes))

    (define (key-with-type key-type key-data)
      (require-uint "psbt key type" key-type #xff)
      (require-bytevector "psbt key data" key-data)
      (bytevector-append (make-bytevector 1 key-type) key-data))

    (define (psbt-keyval key-type key-data value)
      (let ((key (key-with-type key-type key-data)))
        (bytevector-append
          (bytes-with-length key)
          (bytes-with-length value))))

    (define (read-bytes bytes offset count who)
      (ensure-available who bytes offset count)
      (bytevector-copy bytes offset (+ offset count)))

    (define (read-length-prefixed-bytes bytes offset who)
      (let* ((len-result (compact-size-decode-at bytes offset))
             (len (car len-result))
             (payload-offset (cadr len-result))
             (payload (read-bytes bytes payload-offset len who)))
        (list payload (+ payload-offset len))))

    (define (validate-outpoint op)
      (unless (outpoint? op)
        (error "outpoint: expected outpoint"))
      (require-bytevector-length "outpoint txid" (outpoint-txid op) 32)
      (require-uint "outpoint index" (outpoint-index op) %u32-max)
      op)

    (define (validate-witness-item item)
      (require-bytevector "txin witness item" item))

    (define (validate-witness witness)
      (unless (list? witness)
        (error "txin witness: expected list"))
      (do ((xs witness (cdr xs)))
          ((null? xs) witness)
        (validate-witness-item (car xs))))

    (define (validate-txin input)
      (unless (txin? input)
        (error "txin: expected txin"))
      (validate-outpoint (txin-previous-output input))
      (require-bytevector "txin script-sig" (txin-script-sig input))
      (require-uint "txin sequence" (txin-sequence input) %u32-max)
      (validate-witness (txin-witness input))
      input)

    (define (validate-txout output)
      (unless (txout? output)
        (error "txout: expected txout"))
      (require-uint "txout value" (txout-value output) %u64-max)
      (require-bytevector "txout script-pubkey" (txout-script-pubkey output))
      output)

    (define (validate-transaction tx)
      (unless (transaction? tx)
        (error "transaction: expected transaction"))
      (require-uint "transaction version" (transaction-version tx) %u32-max)
      (unless (list? (transaction-inputs tx))
        (error "transaction inputs: expected list"))
      (unless (list? (transaction-outputs tx))
        (error "transaction outputs: expected list"))
      (require-uint "transaction lock-time" (transaction-lock-time tx) %u32-max)
      (do ((xs (transaction-inputs tx) (cdr xs)))
          ((null? xs))
        (validate-txin (car xs)))
      (do ((xs (transaction-outputs tx) (cdr xs)))
          ((null? xs) tx)
        (validate-txout (car xs))))

    (define (serialize-outpoint op)
      (validate-outpoint op)
      (bytevector-append
        (reverse-bytevector (outpoint-txid op))
        (u32-le (outpoint-index op))))

    (define (serialize-txin input)
      (validate-txin input)
      (bytevector-append
        (serialize-outpoint (txin-previous-output input))
        (bytes-with-length (txin-script-sig input))
        (u32-le (txin-sequence input))))

    (define (serialize-txout output)
      (validate-txout output)
      (bytevector-append
        (u64-le (txout-value output))
        (bytes-with-length (txout-script-pubkey output))))

    (define (serialize-vector items serializer)
      (let ((parts '()))
        (do ((xs items (cdr xs)))
            ((null? xs))
          (set! parts (append parts (list (serializer (car xs))))))
        (apply bytevector-append
               (cons (compact-size-encode (length items)) parts))))

    (define (serialize-items items serializer)
      (let ((parts '()))
        (do ((xs items (cdr xs)))
            ((null? xs))
          (set! parts (append parts (list (serializer (car xs))))))
        (if (null? parts)
            #u8()
            (apply bytevector-append parts))))

    (define (serialize-witness witness)
      (validate-witness witness)
      (let ((parts '()))
        (do ((xs witness (cdr xs)))
            ((null? xs))
          (set! parts (append parts (list (bytes-with-length (car xs))))))
        (apply bytevector-append
               (cons (compact-size-encode (length witness)) parts))))

    (define (parse-outpoint bytes offset)
      (let ((wire-txid (read-bytes bytes offset 32 "outpoint"))
            (index (read-u32-le bytes (+ offset 32) "outpoint")))
        (list
          (outpoint txid: (reverse-bytevector wire-txid)
                    index: index)
          (+ offset 36))))

    (define (parse-txin bytes offset)
      (let* ((op-result (parse-outpoint bytes offset))
             (op (car op-result))
             (script-result (read-length-prefixed-bytes
                              bytes (cadr op-result) "txin script-sig"))
             (script-sig (car script-result))
             (sequence (read-u32-le bytes (cadr script-result) "txin sequence")))
        (list
          (txin previous-output: op
                script-sig: script-sig
                sequence: sequence
                witness: '())
          (+ (cadr script-result) 4))))

    (define (parse-txout bytes offset)
      (let* ((value (read-u64-le bytes offset "txout value"))
             (script-result (read-length-prefixed-bytes
                              bytes (+ offset 8) "txout script-pubkey")))
        (list
          (txout value: value
                 script-pubkey: (car script-result))
          (cadr script-result))))

    (define (parse-vector bytes offset parser)
      (let* ((count-result (compact-size-decode-at bytes offset))
             (count (car count-result)))
        (let loop ((i 0)
                   (next (cadr count-result))
                   (items '()))
          (if (>= i count)
              (list (reverse items) next)
              (let ((parsed (parser bytes next)))
                (loop (+ i 1)
                      (cadr parsed)
                      (cons (car parsed) items)))))))

    (define (parse-witness bytes offset)
      (let* ((count-result (compact-size-decode-at bytes offset))
             (count (car count-result)))
        (let loop ((i 0)
                   (next (cadr count-result))
                   (items '()))
          (if (>= i count)
              (list (reverse items) next)
              (let ((item-result (read-length-prefixed-bytes
                                   bytes next "txin witness item")))
                (loop (+ i 1)
                      (cadr item-result)
                      (cons (car item-result) items)))))))

    (define (parse-serialized-witness bytes)
      (let ((parsed (parse-witness bytes 0)))
        (unless (= (cadr parsed) (bytevector-length bytes))
          (error "psbt final witness: trailing bytes"))
        (car parsed)))

    (define (attach-witnesses inputs witnesses)
      (let loop ((ins inputs)
                 (wits witnesses)
                 (out '()))
        (cond ((and (null? ins) (null? wits))
               (reverse out))
              ((or (null? ins) (null? wits))
               (error "transaction-parse: witness/input count mismatch"))
              (else
               (let ((input (car ins)))
                 (loop
                   (cdr ins)
                   (cdr wits)
                   (cons
                     (txin previous-output: (txin-previous-output input)
                           script-sig: (txin-script-sig input)
                           sequence: (txin-sequence input)
                           witness: (car wits))
                     out)))))))

    (define (parse-witnesses bytes offset inputs)
      (let loop ((ins inputs)
                 (next offset)
                 (witnesses '()))
        (if (null? ins)
            (list (attach-witnesses inputs (reverse witnesses)) next)
            (let ((parsed (parse-witness bytes next)))
              (loop (cdr ins)
                    (cadr parsed)
                    (cons (car parsed) witnesses))))))

    ;;; Return true when any transaction input has witness stack items.
    (define (transaction-has-witness? tx)
      (: transaction? -> boolean?)
      (validate-transaction tx)
      (let ((has? #f))
        (do ((xs (transaction-inputs tx) (cdr xs)))
            ((or (null? xs) has?) has?)
          (when (not (null? (txin-witness (car xs))))
            (set! has? #t)))))

    ;;; Serialize a transaction to Bitcoin wire bytes.
    ;;;
    ;;; Includes witness data by default when present. Pass `#f` to omit
    ;;; witnesses for txid/base serialization.
    (define (transaction-serialize tx . maybe-include-witness)
      (: transaction? boolean? ... -> bytevector?)
      (validate-transaction tx)
      (let* ((allow-witness? (if (null? maybe-include-witness)
                                 #t
                                 (car maybe-include-witness)))
             (include-witness? (and allow-witness? (transaction-has-witness? tx)))
             (prefix (if include-witness?
                         (bytevector-append (u32-le (transaction-version tx))
                                            #u8(#x00 #x01))
                         (u32-le (transaction-version tx))))
             (base (bytevector-append
                     prefix
                     (serialize-vector (transaction-inputs tx) serialize-txin)
                     (serialize-vector (transaction-outputs tx) serialize-txout))))
        (if include-witness?
            (let ((witnesses '()))
              (do ((xs (transaction-inputs tx) (cdr xs)))
                  ((null? xs))
                (set! witnesses
                      (append witnesses
                              (list (serialize-witness (txin-witness (car xs)))))))
              (bytevector-append
                base
                (apply bytevector-append witnesses)
                (u32-le (transaction-lock-time tx))))
            (bytevector-append base (u32-le (transaction-lock-time tx))))))

    ;;; Parse Bitcoin wire bytes into a transaction record.
    (define (transaction-parse bytes)
      (: bytevector? -> transaction?)
      (require-bytevector "transaction-parse" bytes)
      (let* ((version (read-u32-le bytes 0 "transaction version"))
             (marker (read-byte bytes 4 "transaction marker"))
             (segwit? (and (= marker 0)
                           (> (bytevector-length bytes) 5)
                           (not (= 0 (read-byte bytes 5 "transaction flag")))))
             (input-offset (if segwit? 6 4))
             (inputs-result (parse-vector bytes input-offset parse-txin))
             (outputs-result (parse-vector bytes (cadr inputs-result) parse-txout))
             (inputs (car inputs-result))
             (outputs (car outputs-result))
             (after-outputs (cadr outputs-result))
             (witness-result (if segwit?
                                 (parse-witnesses bytes after-outputs inputs)
                                 (list inputs after-outputs)))
             (lock-offset (cadr witness-result))
             (lock-time (read-u32-le bytes lock-offset "transaction lock-time"))
             (end (+ lock-offset 4)))
        (unless (= end (bytevector-length bytes))
          (error "transaction-parse: trailing bytes"))
        (transaction version: version
                     inputs: (car witness-result)
                     outputs: outputs
                     lock-time: lock-time)))

    ;;; Serialize a transaction without SegWit marker, flag, or witnesses.
    (define (transaction-base-serialize tx)
      (: transaction? -> bytevector?)
      (transaction-serialize tx #f))

    ;;; Return the transaction ID bytevector for a transaction.
    (define (transaction-txid tx)
      (: transaction? -> bytevector?)
      (hash256 (transaction-base-serialize tx)))

    ;;; Return the witness transaction ID bytevector for a transaction.
    (define (transaction-wtxid tx)
      (: transaction? -> bytevector?)
      (hash256 (transaction-serialize tx #t)))

    (define (nth-item items index who)
      (when (< index 0)
        (error (string-append who ": index out of range")))
      (let loop ((xs items) (i 0))
        (cond ((null? xs)
               (error (string-append who ": index out of range")))
              ((= i index)
               (car xs))
              (else
               (loop (cdr xs) (+ i 1))))))

    (define (replace-nth items index value who)
      (when (< index 0)
        (error (string-append who ": index out of range")))
      (let loop ((xs items) (i 0) (out '()))
        (cond ((null? xs)
               (error (string-append who ": index out of range")))
              ((= i index)
               (append (reverse out) (cons value (cdr xs))))
              (else
               (loop (cdr xs) (+ i 1) (cons (car xs) out))))))

    (define (blank-input-script input)
      (txin previous-output: (txin-previous-output input)
            script-sig: #u8()
            sequence: (txin-sequence input)
            witness: '()))

    (define (input-with-script input script)
      (txin previous-output: (txin-previous-output input)
            script-sig: script
            sequence: (txin-sequence input)
            witness: '()))

    (define (input-with-witness input witness)
      (txin previous-output: (txin-previous-output input)
            script-sig: (txin-script-sig input)
            sequence: (txin-sequence input)
            witness: witness))

    (define (append-sighash-byte sig sighash-type)
      (bytevector-append sig (make-bytevector 1 sighash-type)))

    (define (strip-input-witnesses tx)
      (transaction
        version: (transaction-version tx)
        inputs: (map blank-input-script (transaction-inputs tx))
        outputs: (transaction-outputs tx)
        lock-time: (transaction-lock-time tx)))

    (define (serialize-prevouts inputs)
      (apply bytevector-append
             (map (lambda (input)
                    (serialize-outpoint (txin-previous-output input)))
                  inputs)))

    (define (serialize-sequences inputs)
      (apply bytevector-append
             (map (lambda (input) (u32-le (txin-sequence input))) inputs)))

    (define (serialize-outputs outputs)
      (apply bytevector-append (map serialize-txout outputs)))

    (define (require-sighash-all who sighash-type)
      (unless (= sighash-type sighash-all)
        (error (string-append who ": only SIGHASH_ALL is supported")))
      sighash-type)

    (define (require-taproot-sighash who sighash-type)
      (unless (or (= sighash-type sighash-default)
                  (= sighash-type sighash-all))
        (error (string-append who ": only SIGHASH_DEFAULT and SIGHASH_ALL are supported")))
      sighash-type)

    (define (prevout-script-bytes output)
      (validate-txout output)
      (bytes-with-length (txout-script-pubkey output)))

    (define (validate-prevouts tx prevouts who)
      (unless (list? prevouts)
        (error (string-append who ": expected prevout list")))
      (unless (= (length (transaction-inputs tx)) (length prevouts))
        (error (string-append who ": prevout count mismatch")))
      (do ((xs prevouts (cdr xs)))
          ((null? xs) prevouts)
        (validate-txout (car xs))))

    ;;; Compute a legacy pre-SegWit signature hash for one input.
    ;;;
    ;;; Currently supports `SIGHASH_ALL`.
    (define (transaction-sighash-legacy tx input-index script-code . maybe-sighash-type)
      (: transaction? integer? bytevector? integer? ... -> bytevector?)
      (let ((sighash-type (if (null? maybe-sighash-type)
                              sighash-all
                              (car maybe-sighash-type))))
        (require-sighash-all "transaction-sighash-legacy" sighash-type)
        (validate-transaction tx)
        (require-bytevector "transaction-sighash-legacy script-code" script-code)
        (let* ((blanked (strip-input-witnesses tx))
               (target (input-with-script
                         (nth-item (transaction-inputs blanked)
                                   input-index
                                   "transaction-sighash-legacy")
                         script-code))
               (inputs (replace-nth (transaction-inputs blanked)
                                    input-index
                                    target
                                    "transaction-sighash-legacy"))
               (signing-tx (transaction
                             version: (transaction-version blanked)
                             inputs: inputs
                             outputs: (transaction-outputs blanked)
                             lock-time: (transaction-lock-time blanked))))
          (hash256
            (bytevector-append
              (transaction-base-serialize signing-tx)
              (u32-le sighash-type))))))

    ;;; Compute a BIP143 SegWit v0 signature hash for one input.
    ;;;
    ;;; Currently supports `SIGHASH_ALL`.
    (define (transaction-sighash-segwit-v0 tx input-index script-code value . maybe-sighash-type)
      (: transaction? integer? bytevector? integer? integer? ... -> bytevector?)
      (let ((sighash-type (if (null? maybe-sighash-type)
                              sighash-all
                              (car maybe-sighash-type))))
        (require-sighash-all "transaction-sighash-segwit-v0" sighash-type)
        (validate-transaction tx)
        (require-bytevector "transaction-sighash-segwit-v0 script-code" script-code)
        (require-uint "transaction-sighash-segwit-v0 value" value %u64-max)
        (let* ((inputs (transaction-inputs tx))
               (input (nth-item inputs input-index "transaction-sighash-segwit-v0"))
               (preimage
                 (bytevector-append
                   (u32-le (transaction-version tx))
                   (hash256 (serialize-prevouts inputs))
                   (hash256 (serialize-sequences inputs))
                   (serialize-outpoint (txin-previous-output input))
                   (bytes-with-length script-code)
                   (u64-le value)
                   (u32-le (txin-sequence input))
                   (hash256 (serialize-outputs (transaction-outputs tx)))
                   (u32-le (transaction-lock-time tx))
                   (u32-le sighash-type))))
          (hash256 preimage))))

    ;;; Compute a BIP341 Taproot key-path signature hash.
    ;;;
    ;;; Supports key-path spends without annex or script-path extension for
    ;;; `SIGHASH_DEFAULT` and `SIGHASH_ALL`.
    (define (transaction-sighash-taproot-keypath tx input-index prevouts . maybe-sighash-type)
      (: transaction? integer? list? integer? ... -> bytevector?)
      (let ((sighash-type (if (null? maybe-sighash-type)
                              sighash-default
                              (car maybe-sighash-type))))
        (validate-transaction tx)
        (require-taproot-sighash "transaction-sighash-taproot-keypath" sighash-type)
        (validate-prevouts tx prevouts "transaction-sighash-taproot-keypath")
        (let ((input (nth-item (transaction-inputs tx)
                               input-index
                               "transaction-sighash-taproot-keypath")))
          (let* ((sha-prevouts
                   (sha256-bytes
                     (serialize-items
                       (transaction-inputs tx)
                       (lambda (txin)
                         (serialize-outpoint (txin-previous-output txin))))))
                 (sha-amounts
                   (sha256-bytes
                     (serialize-items
                       prevouts
                       (lambda (prevout)
                         (u64-le (txout-value prevout))))))
                 (sha-scriptpubkeys
                   (sha256-bytes
                     (serialize-items prevouts prevout-script-bytes)))
                 (sha-sequences
                   (sha256-bytes
                     (serialize-items
                       (transaction-inputs tx)
                       (lambda (txin)
                         (u32-le (txin-sequence txin))))))
                 (sha-outputs
                   (sha256-bytes
                     (serialize-items (transaction-outputs tx) serialize-txout)))
                 (sigmsg
                   (bytevector-append
                     (make-bytevector 1 sighash-type)
                     (u32-le (transaction-version tx))
                     (u32-le (transaction-lock-time tx))
                     sha-prevouts
                     sha-amounts
                     sha-scriptpubkeys
                     sha-sequences
                     sha-outputs
                     #u8(0)
                     (u32-le input-index))))
            ;; Reference `input` so out-of-range indexes fail before hashing.
            (txin-sequence input)
            (tagged-hash "TapSighash"
                         (bytevector-append #u8(0) sigmsg))))))

    ;;; Sign one P2WPKH input and return a transaction with witness data.
    (define (transaction-sign-p2wpkh-input tx input-index prevout-value private-key . maybe-sighash-type)
      (: transaction? integer? integer? bytevector? integer? ... -> transaction?)
      (let* ((sighash-type (if (null? maybe-sighash-type)
                               sighash-all
                               (car maybe-sighash-type)))
             (pubkey (private-key->public-key private-key))
             (pubkey-hash (hash160 pubkey))
             (script-code (script-p2pkh pubkey-hash))
             (msghash (transaction-sighash-segwit-v0
                        tx input-index script-code prevout-value sighash-type))
             (der (secp256k1-ecdsa-signature-serialize-der
                    (secp256k1-ecdsa-sign private-key msghash)))
             (sig (append-sighash-byte der sighash-type))
             (input (nth-item (transaction-inputs tx)
                              input-index
                              "transaction-sign-p2wpkh-input"))
             (signed-input (input-with-witness
                             (txin previous-output: (txin-previous-output input)
                                   script-sig: #u8()
                                   sequence: (txin-sequence input)
                                   witness: '())
                             (list sig pubkey))))
        (transaction
          version: (transaction-version tx)
          inputs: (replace-nth (transaction-inputs tx)
                               input-index
                               signed-input
                               "transaction-sign-p2wpkh-input")
          outputs: (transaction-outputs tx)
          lock-time: (transaction-lock-time tx))))

    (define (empty-psbt-input)
      (psbt-input witness-utxo: #f
                  partial-sigs: '()
                  sighash-type: #f
                  final-script-sig: #u8()
                  final-script-witness: '()))

    (define (empty-psbt-output)
      (psbt-output))

    (define (make-empty-list count maker)
      (let loop ((i 0) (out '()))
        (if (>= i count)
            (reverse out)
            (loop (+ i 1) (cons (maker) out)))))

    ;;; Create an empty PSBT from an unsigned transaction.
    (define (psbt-create unsigned-tx)
      (: transaction? -> psbt?)
      (validate-transaction unsigned-tx)
      (psbt unsigned-tx: unsigned-tx
            inputs: (make-empty-list (length (transaction-inputs unsigned-tx))
                                     empty-psbt-input)
            outputs: (make-empty-list (length (transaction-outputs unsigned-tx))
                                      empty-psbt-output)))

    (define (validate-psbt-input input)
      (unless (psbt-input? input)
        (error "psbt input: expected psbt-input"))
      (when (psbt-input-witness-utxo input)
        (validate-txout (psbt-input-witness-utxo input)))
      (unless (list? (psbt-input-partial-sigs input))
        (error "psbt input partial sigs: expected list"))
      (do ((xs (psbt-input-partial-sigs input) (cdr xs)))
          ((null? xs))
        (let ((entry (car xs)))
          (require-bytevector "psbt partial sig pubkey" (car entry))
          (require-bytevector "psbt partial sig signature" (cdr entry))))
      (when (psbt-input-sighash-type input)
        (require-uint "psbt input sighash type" (psbt-input-sighash-type input) %u32-max))
      (require-bytevector "psbt final scriptSig" (psbt-input-final-script-sig input))
      (validate-witness (psbt-input-final-script-witness input))
      input)

    (define (validate-psbt p)
      (unless (psbt? p)
        (error "psbt: expected psbt"))
      (validate-transaction (psbt-unsigned-tx p))
      (unless (= (length (transaction-inputs (psbt-unsigned-tx p)))
                 (length (psbt-inputs p)))
        (error "psbt: input map count mismatch"))
      (unless (= (length (transaction-outputs (psbt-unsigned-tx p)))
                 (length (psbt-outputs p)))
        (error "psbt: output map count mismatch"))
      (do ((xs (psbt-inputs p) (cdr xs)))
          ((null? xs) p)
        (validate-psbt-input (car xs))))

    (define (psbt-input->keyvals input)
      (validate-psbt-input input)
      (let ((parts '()))
        (when (psbt-input-witness-utxo input)
          (set! parts
                (append parts
                        (list (psbt-keyval #x01 #u8()
                                           (serialize-txout
                                             (psbt-input-witness-utxo input)))))))
        (do ((xs (psbt-input-partial-sigs input) (cdr xs)))
            ((null? xs))
          (let ((entry (car xs)))
            (set! parts
                  (append parts
                          (list (psbt-keyval #x02 (car entry) (cdr entry)))))))
        (when (psbt-input-sighash-type input)
          (set! parts
                (append parts
                        (list (psbt-keyval #x03 #u8()
                                           (u32-le (psbt-input-sighash-type input)))))))
        (when (> (bytevector-length (psbt-input-final-script-sig input)) 0)
          (set! parts
                (append parts
                        (list (psbt-keyval #x07 #u8()
                                           (psbt-input-final-script-sig input))))))
        (when (not (null? (psbt-input-final-script-witness input)))
          (set! parts
                (append parts
                        (list (psbt-keyval #x08 #u8()
                                           (serialize-witness
                                             (psbt-input-final-script-witness input)))))))
        parts))

    (define (serialize-psbt-map keyvals)
      (apply bytevector-append (append keyvals (list #u8(0)))))

    ;;; Serialize a PSBT v0 record.
    (define (psbt-serialize p)
      (: psbt? -> bytevector?)
      (validate-psbt p)
      (let* ((global (serialize-psbt-map
                       (list
                         (psbt-keyval #x00 #u8()
                                      (transaction-base-serialize
                                        (psbt-unsigned-tx p))))))
             (input-maps (map (lambda (input)
                                (serialize-psbt-map
                                  (psbt-input->keyvals input)))
                              (psbt-inputs p)))
             (output-maps (map (lambda (output)
                                 (serialize-psbt-map '()))
                               (psbt-outputs p))))
        (apply bytevector-append
               (append (list #u8(#x70 #x73 #x62 #x74 #xff) global)
                       input-maps
                       output-maps))))

    (define (parse-psbt-map bytes offset)
      (let loop ((next offset) (entries '()))
        (let* ((key-result (read-length-prefixed-bytes bytes next "psbt key"))
               (key (car key-result))
               (after-key (cadr key-result)))
          (if (= 0 (bytevector-length key))
              (list (reverse entries) after-key)
              (let* ((value-result (read-length-prefixed-bytes bytes after-key "psbt value"))
                     (value (car value-result)))
                (loop (cadr value-result)
                      (cons (cons key value) entries)))))))

    (define (parse-global-unsigned-tx entries)
      (let ((unsigned #f))
        (do ((xs entries (cdr xs)))
            ((null? xs))
          (let* ((entry (car xs))
                 (key (car entry))
                 (value (cdr entry)))
            (when (and (= 1 (bytevector-length key))
                       (= #x00 (bytevector-u8-ref key 0)))
              (set! unsigned (transaction-parse value)))))
        (unless unsigned
          (error "psbt-parse: missing unsigned transaction"))
        unsigned))

    (define (parse-input-entry input entry)
      (let* ((key (car entry))
             (value (cdr entry))
             (key-type (bytevector-u8-ref key 0))
             (key-data (bytevector-copy key 1)))
        (cond ((= key-type #x01)
               (let ((parsed (parse-txout value 0)))
                 (unless (= (cadr parsed) (bytevector-length value))
                   (error "psbt witness utxo: trailing bytes"))
                 (psbt-input witness-utxo: (car parsed)
                             partial-sigs: (psbt-input-partial-sigs input)
                             sighash-type: (psbt-input-sighash-type input)
                             final-script-sig: (psbt-input-final-script-sig input)
                             final-script-witness: (psbt-input-final-script-witness input))))
              ((= key-type #x02)
               (psbt-input witness-utxo: (psbt-input-witness-utxo input)
                           partial-sigs: (append (psbt-input-partial-sigs input)
                                                 (list (cons key-data value)))
                           sighash-type: (psbt-input-sighash-type input)
                           final-script-sig: (psbt-input-final-script-sig input)
                           final-script-witness: (psbt-input-final-script-witness input)))
              ((= key-type #x03)
               (psbt-input witness-utxo: (psbt-input-witness-utxo input)
                           partial-sigs: (psbt-input-partial-sigs input)
                           sighash-type: (read-u32-le value 0 "psbt sighash type")
                           final-script-sig: (psbt-input-final-script-sig input)
                           final-script-witness: (psbt-input-final-script-witness input)))
              ((= key-type #x07)
               (psbt-input witness-utxo: (psbt-input-witness-utxo input)
                           partial-sigs: (psbt-input-partial-sigs input)
                           sighash-type: (psbt-input-sighash-type input)
                           final-script-sig: value
                           final-script-witness: (psbt-input-final-script-witness input)))
              ((= key-type #x08)
               (psbt-input witness-utxo: (psbt-input-witness-utxo input)
                           partial-sigs: (psbt-input-partial-sigs input)
                           sighash-type: (psbt-input-sighash-type input)
                           final-script-sig: (psbt-input-final-script-sig input)
                           final-script-witness: (parse-serialized-witness value)))
              (else input))))

    (define (parse-psbt-input entries)
      (let ((input (empty-psbt-input)))
        (do ((xs entries (cdr xs)))
            ((null? xs) input)
          (set! input (parse-input-entry input (car xs))))))

    (define (parse-psbt-inputs bytes offset count)
      (let loop ((i 0) (next offset) (inputs '()))
        (if (>= i count)
            (list (reverse inputs) next)
            (let ((parsed (parse-psbt-map bytes next)))
              (loop (+ i 1)
                    (cadr parsed)
                    (cons (parse-psbt-input (car parsed)) inputs))))))

    (define (parse-psbt-outputs bytes offset count)
      (let loop ((i 0) (next offset) (outputs '()))
        (if (>= i count)
            (list (reverse outputs) next)
            (let ((parsed (parse-psbt-map bytes next)))
              (loop (+ i 1)
                    (cadr parsed)
                    (cons (empty-psbt-output) outputs))))))

    ;;; Parse PSBT v0 bytes into a PSBT record.
    (define (psbt-parse bytes)
      (: bytevector? -> psbt?)
      (require-bytevector "psbt-parse" bytes)
      (ensure-available "psbt-parse" bytes 0 5)
      (unless (equal? #u8(#x70 #x73 #x62 #x74 #xff)
                      (bytevector-copy bytes 0 5))
        (error "psbt-parse: bad magic"))
      (let* ((global-result (parse-psbt-map bytes 5))
             (unsigned (parse-global-unsigned-tx (car global-result)))
             (input-result (parse-psbt-inputs
                             bytes
                             (cadr global-result)
                             (length (transaction-inputs unsigned))))
             (output-result (parse-psbt-outputs
                              bytes
                              (cadr input-result)
                              (length (transaction-outputs unsigned)))))
        (unless (= (cadr output-result) (bytevector-length bytes))
          (error "psbt-parse: trailing bytes"))
        (psbt unsigned-tx: unsigned
              inputs: (car input-result)
              outputs: (car output-result))))

    (define (psbt-update-input p input-index input)
      (psbt unsigned-tx: (psbt-unsigned-tx p)
            inputs: (replace-nth (psbt-inputs p)
                                 input-index
                                 input
                                 "psbt input")
            outputs: (psbt-outputs p)))

    ;;; Add a P2WPKH partial signature to a PSBT input.
    ;;;
    ;;; The input must contain a witness UTXO.
    (define (psbt-sign-p2wpkh-input p input-index private-key)
      (: psbt? integer? bytevector? -> psbt?)
      (validate-psbt p)
      (let* ((input (nth-item (psbt-inputs p) input-index "psbt-sign-p2wpkh-input"))
             (utxo (psbt-input-witness-utxo input)))
        (unless utxo
          (error "psbt-sign-p2wpkh-input: missing witness UTXO"))
        (let* ((pubkey (private-key->public-key private-key))
               (pubkey-hash (hash160 pubkey))
               (expected-script (script-p2wpkh pubkey-hash)))
          (unless (equal? expected-script (txout-script-pubkey utxo))
            (error "psbt-sign-p2wpkh-input: witness UTXO is not P2WPKH for key"))
          (let* ((sighash-type (if (psbt-input-sighash-type input)
                                   (psbt-input-sighash-type input)
                                   sighash-all))
                 (script-code (script-p2pkh pubkey-hash))
                 (msghash (transaction-sighash-segwit-v0
                            (psbt-unsigned-tx p)
                            input-index
                            script-code
                            (txout-value utxo)
                            sighash-type))
                 (der (secp256k1-ecdsa-signature-serialize-der
                        (secp256k1-ecdsa-sign private-key msghash)))
                 (sig (append-sighash-byte der sighash-type))
                 (signed-input
                   (psbt-input
                     witness-utxo: utxo
                     partial-sigs: (append (psbt-input-partial-sigs input)
                                           (list (cons pubkey sig)))
                     sighash-type: sighash-type
                     final-script-sig: (psbt-input-final-script-sig input)
                     final-script-witness: (psbt-input-final-script-witness input))))
            (psbt-update-input p input-index signed-input)))))

    ;;; Finalize a signed P2WPKH PSBT input.
    (define (psbt-finalize-p2wpkh-input p input-index)
      (: psbt? integer? -> psbt?)
      (validate-psbt p)
      (let* ((input (nth-item (psbt-inputs p) input-index "psbt-finalize-p2wpkh-input"))
             (partial-sigs (psbt-input-partial-sigs input)))
        (when (null? partial-sigs)
          (error "psbt-finalize-p2wpkh-input: missing partial signature"))
        (let* ((entry (car partial-sigs))
               (final-input
                 (psbt-input
                   witness-utxo: (psbt-input-witness-utxo input)
                   partial-sigs: partial-sigs
                   sighash-type: (psbt-input-sighash-type input)
                   final-script-sig: #u8()
                   final-script-witness: (list (cdr entry) (car entry)))))
          (psbt-update-input p input-index final-input))))

    ;;; Extract the final transaction from a fully-finalized PSBT.
    (define (psbt-extract-transaction p)
      (: psbt? -> transaction?)
      (validate-psbt p)
      (let loop ((txins (transaction-inputs (psbt-unsigned-tx p)))
                 (psbt-ins (psbt-inputs p))
                 (out '()))
        (if (null? txins)
            (transaction
              version: (transaction-version (psbt-unsigned-tx p))
              inputs: (reverse out)
              outputs: (transaction-outputs (psbt-unsigned-tx p))
              lock-time: (transaction-lock-time (psbt-unsigned-tx p)))
            (let ((psbt-in (car psbt-ins))
                  (txin0 (car txins)))
              (when (null? (psbt-input-final-script-witness psbt-in))
                (error "psbt-extract-transaction: input is not finalized"))
              (loop
                (cdr txins)
                (cdr psbt-ins)
                (cons
                  (txin previous-output: (txin-previous-output txin0)
                        script-sig: (psbt-input-final-script-sig psbt-in)
                        sequence: (txin-sequence txin0)
                        witness: (psbt-input-final-script-witness psbt-in))
                  out))))))))
