;;; (sigil bitcoin tx sighash) — Transaction signature hashes and signing

(define-library (sigil bitcoin tx sighash)
  (import (sigil math)
          (sigil crypto)
          (sigil secp256k1)
          (sigil bitcoin utils)
          (sigil bitcoin primitives)
          (sigil bitcoin script)
          (sigil bitcoin keys)
          (sigil bitcoin tx types)
          (sigil bitcoin tx wire))
  (export
    append-sighash-byte
    taproot-tweaked-keypair
    taproot-keypath-signature
    validate-prevouts
    validate-taproot-control-block
    taproot-leaf-hash
    taproot-control-block-output-xonly
    transaction-sighash-legacy
    transaction-sighash-segwit-v0
    transaction-sighash-taproot-keypath
    transaction-sighash-taproot-scriptpath
    transaction-sign-p2pkh-input
    transaction-sign-p2wpkh-input
    transaction-sign-p2tr-keypath-input)
  (begin

    (define (blank-input-script input)
      (txin previous-output: (txin-previous-output input)
            script-sig: #u8()
            sequence: (txin-sequence input)
            witness: '()))

    (define (input-with-script input script)
      (txin previous-output: (txin-previous-output input)
            script-sig: script
            sequence: (txin-sequence input)
            witness: '()))

    (define (input-with-witness input witness)
      (txin previous-output: (txin-previous-output input)
            script-sig: (txin-script-sig input)
            sequence: (txin-sequence input)
            witness: witness))

    (define (append-sighash-byte sig sighash-type)
      (bytevector-append sig (make-bytevector 1 sighash-type)))

    (define (taproot-key-tweak internal-xonly-pubkey)
      (require-bytevector-length "taproot-key-tweak" internal-xonly-pubkey 32)
      (tagged-hash "TapTweak" internal-xonly-pubkey))

    (define (taproot-tweaked-keypair private-key)
      (let* ((keypair (secp256k1-keypair-create private-key))
             (internal-xonly (secp256k1-keypair-xonly-pub keypair))
             (tweak (taproot-key-tweak internal-xonly)))
        (secp256k1-keypair-xonly-tweak-add keypair tweak)))

    (define (taproot-keypath-signature keypair msghash sighash-type)
      (let ((sig (secp256k1-schnorrsig-sign32 keypair msghash)))
        (if (= sighash-type sighash-default)
            sig
            (append-sighash-byte sig sighash-type))))

    (define (strip-input-witnesses tx)
      (transaction
        version: (transaction-version tx)
        inputs: (map blank-input-script (transaction-inputs tx))
        outputs: (transaction-outputs tx)
        lock-time: (transaction-lock-time tx)))

    (define (serialize-prevouts inputs)
      (apply bytevector-append
             (map (lambda (input)
                    (serialize-outpoint (txin-previous-output input)))
                  inputs)))

    (define (serialize-sequences inputs)
      (apply bytevector-append
             (map (lambda (input) (u32-le (txin-sequence input))) inputs)))

    (define (serialize-outputs outputs)
      (apply bytevector-append (map serialize-txout outputs)))

    (define (require-sighash-all who sighash-type)
      (unless (= sighash-type sighash-all)
        (error (string-append who ": only SIGHASH_ALL is supported")))
      sighash-type)

    (define (require-taproot-sighash who sighash-type)
      (unless (or (= sighash-type sighash-default)
                  (= sighash-type sighash-all))
        (error (string-append who ": only SIGHASH_DEFAULT and SIGHASH_ALL are supported")))
      sighash-type)

    (define (prevout-script-bytes output)
      (validate-txout output)
      (bytes-with-length (txout-script-pubkey output)))

    (define (validate-prevouts tx prevouts who)
      (unless (list? prevouts)
        (error (string-append who ": expected prevout list")))
      (unless (= (length (transaction-inputs tx)) (length prevouts))
        (error (string-append who ": prevout count mismatch")))
      (do ((xs prevouts (cdr xs)))
          ((null? xs) prevouts)
        (validate-txout (car xs))))

    (define (validate-taproot-control-block who control-block)
      (require-bytevector who control-block)
      (let ((len (bytevector-length control-block)))
        (unless (and (>= len 33)
                     (= 0 (remainder (- len 33) 32)))
          (error (string-append who ": expected 33 + 32n bytes"))))
      control-block)

    (define (taproot-leaf-hash script leaf-version)
      (require-bytevector "taproot leaf script" script)
      (require-uint "taproot leaf version" leaf-version #xff)
      (tagged-hash "TapLeaf"
                   (bytevector-append
                     (make-bytevector 1 leaf-version)
                     (bytes-with-length script))))

    (define (bytevector-lexicographic<? left right)
      (let ((llen (bytevector-length left))
            (rlen (bytevector-length right)))
        (let loop ((i 0))
          (cond ((and (= i llen) (= i rlen)) #f)
                ((= i llen) #t)
                ((= i rlen) #f)
                ((< (bytevector-u8-ref left i) (bytevector-u8-ref right i)) #t)
                ((> (bytevector-u8-ref left i) (bytevector-u8-ref right i)) #f)
                (else (loop (+ i 1)))))))

    (define (taproot-branch-hash left right)
      (let* ((right-first? (bytevector-lexicographic<? right left))
             (a (if right-first? right left))
             (b (if right-first? left right)))
        (tagged-hash "TapBranch" (bytevector-append a b))))

    (define (taproot-control-block-merkle-root leaf-hash control-block)
      (validate-taproot-control-block "taproot control block" control-block)
      (let loop ((offset 33)
                 (root leaf-hash))
        (if (>= offset (bytevector-length control-block))
            root
            (loop (+ offset 32)
                  (taproot-branch-hash
                    root
                    (bytevector-copy control-block offset (+ offset 32)))))))

    (define (taproot-control-block-internal-key control-block)
      (validate-taproot-control-block "taproot control block" control-block)
      (bytevector-copy control-block 1 33))

    (define (taproot-control-block-output-xonly leaf-hash control-block)
      (let* ((internal (taproot-control-block-internal-key control-block))
             (root (taproot-control-block-merkle-root leaf-hash control-block))
             (tweaked (secp256k1-xonly-pubkey-tweak-add
                        internal
                        (tagged-hash "TapTweak"
                                     (bytevector-append internal root))))
             (parity (if (= #x03 (bytevector-u8-ref tweaked 0)) 1 0)))
        (unless (= parity (bitwise-and (bytevector-u8-ref control-block 0) 1))
          (error "taproot control block: output key parity mismatch"))
        (secp256k1-pubkey-xonly tweaked)))

    (define (taproot-sigmsg-base tx input-index prevouts sighash-type spend-type who)
      (validate-transaction tx)
      (require-taproot-sighash who sighash-type)
      (validate-prevouts tx prevouts who)
      (require-uint (string-append who " spend type") spend-type #xff)
      (let ((input (nth-item (transaction-inputs tx)
                             input-index
                             who)))
        (let* ((sha-prevouts
                 (sha256-bytes
                   (serialize-items
                     (transaction-inputs tx)
                     (lambda (txin)
                       (serialize-outpoint (txin-previous-output txin))))))
               (sha-amounts
                 (sha256-bytes
                   (serialize-items
                     prevouts
                     (lambda (prevout)
                       (u64-le (txout-value prevout))))))
               (sha-scriptpubkeys
                 (sha256-bytes
                   (serialize-items prevouts prevout-script-bytes)))
               (sha-sequences
                 (sha256-bytes
                   (serialize-items
                     (transaction-inputs tx)
                     (lambda (txin)
                       (u32-le (txin-sequence txin))))))
               (sha-outputs
                 (sha256-bytes
                   (serialize-items (transaction-outputs tx) serialize-txout))))
          ;; Reference `input` so out-of-range indexes fail before hashing.
          (txin-sequence input)
          (bytevector-append
            (make-bytevector 1 sighash-type)
            (u32-le (transaction-version tx))
            (u32-le (transaction-lock-time tx))
            sha-prevouts
            sha-amounts
            sha-scriptpubkeys
            sha-sequences
            sha-outputs
            (make-bytevector 1 spend-type)
            (u32-le input-index)))))

    ;;; Compute a legacy pre-SegWit signature hash for one input.
    ;;;
    ;;; Currently supports `SIGHASH_ALL`.
    (define (transaction-sighash-legacy tx input-index script-code . maybe-sighash-type)
      (: transaction? integer? bytevector? integer? ... -> bytevector?)
      (let ((sighash-type (if (null? maybe-sighash-type)
                              sighash-all
                              (car maybe-sighash-type))))
        (require-sighash-all "transaction-sighash-legacy" sighash-type)
        (validate-transaction tx)
        (require-bytevector "transaction-sighash-legacy script-code" script-code)
        (let* ((blanked (strip-input-witnesses tx))
               (target (input-with-script
                         (nth-item (transaction-inputs blanked)
                                   input-index
                                   "transaction-sighash-legacy")
                         script-code))
               (inputs (replace-nth (transaction-inputs blanked)
                                    input-index
                                    target
                                    "transaction-sighash-legacy"))
               (signing-tx (transaction
                             version: (transaction-version blanked)
                             inputs: inputs
                             outputs: (transaction-outputs blanked)
                             lock-time: (transaction-lock-time blanked))))
          (hash256
            (bytevector-append
              (transaction-base-serialize signing-tx)
              (u32-le sighash-type))))))

    ;;; Compute a BIP143 SegWit v0 signature hash for one input.
    ;;;
    ;;; Currently supports `SIGHASH_ALL`.
    (define (transaction-sighash-segwit-v0 tx input-index script-code value . maybe-sighash-type)
      (: transaction? integer? bytevector? integer? integer? ... -> bytevector?)
      (let ((sighash-type (if (null? maybe-sighash-type)
                              sighash-all
                              (car maybe-sighash-type))))
        (require-sighash-all "transaction-sighash-segwit-v0" sighash-type)
        (validate-transaction tx)
        (require-bytevector "transaction-sighash-segwit-v0 script-code" script-code)
        (require-uint "transaction-sighash-segwit-v0 value" value %u64-max)
        (let* ((inputs (transaction-inputs tx))
               (input (nth-item inputs input-index "transaction-sighash-segwit-v0"))
               (preimage
                 (bytevector-append
                   (u32-le (transaction-version tx))
                   (hash256 (serialize-prevouts inputs))
                   (hash256 (serialize-sequences inputs))
                   (serialize-outpoint (txin-previous-output input))
                   (bytes-with-length script-code)
                   (u64-le value)
                   (u32-le (txin-sequence input))
                   (hash256 (serialize-outputs (transaction-outputs tx)))
                   (u32-le (transaction-lock-time tx))
                   (u32-le sighash-type))))
          (hash256 preimage))))

    ;;; Compute a BIP341 Taproot key-path signature hash.
    ;;;
    ;;; Supports key-path spends without annex or script-path extension for
    ;;; `SIGHASH_DEFAULT` and `SIGHASH_ALL`.
    (define (transaction-sighash-taproot-keypath tx input-index prevouts . maybe-sighash-type)
      (: transaction? integer? list? integer? ... -> bytevector?)
      (let ((sighash-type (if (null? maybe-sighash-type)
                              sighash-default
                              (car maybe-sighash-type))))
        (tagged-hash
          "TapSighash"
          (bytevector-append
            #u8(0)
            (taproot-sigmsg-base
              tx
              input-index
              prevouts
              sighash-type
              0
              "transaction-sighash-taproot-keypath")))))

    ;;; Compute a BIP341/BIP342 Taproot script-path signature hash.
    ;;;
    ;;; Supports script-path spends without annex or non-default code separator
    ;;; for `SIGHASH_DEFAULT` and `SIGHASH_ALL`.
    (define (transaction-sighash-taproot-scriptpath tx input-index prevouts script leaf-version . maybe-sighash-type)
      (: transaction? integer? list? bytevector? integer? integer? ... -> bytevector?)
      (let ((sighash-type (if (null? maybe-sighash-type)
                              sighash-default
                              (car maybe-sighash-type))))
        (require-bytevector "transaction-sighash-taproot-scriptpath script" script)
        (require-uint "transaction-sighash-taproot-scriptpath leaf version" leaf-version #xff)
        (tagged-hash
          "TapSighash"
          (bytevector-append
            #u8(0)
            (taproot-sigmsg-base
              tx
              input-index
              prevouts
              sighash-type
              2
              "transaction-sighash-taproot-scriptpath")
            (taproot-leaf-hash script leaf-version)
            #u8(0)
            (u32-le %u32-max)))))

    ;;; Sign one legacy P2PKH input and return a transaction with scriptSig data.
    (define (transaction-sign-p2pkh-input tx input-index private-key . maybe-sighash-type)
      (: transaction? integer? bytevector? integer? ... -> transaction?)
      (let* ((sighash-type (if (null? maybe-sighash-type)
                               sighash-all
                               (car maybe-sighash-type)))
             (pubkey (private-key->public-key private-key))
             (script-code (script-p2pkh (hash160 pubkey)))
             (msghash (transaction-sighash-legacy
                        tx input-index script-code sighash-type))
             (der (secp256k1-ecdsa-signature-serialize-der
                    (secp256k1-ecdsa-sign private-key msghash)))
             (sig (append-sighash-byte der sighash-type))
             (input (nth-item (transaction-inputs tx)
                              input-index
                              "transaction-sign-p2pkh-input"))
             (signed-input (input-with-script
                             input
                             (script-append
                               (script-push-data sig)
                               (script-push-data pubkey)))))
        (transaction
          version: (transaction-version tx)
          inputs: (replace-nth (transaction-inputs tx)
                               input-index
                               signed-input
                               "transaction-sign-p2pkh-input")
          outputs: (transaction-outputs tx)
          lock-time: (transaction-lock-time tx))))

    ;;; Sign one P2WPKH input and return a transaction with witness data.
    (define (transaction-sign-p2wpkh-input tx input-index prevout-value private-key . maybe-sighash-type)
      (: transaction? integer? integer? bytevector? integer? ... -> transaction?)
      (let* ((sighash-type (if (null? maybe-sighash-type)
                               sighash-all
                               (car maybe-sighash-type)))
             (pubkey (private-key->public-key private-key))
             (pubkey-hash (hash160 pubkey))
             (script-code (script-p2pkh pubkey-hash))
             (msghash (transaction-sighash-segwit-v0
                        tx input-index script-code prevout-value sighash-type))
             (der (secp256k1-ecdsa-signature-serialize-der
                    (secp256k1-ecdsa-sign private-key msghash)))
             (sig (append-sighash-byte der sighash-type))
             (input (nth-item (transaction-inputs tx)
                              input-index
                              "transaction-sign-p2wpkh-input"))
             (signed-input (input-with-witness
                             (txin previous-output: (txin-previous-output input)
                                   script-sig: #u8()
                                   sequence: (txin-sequence input)
                                   witness: '())
                             (list sig pubkey))))
        (transaction
          version: (transaction-version tx)
          inputs: (replace-nth (transaction-inputs tx)
                               input-index
                               signed-input
                               "transaction-sign-p2wpkh-input")
          outputs: (transaction-outputs tx)
          lock-time: (transaction-lock-time tx))))

    ;;; Sign one Taproot key-path input and return a transaction with witness data.
    ;;;
    ;;; This signs BIP86-style key-path spends without script tree commitments.
    (define (transaction-sign-p2tr-keypath-input tx input-index prevouts private-key . maybe-sighash-type)
      (: transaction? integer? list? bytevector? integer? ... -> transaction?)
      (let* ((sighash-type (if (null? maybe-sighash-type)
                               sighash-default
                               (car maybe-sighash-type)))
             (tweaked-keypair (taproot-tweaked-keypair private-key))
             (output-xonly (secp256k1-keypair-xonly-pub tweaked-keypair))
             (expected-script (script-p2tr output-xonly))
             (checked-prevouts (validate-prevouts
                                 tx prevouts
                                 "transaction-sign-p2tr-keypath-input"))
             (prevout (nth-item checked-prevouts
                                input-index
                                "transaction-sign-p2tr-keypath-input"))
             (msghash (transaction-sighash-taproot-keypath
                        tx input-index checked-prevouts sighash-type))
             (sig (taproot-keypath-signature tweaked-keypair msghash sighash-type))
             (input (nth-item (transaction-inputs tx)
                              input-index
                              "transaction-sign-p2tr-keypath-input")))
        (unless (equal? expected-script (txout-script-pubkey prevout))
          (error "transaction-sign-p2tr-keypath-input: prevout is not BIP86 P2TR for key"))
        (transaction
          version: (transaction-version tx)
          inputs: (replace-nth (transaction-inputs tx)
                               input-index
                               (input-with-witness
                                 (txin previous-output: (txin-previous-output input)
                                       script-sig: #u8()
                                       sequence: (txin-sequence input)
                                       witness: '())
                                 (list sig))
                               "transaction-sign-p2tr-keypath-input")
          outputs: (transaction-outputs tx)
          lock-time: (transaction-lock-time tx))))))
