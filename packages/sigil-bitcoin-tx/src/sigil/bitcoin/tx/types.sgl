;;; (sigil bitcoin tx types) — Bitcoin transaction and PSBT records

(define-library (sigil bitcoin tx types)
  (import (sigil struct))
  (export
    sighash-default
    sighash-all
    outpoint outpoint?
    outpoint-txid outpoint-index
    txin txin?
    txin-previous-output txin-script-sig txin-sequence txin-witness
    txout txout?
    txout-value txout-script-pubkey
    transaction transaction?
    transaction-version transaction-inputs transaction-outputs
    transaction-lock-time
    psbt psbt?
    psbt-unsigned-tx psbt-inputs psbt-outputs
    psbt-taproot-leaf-script psbt-taproot-leaf-script?
    psbt-taproot-leaf-script-control-block
    psbt-taproot-leaf-script-script
    psbt-taproot-leaf-script-leaf-version
    psbt-input psbt-input?
    psbt-input-non-witness-utxo psbt-input-witness-utxo
    psbt-input-partial-sigs
    psbt-input-sighash-type psbt-input-final-script-sig
    psbt-input-final-script-witness psbt-input-taproot-key-sig
    psbt-input-taproot-script-sigs
    psbt-input-taproot-leaf-scripts
    psbt-input-redeem-script psbt-input-witness-script
    psbt-input-bip32-derivations
    psbt-input-taproot-bip32-derivations
    psbt-input-unknowns
    psbt-output psbt-output?
    psbt-output-bip32-derivations
    psbt-output-taproot-bip32-derivations
    psbt-output-unknowns
    psbt-unknowns)
  (begin

    ;;; Standard Taproot `SIGHASH_DEFAULT` flag.
    (define sighash-default 0)

    ;;; Standard Bitcoin `SIGHASH_ALL` flag.
    (define sighash-all 1)

    ;;; Transaction outpoint identifying a previous output by txid and index.
    (define-struct outpoint
      (txid bytevector?)
      (index integer?))

    ;;; Transaction input with previous output, scriptSig, sequence, and witness.
    (define-struct txin
      (previous-output outpoint?)
      (script-sig bytevector?)
      (sequence integer?)
      (witness list?))

    ;;; Transaction output with satoshi value and scriptPubKey.
    (define-struct txout
      (value integer?)
      (script-pubkey bytevector?))

    ;;; Bitcoin transaction record.
    (define-struct transaction
      (version integer?)
      (inputs list?)
      (outputs list?)
      (lock-time integer?))

    ;;; BIP371 Taproot leaf script record for PSBT input maps.
    (define-struct psbt-taproot-leaf-script
      (control-block bytevector?)
      (script bytevector?)
      (leaf-version integer?))

    ;;; PSBT input map subset supported by this package.
    (define-struct psbt-input
      (non-witness-utxo any?)
      (witness-utxo any?)
      (partial-sigs list?)
      (sighash-type any?)
      (final-script-sig bytevector?)
      (final-script-witness list?)
      (taproot-key-sig any?)
      (taproot-script-sigs list?)
      (taproot-leaf-scripts list?)
      (redeem-script any?)
      (witness-script any?)
      (bip32-derivations list?)
      (taproot-bip32-derivations list?)
      (unknowns list?))

    ;;; PSBT output map subset supported by this package.
    (define-struct psbt-output
      (bip32-derivations list?)
      (taproot-bip32-derivations list?)
      (unknowns list?))

    ;;; Partially Signed Bitcoin Transaction record.
    (define-struct psbt
      (unsigned-tx transaction?)
      (inputs list?)
      (outputs list?)
      (unknowns list?))))
