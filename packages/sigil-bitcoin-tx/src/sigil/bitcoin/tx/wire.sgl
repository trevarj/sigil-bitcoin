;;; (sigil bitcoin tx wire) — Transaction wire encoding and parsing

(define-library (sigil bitcoin tx wire)
  (import (sigil math)
          (sigil bitcoin utils)
          (sigil bitcoin primitives)
          (sigil bitcoin tx types))
  (export
    %u32-max
    %u64-max
    compact-size-encode
    compact-size-decode
    compact-size-decode-at
    bytes-with-length
    key-with-type
    psbt-keyval
    psbt-raw-keyval
    read-bytes
    read-length-prefixed-bytes
    validate-outpoint
    validate-witness
    validate-txin
    validate-txout
    validate-transaction
    transaction-create
    transaction-add-input
    transaction-add-output
    transaction-set-input-script-sig
    transaction-set-input-witness
    serialize-outpoint
    serialize-txin
    serialize-txout
    serialize-vector
    serialize-items
    serialize-witness
    parse-txout
    parse-serialized-witness
    transaction-has-witness?
    transaction-serialize
    transaction-parse-at
    transaction-parse
    transaction-base-serialize
    transaction-stripped-size
    transaction-total-size
    transaction-weight
    transaction-vsize
    transaction-output-value
    transaction-fee
    transaction-feerate
    transaction-txid
    transaction-wtxid
    nth-item
    replace-nth)
  (begin

    (define %u32-max #xffffffff)
    (define %u64-max #xffffffffffffffff)

    ;;; Encode a Bitcoin CompactSize unsigned integer.
    ;;;
    ;;; ```scheme
    ;;; (compact-size-encode 253) ; => #u8(#xfd #xfd #x00)
    ;;; ```
    (define (compact-size-encode n)
      (: integer? -> bytevector?)
      (require-uint "compact-size-encode" n %u64-max)
      (cond ((< n #xfd)
             (make-bytevector 1 n))
            ((<= n #xffff)
             (bytevector-append #u8(#xfd) (u16-le n)))
            ((<= n %u32-max)
             (bytevector-append #u8(#xfe) (u32-le n)))
            (else
             (bytevector-append #u8(#xff) (u64-le n)))))

    ;;; Decode a CompactSize integer at `offset`.
    ;;;
    ;;; Returns `(value next-offset)` and rejects non-canonical encodings.
    ;;;
    ;;; ```scheme
    ;;; (compact-size-decode-at #u8(#xfd #xfd #x00 #xaa) 0)
    ;;; ```
    (define (compact-size-decode-at bytes offset)
      (let ((tag (read-byte bytes offset "compact-size-decode")))
        (cond ((< tag #xfd)
               (list tag (+ offset 1)))
              ((= tag #xfd)
               (let ((n (read-u16-le bytes (+ offset 1) "compact-size-decode")))
                 (when (< n #xfd)
                   (error "compact-size-decode: non-canonical u16 encoding"))
                 (list n (+ offset 3))))
              ((= tag #xfe)
               (let ((n (read-u32-le bytes (+ offset 1) "compact-size-decode")))
                 (when (<= n #xffff)
                   (error "compact-size-decode: non-canonical u32 encoding"))
                 (list n (+ offset 5))))
              (else
               (let ((n (read-u64-le bytes (+ offset 1) "compact-size-decode")))
                 (when (<= n %u32-max)
                   (error "compact-size-decode: non-canonical u64 encoding"))
                 (list n (+ offset 9)))))))

    ;;; Decode a CompactSize integer from a bytevector.
    ;;;
    ;;; Returns the integer and rejects trailing bytes.
    ;;;
    ;;; ```scheme
    ;;; (compact-size-decode #u8(#xfd #xfd #x00)) ; => 253
    ;;; ```
    (define (compact-size-decode bytes)
      (: bytevector? -> integer?)
      (let ((result (compact-size-decode-at bytes 0)))
        (unless (= (cadr result) (bytevector-length bytes))
          (error "compact-size-decode: trailing bytes"))
        (car result)))

    ;;; Prefix a bytevector with its CompactSize length.
    ;;;
    ;;; ```scheme
    ;;; (bytes-with-length #u8(#xaa #xbb))
    ;;; ```
    (define (bytes-with-length bytes)
      (require-bytevector "bytes-with-length" bytes)
      (bytevector-append
        (compact-size-encode (bytevector-length bytes))
        bytes))

    ;;; Build a PSBT key from a one-byte key type and key data.
    ;;;
    ;;; ```scheme
    ;;; (key-with-type #x01 #u8(#x02 #x03))
    ;;; ```
    (define (key-with-type key-type key-data)
      (require-uint "psbt key type" key-type #xff)
      (require-bytevector "psbt key data" key-data)
      (bytevector-append (make-bytevector 1 key-type) key-data))

    ;;; Encode a typed PSBT key-value pair.
    ;;;
    ;;; ```scheme
    ;;; (psbt-keyval #x01 #u8() #u8(#xaa))
    ;;; ```
    (define (psbt-keyval key-type key-data value)
      (let ((key (key-with-type key-type key-data)))
        (bytevector-append
          (bytes-with-length key)
          (bytes-with-length value))))

    ;;; Encode a raw PSBT key-value pair while preserving the key bytes.
    ;;;
    ;;; ```scheme
    ;;; (psbt-raw-keyval (cons #u8(#xfc #x01) #u8(#xaa)))
    ;;; ```
    (define (psbt-raw-keyval entry)
      (require-bytevector "psbt raw key" (car entry))
      (require-bytevector "psbt raw value" (cdr entry))
      (bytevector-append
        (bytes-with-length (car entry))
        (bytes-with-length (cdr entry))))

    ;;; Copy `count` bytes from a bytevector at `offset`.
    ;;;
    ;;; ```scheme
    ;;; (read-bytes #u8(1 2 3 4) 1 2 "example")
    ;;; ```
    (define (read-bytes bytes offset count who)
      (ensure-available who bytes offset count)
      (bytevector-copy bytes offset (+ offset count)))

    ;;; Read a CompactSize-prefixed bytevector at `offset`.
    ;;;
    ;;; ```scheme
    ;;; (read-length-prefixed-bytes #u8(2 #xaa #xbb) 0 "example")
    ;;; ```
    (define (read-length-prefixed-bytes bytes offset who)
      (let* ((len-result (compact-size-decode-at bytes offset))
             (len (car len-result))
             (payload-offset (cadr len-result))
             (payload (read-bytes bytes payload-offset len who)))
        (list payload (+ payload-offset len))))

    ;;; Validate an outpoint record and return it.
    ;;;
    ;;; ```scheme
    ;;; (validate-outpoint (outpoint txid: (make-bytevector 32 0) index: 0))
    ;;; ```
    (define (validate-outpoint op)
      (unless (outpoint? op)
        (error "outpoint: expected outpoint"))
      (require-bytevector-length "outpoint txid" (outpoint-txid op) 32)
      (require-uint "outpoint index" (outpoint-index op) %u32-max)
      op)

    (define (validate-witness-item item)
      (require-bytevector "txin witness item" item))

    ;;; Validate a witness stack and return it.
    ;;;
    ;;; ```scheme
    ;;; (validate-witness (list #u8(#x30) #u8(#x02)))
    ;;; ```
    (define (validate-witness witness)
      (unless (list? witness)
        (error "txin witness: expected list"))
      (do ((xs witness (cdr xs)))
          ((null? xs) witness)
        (validate-witness-item (car xs))))

    ;;; Validate a transaction input and return it.
    ;;;
    ;;; ```scheme
    ;;; (validate-txin
    ;;;   (txin previous-output: (outpoint txid: (make-bytevector 32 0) index: 0)
    ;;;         script-sig: #u8() sequence: #xffffffff witness: '()))
    ;;; ```
    (define (validate-txin input)
      (unless (txin? input)
        (error "txin: expected txin"))
      (validate-outpoint (txin-previous-output input))
      (require-bytevector "txin script-sig" (txin-script-sig input))
      (require-uint "txin sequence" (txin-sequence input) %u32-max)
      (validate-witness (txin-witness input))
      input)

    ;;; Validate a transaction output and return it.
    ;;;
    ;;; ```scheme
    ;;; (validate-txout (txout value: 1000 script-pubkey: #u8(#x51)))
    ;;; ```
    (define (validate-txout output)
      (unless (txout? output)
        (error "txout: expected txout"))
      (require-uint "txout value" (txout-value output) %u64-max)
      (require-bytevector "txout script-pubkey" (txout-script-pubkey output))
      output)

    ;;; Validate a transaction record and return it.
    ;;;
    ;;; ```scheme
    ;;; (validate-transaction (transaction-create 2 0))
    ;;; ```
    (define (validate-transaction tx)
      (unless (transaction? tx)
        (error "transaction: expected transaction"))
      (require-uint "transaction version" (transaction-version tx) %u32-max)
      (unless (list? (transaction-inputs tx))
        (error "transaction inputs: expected list"))
      (unless (list? (transaction-outputs tx))
        (error "transaction outputs: expected list"))
      (require-uint "transaction lock-time" (transaction-lock-time tx) %u32-max)
      (do ((xs (transaction-inputs tx) (cdr xs)))
          ((null? xs))
        (validate-txin (car xs)))
      (do ((xs (transaction-outputs tx) (cdr xs)))
          ((null? xs) tx)
        (validate-txout (car xs))))

    ;;; Create an empty transaction suitable for incremental construction.
    ;;;
    ;;; ```scheme
    ;;; (transaction-create 2 0)
    ;;; ```
    (define (transaction-create version lock-time)
      (: integer? integer? -> transaction?)
      (let ((tx (transaction version: version
                             inputs: '()
                             outputs: '()
                             lock-time: lock-time)))
        (validate-transaction tx)))

    ;;; Append a new input with empty scriptSig and witness.
    ;;;
    ;;; ```scheme
    ;;; (transaction-add-input
    ;;;   (transaction-create 2 0)
    ;;;   (outpoint txid: (make-bytevector 32 0) index: 0)
    ;;;   #xffffffff)
    ;;; ```
    (define (transaction-add-input tx previous-output sequence)
      (: transaction? outpoint? integer? -> transaction?)
      (validate-transaction tx)
      (validate-outpoint previous-output)
      (let ((input (txin previous-output: previous-output
                         script-sig: #u8()
                         sequence: sequence
                         witness: '())))
        (validate-txin input)
        (transaction version: (transaction-version tx)
                     inputs: (append (transaction-inputs tx) (list input))
                     outputs: (transaction-outputs tx)
                     lock-time: (transaction-lock-time tx))))

    ;;; Append a new transaction output.
    ;;;
    ;;; ```scheme
    ;;; (transaction-add-output (transaction-create 2 0) 1000 #u8(#x51))
    ;;; ```
    (define (transaction-add-output tx value script-pubkey)
      (: transaction? integer? bytevector? -> transaction?)
      (validate-transaction tx)
      (let ((output (txout value: value script-pubkey: script-pubkey)))
        (validate-txout output)
        (transaction version: (transaction-version tx)
                     inputs: (transaction-inputs tx)
                     outputs: (append (transaction-outputs tx) (list output))
                     lock-time: (transaction-lock-time tx))))

    ;;; Replace an input's scriptSig.
    ;;;
    ;;; ```scheme
    ;;; (transaction-set-input-script-sig tx 0 #u8(#x51))
    ;;; ```
    (define (transaction-set-input-script-sig tx input-index script-sig)
      (: transaction? integer? bytevector? -> transaction?)
      (validate-transaction tx)
      (require-bytevector "transaction-set-input-script-sig" script-sig)
      (let* ((input (nth-item (transaction-inputs tx)
                              input-index
                              "transaction-set-input-script-sig"))
             (updated (txin previous-output: (txin-previous-output input)
                            script-sig: script-sig
                            sequence: (txin-sequence input)
                            witness: (txin-witness input))))
        (transaction version: (transaction-version tx)
                     inputs: (replace-nth (transaction-inputs tx)
                                          input-index
                                          updated
                                          "transaction-set-input-script-sig")
                     outputs: (transaction-outputs tx)
                     lock-time: (transaction-lock-time tx))))

    ;;; Replace an input's witness stack.
    ;;;
    ;;; ```scheme
    ;;; (transaction-set-input-witness tx 0 (list #u8(#x30) #u8(#x02)))
    ;;; ```
    (define (transaction-set-input-witness tx input-index witness)
      (: transaction? integer? list? -> transaction?)
      (validate-transaction tx)
      (validate-witness witness)
      (let* ((input (nth-item (transaction-inputs tx)
                              input-index
                              "transaction-set-input-witness"))
             (updated (txin previous-output: (txin-previous-output input)
                            script-sig: (txin-script-sig input)
                            sequence: (txin-sequence input)
                            witness: witness)))
        (transaction version: (transaction-version tx)
                     inputs: (replace-nth (transaction-inputs tx)
                                          input-index
                                          updated
                                          "transaction-set-input-witness")
                     outputs: (transaction-outputs tx)
                     lock-time: (transaction-lock-time tx))))

    ;;; Serialize an outpoint to Bitcoin wire byte order.
    ;;;
    ;;; ```scheme
    ;;; (serialize-outpoint (outpoint txid: (make-bytevector 32 0) index: 0))
    ;;; ```
    (define (serialize-outpoint op)
      (validate-outpoint op)
      (bytevector-append
        (reverse-bytevector (outpoint-txid op))
        (u32-le (outpoint-index op))))

    ;;; Serialize a transaction input without witness data.
    ;;;
    ;;; ```scheme
    ;;; (serialize-txin input)
    ;;; ```
    (define (serialize-txin input)
      (validate-txin input)
      (bytevector-append
        (serialize-outpoint (txin-previous-output input))
        (bytes-with-length (txin-script-sig input))
        (u32-le (txin-sequence input))))

    ;;; Serialize a transaction output.
    ;;;
    ;;; ```scheme
    ;;; (serialize-txout (txout value: 1000 script-pubkey: #u8(#x51)))
    ;;; ```
    (define (serialize-txout output)
      (validate-txout output)
      (bytevector-append
        (u64-le (txout-value output))
        (bytes-with-length (txout-script-pubkey output))))

    ;;; Serialize a CompactSize-counted vector with `serializer`.
    ;;;
    ;;; ```scheme
    ;;; (serialize-vector (list #u8(#xaa)) (lambda (item) item))
    ;;; ```
    (define (serialize-vector items serializer)
      (let ((parts '()))
        (do ((xs items (cdr xs)))
            ((null? xs))
          (set! parts (append parts (list (serializer (car xs))))))
        (apply bytevector-append
               (cons (compact-size-encode (length items)) parts))))

    ;;; Serialize a list of items without a count prefix.
    ;;;
    ;;; ```scheme
    ;;; (serialize-items (list #u8(#xaa) #u8(#xbb)) (lambda (item) item))
    ;;; ```
    (define (serialize-items items serializer)
      (let ((parts '()))
        (do ((xs items (cdr xs)))
            ((null? xs))
          (set! parts (append parts (list (serializer (car xs))))))
        (if (null? parts)
            #u8()
            (apply bytevector-append parts))))

    ;;; Serialize a SegWit witness stack.
    ;;;
    ;;; ```scheme
    ;;; (serialize-witness (list #u8(#x30) #u8(#x02)))
    ;;; ```
    (define (serialize-witness witness)
      (validate-witness witness)
      (let ((parts '()))
        (do ((xs witness (cdr xs)))
            ((null? xs))
          (set! parts (append parts (list (bytes-with-length (car xs))))))
        (apply bytevector-append
               (cons (compact-size-encode (length witness)) parts))))

    (define (parse-outpoint bytes offset)
      (let ((wire-txid (read-bytes bytes offset 32 "outpoint"))
            (index (read-u32-le bytes (+ offset 32) "outpoint")))
        (list
          (outpoint txid: (reverse-bytevector wire-txid)
                    index: index)
          (+ offset 36))))

    (define (parse-txin bytes offset)
      (let* ((op-result (parse-outpoint bytes offset))
             (op (car op-result))
             (script-result (read-length-prefixed-bytes
                              bytes (cadr op-result) "txin script-sig"))
             (script-sig (car script-result))
             (sequence (read-u32-le bytes (cadr script-result) "txin sequence")))
        (list
          (txin previous-output: op
                script-sig: script-sig
                sequence: sequence
                witness: '())
          (+ (cadr script-result) 4))))

    ;;; Parse a transaction output at `offset`.
    ;;;
    ;;; ```scheme
    ;;; (parse-txout #u8(#xe8 #x03 #x00 #x00 #x00 #x00 #x00 #x00 #x01 #x51) 0)
    ;;; ```
    (define (parse-txout bytes offset)
      (let* ((value (read-u64-le bytes offset "txout value"))
             (script-result (read-length-prefixed-bytes
                              bytes (+ offset 8) "txout script-pubkey")))
        (list
          (txout value: value
                 script-pubkey: (car script-result))
          (cadr script-result))))

    (define (parse-vector bytes offset parser)
      (let* ((count-result (compact-size-decode-at bytes offset))
             (count (car count-result)))
        (let loop ((i 0)
                   (next (cadr count-result))
                   (items '()))
          (if (>= i count)
              (list (reverse items) next)
              (let ((parsed (parser bytes next)))
                (loop (+ i 1)
                      (cadr parsed)
                      (cons (car parsed) items)))))))

    (define (parse-witness bytes offset)
      (let* ((count-result (compact-size-decode-at bytes offset))
             (count (car count-result)))
        (let loop ((i 0)
                   (next (cadr count-result))
                   (items '()))
          (if (>= i count)
              (list (reverse items) next)
              (let ((item-result (read-length-prefixed-bytes
                                   bytes next "txin witness item")))
                (loop (+ i 1)
                      (cadr item-result)
                      (cons (car item-result) items)))))))

    ;;; Parse a serialized witness stack and reject trailing bytes.
    ;;;
    ;;; ```scheme
    ;;; (parse-serialized-witness (serialize-witness (list #u8(#x30))))
    ;;; ```
    (define (parse-serialized-witness bytes)
      (let ((parsed (parse-witness bytes 0)))
        (unless (= (cadr parsed) (bytevector-length bytes))
          (error "psbt final witness: trailing bytes"))
        (car parsed)))

    (define (attach-witnesses inputs witnesses)
      (let loop ((ins inputs)
                 (wits witnesses)
                 (out '()))
        (cond ((and (null? ins) (null? wits))
               (reverse out))
              ((or (null? ins) (null? wits))
               (error "transaction-parse: witness/input count mismatch"))
              (else
               (let ((input (car ins)))
                 (loop
                   (cdr ins)
                   (cdr wits)
                   (cons
                     (txin previous-output: (txin-previous-output input)
                           script-sig: (txin-script-sig input)
                           sequence: (txin-sequence input)
                           witness: (car wits))
                     out)))))))

    (define (parse-witnesses bytes offset inputs)
      (let loop ((ins inputs)
                 (next offset)
                 (witnesses '()))
        (if (null? ins)
            (list (attach-witnesses inputs (reverse witnesses)) next)
            (let ((parsed (parse-witness bytes next)))
              (loop (cdr ins)
                    (cadr parsed)
                    (cons (car parsed) witnesses))))))

    ;;; Return true when any transaction input has witness stack items.
    ;;;
    ;;; ```scheme
    ;;; (transaction-has-witness? (transaction-create 2 0))
    ;;; ```
    (define (transaction-has-witness? tx)
      (: transaction? -> boolean?)
      (validate-transaction tx)
      (let ((has? #f))
        (do ((xs (transaction-inputs tx) (cdr xs)))
            ((or (null? xs) has?) has?)
          (when (not (null? (txin-witness (car xs))))
            (set! has? #t)))))

    ;;; Serialize a transaction to Bitcoin wire bytes.
    ;;;
    ;;; Includes witness data by default when present. Pass `#f` to omit
    ;;; witnesses for txid/base serialization.
    ;;;
    ;;; ```scheme
    ;;; (transaction-serialize (transaction-create 2 0))
    ;;; ```
    (define (transaction-serialize tx . maybe-include-witness)
      (: transaction? boolean? ... -> bytevector?)
      (validate-transaction tx)
      (let* ((allow-witness? (if (null? maybe-include-witness)
                                 #t
                                 (car maybe-include-witness)))
             (include-witness? (and allow-witness? (transaction-has-witness? tx)))
             (prefix (if include-witness?
                         (bytevector-append (u32-le (transaction-version tx))
                                            #u8(#x00 #x01))
                         (u32-le (transaction-version tx))))
             (base (bytevector-append
                     prefix
                     (serialize-vector (transaction-inputs tx) serialize-txin)
                     (serialize-vector (transaction-outputs tx) serialize-txout))))
        (if include-witness?
            (let ((witnesses '()))
              (do ((xs (transaction-inputs tx) (cdr xs)))
                  ((null? xs))
                (set! witnesses
                      (append witnesses
                              (list (serialize-witness (txin-witness (car xs)))))))
              (bytevector-append
                base
                (apply bytevector-append witnesses)
                (u32-le (transaction-lock-time tx))))
            (bytevector-append base (u32-le (transaction-lock-time tx))))))

    ;;; Parse a Bitcoin transaction at `offset`.
    ;;;
    ;;; Returns `(transaction next-offset)`.
    ;;;
    ;;; ```scheme
    ;;; (transaction-parse-at (transaction-serialize tx) 0)
    ;;; ```
    (define (transaction-parse-at bytes offset)
      (: bytevector? integer? -> list?)
      (require-bytevector "transaction-parse-at" bytes)
      (let* ((version (read-u32-le bytes offset "transaction version"))
             (marker-offset (+ offset 4))
             (marker (read-byte bytes marker-offset "transaction marker"))
             (segwit? (and (= marker 0)
                           (> (bytevector-length bytes) (+ offset 5))
                           (not (= 0 (read-byte bytes (+ offset 5) "transaction flag")))))
             (input-offset (if segwit? (+ offset 6) (+ offset 4)))
             (inputs-result (parse-vector bytes input-offset parse-txin))
             (outputs-result (parse-vector bytes (cadr inputs-result) parse-txout))
             (inputs (car inputs-result))
             (outputs (car outputs-result))
             (after-outputs (cadr outputs-result))
             (witness-result (if segwit?
                                 (parse-witnesses bytes after-outputs inputs)
                                 (list inputs after-outputs)))
             (lock-offset (cadr witness-result))
             (lock-time (read-u32-le bytes lock-offset "transaction lock-time"))
             (end (+ lock-offset 4)))
        (list
          (transaction version: version
                       inputs: (car witness-result)
                       outputs: outputs
                       lock-time: lock-time)
          end)))

    ;;; Parse Bitcoin wire bytes into a transaction record.
    ;;;
    ;;; ```scheme
    ;;; (transaction-parse (transaction-serialize tx))
    ;;; ```
    (define (transaction-parse bytes)
      (: bytevector? -> transaction?)
      (require-bytevector "transaction-parse" bytes)
      (let ((result (transaction-parse-at bytes 0)))
        (unless (= (cadr result) (bytevector-length bytes))
          (error "transaction-parse: trailing bytes"))
        (car result)))

    ;;; Serialize a transaction without SegWit marker, flag, or witnesses.
    ;;;
    ;;; ```scheme
    ;;; (transaction-base-serialize tx)
    ;;; ```
    (define (transaction-base-serialize tx)
      (: transaction? -> bytevector?)
      (transaction-serialize tx #f))

    ;;; Return the transaction's non-witness serialized size in bytes.
    ;;;
    ;;; ```scheme
    ;;; (transaction-stripped-size tx)
    ;;; ```
    (define (transaction-stripped-size tx)
      (: transaction? -> integer?)
      (bytevector-length (transaction-base-serialize tx)))

    ;;; Return the transaction's full serialized size in bytes.
    ;;;
    ;;; ```scheme
    ;;; (transaction-total-size tx)
    ;;; ```
    (define (transaction-total-size tx)
      (: transaction? -> integer?)
      (bytevector-length (transaction-serialize tx #t)))

    ;;; Return the transaction weight units defined by BIP141.
    ;;;
    ;;; ```scheme
    ;;; (transaction-weight tx)
    ;;; ```
    (define (transaction-weight tx)
      (: transaction? -> integer?)
      (+ (* 3 (transaction-stripped-size tx))
         (transaction-total-size tx)))

    ;;; Return the transaction virtual size in vbytes.
    ;;;
    ;;; ```scheme
    ;;; (transaction-vsize tx)
    ;;; ```
    (define (transaction-vsize tx)
      (: transaction? -> integer?)
      (let ((weight (transaction-weight tx)))
        (quotient (+ weight 3) 4)))

    (define (sum-txout-values who outputs)
      (let loop ((xs outputs) (total 0))
        (if (null? xs)
            total
            (let ((output (car xs)))
              (validate-txout output)
              (loop (cdr xs) (+ total (txout-value output)))))))

    ;;; Return the sum of this transaction's output values in satoshis.
    ;;;
    ;;; ```scheme
    ;;; (transaction-output-value tx)
    ;;; ```
    (define (transaction-output-value tx)
      (: transaction? -> integer?)
      (validate-transaction tx)
      (sum-txout-values "transaction-output-value"
                        (transaction-outputs tx)))

    (define (require-prevout-count tx prevouts)
      (unless (= (length (transaction-inputs tx)) (length prevouts))
        (error "transaction-fee: prevout count mismatch")))

    ;;; Return input value minus output value for a transaction.
    ;;;
    ;;; `prevouts` must contain one `txout` for each transaction input.
    ;;;
    ;;; ```scheme
    ;;; (transaction-fee tx prevouts)
    ;;; ```
    (define (transaction-fee tx prevouts)
      (: transaction? list? -> integer?)
      (validate-transaction tx)
      (require-prevout-count tx prevouts)
      (let ((fee (- (sum-txout-values "transaction-fee" prevouts)
                    (transaction-output-value tx))))
        (when (< fee 0)
          (error "transaction-fee: output value exceeds input value"))
        fee))

    ;;; Return the fee rate in satoshis per virtual byte.
    ;;;
    ;;; ```scheme
    ;;; (transaction-feerate tx prevouts)
    ;;; ```
    (define (transaction-feerate tx prevouts)
      (: transaction? list? -> number?)
      (/ (transaction-fee tx prevouts)
         (transaction-vsize tx)))

    ;;; Return the transaction ID bytevector for a transaction.
    ;;;
    ;;; ```scheme
    ;;; (transaction-txid tx)
    ;;; ```
    (define (transaction-txid tx)
      (: transaction? -> bytevector?)
      (hash256 (transaction-base-serialize tx)))

    ;;; Return the witness transaction ID bytevector for a transaction.
    ;;;
    ;;; ```scheme
    ;;; (transaction-wtxid tx)
    ;;; ```
    (define (transaction-wtxid tx)
      (: transaction? -> bytevector?)
      (hash256 (transaction-serialize tx #t)))

    ;;; Return the nth list item or raise an indexed error named by `who`.
    ;;;
    ;;; ```scheme
    ;;; (nth-item '(a b c) 1 "example")
    ;;; ```
    (define (nth-item items index who)
      (when (< index 0)
        (error (string-append who ": index out of range")))
      (let loop ((xs items) (i 0))
        (cond ((null? xs)
               (error (string-append who ": index out of range")))
              ((= i index)
               (car xs))
              (else
               (loop (cdr xs) (+ i 1))))))

    ;;; Return a list with the nth item replaced.
    ;;;
    ;;; ```scheme
    ;;; (replace-nth '(a b c) 1 'x "example")
    ;;; ```
    (define (replace-nth items index value who)
      (when (< index 0)
        (error (string-append who ": index out of range")))
      (let loop ((xs items) (i 0) (out '()))
        (cond ((null? xs)
               (error (string-append who ": index out of range")))
              ((= i index)
               (append (reverse out) (cons value (cdr xs))))
              (else
               (loop (cdr xs) (+ i 1) (cons (car xs) out))))))))
