;;; (sigil bitcoin psbt) — Partially Signed Bitcoin Transactions

(define-library (sigil bitcoin psbt)
  (import (sigil math)
          (sigil crypto)
          (sigil secp256k1)
          (sigil bitcoin utils)
          (sigil bitcoin tx types)
          (sigil bitcoin tx wire)
          (sigil bitcoin tx sighash)
          (sigil bitcoin primitives)
          (sigil bitcoin script)
          (sigil bitcoin keys)
          (sigil bitcoin psbt base)
          (sigil bitcoin psbt wire))
  (export
    psbt psbt?
    psbt-unsigned-tx psbt-inputs psbt-outputs
    psbt-taproot-leaf-script psbt-taproot-leaf-script?
    psbt-taproot-leaf-script-control-block
    psbt-taproot-leaf-script-script
    psbt-taproot-leaf-script-leaf-version
    psbt-input psbt-input?
    psbt-input-non-witness-utxo psbt-input-witness-utxo
    psbt-input-partial-sigs
    psbt-input-sighash-type psbt-input-final-script-sig
    psbt-input-final-script-witness psbt-input-taproot-key-sig
    psbt-input-taproot-script-sigs
    psbt-input-taproot-leaf-scripts
    psbt-input-redeem-script psbt-input-witness-script
    psbt-input-bip32-derivations
    psbt-input-taproot-bip32-derivations
    psbt-input-unknowns
    psbt-output psbt-output?
    psbt-output-bip32-derivations
    psbt-output-taproot-bip32-derivations
    psbt-output-unknowns
    psbt-unknowns
    psbt-create
    psbt-annotate-input
    psbt-annotate-input-scripts
    psbt-annotate-output
    psbt-serialize
    psbt-parse
    psbt-sign-p2pkh-input
    psbt-sign-p2wpkh-input
    psbt-sign-p2wsh-input
    psbt-sign-p2tr-keypath-input
    psbt-sign-p2tr-scriptpath-input
    psbt-sign-standard-input
    psbt-finalize-p2pkh-input
    psbt-finalize-p2wpkh-input
    psbt-finalize-p2wsh-input
    psbt-finalize-p2tr-keypath-input
    psbt-finalize-p2tr-scriptpath-input
    psbt-finalize-standard-input
    psbt-extract-transaction)
  (begin

    (define (psbt-annotate-input p input-index script-pubkey bip32-derivations taproot-bip32-derivations)
      (: psbt? integer? bytevector? list? list? -> psbt?)
      (validate-psbt p)
      (require-bytevector "psbt-annotate-input scriptPubKey" script-pubkey)
      (validate-bip32-derivations
        "psbt-annotate-input BIP32 derivation"
        bip32-derivations
        33
        validate-bip32-origin-value)
      (validate-bip32-derivations
        "psbt-annotate-input Taproot BIP32 derivation"
        taproot-bip32-derivations
        32
        validate-taproot-origin-value)
      (let* ((input (nth-item (psbt-inputs p) input-index "psbt-annotate-input"))
             (utxo (psbt-input-prevout p input-index "psbt-annotate-input")))
        (unless (equal? script-pubkey (txout-script-pubkey utxo))
          (error "psbt-annotate-input: prevout scriptPubKey mismatch"))
        (psbt-update-input
          p
          input-index
          (psbt-input
            non-witness-utxo: (psbt-input-non-witness-utxo input)
            witness-utxo: (psbt-input-witness-utxo input)
            partial-sigs: (psbt-input-partial-sigs input)
            sighash-type: (psbt-input-sighash-type input)
            final-script-sig: (psbt-input-final-script-sig input)
            final-script-witness: (psbt-input-final-script-witness input)
            taproot-key-sig: (psbt-input-taproot-key-sig input)
                           taproot-script-sigs: (psbt-input-taproot-script-sigs input)
                           taproot-leaf-scripts: (psbt-input-taproot-leaf-scripts input)
            redeem-script: (psbt-input-redeem-script input)
            witness-script: (psbt-input-witness-script input)
            bip32-derivations: (merge-keyvals (psbt-input-bip32-derivations input)
                                              bip32-derivations)
            taproot-bip32-derivations: (merge-keyvals
                                          (psbt-input-taproot-bip32-derivations input)
                                          taproot-bip32-derivations)
            unknowns: (psbt-input-unknowns input)))))

    ;;; Attach redeem or witness scripts to a PSBT input map.
    (define (psbt-annotate-input-scripts p input-index redeem-script witness-script)
      (: psbt? integer? any? any? -> psbt?)
      (validate-psbt p)
      (when redeem-script
        (require-bytevector "psbt-annotate-input-scripts redeem script" redeem-script))
      (when witness-script
        (require-bytevector "psbt-annotate-input-scripts witness script" witness-script))
      (let ((input (nth-item (psbt-inputs p) input-index "psbt-annotate-input-scripts")))
        (psbt-update-input
          p
          input-index
          (psbt-input
            non-witness-utxo: (psbt-input-non-witness-utxo input)
            witness-utxo: (psbt-input-witness-utxo input)
            partial-sigs: (psbt-input-partial-sigs input)
            sighash-type: (psbt-input-sighash-type input)
            final-script-sig: (psbt-input-final-script-sig input)
            final-script-witness: (psbt-input-final-script-witness input)
            taproot-key-sig: (psbt-input-taproot-key-sig input)
                           taproot-script-sigs: (psbt-input-taproot-script-sigs input)
                           taproot-leaf-scripts: (psbt-input-taproot-leaf-scripts input)
            redeem-script: (if redeem-script redeem-script (psbt-input-redeem-script input))
            witness-script: (if witness-script witness-script (psbt-input-witness-script input))
            bip32-derivations: (psbt-input-bip32-derivations input)
            taproot-bip32-derivations: (psbt-input-taproot-bip32-derivations input)
            unknowns: (psbt-input-unknowns input)))))

    ;;; Attach BIP32 derivation metadata to a PSBT output after script matching.
    (define (psbt-annotate-output p output-index script-pubkey bip32-derivations taproot-bip32-derivations)
      (: psbt? integer? bytevector? list? list? -> psbt?)
      (validate-psbt p)
      (require-bytevector "psbt-annotate-output scriptPubKey" script-pubkey)
      (validate-bip32-derivations
        "psbt-annotate-output BIP32 derivation"
        bip32-derivations
        33
        validate-bip32-origin-value)
      (validate-bip32-derivations
        "psbt-annotate-output Taproot BIP32 derivation"
        taproot-bip32-derivations
        32
        validate-taproot-origin-value)
      (let* ((output (nth-item (psbt-outputs p) output-index "psbt-annotate-output"))
             (txout0 (nth-item (transaction-outputs (psbt-unsigned-tx p))
                               output-index
                               "psbt-annotate-output")))
        (unless (equal? script-pubkey (txout-script-pubkey txout0))
          (error "psbt-annotate-output: output scriptPubKey mismatch"))
        (psbt-update-output
          p
          output-index
          (psbt-output
            bip32-derivations: (merge-keyvals (psbt-output-bip32-derivations output)
                                              bip32-derivations)
            taproot-bip32-derivations: (merge-keyvals
                                          (psbt-output-taproot-bip32-derivations output)
                                          taproot-bip32-derivations)
            unknowns: (psbt-output-unknowns output)))))
    ;;; Add a legacy P2PKH partial signature to a PSBT input.
    ;;;
    ;;; The input must contain the previous transaction as a non-witness UTXO.
    (define (psbt-sign-p2pkh-input p input-index private-key)
      (: psbt? integer? bytevector? -> psbt?)
      (validate-psbt p)
      (let* ((input (nth-item (psbt-inputs p) input-index "psbt-sign-p2pkh-input"))
             (utxo (psbt-prevout-from-non-witness-utxo
                     p input-index input "psbt-sign-p2pkh-input"))
             (pubkey (private-key->public-key private-key))
             (pubkey-hash (hash160 pubkey))
             (expected-script (script-p2pkh pubkey-hash)))
        (unless (equal? expected-script (txout-script-pubkey utxo))
          (error "psbt-sign-p2pkh-input: non-witness UTXO is not P2PKH for key"))
        (let* ((sighash-type (psbt-input-sighash-or-default input sighash-all))
               (msghash (transaction-sighash-legacy
                          (psbt-unsigned-tx p)
                          input-index
                          expected-script
                          sighash-type))
               (der (secp256k1-ecdsa-signature-serialize-der
                      (secp256k1-ecdsa-sign private-key msghash)))
               (sig (append-sighash-byte der sighash-type))
               (signed-input
                 (psbt-input
                   non-witness-utxo: (psbt-input-non-witness-utxo input)
                   witness-utxo: (psbt-input-witness-utxo input)
                   partial-sigs: (append (psbt-input-partial-sigs input)
                                         (list (cons pubkey sig)))
                   sighash-type: sighash-type
                   final-script-sig: (psbt-input-final-script-sig input)
                   final-script-witness: (psbt-input-final-script-witness input)
                   taproot-key-sig: (psbt-input-taproot-key-sig input)
                           taproot-script-sigs: (psbt-input-taproot-script-sigs input)
                           taproot-leaf-scripts: (psbt-input-taproot-leaf-scripts input)
                   redeem-script: (psbt-input-redeem-script input)
                   witness-script: (psbt-input-witness-script input)
                   bip32-derivations: (psbt-input-bip32-derivations input)
                   taproot-bip32-derivations: (psbt-input-taproot-bip32-derivations input)
                   unknowns: (psbt-input-unknowns input))))
          (psbt-update-input p input-index signed-input))))

    ;;; Add a P2WPKH partial signature to a PSBT input.
    ;;;
    ;;; The input must contain a witness UTXO.
    (define (psbt-sign-p2wpkh-input p input-index private-key)
      (: psbt? integer? bytevector? -> psbt?)
      (validate-psbt p)
      (let* ((input (nth-item (psbt-inputs p) input-index "psbt-sign-p2wpkh-input"))
             (utxo (psbt-input-witness-utxo input)))
        (unless utxo
          (error "psbt-sign-p2wpkh-input: missing witness UTXO"))
        (let* ((pubkey (private-key->public-key private-key))
               (pubkey-hash (hash160 pubkey))
               (expected-script (script-p2wpkh pubkey-hash)))
          (unless (equal? expected-script (txout-script-pubkey utxo))
            (error "psbt-sign-p2wpkh-input: witness UTXO is not P2WPKH for key"))
          (let* ((sighash-type (psbt-input-sighash-or-default input sighash-all))
                 (script-code (script-p2pkh pubkey-hash))
                 (msghash (transaction-sighash-segwit-v0
                            (psbt-unsigned-tx p)
                            input-index
                            script-code
                            (txout-value utxo)
                            sighash-type))
                 (der (secp256k1-ecdsa-signature-serialize-der
                        (secp256k1-ecdsa-sign private-key msghash)))
                 (sig (append-sighash-byte der sighash-type))
                 (signed-input
                   (psbt-input
                     non-witness-utxo: (psbt-input-non-witness-utxo input)
                     witness-utxo: utxo
                     partial-sigs: (append (psbt-input-partial-sigs input)
                                           (list (cons pubkey sig)))
                     sighash-type: sighash-type
                     final-script-sig: (psbt-input-final-script-sig input)
                     final-script-witness: (psbt-input-final-script-witness input)
                     taproot-key-sig: (psbt-input-taproot-key-sig input)
                           taproot-script-sigs: (psbt-input-taproot-script-sigs input)
                           taproot-leaf-scripts: (psbt-input-taproot-leaf-scripts input)
                     redeem-script: (psbt-input-redeem-script input)
                     witness-script: (psbt-input-witness-script input)
                     bip32-derivations: (psbt-input-bip32-derivations input)
                     taproot-bip32-derivations: (psbt-input-taproot-bip32-derivations input)
                     unknowns: (psbt-input-unknowns input))))
            (psbt-update-input p input-index signed-input)))))

    ;;; Add a P2WSH partial signature for a single-key checksig witness script.
    (define (psbt-sign-p2wsh-input p input-index private-key)
      (: psbt? integer? bytevector? -> psbt?)
      (validate-psbt p)
      (let* ((input (nth-item (psbt-inputs p) input-index "psbt-sign-p2wsh-input"))
             (utxo (psbt-input-witness-utxo input))
             (witness-script (psbt-input-witness-script input)))
        (unless utxo
          (error "psbt-sign-p2wsh-input: missing witness UTXO"))
        (unless witness-script
          (error "psbt-sign-p2wsh-input: missing witness script"))
        (let* ((pubkey (private-key->public-key private-key))
               (script-pubkey (script-p2wsh (sha256-bytes witness-script)))
               (script-pubkey-key (witness-script-pk-checksig-pubkey witness-script)))
          (unless (equal? script-pubkey (txout-script-pubkey utxo))
            (error "psbt-sign-p2wsh-input: witness UTXO is not P2WSH for witness script"))
          (unless (and script-pubkey-key (equal? pubkey script-pubkey-key))
            (error "psbt-sign-p2wsh-input: witness script is not single-key checksig for key"))
          (let* ((sighash-type (psbt-input-sighash-or-default input sighash-all))
                 (msghash (transaction-sighash-segwit-v0
                            (psbt-unsigned-tx p)
                            input-index
                            witness-script
                            (txout-value utxo)
                            sighash-type))
                 (der (secp256k1-ecdsa-signature-serialize-der
                        (secp256k1-ecdsa-sign private-key msghash)))
                 (sig (append-sighash-byte der sighash-type))
                 (signed-input
                   (psbt-input
                     non-witness-utxo: (psbt-input-non-witness-utxo input)
                     witness-utxo: utxo
                     partial-sigs: (append (psbt-input-partial-sigs input)
                                           (list (cons pubkey sig)))
                     sighash-type: sighash-type
                     final-script-sig: (psbt-input-final-script-sig input)
                     final-script-witness: (psbt-input-final-script-witness input)
                     taproot-key-sig: (psbt-input-taproot-key-sig input)
                           taproot-script-sigs: (psbt-input-taproot-script-sigs input)
                           taproot-leaf-scripts: (psbt-input-taproot-leaf-scripts input)
                     redeem-script: (psbt-input-redeem-script input)
                     witness-script: witness-script
                     bip32-derivations: (psbt-input-bip32-derivations input)
                     taproot-bip32-derivations: (psbt-input-taproot-bip32-derivations input)
                     unknowns: (psbt-input-unknowns input))))
            (psbt-update-input p input-index signed-input)))))

    ;;; Add a Taproot key-path signature to a PSBT input.
    (define (psbt-sign-p2tr-keypath-input p input-index private-key)
      (: psbt? integer? bytevector? -> psbt?)
      (validate-psbt p)
      (let* ((input (nth-item (psbt-inputs p) input-index "psbt-sign-p2tr-keypath-input"))
             (prevouts (psbt-prevouts p "psbt-sign-p2tr-keypath-input"))
             (utxo (nth-item prevouts input-index "psbt-sign-p2tr-keypath-input"))
             (sighash-type (psbt-input-sighash-or-default input sighash-default))
             (tweaked-keypair (taproot-tweaked-keypair private-key))
             (output-xonly (secp256k1-keypair-xonly-pub tweaked-keypair))
             (expected-script (script-p2tr output-xonly)))
        (unless (equal? expected-script (txout-script-pubkey utxo))
          (error "psbt-sign-p2tr-keypath-input: UTXO is not BIP86 P2TR for key"))
        (let* ((msghash (transaction-sighash-taproot-keypath
                          (psbt-unsigned-tx p)
                          input-index
                          prevouts
                          sighash-type))
               (sig (taproot-keypath-signature tweaked-keypair msghash sighash-type))
               (signed-input
                 (psbt-input
                   non-witness-utxo: (psbt-input-non-witness-utxo input)
                   witness-utxo: (psbt-input-witness-utxo input)
                   partial-sigs: (psbt-input-partial-sigs input)
                   sighash-type: sighash-type
                   final-script-sig: (psbt-input-final-script-sig input)
                   final-script-witness: (psbt-input-final-script-witness input)
                   taproot-key-sig: sig
                  taproot-script-sigs: (psbt-input-taproot-script-sigs input)
                  taproot-leaf-scripts: (psbt-input-taproot-leaf-scripts input)
                   redeem-script: (psbt-input-redeem-script input)
                   witness-script: (psbt-input-witness-script input)
                   bip32-derivations: (psbt-input-bip32-derivations input)
                   taproot-bip32-derivations: (psbt-input-taproot-bip32-derivations input)
                   unknowns: (psbt-input-unknowns input))))
          (psbt-update-input p input-index signed-input))))

    ;;; Add a Taproot script-path signature for a single-key checksig leaf.
    (define (psbt-sign-p2tr-scriptpath-input p input-index private-key)
      (: psbt? integer? bytevector? -> psbt?)
      (validate-psbt p)
      (let* ((input (nth-item (psbt-inputs p) input-index "psbt-sign-p2tr-scriptpath-input"))
             (prevouts (psbt-prevouts p "psbt-sign-p2tr-scriptpath-input"))
             (utxo (nth-item prevouts input-index "psbt-sign-p2tr-scriptpath-input"))
             (keypair (secp256k1-keypair-create private-key))
             (xonly-pubkey (secp256k1-keypair-xonly-pub keypair))
             (leaf-script (find-taproot-leaf-for-pubkey
                            (psbt-input-taproot-leaf-scripts input)
                            xonly-pubkey
                            "psbt-sign-p2tr-scriptpath-input"))
             (script (psbt-taproot-leaf-script-script leaf-script))
             (leaf-version (psbt-taproot-leaf-script-leaf-version leaf-script))
             (leaf-hash (taproot-leaf-script-hash leaf-script))
             (sighash-type (psbt-input-sighash-or-default input sighash-default)))
        (verify-taproot-leaf-prevout
          utxo
          leaf-script
          leaf-hash
          "psbt-sign-p2tr-scriptpath-input")
        (let* ((msghash (transaction-sighash-taproot-scriptpath
                          (psbt-unsigned-tx p)
                          input-index
                          prevouts
                          script
                          leaf-version
                          sighash-type))
               (sig (taproot-keypath-signature keypair msghash sighash-type))
               (sig-key (bytevector-append xonly-pubkey leaf-hash))
               (signed-input
                 (psbt-input
                   non-witness-utxo: (psbt-input-non-witness-utxo input)
                   witness-utxo: (psbt-input-witness-utxo input)
                   partial-sigs: (psbt-input-partial-sigs input)
                   sighash-type: sighash-type
                   final-script-sig: (psbt-input-final-script-sig input)
                   final-script-witness: (psbt-input-final-script-witness input)
                   taproot-key-sig: (psbt-input-taproot-key-sig input)
                   taproot-script-sigs: (append (psbt-input-taproot-script-sigs input)
                                                (list (cons sig-key sig)))
                   taproot-leaf-scripts: (psbt-input-taproot-leaf-scripts input)
                   redeem-script: (psbt-input-redeem-script input)
                   witness-script: (psbt-input-witness-script input)
                   bip32-derivations: (psbt-input-bip32-derivations input)
                   taproot-bip32-derivations: (psbt-input-taproot-bip32-derivations input)
                   unknowns: (psbt-input-unknowns input))))
          (psbt-update-input p input-index signed-input))))

    ;;; Sign a standard P2PKH, P2WPKH, or key-path P2TR PSBT input.
    (define (psbt-sign-standard-input p input-index private-key)
      (: psbt? integer? bytevector? -> psbt?)
      (validate-psbt p)
      (let* ((utxo (psbt-input-prevout p input-index "psbt-sign-standard-input"))
             (script (txout-script-pubkey utxo)))
        (cond ((script-p2pkh? script)
               (psbt-sign-p2pkh-input p input-index private-key))
              ((script-p2wpkh? script)
               (psbt-sign-p2wpkh-input p input-index private-key))
              ((script-p2wsh? script)
               (psbt-sign-p2wsh-input p input-index private-key))
              ((script-p2tr? script)
               (psbt-sign-p2tr-keypath-input p input-index private-key))
              (else
               (error "psbt-sign-standard-input: unsupported prevout scriptPubKey")))))

    ;;; Finalize a signed P2PKH PSBT input.
    (define (psbt-finalize-p2pkh-input p input-index)
      (: psbt? integer? -> psbt?)
      (validate-psbt p)
      (let* ((input (nth-item (psbt-inputs p) input-index "psbt-finalize-p2pkh-input"))
             (partial-sigs (psbt-input-partial-sigs input)))
        (when (null? partial-sigs)
          (error "psbt-finalize-p2pkh-input: missing partial signature"))
        (let* ((entry (car partial-sigs))
               (final-input
                 (psbt-input
                   non-witness-utxo: (psbt-input-non-witness-utxo input)
                   witness-utxo: (psbt-input-witness-utxo input)
                   partial-sigs: partial-sigs
                   sighash-type: (psbt-input-sighash-type input)
                   final-script-sig: (script-append
                                       (script-push-data (cdr entry))
                                       (script-push-data (car entry)))
                   final-script-witness: '()
                   taproot-key-sig: (psbt-input-taproot-key-sig input)
                           taproot-script-sigs: (psbt-input-taproot-script-sigs input)
                           taproot-leaf-scripts: (psbt-input-taproot-leaf-scripts input)
                   redeem-script: (psbt-input-redeem-script input)
                   witness-script: (psbt-input-witness-script input)
                   bip32-derivations: (psbt-input-bip32-derivations input)
                   taproot-bip32-derivations: (psbt-input-taproot-bip32-derivations input)
                   unknowns: (psbt-input-unknowns input))))
          (psbt-update-input p input-index final-input))))

    ;;; Finalize a signed P2WPKH PSBT input.
    (define (psbt-finalize-p2wpkh-input p input-index)
      (: psbt? integer? -> psbt?)
      (validate-psbt p)
      (let* ((input (nth-item (psbt-inputs p) input-index "psbt-finalize-p2wpkh-input"))
             (partial-sigs (psbt-input-partial-sigs input)))
        (when (null? partial-sigs)
          (error "psbt-finalize-p2wpkh-input: missing partial signature"))
        (let* ((entry (car partial-sigs))
               (final-input
                 (psbt-input
                   non-witness-utxo: (psbt-input-non-witness-utxo input)
                   witness-utxo: (psbt-input-witness-utxo input)
                   partial-sigs: partial-sigs
                   sighash-type: (psbt-input-sighash-type input)
                   final-script-sig: #u8()
                   final-script-witness: (list (cdr entry) (car entry))
                   taproot-key-sig: (psbt-input-taproot-key-sig input)
                           taproot-script-sigs: (psbt-input-taproot-script-sigs input)
                           taproot-leaf-scripts: (psbt-input-taproot-leaf-scripts input)
                   redeem-script: (psbt-input-redeem-script input)
                   witness-script: (psbt-input-witness-script input)
                   bip32-derivations: (psbt-input-bip32-derivations input)
                   taproot-bip32-derivations: (psbt-input-taproot-bip32-derivations input)
                   unknowns: (psbt-input-unknowns input))))
          (psbt-update-input p input-index final-input))))

    ;;; Finalize a signed P2WSH single-key checksig PSBT input.
    (define (psbt-finalize-p2wsh-input p input-index)
      (: psbt? integer? -> psbt?)
      (validate-psbt p)
      (let* ((input (nth-item (psbt-inputs p) input-index "psbt-finalize-p2wsh-input"))
             (partial-sigs (psbt-input-partial-sigs input))
             (witness-script (psbt-input-witness-script input)))
        (when (null? partial-sigs)
          (error "psbt-finalize-p2wsh-input: missing partial signature"))
        (unless witness-script
          (error "psbt-finalize-p2wsh-input: missing witness script"))
        (unless (witness-script-pk-checksig-pubkey witness-script)
          (error "psbt-finalize-p2wsh-input: unsupported witness script"))
        (let* ((entry (car partial-sigs))
               (final-input
                 (psbt-input
                   non-witness-utxo: (psbt-input-non-witness-utxo input)
                   witness-utxo: (psbt-input-witness-utxo input)
                   partial-sigs: partial-sigs
                   sighash-type: (psbt-input-sighash-type input)
                   final-script-sig: #u8()
                   final-script-witness: (list (cdr entry) witness-script)
                   taproot-key-sig: (psbt-input-taproot-key-sig input)
                           taproot-script-sigs: (psbt-input-taproot-script-sigs input)
                           taproot-leaf-scripts: (psbt-input-taproot-leaf-scripts input)
                   redeem-script: (psbt-input-redeem-script input)
                   witness-script: witness-script
                   bip32-derivations: (psbt-input-bip32-derivations input)
                   taproot-bip32-derivations: (psbt-input-taproot-bip32-derivations input)
                   unknowns: (psbt-input-unknowns input))))
          (psbt-update-input p input-index final-input))))

    ;;; Finalize a signed Taproot key-path PSBT input.
    (define (psbt-finalize-p2tr-keypath-input p input-index)
      (: psbt? integer? -> psbt?)
      (validate-psbt p)
      (let* ((input (nth-item (psbt-inputs p) input-index "psbt-finalize-p2tr-keypath-input"))
             (sig (psbt-input-taproot-key-sig input)))
        (unless sig
          (error "psbt-finalize-p2tr-keypath-input: missing Taproot key signature"))
        (let ((final-input
                (psbt-input
                  non-witness-utxo: (psbt-input-non-witness-utxo input)
                  witness-utxo: (psbt-input-witness-utxo input)
                  partial-sigs: (psbt-input-partial-sigs input)
                  sighash-type: (psbt-input-sighash-type input)
                  final-script-sig: #u8()
                  final-script-witness: (list sig)
                  taproot-key-sig: sig
                  taproot-script-sigs: (psbt-input-taproot-script-sigs input)
                  taproot-leaf-scripts: (psbt-input-taproot-leaf-scripts input)
                  redeem-script: (psbt-input-redeem-script input)
                  witness-script: (psbt-input-witness-script input)
                  bip32-derivations: (psbt-input-bip32-derivations input)
                  taproot-bip32-derivations: (psbt-input-taproot-bip32-derivations input)
                  unknowns: (psbt-input-unknowns input))))
          (psbt-update-input p input-index final-input))))

    ;;; Finalize a signed Taproot script-path PSBT input.
    (define (psbt-finalize-p2tr-scriptpath-input p input-index)
      (: psbt? integer? -> psbt?)
      (validate-psbt p)
      (let* ((input (nth-item (psbt-inputs p) input-index "psbt-finalize-p2tr-scriptpath-input"))
             (leaf-scripts (psbt-input-taproot-leaf-scripts input)))
        (when (null? leaf-scripts)
          (error "psbt-finalize-p2tr-scriptpath-input: missing Taproot leaf script"))
        (let* ((leaf-script (car leaf-scripts))
               (script (psbt-taproot-leaf-script-script leaf-script))
               (script-key (tapscript-pk-checksig-pubkey script))
               (leaf-hash (taproot-leaf-script-hash leaf-script)))
          (unless script-key
            (error "psbt-finalize-p2tr-scriptpath-input: unsupported Taproot leaf script"))
          (let* ((sig (find-taproot-script-sig
                        (psbt-input-taproot-script-sigs input)
                        script-key
                        leaf-hash
                        "psbt-finalize-p2tr-scriptpath-input"))
                 (final-input
                   (psbt-input
                     non-witness-utxo: (psbt-input-non-witness-utxo input)
                     witness-utxo: (psbt-input-witness-utxo input)
                     partial-sigs: (psbt-input-partial-sigs input)
                     sighash-type: (psbt-input-sighash-type input)
                     final-script-sig: #u8()
                     final-script-witness: (list
                                             sig
                                             script
                                             (psbt-taproot-leaf-script-control-block leaf-script))
                     taproot-key-sig: (psbt-input-taproot-key-sig input)
                     taproot-script-sigs: (psbt-input-taproot-script-sigs input)
                     taproot-leaf-scripts: leaf-scripts
                     redeem-script: (psbt-input-redeem-script input)
                     witness-script: (psbt-input-witness-script input)
                     bip32-derivations: (psbt-input-bip32-derivations input)
                     taproot-bip32-derivations: (psbt-input-taproot-bip32-derivations input)
                     unknowns: (psbt-input-unknowns input))))
            (psbt-update-input p input-index final-input)))))

    ;;; Finalize a standard P2PKH, P2WPKH, or key-path P2TR PSBT input.
    (define (psbt-finalize-standard-input p input-index)
      (: psbt? integer? -> psbt?)
      (validate-psbt p)
      (let* ((utxo (psbt-input-prevout p input-index "psbt-finalize-standard-input"))
             (script (txout-script-pubkey utxo)))
        (cond ((script-p2pkh? script)
               (psbt-finalize-p2pkh-input p input-index))
              ((script-p2wpkh? script)
               (psbt-finalize-p2wpkh-input p input-index))
              ((script-p2wsh? script)
               (psbt-finalize-p2wsh-input p input-index))
              ((script-p2tr? script)
               (psbt-finalize-p2tr-keypath-input p input-index))
              (else
               (error "psbt-finalize-standard-input: unsupported prevout scriptPubKey")))))

    ;;; Extract the final transaction from a fully-finalized PSBT.
    (define (psbt-extract-transaction p)
      (: psbt? -> transaction?)
      (validate-psbt p)
      (let loop ((txins (transaction-inputs (psbt-unsigned-tx p)))
                 (psbt-ins (psbt-inputs p))
                 (out '()))
        (if (null? txins)
            (transaction
              version: (transaction-version (psbt-unsigned-tx p))
              inputs: (reverse out)
              outputs: (transaction-outputs (psbt-unsigned-tx p))
              lock-time: (transaction-lock-time (psbt-unsigned-tx p)))
            (let ((psbt-in (car psbt-ins))
                  (txin0 (car txins)))
              (when (and (= 0 (bytevector-length (psbt-input-final-script-sig psbt-in)))
                         (null? (psbt-input-final-script-witness psbt-in)))
                (error "psbt-extract-transaction: input is not finalized"))
              (loop
                (cdr txins)
                (cdr psbt-ins)
                (cons
                  (txin previous-output: (txin-previous-output txin0)
                        script-sig: (psbt-input-final-script-sig psbt-in)
                        sequence: (txin-sequence txin0)
                        witness: (psbt-input-final-script-witness psbt-in))
                  out))))))))
