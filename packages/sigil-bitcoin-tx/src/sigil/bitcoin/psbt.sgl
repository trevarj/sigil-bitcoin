;;; (sigil bitcoin psbt) — Partially Signed Bitcoin Transactions

(define-library (sigil bitcoin psbt)
  (import (sigil math)
          (sigil crypto)
          (sigil secp256k1)
          (sigil bitcoin utils)
          (sigil bitcoin tx types)
          (sigil bitcoin tx wire)
          (sigil bitcoin tx sighash)
          (sigil bitcoin primitives)
          (sigil bitcoin script)
          (sigil bitcoin keys))
  (export
    psbt psbt?
    psbt-unsigned-tx psbt-inputs psbt-outputs
    psbt-taproot-leaf-script psbt-taproot-leaf-script?
    psbt-taproot-leaf-script-control-block
    psbt-taproot-leaf-script-script
    psbt-taproot-leaf-script-leaf-version
    psbt-input psbt-input?
    psbt-input-non-witness-utxo psbt-input-witness-utxo
    psbt-input-partial-sigs
    psbt-input-sighash-type psbt-input-final-script-sig
    psbt-input-final-script-witness psbt-input-taproot-key-sig
    psbt-input-taproot-script-sigs
    psbt-input-taproot-leaf-scripts
    psbt-input-redeem-script psbt-input-witness-script
    psbt-input-bip32-derivations
    psbt-input-taproot-bip32-derivations
    psbt-input-unknowns
    psbt-output psbt-output?
    psbt-output-bip32-derivations
    psbt-output-taproot-bip32-derivations
    psbt-output-unknowns
    psbt-unknowns
    psbt-create
    psbt-annotate-input
    psbt-annotate-input-scripts
    psbt-annotate-output
    psbt-serialize
    psbt-parse
    psbt-sign-p2pkh-input
    psbt-sign-p2wpkh-input
    psbt-sign-p2wsh-input
    psbt-sign-p2tr-keypath-input
    psbt-sign-p2tr-scriptpath-input
    psbt-sign-standard-input
    psbt-finalize-p2pkh-input
    psbt-finalize-p2wpkh-input
    psbt-finalize-p2wsh-input
    psbt-finalize-p2tr-keypath-input
    psbt-finalize-p2tr-scriptpath-input
    psbt-finalize-standard-input
    psbt-extract-transaction)
  (begin

    (define (empty-psbt-input)
      (psbt-input non-witness-utxo: #f
                  witness-utxo: #f
                  partial-sigs: '()
                  sighash-type: #f
                  final-script-sig: #u8()
                  final-script-witness: '()
                  taproot-key-sig: #f
                  taproot-script-sigs: '()
                  taproot-leaf-scripts: '()
                  redeem-script: #f
                  witness-script: #f
                  bip32-derivations: '()
                  taproot-bip32-derivations: '()
                  unknowns: '()))

    (define (empty-psbt-output)
      (psbt-output bip32-derivations: '()
                   taproot-bip32-derivations: '()
                   unknowns: '()))

    (define (validate-raw-keyvals who keyvals)
      (unless (list? keyvals)
        (error (string-append who ": expected list")))
      (do ((xs keyvals (cdr xs)))
          ((null? xs) keyvals)
        (let ((entry (car xs)))
          (unless (pair? entry)
            (error (string-append who ": expected key-value pair")))
          (require-bytevector (string-append who " key") (car entry))
          (require-bytevector (string-append who " value") (cdr entry))
          (when (= 0 (bytevector-length (car entry)))
            (error (string-append who ": empty key is reserved for map terminator"))))))

    (define (validate-bip32-origin-value who value)
      (require-bytevector who value)
      (when (or (< (bytevector-length value) 4)
                (not (= 0 (remainder (- (bytevector-length value) 4) 4))))
        (error (string-append who ": expected fingerprint plus u32 path elements")))
      value)

    (define (validate-taproot-origin-value who value)
      (require-bytevector who value)
      (let* ((count-result (compact-size-decode-at value 0))
             (count (car count-result))
             (path-start (+ (cadr count-result) (* count 32))))
        (ensure-available who value (cadr count-result) (* count 32))
        (when (or (< (- (bytevector-length value) path-start) 4)
                  (not (= 0 (remainder (- (bytevector-length value) path-start 4) 4))))
          (error (string-append who ": expected leaf hashes, fingerprint, and u32 path elements"))))
      value)

    (define (validate-bip32-derivations who derivations key-length value-validator)
      (unless (list? derivations)
        (error (string-append who ": expected list")))
      (do ((xs derivations (cdr xs)))
          ((null? xs) derivations)
        (let ((entry (car xs)))
          (unless (pair? entry)
            (error (string-append who ": expected key-value pair")))
          (require-bytevector-length who (car entry) key-length)
          (value-validator who (cdr entry)))))

    (define (validate-schnorr-signature who sig)
      (let ((len (bytevector-length (require-bytevector who sig))))
        (unless (or (= len 64) (= len 65))
          (error (string-append who ": expected 64 or 65 bytes"))))
      sig)

    (define (validate-taproot-script-sigs who sigs)
      (unless (list? sigs)
        (error (string-append who ": expected list")))
      (do ((xs sigs (cdr xs)))
          ((null? xs) sigs)
        (let ((entry (car xs)))
          (unless (pair? entry)
            (error (string-append who ": expected key-signature pair")))
          (require-bytevector-length who (car entry) 64)
          (validate-schnorr-signature who (cdr entry)))))

    (define (validate-taproot-leaf-scripts who leaf-scripts)
      (unless (list? leaf-scripts)
        (error (string-append who ": expected list")))
      (do ((xs leaf-scripts (cdr xs)))
          ((null? xs) leaf-scripts)
        (let ((entry (car xs)))
          (unless (psbt-taproot-leaf-script? entry)
            (error (string-append who ": expected psbt-taproot-leaf-script")))
          (validate-taproot-control-block
            who
            (psbt-taproot-leaf-script-control-block entry))
          (require-bytevector who (psbt-taproot-leaf-script-script entry))
          (require-uint who (psbt-taproot-leaf-script-leaf-version entry) #xff))))

    (define (make-empty-list count maker)
      (let loop ((i 0) (out '()))
        (if (>= i count)
            (reverse out)
            (loop (+ i 1) (cons (maker) out)))))

    ;;; Create an empty PSBT from an unsigned transaction.
    (define (psbt-create unsigned-tx)
      (: transaction? -> psbt?)
      (validate-transaction unsigned-tx)
      (psbt unsigned-tx: unsigned-tx
            inputs: (make-empty-list (length (transaction-inputs unsigned-tx))
                                     empty-psbt-input)
            outputs: (make-empty-list (length (transaction-outputs unsigned-tx))
                                      empty-psbt-output)
            unknowns: '()))

    (define (validate-psbt-input input)
      (unless (psbt-input? input)
        (error "psbt input: expected psbt-input"))
      (when (psbt-input-non-witness-utxo input)
        (validate-transaction (psbt-input-non-witness-utxo input)))
      (when (psbt-input-witness-utxo input)
        (validate-txout (psbt-input-witness-utxo input)))
      (unless (list? (psbt-input-partial-sigs input))
        (error "psbt input partial sigs: expected list"))
      (do ((xs (psbt-input-partial-sigs input) (cdr xs)))
          ((null? xs))
        (let ((entry (car xs)))
          (require-bytevector "psbt partial sig pubkey" (car entry))
          (require-bytevector "psbt partial sig signature" (cdr entry))))
      (when (psbt-input-sighash-type input)
        (require-uint "psbt input sighash type" (psbt-input-sighash-type input) %u32-max))
      (require-bytevector "psbt final scriptSig" (psbt-input-final-script-sig input))
      (validate-witness (psbt-input-final-script-witness input))
      (when (psbt-input-taproot-key-sig input)
        (validate-schnorr-signature
          "psbt taproot key signature"
          (psbt-input-taproot-key-sig input)))
      (validate-taproot-script-sigs
        "psbt input Taproot script signatures"
        (psbt-input-taproot-script-sigs input))
      (validate-taproot-leaf-scripts
        "psbt input Taproot leaf scripts"
        (psbt-input-taproot-leaf-scripts input))
      (when (psbt-input-redeem-script input)
        (require-bytevector "psbt input redeem script"
                            (psbt-input-redeem-script input)))
      (when (psbt-input-witness-script input)
        (require-bytevector "psbt input witness script"
                            (psbt-input-witness-script input)))
      (validate-bip32-derivations
        "psbt input BIP32 derivation"
        (psbt-input-bip32-derivations input)
        33
        validate-bip32-origin-value)
      (validate-bip32-derivations
        "psbt input Taproot BIP32 derivation"
        (psbt-input-taproot-bip32-derivations input)
        32
        validate-taproot-origin-value)
      (validate-raw-keyvals "psbt input unknowns" (psbt-input-unknowns input))
      input)

    (define (validate-psbt-output output)
      (unless (psbt-output? output)
        (error "psbt output: expected psbt-output"))
      (validate-bip32-derivations
        "psbt output BIP32 derivation"
        (psbt-output-bip32-derivations output)
        33
        validate-bip32-origin-value)
      (validate-bip32-derivations
        "psbt output Taproot BIP32 derivation"
        (psbt-output-taproot-bip32-derivations output)
        32
        validate-taproot-origin-value)
      (validate-raw-keyvals "psbt output unknowns" (psbt-output-unknowns output))
      output)

    (define (validate-psbt p)
      (unless (psbt? p)
        (error "psbt: expected psbt"))
      (validate-transaction (psbt-unsigned-tx p))
      (validate-raw-keyvals "psbt global unknowns" (psbt-unknowns p))
      (unless (= (length (transaction-inputs (psbt-unsigned-tx p)))
                 (length (psbt-inputs p)))
        (error "psbt: input map count mismatch"))
      (unless (= (length (transaction-outputs (psbt-unsigned-tx p)))
                 (length (psbt-outputs p)))
        (error "psbt: output map count mismatch"))
      (do ((xs (psbt-inputs p) (cdr xs)))
          ((null? xs))
        (validate-psbt-input (car xs)))
      (do ((xs (psbt-outputs p) (cdr xs)))
          ((null? xs) p)
        (validate-psbt-output (car xs))))

    (define (taproot-leaf-script-value leaf-script)
      (bytevector-append
        (psbt-taproot-leaf-script-script leaf-script)
        (make-bytevector 1 (psbt-taproot-leaf-script-leaf-version leaf-script))))

    (define (parse-taproot-leaf-script control-block value)
      (validate-taproot-control-block "psbt Taproot leaf script control block" control-block)
      (require-bytevector "psbt Taproot leaf script value" value)
      (when (= 0 (bytevector-length value))
        (error "psbt Taproot leaf script: missing leaf version"))
      (psbt-taproot-leaf-script
        control-block: control-block
        script: (bytevector-copy value 0 (- (bytevector-length value) 1))
        leaf-version: (bytevector-u8-ref value (- (bytevector-length value) 1))))

    (define (psbt-input->keyvals input)
      (validate-psbt-input input)
      (let ((parts '()))
        (when (psbt-input-non-witness-utxo input)
          (set! parts
                (append parts
                        (list (psbt-keyval #x00 #u8()
                                           (transaction-serialize
                                             (psbt-input-non-witness-utxo input)))))))
        (when (psbt-input-witness-utxo input)
          (set! parts
                (append parts
                        (list (psbt-keyval #x01 #u8()
                                           (serialize-txout
                                             (psbt-input-witness-utxo input)))))))
        (do ((xs (psbt-input-partial-sigs input) (cdr xs)))
            ((null? xs))
          (let ((entry (car xs)))
            (set! parts
                  (append parts
                          (list (psbt-keyval #x02 (car entry) (cdr entry)))))))
        (when (psbt-input-sighash-type input)
          (set! parts
                (append parts
                        (list (psbt-keyval #x03 #u8()
                                           (u32-le (psbt-input-sighash-type input)))))))
        (when (> (bytevector-length (psbt-input-final-script-sig input)) 0)
          (set! parts
                (append parts
                        (list (psbt-keyval #x07 #u8()
                                           (psbt-input-final-script-sig input))))))
        (when (not (null? (psbt-input-final-script-witness input)))
          (set! parts
                (append parts
                        (list (psbt-keyval #x08 #u8()
                                           (serialize-witness
                                             (psbt-input-final-script-witness input)))))))
        (when (psbt-input-taproot-key-sig input)
          (set! parts
                (append parts
                        (list (psbt-keyval #x13 #u8()
                                           (psbt-input-taproot-key-sig input))))))
        (do ((xs (psbt-input-taproot-script-sigs input) (cdr xs)))
            ((null? xs))
          (let ((entry (car xs)))
            (set! parts
                  (append parts
                          (list (psbt-keyval #x14 (car entry) (cdr entry)))))))
        (do ((xs (psbt-input-taproot-leaf-scripts input) (cdr xs)))
            ((null? xs))
          (let ((entry (car xs)))
            (set! parts
                  (append parts
                          (list
                            (psbt-keyval
                              #x15
                              (psbt-taproot-leaf-script-control-block entry)
                              (taproot-leaf-script-value entry)))))))
        (when (psbt-input-redeem-script input)
          (set! parts
                (append parts
                        (list (psbt-keyval #x04 #u8()
                                           (psbt-input-redeem-script input))))))
        (when (psbt-input-witness-script input)
          (set! parts
                (append parts
                        (list (psbt-keyval #x05 #u8()
                                           (psbt-input-witness-script input))))))
        (do ((xs (psbt-input-bip32-derivations input) (cdr xs)))
            ((null? xs))
          (let ((entry (car xs)))
            (set! parts
                  (append parts
                          (list (psbt-keyval #x06 (car entry) (cdr entry)))))))
        (do ((xs (psbt-input-taproot-bip32-derivations input) (cdr xs)))
            ((null? xs))
          (let ((entry (car xs)))
            (set! parts
                  (append parts
                          (list (psbt-keyval #x16 (car entry) (cdr entry)))))))
        (append parts (map psbt-raw-keyval (psbt-input-unknowns input)))))

    (define (psbt-output->keyvals output)
      (validate-psbt-output output)
      (let ((parts '()))
        (do ((xs (psbt-output-bip32-derivations output) (cdr xs)))
            ((null? xs))
          (let ((entry (car xs)))
            (set! parts
                  (append parts
                          (list (psbt-keyval #x02 (car entry) (cdr entry)))))))
        (do ((xs (psbt-output-taproot-bip32-derivations output) (cdr xs)))
            ((null? xs))
          (let ((entry (car xs)))
            (set! parts
                  (append parts
                          (list (psbt-keyval #x07 (car entry) (cdr entry)))))))
        (append parts (map psbt-raw-keyval (psbt-output-unknowns output)))))

    (define (serialize-psbt-map keyvals)
      (apply bytevector-append (append keyvals (list #u8(0)))))

    ;;; Serialize a PSBT v0 record.
    (define (psbt-serialize p)
      (: psbt? -> bytevector?)
      (validate-psbt p)
      (let* ((global (serialize-psbt-map
                       (append
                         (list
                           (psbt-keyval #x00 #u8()
                                        (transaction-base-serialize
                                          (psbt-unsigned-tx p))))
                         (map psbt-raw-keyval (psbt-unknowns p)))))
             (input-maps (map (lambda (input)
                                (serialize-psbt-map
                                  (psbt-input->keyvals input)))
                              (psbt-inputs p)))
             (output-maps (map (lambda (output)
                                 (serialize-psbt-map
                                   (psbt-output->keyvals output)))
                               (psbt-outputs p))))
        (apply bytevector-append
               (append (list #u8(#x70 #x73 #x62 #x74 #xff) global)
                       input-maps
                       output-maps))))

    (define (parse-psbt-map bytes offset)
      (let loop ((next offset) (entries '()))
        (let* ((key-result (read-length-prefixed-bytes bytes next "psbt key"))
               (key (car key-result))
               (after-key (cadr key-result)))
          (if (= 0 (bytevector-length key))
              (list (reverse entries) after-key)
              (let* ((value-result (read-length-prefixed-bytes bytes after-key "psbt value"))
                     (value (car value-result)))
                (loop (cadr value-result)
                      (cons (cons key value) entries)))))))

    (define (parse-global-map entries)
      (let ((unsigned #f)
            (unknowns '()))
        (do ((xs entries (cdr xs)))
            ((null? xs))
          (let* ((entry (car xs))
                 (key (car entry))
                 (value (cdr entry)))
            (if (and (= 1 (bytevector-length key))
                     (= #x00 (bytevector-u8-ref key 0)))
                (set! unsigned (transaction-parse value))
                (set! unknowns (append unknowns (list (cons key value)))))))
        (unless unsigned
          (error "psbt-parse: missing unsigned transaction"))
        (list unsigned unknowns)))

    (define (parse-input-entry current-input entry)
      (let ((base-non-witness-utxo (psbt-input-non-witness-utxo current-input))
            (base-witness-utxo (psbt-input-witness-utxo current-input))
            (base-partial-sigs (psbt-input-partial-sigs current-input))
            (base-sighash-type (psbt-input-sighash-type current-input))
            (base-final-script-sig (psbt-input-final-script-sig current-input))
            (base-final-script-witness (psbt-input-final-script-witness current-input))
            (base-taproot-key-sig (psbt-input-taproot-key-sig current-input))
            (base-taproot-script-sigs (psbt-input-taproot-script-sigs current-input))
            (base-taproot-leaf-scripts (psbt-input-taproot-leaf-scripts current-input))
            (base-redeem-script (psbt-input-redeem-script current-input))
            (base-witness-script (psbt-input-witness-script current-input))
            (base-bip32-derivations (psbt-input-bip32-derivations current-input))
            (base-taproot-bip32-derivations (psbt-input-taproot-bip32-derivations current-input))
            (base-unknowns (psbt-input-unknowns current-input)))
        (let* ((key (car entry))
               (value (cdr entry))
               (key-type (bytevector-u8-ref key 0))
               (key-data (bytevector-copy key 1)))
        (cond ((= key-type #x01)
               (let* ((parsed (parse-txout value 0))
                      (witness-utxo (car parsed))
                      (next (cadr parsed)))
                 (unless (= next (bytevector-length value))
                   (error "psbt witness utxo: trailing bytes"))
                 (psbt-input non-witness-utxo: base-non-witness-utxo
                             witness-utxo: witness-utxo
                             partial-sigs: base-partial-sigs
                             sighash-type: base-sighash-type
                             final-script-sig: base-final-script-sig
                             final-script-witness: base-final-script-witness
                             taproot-key-sig: base-taproot-key-sig
                             taproot-script-sigs: base-taproot-script-sigs
                             taproot-leaf-scripts: base-taproot-leaf-scripts
                             redeem-script: base-redeem-script
                             witness-script: base-witness-script
                             bip32-derivations: base-bip32-derivations
                             taproot-bip32-derivations: base-taproot-bip32-derivations
                             unknowns: base-unknowns)))
              ((= key-type #x02)
               (psbt-input non-witness-utxo: base-non-witness-utxo
                           witness-utxo: base-witness-utxo
                           partial-sigs: (append base-partial-sigs
                                                 (list (cons key-data value)))
                           sighash-type: base-sighash-type
                           final-script-sig: base-final-script-sig
                           final-script-witness: base-final-script-witness
                           taproot-key-sig: base-taproot-key-sig
                           taproot-script-sigs: base-taproot-script-sigs
                           taproot-leaf-scripts: base-taproot-leaf-scripts
                           redeem-script: base-redeem-script
                           witness-script: base-witness-script
                           bip32-derivations: base-bip32-derivations
                           taproot-bip32-derivations: base-taproot-bip32-derivations
                           unknowns: base-unknowns))
              ((= key-type #x03)
               (psbt-input non-witness-utxo: base-non-witness-utxo
                           witness-utxo: base-witness-utxo
                           partial-sigs: base-partial-sigs
                           sighash-type: (read-u32-le value 0 "psbt sighash type")
                           final-script-sig: base-final-script-sig
                           final-script-witness: base-final-script-witness
                           taproot-key-sig: base-taproot-key-sig
                           taproot-script-sigs: base-taproot-script-sigs
                           taproot-leaf-scripts: base-taproot-leaf-scripts
                           redeem-script: base-redeem-script
                           witness-script: base-witness-script
                           bip32-derivations: base-bip32-derivations
                           taproot-bip32-derivations: base-taproot-bip32-derivations
                           unknowns: base-unknowns))
              ((= key-type #x04)
               (psbt-input non-witness-utxo: base-non-witness-utxo
                           witness-utxo: base-witness-utxo
                           partial-sigs: base-partial-sigs
                           sighash-type: base-sighash-type
                           final-script-sig: base-final-script-sig
                           final-script-witness: base-final-script-witness
                           taproot-key-sig: base-taproot-key-sig
                           taproot-script-sigs: base-taproot-script-sigs
                           taproot-leaf-scripts: base-taproot-leaf-scripts
                           redeem-script: value
                           witness-script: base-witness-script
                           bip32-derivations: base-bip32-derivations
                           taproot-bip32-derivations: base-taproot-bip32-derivations
                           unknowns: base-unknowns))
              ((= key-type #x05)
               (psbt-input non-witness-utxo: base-non-witness-utxo
                           witness-utxo: base-witness-utxo
                           partial-sigs: base-partial-sigs
                           sighash-type: base-sighash-type
                           final-script-sig: base-final-script-sig
                           final-script-witness: base-final-script-witness
                           taproot-key-sig: base-taproot-key-sig
                           taproot-script-sigs: base-taproot-script-sigs
                           taproot-leaf-scripts: base-taproot-leaf-scripts
                           redeem-script: base-redeem-script
                           witness-script: value
                           bip32-derivations: base-bip32-derivations
                           taproot-bip32-derivations: base-taproot-bip32-derivations
                           unknowns: base-unknowns))
              ((= key-type #x07)
               (psbt-input non-witness-utxo: base-non-witness-utxo
                           witness-utxo: base-witness-utxo
                           partial-sigs: base-partial-sigs
                           sighash-type: base-sighash-type
                           final-script-sig: value
                           final-script-witness: base-final-script-witness
                           taproot-key-sig: base-taproot-key-sig
                           taproot-script-sigs: base-taproot-script-sigs
                           taproot-leaf-scripts: base-taproot-leaf-scripts
                           redeem-script: base-redeem-script
                           witness-script: base-witness-script
                           bip32-derivations: base-bip32-derivations
                           taproot-bip32-derivations: base-taproot-bip32-derivations
                           unknowns: base-unknowns))
              ((= key-type #x08)
               (psbt-input non-witness-utxo: base-non-witness-utxo
                           witness-utxo: base-witness-utxo
                           partial-sigs: base-partial-sigs
                           sighash-type: base-sighash-type
                           final-script-sig: base-final-script-sig
                           final-script-witness: (parse-serialized-witness value)
                           taproot-key-sig: base-taproot-key-sig
                           taproot-script-sigs: base-taproot-script-sigs
                           taproot-leaf-scripts: base-taproot-leaf-scripts
                           redeem-script: base-redeem-script
                           witness-script: base-witness-script
                           bip32-derivations: base-bip32-derivations
                           taproot-bip32-derivations: base-taproot-bip32-derivations
                           unknowns: base-unknowns))
              ((= key-type #x00)
               (psbt-input non-witness-utxo: (transaction-parse value)
                           witness-utxo: base-witness-utxo
                           partial-sigs: base-partial-sigs
                           sighash-type: base-sighash-type
                           final-script-sig: base-final-script-sig
                           final-script-witness: base-final-script-witness
                           taproot-key-sig: base-taproot-key-sig
                           taproot-script-sigs: base-taproot-script-sigs
                           taproot-leaf-scripts: base-taproot-leaf-scripts
                           redeem-script: base-redeem-script
                           witness-script: base-witness-script
                           bip32-derivations: base-bip32-derivations
                           taproot-bip32-derivations: base-taproot-bip32-derivations
                           unknowns: base-unknowns))
              ((= key-type #x13)
               (psbt-input non-witness-utxo: base-non-witness-utxo
                           witness-utxo: base-witness-utxo
                           partial-sigs: base-partial-sigs
                           sighash-type: base-sighash-type
                           final-script-sig: base-final-script-sig
                           final-script-witness: base-final-script-witness
                           taproot-key-sig: value
                           taproot-script-sigs: base-taproot-script-sigs
                           taproot-leaf-scripts: base-taproot-leaf-scripts
                           redeem-script: base-redeem-script
                           witness-script: base-witness-script
                           bip32-derivations: base-bip32-derivations
                           taproot-bip32-derivations: base-taproot-bip32-derivations
                           unknowns: base-unknowns))
              ((= key-type #x14)
               (require-bytevector-length "psbt Taproot script signature key" key-data 64)
               (validate-schnorr-signature "psbt Taproot script signature" value)
               (psbt-input non-witness-utxo: base-non-witness-utxo
                           witness-utxo: base-witness-utxo
                           partial-sigs: base-partial-sigs
                           sighash-type: base-sighash-type
                           final-script-sig: base-final-script-sig
                           final-script-witness: base-final-script-witness
                           taproot-key-sig: base-taproot-key-sig
                           taproot-script-sigs: (append base-taproot-script-sigs
                                                        (list (cons key-data value)))
                           taproot-leaf-scripts: base-taproot-leaf-scripts
                           redeem-script: base-redeem-script
                           witness-script: base-witness-script
                           bip32-derivations: base-bip32-derivations
                           taproot-bip32-derivations: base-taproot-bip32-derivations
                           unknowns: base-unknowns))
              ((= key-type #x15)
               (psbt-input non-witness-utxo: base-non-witness-utxo
                           witness-utxo: base-witness-utxo
                           partial-sigs: base-partial-sigs
                           sighash-type: base-sighash-type
                           final-script-sig: base-final-script-sig
                           final-script-witness: base-final-script-witness
                           taproot-key-sig: base-taproot-key-sig
                           taproot-script-sigs: base-taproot-script-sigs
                           taproot-leaf-scripts: (append
                                                   base-taproot-leaf-scripts
                                                   (list (parse-taproot-leaf-script
                                                           key-data
                                                           value)))
                           redeem-script: base-redeem-script
                           witness-script: base-witness-script
                           bip32-derivations: base-bip32-derivations
                           taproot-bip32-derivations: base-taproot-bip32-derivations
                           unknowns: base-unknowns))
              ((= key-type #x06)
               (require-bytevector-length "psbt BIP32 derivation pubkey" key-data 33)
               (validate-bip32-origin-value "psbt BIP32 derivation" value)
               (psbt-input non-witness-utxo: base-non-witness-utxo
                           witness-utxo: base-witness-utxo
                           partial-sigs: base-partial-sigs
                           sighash-type: base-sighash-type
                           final-script-sig: base-final-script-sig
                           final-script-witness: base-final-script-witness
                           taproot-key-sig: base-taproot-key-sig
                           taproot-script-sigs: base-taproot-script-sigs
                           taproot-leaf-scripts: base-taproot-leaf-scripts
                           redeem-script: base-redeem-script
                           witness-script: base-witness-script
                           bip32-derivations: (append base-bip32-derivations
                                                      (list (cons key-data value)))
                           taproot-bip32-derivations: base-taproot-bip32-derivations
                           unknowns: base-unknowns))
              ((= key-type #x16)
               (require-bytevector-length "psbt Taproot BIP32 derivation xonly pubkey" key-data 32)
               (validate-taproot-origin-value "psbt Taproot BIP32 derivation" value)
               (psbt-input non-witness-utxo: base-non-witness-utxo
                           witness-utxo: base-witness-utxo
                           partial-sigs: base-partial-sigs
                           sighash-type: base-sighash-type
                           final-script-sig: base-final-script-sig
                           final-script-witness: base-final-script-witness
                           taproot-key-sig: base-taproot-key-sig
                           taproot-script-sigs: base-taproot-script-sigs
                           taproot-leaf-scripts: base-taproot-leaf-scripts
                           redeem-script: base-redeem-script
                           witness-script: base-witness-script
                           bip32-derivations: base-bip32-derivations
                           taproot-bip32-derivations: (append base-taproot-bip32-derivations
                                                              (list (cons key-data value)))
                           unknowns: base-unknowns))
              (else
               (psbt-input non-witness-utxo: base-non-witness-utxo
                           witness-utxo: base-witness-utxo
                           partial-sigs: base-partial-sigs
                           sighash-type: base-sighash-type
                           final-script-sig: base-final-script-sig
                           final-script-witness: base-final-script-witness
                           taproot-key-sig: base-taproot-key-sig
                           taproot-script-sigs: base-taproot-script-sigs
                           taproot-leaf-scripts: base-taproot-leaf-scripts
                           redeem-script: base-redeem-script
                           witness-script: base-witness-script
                           bip32-derivations: base-bip32-derivations
                           taproot-bip32-derivations: base-taproot-bip32-derivations
                           unknowns: (append base-unknowns
                                             (list (cons key value)))))))))

    (define (parse-psbt-input entries)
      (let loop ((xs entries)
                 (current (empty-psbt-input)))
        (if (null? xs)
            current
            (loop (cdr xs)
                  (parse-input-entry current (car xs))))))

    (define (parse-psbt-inputs bytes offset count)
      (let loop ((i 0) (next offset) (inputs '()))
        (if (>= i count)
            (list (reverse inputs) next)
            (let ((parsed (parse-psbt-map bytes next)))
              (loop (+ i 1)
                    (cadr parsed)
                    (cons (parse-psbt-input (car parsed)) inputs))))))

    (define (parse-output-entry output entry)
      (let* ((key (car entry))
             (value (cdr entry))
             (key-type (bytevector-u8-ref key 0))
             (key-data (bytevector-copy key 1)))
        (cond ((= key-type #x02)
               (require-bytevector-length "psbt output BIP32 derivation pubkey" key-data 33)
               (validate-bip32-origin-value "psbt output BIP32 derivation" value)
               (psbt-output bip32-derivations: (append (psbt-output-bip32-derivations output)
                                                       (list (cons key-data value)))
                            taproot-bip32-derivations: (psbt-output-taproot-bip32-derivations output)
                            unknowns: (psbt-output-unknowns output)))
              ((= key-type #x07)
               (require-bytevector-length "psbt output Taproot BIP32 derivation xonly pubkey" key-data 32)
               (validate-taproot-origin-value "psbt output Taproot BIP32 derivation" value)
               (psbt-output bip32-derivations: (psbt-output-bip32-derivations output)
                            taproot-bip32-derivations: (append (psbt-output-taproot-bip32-derivations output)
                                                               (list (cons key-data value)))
                            unknowns: (psbt-output-unknowns output)))
              (else
               (psbt-output bip32-derivations: (psbt-output-bip32-derivations output)
                            taproot-bip32-derivations: (psbt-output-taproot-bip32-derivations output)
                            unknowns: (append (psbt-output-unknowns output)
                                              (list (cons key value))))))))

    (define (parse-psbt-output entries)
      (let ((output (empty-psbt-output)))
        (do ((xs entries (cdr xs)))
            ((null? xs) output)
          (set! output (parse-output-entry output (car xs))))))

    (define (parse-psbt-outputs bytes offset count)
      (let loop ((i 0) (next offset) (outputs '()))
        (if (>= i count)
            (list (reverse outputs) next)
            (let ((parsed (parse-psbt-map bytes next)))
              (loop (+ i 1)
                    (cadr parsed)
                    (cons (parse-psbt-output (car parsed)) outputs))))))

    ;;; Parse PSBT v0 bytes into a PSBT record.
    (define (psbt-parse bytes)
      (: bytevector? -> psbt?)
      (require-bytevector "psbt-parse" bytes)
      (ensure-available "psbt-parse" bytes 0 5)
      (unless (equal? #u8(#x70 #x73 #x62 #x74 #xff)
                      (bytevector-copy bytes 0 5))
        (error "psbt-parse: bad magic"))
      (let* ((global-result (parse-psbt-map bytes 5))
             (global-map (parse-global-map (car global-result)))
             (unsigned (car global-map))
             (input-result (parse-psbt-inputs
                             bytes
                             (cadr global-result)
                             (length (transaction-inputs unsigned))))
             (output-result (parse-psbt-outputs
                              bytes
                              (cadr input-result)
                              (length (transaction-outputs unsigned)))))
        (unless (= (cadr output-result) (bytevector-length bytes))
          (error "psbt-parse: trailing bytes"))
        (psbt unsigned-tx: unsigned
              inputs: (car input-result)
              outputs: (car output-result)
              unknowns: (cadr global-map))))

    (define (psbt-update-input p input-index input)
      (psbt unsigned-tx: (psbt-unsigned-tx p)
            inputs: (replace-nth (psbt-inputs p)
                                 input-index
                                 input
                                 "psbt input")
            outputs: (psbt-outputs p)
            unknowns: (psbt-unknowns p)))

    (define (psbt-update-output p output-index output)
      (psbt unsigned-tx: (psbt-unsigned-tx p)
            inputs: (psbt-inputs p)
            outputs: (replace-nth (psbt-outputs p)
                                  output-index
                                  output
                                  "psbt output")
            unknowns: (psbt-unknowns p)))

    (define (entry-key-in? key entries)
      (cond ((null? entries) #f)
            ((equal? key (car (car entries))) #t)
            (else (entry-key-in? key (cdr entries)))))

    (define (merge-keyvals existing added)
      (let loop ((xs existing)
                 (out '()))
        (if (null? xs)
            (append (reverse out) added)
            (let ((entry (car xs)))
              (loop (cdr xs)
                    (if (entry-key-in? (car entry) added)
                        out
                        (cons entry out)))))))

    (define (script-p2pkh? script)
      (and (= 25 (bytevector-length script))
           (= op-dup (bytevector-u8-ref script 0))
           (= op-hash160 (bytevector-u8-ref script 1))
           (= #x14 (bytevector-u8-ref script 2))
           (= op-equalverify (bytevector-u8-ref script 23))
           (= op-checksig (bytevector-u8-ref script 24))))

    (define (script-p2wpkh? script)
      (and (= 22 (bytevector-length script))
           (= op-0 (bytevector-u8-ref script 0))
           (= #x14 (bytevector-u8-ref script 1))))

    (define (script-p2wsh? script)
      (and (= 34 (bytevector-length script))
           (= op-0 (bytevector-u8-ref script 0))
           (= #x20 (bytevector-u8-ref script 1))))

    (define (script-p2tr? script)
      (and (= 34 (bytevector-length script))
           (= op-1 (bytevector-u8-ref script 0))
           (= #x20 (bytevector-u8-ref script 1))))

    ;;; Attach BIP32 derivation metadata to a PSBT input after script matching.
    (define (psbt-annotate-input p input-index script-pubkey bip32-derivations taproot-bip32-derivations)
      (: psbt? integer? bytevector? list? list? -> psbt?)
      (validate-psbt p)
      (require-bytevector "psbt-annotate-input scriptPubKey" script-pubkey)
      (validate-bip32-derivations
        "psbt-annotate-input BIP32 derivation"
        bip32-derivations
        33
        validate-bip32-origin-value)
      (validate-bip32-derivations
        "psbt-annotate-input Taproot BIP32 derivation"
        taproot-bip32-derivations
        32
        validate-taproot-origin-value)
      (let* ((input (nth-item (psbt-inputs p) input-index "psbt-annotate-input"))
             (utxo (psbt-input-prevout p input-index "psbt-annotate-input")))
        (unless (equal? script-pubkey (txout-script-pubkey utxo))
          (error "psbt-annotate-input: prevout scriptPubKey mismatch"))
        (psbt-update-input
          p
          input-index
          (psbt-input
            non-witness-utxo: (psbt-input-non-witness-utxo input)
            witness-utxo: (psbt-input-witness-utxo input)
            partial-sigs: (psbt-input-partial-sigs input)
            sighash-type: (psbt-input-sighash-type input)
            final-script-sig: (psbt-input-final-script-sig input)
            final-script-witness: (psbt-input-final-script-witness input)
            taproot-key-sig: (psbt-input-taproot-key-sig input)
                           taproot-script-sigs: (psbt-input-taproot-script-sigs input)
                           taproot-leaf-scripts: (psbt-input-taproot-leaf-scripts input)
            redeem-script: (psbt-input-redeem-script input)
            witness-script: (psbt-input-witness-script input)
            bip32-derivations: (merge-keyvals (psbt-input-bip32-derivations input)
                                              bip32-derivations)
            taproot-bip32-derivations: (merge-keyvals
                                          (psbt-input-taproot-bip32-derivations input)
                                          taproot-bip32-derivations)
            unknowns: (psbt-input-unknowns input)))))

    ;;; Attach redeem or witness scripts to a PSBT input map.
    (define (psbt-annotate-input-scripts p input-index redeem-script witness-script)
      (: psbt? integer? any? any? -> psbt?)
      (validate-psbt p)
      (when redeem-script
        (require-bytevector "psbt-annotate-input-scripts redeem script" redeem-script))
      (when witness-script
        (require-bytevector "psbt-annotate-input-scripts witness script" witness-script))
      (let ((input (nth-item (psbt-inputs p) input-index "psbt-annotate-input-scripts")))
        (psbt-update-input
          p
          input-index
          (psbt-input
            non-witness-utxo: (psbt-input-non-witness-utxo input)
            witness-utxo: (psbt-input-witness-utxo input)
            partial-sigs: (psbt-input-partial-sigs input)
            sighash-type: (psbt-input-sighash-type input)
            final-script-sig: (psbt-input-final-script-sig input)
            final-script-witness: (psbt-input-final-script-witness input)
            taproot-key-sig: (psbt-input-taproot-key-sig input)
                           taproot-script-sigs: (psbt-input-taproot-script-sigs input)
                           taproot-leaf-scripts: (psbt-input-taproot-leaf-scripts input)
            redeem-script: (if redeem-script redeem-script (psbt-input-redeem-script input))
            witness-script: (if witness-script witness-script (psbt-input-witness-script input))
            bip32-derivations: (psbt-input-bip32-derivations input)
            taproot-bip32-derivations: (psbt-input-taproot-bip32-derivations input)
            unknowns: (psbt-input-unknowns input)))))

    ;;; Attach BIP32 derivation metadata to a PSBT output after script matching.
    (define (psbt-annotate-output p output-index script-pubkey bip32-derivations taproot-bip32-derivations)
      (: psbt? integer? bytevector? list? list? -> psbt?)
      (validate-psbt p)
      (require-bytevector "psbt-annotate-output scriptPubKey" script-pubkey)
      (validate-bip32-derivations
        "psbt-annotate-output BIP32 derivation"
        bip32-derivations
        33
        validate-bip32-origin-value)
      (validate-bip32-derivations
        "psbt-annotate-output Taproot BIP32 derivation"
        taproot-bip32-derivations
        32
        validate-taproot-origin-value)
      (let* ((output (nth-item (psbt-outputs p) output-index "psbt-annotate-output"))
             (txout0 (nth-item (transaction-outputs (psbt-unsigned-tx p))
                               output-index
                               "psbt-annotate-output")))
        (unless (equal? script-pubkey (txout-script-pubkey txout0))
          (error "psbt-annotate-output: output scriptPubKey mismatch"))
        (psbt-update-output
          p
          output-index
          (psbt-output
            bip32-derivations: (merge-keyvals (psbt-output-bip32-derivations output)
                                              bip32-derivations)
            taproot-bip32-derivations: (merge-keyvals
                                          (psbt-output-taproot-bip32-derivations output)
                                          taproot-bip32-derivations)
            unknowns: (psbt-output-unknowns output)))))

    (define (psbt-input-sighash-or-default input default)
      (if (psbt-input-sighash-type input)
          (psbt-input-sighash-type input)
          default))

    (define (psbt-prevout-from-non-witness-utxo p input-index input who)
      (let ((prev-tx (psbt-input-non-witness-utxo input)))
        (unless prev-tx
          (error (string-append who ": missing non-witness UTXO")))
        (let* ((unsigned-input (nth-item (transaction-inputs (psbt-unsigned-tx p))
                                         input-index
                                         who))
               (op (txin-previous-output unsigned-input)))
          (unless (equal? (transaction-txid prev-tx) (outpoint-txid op))
            (error (string-append who ": non-witness UTXO txid mismatch")))
          (nth-item (transaction-outputs prev-tx)
                    (outpoint-index op)
                    who))))

    (define (psbt-input-prevout p input-index who)
      (let* ((input (nth-item (psbt-inputs p) input-index who))
             (witness-utxo (psbt-input-witness-utxo input)))
        (if witness-utxo
            witness-utxo
            (psbt-prevout-from-non-witness-utxo p input-index input who))))

    (define (psbt-prevouts p who)
      (let loop ((i 0)
                 (inputs (psbt-inputs p))
                 (out '()))
        (if (null? inputs)
            (reverse out)
            (loop (+ i 1)
                  (cdr inputs)
                  (cons (psbt-input-prevout p i who) out)))))

    (define (witness-script-pk-checksig-pubkey script)
      (if (and (= 35 (bytevector-length script))
               (= #x21 (bytevector-u8-ref script 0))
               (= op-checksig (bytevector-u8-ref script 34)))
          (bytevector-copy script 1 34)
          #f))

    (define (tapscript-pk-checksig-pubkey script)
      (if (and (= 34 (bytevector-length script))
               (= #x20 (bytevector-u8-ref script 0))
               (= op-checksig (bytevector-u8-ref script 33)))
          (bytevector-copy script 1 33)
          #f))

    (define (p2tr-script-xonly script)
      (if (and (= 34 (bytevector-length script))
               (= op-1 (bytevector-u8-ref script 0))
               (= #x20 (bytevector-u8-ref script 1)))
          (bytevector-copy script 2 34)
          #f))

    (define (taproot-leaf-script-hash leaf-script)
      (taproot-leaf-hash
        (psbt-taproot-leaf-script-script leaf-script)
        (psbt-taproot-leaf-script-leaf-version leaf-script)))

    (define (find-taproot-leaf-for-pubkey leaf-scripts xonly-pubkey who)
      (let loop ((xs leaf-scripts))
        (cond ((null? xs)
               (error (string-append who ": missing Taproot leaf script for key")))
              ((let* ((leaf-script (car xs))
                      (script (psbt-taproot-leaf-script-script leaf-script))
                      (script-key (tapscript-pk-checksig-pubkey script)))
                 (and script-key (equal? script-key xonly-pubkey)))
               (car xs))
              (else (loop (cdr xs))))))

    (define (find-taproot-script-sig script-sigs xonly-pubkey leaf-hash who)
      (let ((wanted-key (bytevector-append xonly-pubkey leaf-hash)))
        (let loop ((xs script-sigs))
          (cond ((null? xs)
                 (error (string-append who ": missing Taproot script signature")))
                ((equal? wanted-key (car (car xs))) (cdr (car xs)))
                (else (loop (cdr xs)))))))

    (define (verify-taproot-leaf-prevout utxo leaf-script leaf-hash who)
      (let* ((script (txout-script-pubkey utxo))
             (expected-xonly (p2tr-script-xonly script)))
        (unless expected-xonly
          (error (string-append who ": UTXO is not P2TR")))
        (unless (equal? expected-xonly
                        (taproot-control-block-output-xonly
                          leaf-hash
                          (psbt-taproot-leaf-script-control-block leaf-script)))
          (error (string-append who ": Taproot control block does not match UTXO")))))

    ;;; Add a legacy P2PKH partial signature to a PSBT input.
    ;;;
    ;;; The input must contain the previous transaction as a non-witness UTXO.
    (define (psbt-sign-p2pkh-input p input-index private-key)
      (: psbt? integer? bytevector? -> psbt?)
      (validate-psbt p)
      (let* ((input (nth-item (psbt-inputs p) input-index "psbt-sign-p2pkh-input"))
             (utxo (psbt-prevout-from-non-witness-utxo
                     p input-index input "psbt-sign-p2pkh-input"))
             (pubkey (private-key->public-key private-key))
             (pubkey-hash (hash160 pubkey))
             (expected-script (script-p2pkh pubkey-hash)))
        (unless (equal? expected-script (txout-script-pubkey utxo))
          (error "psbt-sign-p2pkh-input: non-witness UTXO is not P2PKH for key"))
        (let* ((sighash-type (psbt-input-sighash-or-default input sighash-all))
               (msghash (transaction-sighash-legacy
                          (psbt-unsigned-tx p)
                          input-index
                          expected-script
                          sighash-type))
               (der (secp256k1-ecdsa-signature-serialize-der
                      (secp256k1-ecdsa-sign private-key msghash)))
               (sig (append-sighash-byte der sighash-type))
               (signed-input
                 (psbt-input
                   non-witness-utxo: (psbt-input-non-witness-utxo input)
                   witness-utxo: (psbt-input-witness-utxo input)
                   partial-sigs: (append (psbt-input-partial-sigs input)
                                         (list (cons pubkey sig)))
                   sighash-type: sighash-type
                   final-script-sig: (psbt-input-final-script-sig input)
                   final-script-witness: (psbt-input-final-script-witness input)
                   taproot-key-sig: (psbt-input-taproot-key-sig input)
                           taproot-script-sigs: (psbt-input-taproot-script-sigs input)
                           taproot-leaf-scripts: (psbt-input-taproot-leaf-scripts input)
                   redeem-script: (psbt-input-redeem-script input)
                   witness-script: (psbt-input-witness-script input)
                   bip32-derivations: (psbt-input-bip32-derivations input)
                   taproot-bip32-derivations: (psbt-input-taproot-bip32-derivations input)
                   unknowns: (psbt-input-unknowns input))))
          (psbt-update-input p input-index signed-input))))

    ;;; Add a P2WPKH partial signature to a PSBT input.
    ;;;
    ;;; The input must contain a witness UTXO.
    (define (psbt-sign-p2wpkh-input p input-index private-key)
      (: psbt? integer? bytevector? -> psbt?)
      (validate-psbt p)
      (let* ((input (nth-item (psbt-inputs p) input-index "psbt-sign-p2wpkh-input"))
             (utxo (psbt-input-witness-utxo input)))
        (unless utxo
          (error "psbt-sign-p2wpkh-input: missing witness UTXO"))
        (let* ((pubkey (private-key->public-key private-key))
               (pubkey-hash (hash160 pubkey))
               (expected-script (script-p2wpkh pubkey-hash)))
          (unless (equal? expected-script (txout-script-pubkey utxo))
            (error "psbt-sign-p2wpkh-input: witness UTXO is not P2WPKH for key"))
          (let* ((sighash-type (psbt-input-sighash-or-default input sighash-all))
                 (script-code (script-p2pkh pubkey-hash))
                 (msghash (transaction-sighash-segwit-v0
                            (psbt-unsigned-tx p)
                            input-index
                            script-code
                            (txout-value utxo)
                            sighash-type))
                 (der (secp256k1-ecdsa-signature-serialize-der
                        (secp256k1-ecdsa-sign private-key msghash)))
                 (sig (append-sighash-byte der sighash-type))
                 (signed-input
                   (psbt-input
                     non-witness-utxo: (psbt-input-non-witness-utxo input)
                     witness-utxo: utxo
                     partial-sigs: (append (psbt-input-partial-sigs input)
                                           (list (cons pubkey sig)))
                     sighash-type: sighash-type
                     final-script-sig: (psbt-input-final-script-sig input)
                     final-script-witness: (psbt-input-final-script-witness input)
                     taproot-key-sig: (psbt-input-taproot-key-sig input)
                           taproot-script-sigs: (psbt-input-taproot-script-sigs input)
                           taproot-leaf-scripts: (psbt-input-taproot-leaf-scripts input)
                     redeem-script: (psbt-input-redeem-script input)
                     witness-script: (psbt-input-witness-script input)
                     bip32-derivations: (psbt-input-bip32-derivations input)
                     taproot-bip32-derivations: (psbt-input-taproot-bip32-derivations input)
                     unknowns: (psbt-input-unknowns input))))
            (psbt-update-input p input-index signed-input)))))

    ;;; Add a P2WSH partial signature for a single-key checksig witness script.
    (define (psbt-sign-p2wsh-input p input-index private-key)
      (: psbt? integer? bytevector? -> psbt?)
      (validate-psbt p)
      (let* ((input (nth-item (psbt-inputs p) input-index "psbt-sign-p2wsh-input"))
             (utxo (psbt-input-witness-utxo input))
             (witness-script (psbt-input-witness-script input)))
        (unless utxo
          (error "psbt-sign-p2wsh-input: missing witness UTXO"))
        (unless witness-script
          (error "psbt-sign-p2wsh-input: missing witness script"))
        (let* ((pubkey (private-key->public-key private-key))
               (script-pubkey (script-p2wsh (sha256-bytes witness-script)))
               (script-pubkey-key (witness-script-pk-checksig-pubkey witness-script)))
          (unless (equal? script-pubkey (txout-script-pubkey utxo))
            (error "psbt-sign-p2wsh-input: witness UTXO is not P2WSH for witness script"))
          (unless (and script-pubkey-key (equal? pubkey script-pubkey-key))
            (error "psbt-sign-p2wsh-input: witness script is not single-key checksig for key"))
          (let* ((sighash-type (psbt-input-sighash-or-default input sighash-all))
                 (msghash (transaction-sighash-segwit-v0
                            (psbt-unsigned-tx p)
                            input-index
                            witness-script
                            (txout-value utxo)
                            sighash-type))
                 (der (secp256k1-ecdsa-signature-serialize-der
                        (secp256k1-ecdsa-sign private-key msghash)))
                 (sig (append-sighash-byte der sighash-type))
                 (signed-input
                   (psbt-input
                     non-witness-utxo: (psbt-input-non-witness-utxo input)
                     witness-utxo: utxo
                     partial-sigs: (append (psbt-input-partial-sigs input)
                                           (list (cons pubkey sig)))
                     sighash-type: sighash-type
                     final-script-sig: (psbt-input-final-script-sig input)
                     final-script-witness: (psbt-input-final-script-witness input)
                     taproot-key-sig: (psbt-input-taproot-key-sig input)
                           taproot-script-sigs: (psbt-input-taproot-script-sigs input)
                           taproot-leaf-scripts: (psbt-input-taproot-leaf-scripts input)
                     redeem-script: (psbt-input-redeem-script input)
                     witness-script: witness-script
                     bip32-derivations: (psbt-input-bip32-derivations input)
                     taproot-bip32-derivations: (psbt-input-taproot-bip32-derivations input)
                     unknowns: (psbt-input-unknowns input))))
            (psbt-update-input p input-index signed-input)))))

    ;;; Add a Taproot key-path signature to a PSBT input.
    (define (psbt-sign-p2tr-keypath-input p input-index private-key)
      (: psbt? integer? bytevector? -> psbt?)
      (validate-psbt p)
      (let* ((input (nth-item (psbt-inputs p) input-index "psbt-sign-p2tr-keypath-input"))
             (prevouts (psbt-prevouts p "psbt-sign-p2tr-keypath-input"))
             (utxo (nth-item prevouts input-index "psbt-sign-p2tr-keypath-input"))
             (sighash-type (psbt-input-sighash-or-default input sighash-default))
             (tweaked-keypair (taproot-tweaked-keypair private-key))
             (output-xonly (secp256k1-keypair-xonly-pub tweaked-keypair))
             (expected-script (script-p2tr output-xonly)))
        (unless (equal? expected-script (txout-script-pubkey utxo))
          (error "psbt-sign-p2tr-keypath-input: UTXO is not BIP86 P2TR for key"))
        (let* ((msghash (transaction-sighash-taproot-keypath
                          (psbt-unsigned-tx p)
                          input-index
                          prevouts
                          sighash-type))
               (sig (taproot-keypath-signature tweaked-keypair msghash sighash-type))
               (signed-input
                 (psbt-input
                   non-witness-utxo: (psbt-input-non-witness-utxo input)
                   witness-utxo: (psbt-input-witness-utxo input)
                   partial-sigs: (psbt-input-partial-sigs input)
                   sighash-type: sighash-type
                   final-script-sig: (psbt-input-final-script-sig input)
                   final-script-witness: (psbt-input-final-script-witness input)
                   taproot-key-sig: sig
                  taproot-script-sigs: (psbt-input-taproot-script-sigs input)
                  taproot-leaf-scripts: (psbt-input-taproot-leaf-scripts input)
                   redeem-script: (psbt-input-redeem-script input)
                   witness-script: (psbt-input-witness-script input)
                   bip32-derivations: (psbt-input-bip32-derivations input)
                   taproot-bip32-derivations: (psbt-input-taproot-bip32-derivations input)
                   unknowns: (psbt-input-unknowns input))))
          (psbt-update-input p input-index signed-input))))

    ;;; Add a Taproot script-path signature for a single-key checksig leaf.
    (define (psbt-sign-p2tr-scriptpath-input p input-index private-key)
      (: psbt? integer? bytevector? -> psbt?)
      (validate-psbt p)
      (let* ((input (nth-item (psbt-inputs p) input-index "psbt-sign-p2tr-scriptpath-input"))
             (prevouts (psbt-prevouts p "psbt-sign-p2tr-scriptpath-input"))
             (utxo (nth-item prevouts input-index "psbt-sign-p2tr-scriptpath-input"))
             (keypair (secp256k1-keypair-create private-key))
             (xonly-pubkey (secp256k1-keypair-xonly-pub keypair))
             (leaf-script (find-taproot-leaf-for-pubkey
                            (psbt-input-taproot-leaf-scripts input)
                            xonly-pubkey
                            "psbt-sign-p2tr-scriptpath-input"))
             (script (psbt-taproot-leaf-script-script leaf-script))
             (leaf-version (psbt-taproot-leaf-script-leaf-version leaf-script))
             (leaf-hash (taproot-leaf-script-hash leaf-script))
             (sighash-type (psbt-input-sighash-or-default input sighash-default)))
        (verify-taproot-leaf-prevout
          utxo
          leaf-script
          leaf-hash
          "psbt-sign-p2tr-scriptpath-input")
        (let* ((msghash (transaction-sighash-taproot-scriptpath
                          (psbt-unsigned-tx p)
                          input-index
                          prevouts
                          script
                          leaf-version
                          sighash-type))
               (sig (taproot-keypath-signature keypair msghash sighash-type))
               (sig-key (bytevector-append xonly-pubkey leaf-hash))
               (signed-input
                 (psbt-input
                   non-witness-utxo: (psbt-input-non-witness-utxo input)
                   witness-utxo: (psbt-input-witness-utxo input)
                   partial-sigs: (psbt-input-partial-sigs input)
                   sighash-type: sighash-type
                   final-script-sig: (psbt-input-final-script-sig input)
                   final-script-witness: (psbt-input-final-script-witness input)
                   taproot-key-sig: (psbt-input-taproot-key-sig input)
                   taproot-script-sigs: (append (psbt-input-taproot-script-sigs input)
                                                (list (cons sig-key sig)))
                   taproot-leaf-scripts: (psbt-input-taproot-leaf-scripts input)
                   redeem-script: (psbt-input-redeem-script input)
                   witness-script: (psbt-input-witness-script input)
                   bip32-derivations: (psbt-input-bip32-derivations input)
                   taproot-bip32-derivations: (psbt-input-taproot-bip32-derivations input)
                   unknowns: (psbt-input-unknowns input))))
          (psbt-update-input p input-index signed-input))))

    ;;; Sign a standard P2PKH, P2WPKH, or key-path P2TR PSBT input.
    (define (psbt-sign-standard-input p input-index private-key)
      (: psbt? integer? bytevector? -> psbt?)
      (validate-psbt p)
      (let* ((utxo (psbt-input-prevout p input-index "psbt-sign-standard-input"))
             (script (txout-script-pubkey utxo)))
        (cond ((script-p2pkh? script)
               (psbt-sign-p2pkh-input p input-index private-key))
              ((script-p2wpkh? script)
               (psbt-sign-p2wpkh-input p input-index private-key))
              ((script-p2wsh? script)
               (psbt-sign-p2wsh-input p input-index private-key))
              ((script-p2tr? script)
               (psbt-sign-p2tr-keypath-input p input-index private-key))
              (else
               (error "psbt-sign-standard-input: unsupported prevout scriptPubKey")))))

    ;;; Finalize a signed P2PKH PSBT input.
    (define (psbt-finalize-p2pkh-input p input-index)
      (: psbt? integer? -> psbt?)
      (validate-psbt p)
      (let* ((input (nth-item (psbt-inputs p) input-index "psbt-finalize-p2pkh-input"))
             (partial-sigs (psbt-input-partial-sigs input)))
        (when (null? partial-sigs)
          (error "psbt-finalize-p2pkh-input: missing partial signature"))
        (let* ((entry (car partial-sigs))
               (final-input
                 (psbt-input
                   non-witness-utxo: (psbt-input-non-witness-utxo input)
                   witness-utxo: (psbt-input-witness-utxo input)
                   partial-sigs: partial-sigs
                   sighash-type: (psbt-input-sighash-type input)
                   final-script-sig: (script-append
                                       (script-push-data (cdr entry))
                                       (script-push-data (car entry)))
                   final-script-witness: '()
                   taproot-key-sig: (psbt-input-taproot-key-sig input)
                           taproot-script-sigs: (psbt-input-taproot-script-sigs input)
                           taproot-leaf-scripts: (psbt-input-taproot-leaf-scripts input)
                   redeem-script: (psbt-input-redeem-script input)
                   witness-script: (psbt-input-witness-script input)
                   bip32-derivations: (psbt-input-bip32-derivations input)
                   taproot-bip32-derivations: (psbt-input-taproot-bip32-derivations input)
                   unknowns: (psbt-input-unknowns input))))
          (psbt-update-input p input-index final-input))))

    ;;; Finalize a signed P2WPKH PSBT input.
    (define (psbt-finalize-p2wpkh-input p input-index)
      (: psbt? integer? -> psbt?)
      (validate-psbt p)
      (let* ((input (nth-item (psbt-inputs p) input-index "psbt-finalize-p2wpkh-input"))
             (partial-sigs (psbt-input-partial-sigs input)))
        (when (null? partial-sigs)
          (error "psbt-finalize-p2wpkh-input: missing partial signature"))
        (let* ((entry (car partial-sigs))
               (final-input
                 (psbt-input
                   non-witness-utxo: (psbt-input-non-witness-utxo input)
                   witness-utxo: (psbt-input-witness-utxo input)
                   partial-sigs: partial-sigs
                   sighash-type: (psbt-input-sighash-type input)
                   final-script-sig: #u8()
                   final-script-witness: (list (cdr entry) (car entry))
                   taproot-key-sig: (psbt-input-taproot-key-sig input)
                           taproot-script-sigs: (psbt-input-taproot-script-sigs input)
                           taproot-leaf-scripts: (psbt-input-taproot-leaf-scripts input)
                   redeem-script: (psbt-input-redeem-script input)
                   witness-script: (psbt-input-witness-script input)
                   bip32-derivations: (psbt-input-bip32-derivations input)
                   taproot-bip32-derivations: (psbt-input-taproot-bip32-derivations input)
                   unknowns: (psbt-input-unknowns input))))
          (psbt-update-input p input-index final-input))))

    ;;; Finalize a signed P2WSH single-key checksig PSBT input.
    (define (psbt-finalize-p2wsh-input p input-index)
      (: psbt? integer? -> psbt?)
      (validate-psbt p)
      (let* ((input (nth-item (psbt-inputs p) input-index "psbt-finalize-p2wsh-input"))
             (partial-sigs (psbt-input-partial-sigs input))
             (witness-script (psbt-input-witness-script input)))
        (when (null? partial-sigs)
          (error "psbt-finalize-p2wsh-input: missing partial signature"))
        (unless witness-script
          (error "psbt-finalize-p2wsh-input: missing witness script"))
        (unless (witness-script-pk-checksig-pubkey witness-script)
          (error "psbt-finalize-p2wsh-input: unsupported witness script"))
        (let* ((entry (car partial-sigs))
               (final-input
                 (psbt-input
                   non-witness-utxo: (psbt-input-non-witness-utxo input)
                   witness-utxo: (psbt-input-witness-utxo input)
                   partial-sigs: partial-sigs
                   sighash-type: (psbt-input-sighash-type input)
                   final-script-sig: #u8()
                   final-script-witness: (list (cdr entry) witness-script)
                   taproot-key-sig: (psbt-input-taproot-key-sig input)
                           taproot-script-sigs: (psbt-input-taproot-script-sigs input)
                           taproot-leaf-scripts: (psbt-input-taproot-leaf-scripts input)
                   redeem-script: (psbt-input-redeem-script input)
                   witness-script: witness-script
                   bip32-derivations: (psbt-input-bip32-derivations input)
                   taproot-bip32-derivations: (psbt-input-taproot-bip32-derivations input)
                   unknowns: (psbt-input-unknowns input))))
          (psbt-update-input p input-index final-input))))

    ;;; Finalize a signed Taproot key-path PSBT input.
    (define (psbt-finalize-p2tr-keypath-input p input-index)
      (: psbt? integer? -> psbt?)
      (validate-psbt p)
      (let* ((input (nth-item (psbt-inputs p) input-index "psbt-finalize-p2tr-keypath-input"))
             (sig (psbt-input-taproot-key-sig input)))
        (unless sig
          (error "psbt-finalize-p2tr-keypath-input: missing Taproot key signature"))
        (let ((final-input
                (psbt-input
                  non-witness-utxo: (psbt-input-non-witness-utxo input)
                  witness-utxo: (psbt-input-witness-utxo input)
                  partial-sigs: (psbt-input-partial-sigs input)
                  sighash-type: (psbt-input-sighash-type input)
                  final-script-sig: #u8()
                  final-script-witness: (list sig)
                  taproot-key-sig: sig
                  taproot-script-sigs: (psbt-input-taproot-script-sigs input)
                  taproot-leaf-scripts: (psbt-input-taproot-leaf-scripts input)
                  redeem-script: (psbt-input-redeem-script input)
                  witness-script: (psbt-input-witness-script input)
                  bip32-derivations: (psbt-input-bip32-derivations input)
                  taproot-bip32-derivations: (psbt-input-taproot-bip32-derivations input)
                  unknowns: (psbt-input-unknowns input))))
          (psbt-update-input p input-index final-input))))

    ;;; Finalize a signed Taproot script-path PSBT input.
    (define (psbt-finalize-p2tr-scriptpath-input p input-index)
      (: psbt? integer? -> psbt?)
      (validate-psbt p)
      (let* ((input (nth-item (psbt-inputs p) input-index "psbt-finalize-p2tr-scriptpath-input"))
             (leaf-scripts (psbt-input-taproot-leaf-scripts input)))
        (when (null? leaf-scripts)
          (error "psbt-finalize-p2tr-scriptpath-input: missing Taproot leaf script"))
        (let* ((leaf-script (car leaf-scripts))
               (script (psbt-taproot-leaf-script-script leaf-script))
               (script-key (tapscript-pk-checksig-pubkey script))
               (leaf-hash (taproot-leaf-script-hash leaf-script)))
          (unless script-key
            (error "psbt-finalize-p2tr-scriptpath-input: unsupported Taproot leaf script"))
          (let* ((sig (find-taproot-script-sig
                        (psbt-input-taproot-script-sigs input)
                        script-key
                        leaf-hash
                        "psbt-finalize-p2tr-scriptpath-input"))
                 (final-input
                   (psbt-input
                     non-witness-utxo: (psbt-input-non-witness-utxo input)
                     witness-utxo: (psbt-input-witness-utxo input)
                     partial-sigs: (psbt-input-partial-sigs input)
                     sighash-type: (psbt-input-sighash-type input)
                     final-script-sig: #u8()
                     final-script-witness: (list
                                             sig
                                             script
                                             (psbt-taproot-leaf-script-control-block leaf-script))
                     taproot-key-sig: (psbt-input-taproot-key-sig input)
                     taproot-script-sigs: (psbt-input-taproot-script-sigs input)
                     taproot-leaf-scripts: leaf-scripts
                     redeem-script: (psbt-input-redeem-script input)
                     witness-script: (psbt-input-witness-script input)
                     bip32-derivations: (psbt-input-bip32-derivations input)
                     taproot-bip32-derivations: (psbt-input-taproot-bip32-derivations input)
                     unknowns: (psbt-input-unknowns input))))
            (psbt-update-input p input-index final-input)))))

    ;;; Finalize a standard P2PKH, P2WPKH, or key-path P2TR PSBT input.
    (define (psbt-finalize-standard-input p input-index)
      (: psbt? integer? -> psbt?)
      (validate-psbt p)
      (let* ((utxo (psbt-input-prevout p input-index "psbt-finalize-standard-input"))
             (script (txout-script-pubkey utxo)))
        (cond ((script-p2pkh? script)
               (psbt-finalize-p2pkh-input p input-index))
              ((script-p2wpkh? script)
               (psbt-finalize-p2wpkh-input p input-index))
              ((script-p2wsh? script)
               (psbt-finalize-p2wsh-input p input-index))
              ((script-p2tr? script)
               (psbt-finalize-p2tr-keypath-input p input-index))
              (else
               (error "psbt-finalize-standard-input: unsupported prevout scriptPubKey")))))

    ;;; Extract the final transaction from a fully-finalized PSBT.
    (define (psbt-extract-transaction p)
      (: psbt? -> transaction?)
      (validate-psbt p)
      (let loop ((txins (transaction-inputs (psbt-unsigned-tx p)))
                 (psbt-ins (psbt-inputs p))
                 (out '()))
        (if (null? txins)
            (transaction
              version: (transaction-version (psbt-unsigned-tx p))
              inputs: (reverse out)
              outputs: (transaction-outputs (psbt-unsigned-tx p))
              lock-time: (transaction-lock-time (psbt-unsigned-tx p)))
            (let ((psbt-in (car psbt-ins))
                  (txin0 (car txins)))
              (when (and (= 0 (bytevector-length (psbt-input-final-script-sig psbt-in)))
                         (null? (psbt-input-final-script-witness psbt-in)))
                (error "psbt-extract-transaction: input is not finalized"))
              (loop
                (cdr txins)
                (cdr psbt-ins)
                (cons
                  (txin previous-output: (txin-previous-output txin0)
                        script-sig: (psbt-input-final-script-sig psbt-in)
                        sequence: (txin-sequence txin0)
                        witness: (psbt-input-final-script-witness psbt-in))
                  out))))))))
