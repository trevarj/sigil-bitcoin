;;; (sigil bitcoin psbt finalize) — PSBT finalization and extraction

(define-library (sigil bitcoin psbt finalize)
  (import (sigil bitcoin utils)
          (sigil bitcoin tx types)
          (sigil bitcoin tx wire)
          (sigil bitcoin script)
          (sigil bitcoin psbt base))
  (export
    psbt-finalize-p2pkh-input
    psbt-finalize-p2wpkh-input
    psbt-finalize-p2wsh-input
    psbt-finalize-p2tr-keypath-input
    psbt-finalize-p2tr-scriptpath-input
    psbt-finalize-standard-input
    psbt-extract-transaction)
  (begin
    (define (find-taproot-script-sig-or-false script-sigs xonly-pubkey leaf-hash)
      (let ((wanted-key (bytevector-append xonly-pubkey leaf-hash)))
        (let loop ((xs script-sigs))
          (cond ((null? xs) #f)
                ((equal? wanted-key (car (car xs))) (cdr (car xs)))
                (else (loop (cdr xs)))))))

    (define (taproot-multi-a-witness-items script-sigs keys leaf-hash threshold)
      (let loop ((xs keys)
                 (signed-count 0)
                 (out '()))
        (if (null? xs)
            (begin
              (when (< signed-count threshold)
                (error "psbt-finalize-p2tr-scriptpath-input: missing Taproot script signatures"))
              out)
            (let ((sig (find-taproot-script-sig-or-false script-sigs (car xs) leaf-hash)))
              (loop (cdr xs)
                    (if sig (+ signed-count 1) signed-count)
                    (cons (if sig sig #u8()) out))))))

    ;;; Finalize a signed P2PKH PSBT input.
    (define (psbt-finalize-p2pkh-input p input-index)
      (: psbt? integer? -> psbt?)
      (validate-psbt p)
      (let* ((input (nth-item (psbt-inputs p) input-index "psbt-finalize-p2pkh-input"))
             (partial-sigs (psbt-input-partial-sigs input)))
        (when (null? partial-sigs)
          (error "psbt-finalize-p2pkh-input: missing partial signature"))
        (let* ((entry (car partial-sigs))
               (final-input
                 (psbt-input
                   non-witness-utxo: (psbt-input-non-witness-utxo input)
                   witness-utxo: (psbt-input-witness-utxo input)
                   partial-sigs: partial-sigs
                   sighash-type: (psbt-input-sighash-type input)
                   final-script-sig: (script-append
                                       (script-push-data (cdr entry))
                                       (script-push-data (car entry)))
                   final-script-witness: '()
                   taproot-key-sig: (psbt-input-taproot-key-sig input)
                           taproot-script-sigs: (psbt-input-taproot-script-sigs input)
                           taproot-leaf-scripts: (psbt-input-taproot-leaf-scripts input)
                   redeem-script: (psbt-input-redeem-script input)
                   witness-script: (psbt-input-witness-script input)
                   bip32-derivations: (psbt-input-bip32-derivations input)
                   taproot-bip32-derivations: (psbt-input-taproot-bip32-derivations input)
                   unknowns: (psbt-input-unknowns input))))
          (psbt-update-input p input-index final-input))))

    ;;; Finalize a signed P2WPKH PSBT input.
    (define (psbt-finalize-p2wpkh-input p input-index)
      (: psbt? integer? -> psbt?)
      (validate-psbt p)
      (let* ((input (nth-item (psbt-inputs p) input-index "psbt-finalize-p2wpkh-input"))
             (partial-sigs (psbt-input-partial-sigs input)))
        (when (null? partial-sigs)
          (error "psbt-finalize-p2wpkh-input: missing partial signature"))
        (let* ((entry (car partial-sigs))
               (final-input
                 (psbt-input
                   non-witness-utxo: (psbt-input-non-witness-utxo input)
                   witness-utxo: (psbt-input-witness-utxo input)
                   partial-sigs: partial-sigs
                   sighash-type: (psbt-input-sighash-type input)
                   final-script-sig: #u8()
                   final-script-witness: (list (cdr entry) (car entry))
                   taproot-key-sig: (psbt-input-taproot-key-sig input)
                           taproot-script-sigs: (psbt-input-taproot-script-sigs input)
                           taproot-leaf-scripts: (psbt-input-taproot-leaf-scripts input)
                   redeem-script: (psbt-input-redeem-script input)
                   witness-script: (psbt-input-witness-script input)
                   bip32-derivations: (psbt-input-bip32-derivations input)
                   taproot-bip32-derivations: (psbt-input-taproot-bip32-derivations input)
                   unknowns: (psbt-input-unknowns input))))
          (psbt-update-input p input-index final-input))))

    ;;; Finalize a signed P2WSH single-key checksig PSBT input.
    (define (psbt-finalize-p2wsh-input p input-index)
      (: psbt? integer? -> psbt?)
      (validate-psbt p)
      (let* ((input (nth-item (psbt-inputs p) input-index "psbt-finalize-p2wsh-input"))
             (partial-sigs (psbt-input-partial-sigs input))
             (witness-script (psbt-input-witness-script input)))
        (when (null? partial-sigs)
          (error "psbt-finalize-p2wsh-input: missing partial signature"))
        (unless witness-script
          (error "psbt-finalize-p2wsh-input: missing witness script"))
        (unless (witness-script-pk-checksig-pubkey witness-script)
          (error "psbt-finalize-p2wsh-input: unsupported witness script"))
        (let* ((entry (car partial-sigs))
               (final-input
                 (psbt-input
                   non-witness-utxo: (psbt-input-non-witness-utxo input)
                   witness-utxo: (psbt-input-witness-utxo input)
                   partial-sigs: partial-sigs
                   sighash-type: (psbt-input-sighash-type input)
                   final-script-sig: #u8()
                   final-script-witness: (list (cdr entry) witness-script)
                   taproot-key-sig: (psbt-input-taproot-key-sig input)
                           taproot-script-sigs: (psbt-input-taproot-script-sigs input)
                           taproot-leaf-scripts: (psbt-input-taproot-leaf-scripts input)
                   redeem-script: (psbt-input-redeem-script input)
                   witness-script: witness-script
                   bip32-derivations: (psbt-input-bip32-derivations input)
                   taproot-bip32-derivations: (psbt-input-taproot-bip32-derivations input)
                   unknowns: (psbt-input-unknowns input))))
          (psbt-update-input p input-index final-input))))

    ;;; Finalize a signed Taproot key-path PSBT input.
    (define (psbt-finalize-p2tr-keypath-input p input-index)
      (: psbt? integer? -> psbt?)
      (validate-psbt p)
      (let* ((input (nth-item (psbt-inputs p) input-index "psbt-finalize-p2tr-keypath-input"))
             (sig (psbt-input-taproot-key-sig input)))
        (unless sig
          (error "psbt-finalize-p2tr-keypath-input: missing Taproot key signature"))
        (let ((final-input
                (psbt-input
                  non-witness-utxo: (psbt-input-non-witness-utxo input)
                  witness-utxo: (psbt-input-witness-utxo input)
                  partial-sigs: (psbt-input-partial-sigs input)
                  sighash-type: (psbt-input-sighash-type input)
                  final-script-sig: #u8()
                  final-script-witness: (list sig)
                  taproot-key-sig: sig
                  taproot-script-sigs: (psbt-input-taproot-script-sigs input)
                  taproot-leaf-scripts: (psbt-input-taproot-leaf-scripts input)
                  redeem-script: (psbt-input-redeem-script input)
                  witness-script: (psbt-input-witness-script input)
                  bip32-derivations: (psbt-input-bip32-derivations input)
                  taproot-bip32-derivations: (psbt-input-taproot-bip32-derivations input)
                  unknowns: (psbt-input-unknowns input))))
          (psbt-update-input p input-index final-input))))

    ;;; Finalize a signed Taproot script-path PSBT input.
    (define (psbt-finalize-p2tr-scriptpath-input p input-index)
      (: psbt? integer? -> psbt?)
      (validate-psbt p)
      (let* ((input (nth-item (psbt-inputs p) input-index "psbt-finalize-p2tr-scriptpath-input"))
             (leaf-scripts (psbt-input-taproot-leaf-scripts input)))
        (when (null? leaf-scripts)
          (error "psbt-finalize-p2tr-scriptpath-input: missing Taproot leaf script"))
        (let* ((leaf-script (car leaf-scripts))
               (script (psbt-taproot-leaf-script-script leaf-script))
               (script-key (tapscript-pk-checksig-pubkey script))
               (multi-a (tapscript-multi-a-pubkeys script))
               (leaf-hash (taproot-leaf-script-hash leaf-script)))
          (unless (or script-key multi-a)
            (error "psbt-finalize-p2tr-scriptpath-input: unsupported Taproot leaf script"))
          (let* ((witness-items
                   (if script-key
                       (list
                         (find-taproot-script-sig
                           (psbt-input-taproot-script-sigs input)
                           script-key
                           leaf-hash
                           "psbt-finalize-p2tr-scriptpath-input"))
                       (taproot-multi-a-witness-items
                         (psbt-input-taproot-script-sigs input)
                         (cdr multi-a)
                         leaf-hash
                         (car multi-a))))
                 (final-input
                   (psbt-input
                     non-witness-utxo: (psbt-input-non-witness-utxo input)
                     witness-utxo: (psbt-input-witness-utxo input)
                     partial-sigs: (psbt-input-partial-sigs input)
                     sighash-type: (psbt-input-sighash-type input)
                     final-script-sig: #u8()
                     final-script-witness: (append
                                             witness-items
                                             (list
                                               script
                                               (psbt-taproot-leaf-script-control-block leaf-script)))
                     taproot-key-sig: (psbt-input-taproot-key-sig input)
                     taproot-script-sigs: (psbt-input-taproot-script-sigs input)
                     taproot-leaf-scripts: leaf-scripts
                     redeem-script: (psbt-input-redeem-script input)
                     witness-script: (psbt-input-witness-script input)
                     bip32-derivations: (psbt-input-bip32-derivations input)
                     taproot-bip32-derivations: (psbt-input-taproot-bip32-derivations input)
                     unknowns: (psbt-input-unknowns input))))
            (psbt-update-input p input-index final-input)))))

    ;;; Finalize a standard P2PKH, P2WPKH, or key-path P2TR PSBT input.
    (define (psbt-finalize-standard-input p input-index)
      (: psbt? integer? -> psbt?)
      (validate-psbt p)
      (let* ((utxo (psbt-input-prevout p input-index "psbt-finalize-standard-input"))
             (script (txout-script-pubkey utxo)))
        (cond ((script-p2pkh? script)
               (psbt-finalize-p2pkh-input p input-index))
              ((script-p2wpkh? script)
               (psbt-finalize-p2wpkh-input p input-index))
              ((script-p2wsh? script)
               (psbt-finalize-p2wsh-input p input-index))
              ((script-p2tr? script)
               (psbt-finalize-p2tr-keypath-input p input-index))
              (else
               (error "psbt-finalize-standard-input: unsupported prevout scriptPubKey")))))

    ;;; Extract the final transaction from a fully-finalized PSBT.
    (define (psbt-extract-transaction p)
      (: psbt? -> transaction?)
      (validate-psbt p)
      (let loop ((txins (transaction-inputs (psbt-unsigned-tx p)))
                 (psbt-ins (psbt-inputs p))
                 (out '()))
        (if (null? txins)
            (transaction
              version: (transaction-version (psbt-unsigned-tx p))
              inputs: (reverse out)
              outputs: (transaction-outputs (psbt-unsigned-tx p))
              lock-time: (transaction-lock-time (psbt-unsigned-tx p)))
            (let ((psbt-in (car psbt-ins))
                  (txin0 (car txins)))
              (when (and (= 0 (bytevector-length (psbt-input-final-script-sig psbt-in)))
                         (null? (psbt-input-final-script-witness psbt-in)))
                (error "psbt-extract-transaction: input is not finalized"))
              (loop
                (cdr txins)
                (cdr psbt-ins)
                (cons
                  (txin previous-output: (txin-previous-output txin0)
                        script-sig: (psbt-input-final-script-sig psbt-in)
                        sequence: (txin-sequence txin0)
                        witness: (psbt-input-final-script-witness psbt-in))
                  out))))))
))
