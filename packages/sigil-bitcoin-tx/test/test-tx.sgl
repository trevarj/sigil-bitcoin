(import (sigil test)
        (sigil crypto)
        (sigil secp256k1)
        (sigil bitcoin encoding)
        (sigil bitcoin primitives)
        (sigil bitcoin script)
        (sigil bitcoin tx))

(define %native-secp256k1? (procedure? secp256k1-seckey-verify?))

(define %zero-txid (make-bytevector 32 0))

(define %one
  #u8(#x00 #x00 #x00 #x00 #x00 #x00 #x00 #x00
      #x00 #x00 #x00 #x00 #x00 #x00 #x00 #x00
      #x00 #x00 #x00 #x00 #x00 #x00 #x00 #x00
      #x00 #x00 #x00 #x00 #x00 #x00 #x00 #x01))

(define %ascending-txid
  #u8(#x00 #x01 #x02 #x03 #x04 #x05 #x06 #x07
      #x08 #x09 #x0a #x0b #x0c #x0d #x0e #x0f
      #x10 #x11 #x12 #x13 #x14 #x15 #x16 #x17
      #x18 #x19 #x1a #x1b #x1c #x1d #x1e #x1f))

(define %coinbase-script #u8(#x03 #x04 #x05 #x06))

(define %pubkey-hash
  #u8(#x75 #x1e #x76 #xe8 #x19 #x91 #x96 #xd4 #x54 #x94
      #x1c #x45 #xd1 #xb3 #xa3 #x23 #xf1 #x43 #x3b #xd6))

(define %generator-pub
  (hex-decode "0279be667ef9dcbbac55a06295ce870b07029bfcdb2dce28d959f2815b16f81798"))

(define %p2pkh-script (script-p2pkh %pubkey-hash))

(define %p2wpkh-script (script-p2wpkh %pubkey-hash))

(define %p2wsh-witness-script
  (script-append (script-push-data %generator-pub) (script-op op-checksig)))

(define %p2wpkh-utxo
  (txout value: 1000 script-pubkey: %p2wpkh-script))

(define %p2tr-utxo
  (txout value: 1000 script-pubkey: (script-p2tr %one)))

(define %legacy-tx
  (transaction
    version: 1
    inputs: (list
      (txin
        previous-output: (outpoint txid: %zero-txid index: #xffffffff)
        script-sig: %coinbase-script
        sequence: #xffffffff
        witness: '()))
    outputs: (list
      (txout value: 5000000000 script-pubkey: %p2pkh-script))
    lock-time: 0))

(define %legacy-serialized
  #u8(#x01 #x00 #x00 #x00
      #x01
      #x00 #x00 #x00 #x00 #x00 #x00 #x00 #x00
      #x00 #x00 #x00 #x00 #x00 #x00 #x00 #x00
      #x00 #x00 #x00 #x00 #x00 #x00 #x00 #x00
      #x00 #x00 #x00 #x00 #x00 #x00 #x00 #x00
      #xff #xff #xff #xff
      #x04 #x03 #x04 #x05 #x06
      #xff #xff #xff #xff
      #x01
      #x00 #xf2 #x05 #x2a #x01 #x00 #x00 #x00
      #x19
      #x76 #xa9 #x14 #x75 #x1e #x76 #xe8 #x19 #x91 #x96
      #xd4 #x54 #x94 #x1c #x45 #xd1 #xb3 #xa3 #x23 #xf1
      #x43 #x3b #xd6 #x88 #xac
      #x00 #x00 #x00 #x00))

(define %witness-tx
  (transaction
    version: 2
    inputs: (list
      (txin
        previous-output: (outpoint txid: %zero-txid index: 0)
        script-sig: #u8()
        sequence: #xfffffffe
        witness: (list #u8(#x30 #x01) #u8(#x02 #x79))))
    outputs: (list
      (txout value: 1000 script-pubkey: (script-p2wpkh %pubkey-hash)))
    lock-time: 0))

(define %unsigned-p2wpkh-tx
  (transaction
    version: 2
    inputs: (list
      (txin
        previous-output: (outpoint txid: %zero-txid index: 0)
        script-sig: #u8()
        sequence: #xfffffffe
        witness: '()))
    outputs: (list %p2wpkh-utxo)
    lock-time: 0))

(define %unsigned-p2pkh-tx
  (transaction
    version: 1
    inputs: (list
      (txin
        previous-output: (outpoint txid: %ascending-txid index: 0)
        script-sig: #u8()
        sequence: #xfffffffe
        witness: '()))
    outputs: (list
      (txout value: 1000 script-pubkey: %p2pkh-script))
    lock-time: 0))

(define (read-push script offset)
  (let* ((len (bytevector-u8-ref script offset))
         (start (+ offset 1))
         (end (+ start len)))
    (cons (bytevector-copy script start end) end)))

(define (bip86-tweaked-keypair private-key)
  (let* ((keypair (secp256k1-keypair-create private-key))
         (internal-xonly (secp256k1-keypair-xonly-pub keypair))
         (tweak (tagged-hash "TapTweak" internal-xonly)))
    (secp256k1-keypair-xonly-tweak-add keypair tweak)))

(define (taproot-test-leaf-hash script)
  (tagged-hash "TapLeaf"
               (bytevector-append #u8(#xc0)
                                  (compact-size-encode (bytevector-length script))
                                  script)))

(define (taproot-script-output-data internal-key script)
  (let* ((leaf-hash (taproot-test-leaf-hash script))
         (tweak (tagged-hash "TapTweak"
                             (bytevector-append internal-key leaf-hash)))
         (tweaked (secp256k1-xonly-pubkey-tweak-add internal-key tweak))
         (output-xonly (secp256k1-pubkey-xonly tweaked))
         (parity (if (= #x03 (bytevector-u8-ref tweaked 0)) 1 0))
         (control-block (bytevector-append
                          (make-bytevector 1 (+ #xc0 parity))
                          internal-key)))
    (list output-xonly control-block)))

(define (empty-test-psbt-input non-witness-utxo witness-utxo)
  (psbt-input
    non-witness-utxo: non-witness-utxo
    witness-utxo: witness-utxo
    partial-sigs: '()
    sighash-type: #f
    final-script-sig: #u8()
    final-script-witness: '()
    taproot-key-sig: #f
    taproot-script-sigs: '()
    taproot-leaf-scripts: '()
    redeem-script: #f
    witness-script: #f
    bip32-derivations: '()
    taproot-bip32-derivations: '()
    unknowns: '()))

(define (empty-test-psbt-output)
  (psbt-output
    bip32-derivations: '()
    taproot-bip32-derivations: '()
    unknowns: '()))

(define (funding-transaction script-pubkey)
  (transaction
    version: 1
    inputs: (list
      (txin
        previous-output: (outpoint txid: %zero-txid index: #xffffffff)
        script-sig: %coinbase-script
        sequence: #xffffffff
        witness: '()))
    outputs: (list
      (txout value: 1000 script-pubkey: script-pubkey))
    lock-time: 0))

(define (spending-transaction funding-tx)
  (transaction
    version: 1
    inputs: (list
      (txin
        previous-output: (outpoint txid: (transaction-txid funding-tx) index: 0)
        script-sig: #u8()
        sequence: #xfffffffe
        witness: '()))
    outputs: (list
      (txout value: 500 script-pubkey: %p2pkh-script))
    lock-time: 0))

(define %psbt-test-pubkey
  #u8(#x02 #x00 #x01 #x02 #x03 #x04 #x05 #x06 #x07
      #x08 #x09 #x0a #x0b #x0c #x0d #x0e #x0f #x10
      #x11 #x12 #x13 #x14 #x15 #x16 #x17 #x18 #x19
      #x1a #x1b #x1c #x1d #x1e #x1f))

(define %psbt-test-xonly
  #u8(#x00 #x01 #x02 #x03 #x04 #x05 #x06 #x07
      #x08 #x09 #x0a #x0b #x0c #x0d #x0e #x0f
      #x10 #x11 #x12 #x13 #x14 #x15 #x16 #x17
      #x18 #x19 #x1a #x1b #x1c #x1d #x1e #x1f))

(define %psbt-test-origin
  #u8(#xaa #xbb #xcc #xdd
      #x2c #x00 #x00 #x80
      #x00 #x00 #x00 #x00))

(define %psbt-test-taproot-origin
  #u8(#x00
      #xaa #xbb #xcc #xdd
      #x56 #x00 #x00 #x80
      #x01 #x00 #x00 #x00))

(define %witness-serialized
  #u8(#x02 #x00 #x00 #x00
      #x00 #x01
      #x01
      #x00 #x00 #x00 #x00 #x00 #x00 #x00 #x00
      #x00 #x00 #x00 #x00 #x00 #x00 #x00 #x00
      #x00 #x00 #x00 #x00 #x00 #x00 #x00 #x00
      #x00 #x00 #x00 #x00 #x00 #x00 #x00 #x00
      #x00 #x00 #x00 #x00
      #x00
      #xfe #xff #xff #xff
      #x01
      #xe8 #x03 #x00 #x00 #x00 #x00 #x00 #x00
      #x16
      #x00 #x14 #x75 #x1e #x76 #xe8 #x19 #x91 #x96 #xd4
      #x54 #x94 #x1c #x45 #xd1 #xb3 #xa3 #x23 #xf1 #x43
      #x3b #xd6
      #x02
      #x02 #x30 #x01
      #x02 #x02 #x79
      #x00 #x00 #x00 #x00))

(define %witness-base-serialized
  #u8(#x02 #x00 #x00 #x00
      #x01
      #x00 #x00 #x00 #x00 #x00 #x00 #x00 #x00
      #x00 #x00 #x00 #x00 #x00 #x00 #x00 #x00
      #x00 #x00 #x00 #x00 #x00 #x00 #x00 #x00
      #x00 #x00 #x00 #x00 #x00 #x00 #x00 #x00
      #x00 #x00 #x00 #x00
      #x00
      #xfe #xff #xff #xff
      #x01
      #xe8 #x03 #x00 #x00 #x00 #x00 #x00 #x00
      #x16
      #x00 #x14 #x75 #x1e #x76 #xe8 #x19 #x91 #x96 #xd4
      #x54 #x94 #x1c #x45 #xd1 #xb3 #xa3 #x23 #xf1 #x43
      #x3b #xd6
      #x00 #x00 #x00 #x00))

(define %nonzero-prevout-tx
  (transaction
    version: 1
    inputs: (list
      (txin
        previous-output: (outpoint txid: %ascending-txid index: #x01020304)
        script-sig: #u8()
        sequence: 0
        witness: '()))
    outputs: '()
    lock-time: 0))

(define %nonzero-prevout-serialized
  #u8(#x01 #x00 #x00 #x00
      #x01
      #x1f #x1e #x1d #x1c #x1b #x1a #x19 #x18
      #x17 #x16 #x15 #x14 #x13 #x12 #x11 #x10
      #x0f #x0e #x0d #x0c #x0b #x0a #x09 #x08
      #x07 #x06 #x05 #x04 #x03 #x02 #x01 #x00
      #x04 #x03 #x02 #x01
      #x00
      #x00 #x00 #x00 #x00
      #x00
      #x00 #x00 #x00 #x00))

;; Selected Bitcoin Core `tx_valid.json` raw transaction fixtures.
(define %bitcoin-core-rawtx-fixtures
  (list
    (list
      "tx_valid multisig standard form"
      "")
    (list
      "tx_valid multisig extra dummy byte"
      "")))

(test-group "compactSize"
  (test "single byte range"
    (assert-equal #u8(#xfc) (compact-size-encode #xfc))
    (assert-equal #xfc (compact-size-decode #u8(#xfc))))

  (test "u16 range"
    (assert-equal #u8(#xfd #xfd #x00) (compact-size-encode #xfd))
    (assert-equal #xfd (compact-size-decode #u8(#xfd #xfd #x00)))
    (assert-equal #u8(#xfd #xff #xff) (compact-size-encode #xffff))
    (assert-equal #xffff (compact-size-decode #u8(#xfd #xff #xff))))

  (test "u32 and u64 ranges"
    (assert-equal #u8(#xfe #x00 #x00 #x01 #x00) (compact-size-encode #x10000))
    (assert-equal #x10000 (compact-size-decode #u8(#xfe #x00 #x00 #x01 #x00)))
    (assert-equal #u8(#xff #x00 #x00 #x00 #x00 #x01 #x00 #x00 #x00)
                  (compact-size-encode #x100000000))
    (assert-equal #x100000000
                  (compact-size-decode
                    #u8(#xff #x00 #x00 #x00 #x00 #x01 #x00 #x00 #x00)))))

(test-group "legacy transaction serialization"
  (test "serializes without witness marker"
    (assert-equal %legacy-serialized (transaction-serialize %legacy-tx)))

  (test "base serialization matches default for no-witness transaction"
    (assert-equal (transaction-serialize %legacy-tx)
                  (transaction-base-serialize %legacy-tx)))

  (test "parses and reserializes"
    (let ((parsed (transaction-parse %legacy-serialized)))
      (assert-equal %legacy-serialized (transaction-serialize parsed))
      (assert-equal 1 (transaction-version parsed))
      (assert-equal 1 (length (transaction-inputs parsed)))
      (assert-equal 1 (length (transaction-outputs parsed)))))

  (test "txid and wtxid match for no-witness transaction"
    (assert-equal (transaction-txid %legacy-tx)
                  (transaction-wtxid %legacy-tx))))

(test-group "little-endian wire order"
  (test "serializes previous txid and index in wire order"
    (assert-equal %nonzero-prevout-serialized
                  (transaction-serialize %nonzero-prevout-tx)))

  (test "transaction IDs are 32-byte hashes"
    (assert-equal 32 (bytevector-length (transaction-txid %legacy-tx)))
    (assert-equal 32 (bytevector-length (transaction-wtxid %witness-tx)))))

(test-group "segwit transaction serialization"
  (test "serializes with BIP144 marker and witness stack"
    (assert-equal %witness-serialized (transaction-serialize %witness-tx)))

  (test "base serialization excludes marker, flag, and witnesses"
    (assert-equal %witness-base-serialized
                  (transaction-base-serialize %witness-tx)))

  (test "parses and reserializes with witness stack"
    (let* ((parsed (transaction-parse %witness-serialized))
           (input (car (transaction-inputs parsed))))
      (assert-equal %witness-serialized (transaction-serialize parsed))
      (assert-true (transaction-has-witness? parsed))
      (assert-equal 2 (length (txin-witness input)))
      (assert-equal #u8(#x30 #x01) (car (txin-witness input)))))

  (test "txid and wtxid differ when witness is present"
    (assert-false (equal? (transaction-txid %witness-tx)
                          (transaction-wtxid %witness-tx)))))

(test-group "transaction metrics"
  (test "reports stripped and total serialized sizes"
    (assert-equal (bytevector-length %legacy-serialized)
                  (transaction-stripped-size %legacy-tx))
    (assert-equal (bytevector-length %legacy-serialized)
                  (transaction-total-size %legacy-tx))
    (assert-equal (bytevector-length %witness-base-serialized)
                  (transaction-stripped-size %witness-tx))
    (assert-equal (bytevector-length %witness-serialized)
                  (transaction-total-size %witness-tx)))

  (test "computes weight and virtual size"
    (assert-equal (* 4 (bytevector-length %legacy-serialized))
                  (transaction-weight %legacy-tx))
    (assert-equal (bytevector-length %legacy-serialized)
                  (transaction-vsize %legacy-tx))
    (assert-equal 337 (transaction-weight %witness-tx))
    (assert-equal 85 (transaction-vsize %witness-tx)))

  (test "sums output value and computes fees"
    (assert-equal 1000 (transaction-output-value %witness-tx))
    (assert-equal 500
                  (transaction-fee
                    %witness-tx
                    (list (txout value: 1500 script-pubkey: %p2wpkh-script)))))

  (test "fee calculation rejects prevout count mismatch"
    (assert-error
      (transaction-fee %witness-tx '())))

  (test "fee calculation rejects negative fees"
    (assert-error
      (transaction-fee
        %witness-tx
        (list (txout value: 999 script-pubkey: %p2wpkh-script))))))

(test-group "Bitcoin Core rawtx fixtures"
  (test "round-trips tx_valid raw transactions"
    (do ((xs %bitcoin-core-rawtx-fixtures (cdr xs)))
        ((null? xs))
      (let* ((fixture (car xs))
             (raw (hex-decode (cadr fixture)))
             (parsed (transaction-parse raw)))
        (assert-equal raw (transaction-serialize parsed))
        (assert-equal raw (transaction-base-serialize parsed))
        (assert-false (transaction-has-witness? parsed))))))

(test-group "sighash"
  (test "legacy SIGHASH_ALL returns 32-byte digest"
    (let ((digest (transaction-sighash-legacy
                    %legacy-tx 0 %coinbase-script sighash-all)))
      (assert-equal 32 (bytevector-length digest))))

  (test "segwit v0 SIGHASH_ALL returns 32-byte digest"
    (let ((digest (transaction-sighash-segwit-v0
                    %witness-tx 0 %p2pkh-script 1000 sighash-all)))
      (assert-equal 32 (bytevector-length digest))))

  (test "segwit v0 sighash commits to amount"
    (assert-false
      (equal?
        (transaction-sighash-segwit-v0 %witness-tx 0 %p2pkh-script 1000)
        (transaction-sighash-segwit-v0 %witness-tx 0 %p2pkh-script 1001)))))

(test-group "taproot sighash"

  (test "taproot key-path SIGHASH_DEFAULT returns 32-byte digest"
    (let ((digest (transaction-sighash-taproot-keypath
                    %witness-tx 0 (list %p2tr-utxo) sighash-default)))
      (assert-equal 32 (bytevector-length digest))))

  (test "taproot script-path SIGHASH_DEFAULT returns 32-byte digest"
    (let ((digest (transaction-sighash-taproot-scriptpath
                    %witness-tx 0 (list %p2tr-utxo) #u8(#x51) #xc0 sighash-default)))
      (assert-equal 32 (bytevector-length digest))))

  (test "taproot key-path SIGHASH_DEFAULT and ALL encode different hash types"
    (assert-false
      (equal?
        (transaction-sighash-taproot-keypath %witness-tx 0 (list %p2tr-utxo) sighash-default)
        (transaction-sighash-taproot-keypath %witness-tx 0 (list %p2tr-utxo) sighash-all))))

  (test "taproot script-path commits to leaf script and version"
    (let ((base (transaction-sighash-taproot-scriptpath
                  %witness-tx 0 (list %p2tr-utxo) #u8(#x51) #xc0)))
      (assert-false
        (equal?
          base
          (transaction-sighash-taproot-scriptpath
            %witness-tx 0 (list %p2tr-utxo) #u8(#x52) #xc0)))
      (assert-false
        (equal?
          base
          (transaction-sighash-taproot-scriptpath
            %witness-tx 0 (list %p2tr-utxo) #u8(#x51) #xc2)))))

  (test "taproot key-path sighash commits to prevout amount and script"
    (let* ((base (transaction-sighash-taproot-keypath
                   %witness-tx 0 (list %p2tr-utxo)))
           (different-amount
             (txout value: 1001 script-pubkey: (txout-script-pubkey %p2tr-utxo)))
           (different-script
             (txout value: 1000 script-pubkey: (script-p2tr (make-bytevector 32 0)))))
      (assert-false
        (equal?
          base
          (transaction-sighash-taproot-keypath %witness-tx 0 (list different-amount))))
      (assert-false
        (equal?
          base
          (transaction-sighash-taproot-keypath %witness-tx 0 (list different-script))))))

  (test "taproot key-path sighash rejects prevout count mismatch"
    (assert-error
      (transaction-sighash-taproot-keypath %witness-tx 0 '())))

  (test "taproot key-path sighash rejects unsupported hash type"
    (assert-error
      (transaction-sighash-taproot-keypath %witness-tx 0 (list %p2tr-utxo) #x02)))

  (test "taproot script-path sighash rejects unsupported hash type"
    (assert-error
      (transaction-sighash-taproot-scriptpath
        %witness-tx 0 (list %p2tr-utxo) #u8(#x51) #xc0 #x02))))

(if %native-secp256k1?
  (test-group "input signing"
    (test "P2PKH adds a DER signature and pubkey scriptSig"
      (let* ((signed (transaction-sign-p2pkh-input %unsigned-p2pkh-tx 0 %one))
             (input (car (transaction-inputs signed)))
             (script-sig (txin-script-sig input))
             (sig-result (read-push script-sig 0))
             (sig+type (car sig-result))
             (pubkey-result (read-push script-sig (cdr sig-result)))
             (pubkey (car pubkey-result))
             (sig (bytevector-copy sig+type 0 (- (bytevector-length sig+type) 1)))
             (script-code (script-p2pkh (hash160 pubkey)))
             (msghash (transaction-sighash-legacy
                        %unsigned-p2pkh-tx 0 script-code)))
        (assert-equal '() (txin-witness input))
        (assert-equal (bytevector-length script-sig) (cdr pubkey-result))
        (assert-equal sighash-all
                      (bytevector-u8-ref sig+type (- (bytevector-length sig+type) 1)))
        (assert-true
          (secp256k1-ecdsa-verify
            (secp256k1-ecdsa-signature-parse-der sig)
            msghash
            pubkey))))

    (test "adds a DER signature and pubkey witness"
      (let* ((signed (transaction-sign-p2wpkh-input %witness-tx 0 1000 %one))
             (input (car (transaction-inputs signed)))
             (witness (txin-witness input))
             (sig+type (car witness))
             (sig (bytevector-copy sig+type 0 (- (bytevector-length sig+type) 1)))
             (pubkey (cadr witness))
             (script-code (script-p2pkh %pubkey-hash))
             (msghash (transaction-sighash-segwit-v0
                        %witness-tx 0 script-code 1000)))
        (assert-equal 2 (length witness))
        (assert-equal sighash-all
                      (bytevector-u8-ref sig+type (- (bytevector-length sig+type) 1)))
        (assert-true
          (secp256k1-ecdsa-verify
            (secp256k1-ecdsa-signature-parse-der sig)
            msghash
            pubkey))))

    (test "P2TR key-path adds a 64-byte Schnorr signature witness"
      (let* ((tweaked (bip86-tweaked-keypair %one))
             (xonly (secp256k1-keypair-xonly-pub tweaked))
             (prevout (txout value: 1000 script-pubkey: (script-p2tr xonly)))
             (signed (transaction-sign-p2tr-keypath-input
                       %witness-tx 0 (list prevout) %one))
             (input (car (transaction-inputs signed)))
             (witness (txin-witness input))
             (sig (car witness))
             (msghash (transaction-sighash-taproot-keypath
                        %witness-tx 0 (list prevout))))
        (assert-equal #u8() (txin-script-sig input))
        (assert-equal 1 (length witness))
        (assert-equal 64 (bytevector-length sig))
        (assert-true (secp256k1-schnorrsig-verify sig msghash xonly))))

    (test "P2TR key-path appends non-default sighash type"
      (let* ((tweaked (bip86-tweaked-keypair %one))
             (xonly (secp256k1-keypair-xonly-pub tweaked))
             (prevout (txout value: 1000 script-pubkey: (script-p2tr xonly)))
             (signed (transaction-sign-p2tr-keypath-input
                       %witness-tx 0 (list prevout) %one sighash-all))
             (sig+type (car (txin-witness (car (transaction-inputs signed)))))
             (sig (bytevector-copy sig+type 0 64))
             (msghash (transaction-sighash-taproot-keypath
                        %witness-tx 0 (list prevout) sighash-all)))
        (assert-equal 65 (bytevector-length sig+type))
        (assert-equal sighash-all (bytevector-u8-ref sig+type 64))
        (assert-true (secp256k1-schnorrsig-verify sig msghash xonly))))

    (test "P2TR key-path rejects the wrong prevout script"
      (assert-error
        (transaction-sign-p2tr-keypath-input
          %witness-tx 0 (list %p2tr-utxo) %one))))
  (test-group "input signing"
    (test-skip "native secp256k1 module is not linked in direct workspace runner"
      #t)))

(test-group "PSBT"
  (test "creates empty input and output maps from unsigned tx"
    (let ((p (psbt-create %unsigned-p2wpkh-tx)))
      (assert-equal 1 (length (psbt-inputs p)))
      (assert-equal 1 (length (psbt-outputs p)))))

  (test "serializes and parses unsigned transaction"
    (let* ((p (psbt-create %unsigned-p2wpkh-tx))
           (parsed (psbt-parse (psbt-serialize p))))
      (assert-equal (transaction-base-serialize %unsigned-p2wpkh-tx)
                    (transaction-base-serialize (psbt-unsigned-tx parsed)))))

  (test "round-trips witness UTXO input data"
    (let* ((p (psbt
                unsigned-tx: %unsigned-p2wpkh-tx
                inputs: (list
                  (empty-test-psbt-input #f %p2wpkh-utxo))
                outputs: (list (empty-test-psbt-output))
                unknowns: '()))
           (parsed (psbt-parse (psbt-serialize p)))
           (input (car (psbt-inputs parsed))))
      (assert-equal 1000 (txout-value (psbt-input-witness-utxo input)))
      (assert-equal %p2wpkh-script
                    (txout-script-pubkey (psbt-input-witness-utxo input)))))

  (test "round-trips non-witness UTXO input data"
    (let* ((p (psbt
                unsigned-tx: %unsigned-p2pkh-tx
                inputs: (list
                  (empty-test-psbt-input %legacy-tx #f))
                outputs: (list (empty-test-psbt-output))
                unknowns: '()))
           (parsed (psbt-parse (psbt-serialize p)))
           (input (car (psbt-inputs parsed))))
      (assert-equal (transaction-txid %legacy-tx)
                    (transaction-txid (psbt-input-non-witness-utxo input)))))

  (test "round-trips derivation and unknown records"
    (let* ((global-unknowns (list (cons #u8(#xfb) #u8(#x01 #x02))))
           (input-unknowns (list (cons #u8(#xfc #x01 #x99) #u8(#xaa))))
           (output-unknowns (list (cons #u8(#xfc #x02 #x77) #u8(#xbb #xcc))))
           (taproot-script-sig-key (bytevector-append %psbt-test-xonly %psbt-test-xonly))
           (taproot-script-sig (bytevector-append %psbt-test-xonly %psbt-test-xonly))
           (taproot-leaf-script
             (psbt-taproot-leaf-script
               control-block: (bytevector-append #u8(#xc0) %psbt-test-xonly)
               script: #u8(#x51)
               leaf-version: #xc0))
           (input
             (psbt-input
               non-witness-utxo: #f
               witness-utxo: %p2wpkh-utxo
               partial-sigs: '()
               sighash-type: #f
               final-script-sig: #u8()
               final-script-witness: '()
               taproot-key-sig: #f
               taproot-script-sigs: (list (cons taproot-script-sig-key taproot-script-sig))
               taproot-leaf-scripts: (list taproot-leaf-script)
               redeem-script: #f
               witness-script: %p2wsh-witness-script
               bip32-derivations: (list (cons %psbt-test-pubkey %psbt-test-origin))
               taproot-bip32-derivations: (list (cons %psbt-test-xonly
                                                       %psbt-test-taproot-origin))
               unknowns: input-unknowns))
           (output (psbt-output
                     bip32-derivations: (list (cons %psbt-test-pubkey
                                                    %psbt-test-origin))
                     taproot-bip32-derivations: (list (cons %psbt-test-xonly
                                                            %psbt-test-taproot-origin))
                     unknowns: output-unknowns))
           (p (psbt
                unsigned-tx: %unsigned-p2wpkh-tx
                inputs: (list input)
                outputs: (list output)
                unknowns: global-unknowns))
           (parsed (psbt-parse (psbt-serialize p)))
           (parsed-input (car (psbt-inputs parsed)))
           (parsed-output (car (psbt-outputs parsed))))
      (assert-equal global-unknowns (psbt-unknowns parsed))
      (assert-equal input-unknowns (psbt-input-unknowns parsed-input))
      (assert-equal output-unknowns (psbt-output-unknowns parsed-output))
      (assert-equal (list (cons %psbt-test-pubkey %psbt-test-origin))
                    (psbt-input-bip32-derivations parsed-input))
      (assert-equal (list (cons %psbt-test-xonly %psbt-test-taproot-origin))
                    (psbt-input-taproot-bip32-derivations parsed-input))
      (assert-equal (list (cons taproot-script-sig-key taproot-script-sig))
                    (psbt-input-taproot-script-sigs parsed-input))
      (let ((parsed-leaf-script (car (psbt-input-taproot-leaf-scripts parsed-input))))
        (assert-equal (psbt-taproot-leaf-script-control-block taproot-leaf-script)
                      (psbt-taproot-leaf-script-control-block parsed-leaf-script))
        (assert-equal (psbt-taproot-leaf-script-script taproot-leaf-script)
                      (psbt-taproot-leaf-script-script parsed-leaf-script))
        (assert-equal (psbt-taproot-leaf-script-leaf-version taproot-leaf-script)
                      (psbt-taproot-leaf-script-leaf-version parsed-leaf-script)))
      (assert-equal %p2wsh-witness-script
                    (psbt-input-witness-script parsed-input))
      (assert-equal (list (cons %psbt-test-pubkey %psbt-test-origin))
                    (psbt-output-bip32-derivations parsed-output))
      (assert-equal (list (cons %psbt-test-xonly %psbt-test-taproot-origin))
                    (psbt-output-taproot-bip32-derivations parsed-output))))

  (test "annotates PSBT inputs and outputs with derivation records"
    (let* ((p (psbt
                unsigned-tx: %unsigned-p2wpkh-tx
                inputs: (list
                  (empty-test-psbt-input #f %p2wpkh-utxo))
                outputs: (list (empty-test-psbt-output))
                unknowns: '()))
           (annotated-input (psbt-annotate-input
                              p
                              0
                              %p2wpkh-script
                              (list (cons %psbt-test-pubkey %psbt-test-origin))
                              '()))
           (annotated-output (psbt-annotate-output
                               annotated-input
                               0
                               %p2wpkh-script
                               (list (cons %psbt-test-pubkey %psbt-test-origin))
                               '()))
           (input (car (psbt-inputs annotated-output)))
           (output (car (psbt-outputs annotated-output))))
      (assert-equal (list (cons %psbt-test-pubkey %psbt-test-origin))
                    (psbt-input-bip32-derivations input))
      (assert-equal (list (cons %psbt-test-pubkey %psbt-test-origin))
                    (psbt-output-bip32-derivations output))
      (assert-error
        (psbt-annotate-input p 0 %p2pkh-script '() '())))))

(if %native-secp256k1?
  (test-group "PSBT signing"
    (test "signs, finalizes, and extracts P2WPKH transaction"
      (let* ((p (psbt
                  unsigned-tx: %unsigned-p2wpkh-tx
                  inputs: (list
                    (empty-test-psbt-input #f %p2wpkh-utxo))
                  outputs: (list (empty-test-psbt-output))
                  unknowns: '()))
             (signed (psbt-sign-standard-input p 0 %one))
             (signed-input (car (psbt-inputs signed)))
             (parsed (psbt-parse (psbt-serialize signed)))
             (finalized (psbt-finalize-standard-input parsed 0))
             (extracted (psbt-extract-transaction finalized))
             (witness (txin-witness (car (transaction-inputs extracted)))))
        (assert-equal 1 (length (psbt-input-partial-sigs signed-input)))
        (assert-equal 2 (length witness))
        (assert-true (transaction-has-witness? extracted))))

    (test "signs, finalizes, and extracts P2WSH single-key transaction"
      (let* ((prevout (txout value: 1000
                             script-pubkey: (script-p2wsh
                                              (sha256-bytes %p2wsh-witness-script))))
             (p (psbt
                  unsigned-tx: %witness-tx
                  inputs: (list
                    (empty-test-psbt-input #f prevout))
                  outputs: (list (empty-test-psbt-output))
                  unknowns: '()))
             (with-script (psbt-annotate-input-scripts p 0 #f %p2wsh-witness-script))
             (signed (psbt-sign-standard-input with-script 0 %one))
             (parsed (psbt-parse (psbt-serialize signed)))
             (finalized (psbt-finalize-standard-input parsed 0))
             (extracted (psbt-extract-transaction finalized))
             (witness (txin-witness (car (transaction-inputs extracted)))))
        (assert-equal 2 (length witness))
        (assert-equal %p2wsh-witness-script (cadr witness))
        (assert-true (transaction-has-witness? extracted))))

    (test "signs, finalizes, and extracts P2PKH transaction"
      (let* ((pubkey (secp256k1-pubkey-create %one))
             (script (script-p2pkh (hash160 pubkey)))
             (funding (funding-transaction script))
             (unsigned (spending-transaction funding))
             (p (psbt
                  unsigned-tx: unsigned
                  inputs: (list
                    (empty-test-psbt-input funding #f))
                  outputs: (list (empty-test-psbt-output))
                  unknowns: '()))
             (signed (psbt-sign-p2pkh-input p 0 %one))
             (parsed (psbt-parse (psbt-serialize signed)))
             (finalized (psbt-finalize-p2pkh-input parsed 0))
             (extracted (psbt-extract-transaction finalized))
             (input (car (transaction-inputs extracted)))
             (script-sig (txin-script-sig input))
             (sig-result (read-push script-sig 0))
             (pubkey-result (read-push script-sig (cdr sig-result))))
        (assert-equal '() (txin-witness input))
        (assert-equal (bytevector-length script-sig) (cdr pubkey-result))
        (assert-false (transaction-has-witness? extracted))))

    (test "signs, finalizes, and extracts P2TR key-path transaction"
      (let* ((tweaked (bip86-tweaked-keypair %one))
             (xonly (secp256k1-keypair-xonly-pub tweaked))
             (prevout (txout value: 1000 script-pubkey: (script-p2tr xonly)))
             (p (psbt
                  unsigned-tx: %witness-tx
                  inputs: (list
                    (empty-test-psbt-input #f prevout))
                  outputs: (list (empty-test-psbt-output))
                  unknowns: '()))
             (signed (psbt-sign-p2tr-keypath-input p 0 %one))
             (signed-input (car (psbt-inputs signed)))
             (parsed (psbt-parse (psbt-serialize signed)))
             (finalized (psbt-finalize-p2tr-keypath-input parsed 0))
             (extracted (psbt-extract-transaction finalized))
             (witness (txin-witness (car (transaction-inputs extracted)))))
	        (assert-equal 64 (bytevector-length (psbt-input-taproot-key-sig signed-input)))
	        (assert-equal 1 (length witness))
	        (assert-true (transaction-has-witness? extracted))))

    (test "signs, finalizes, and extracts P2TR script-path transaction"
      (let* ((keypair (secp256k1-keypair-create %one))
             (xonly (secp256k1-keypair-xonly-pub keypair))
             (script (script-append (script-push-data xonly)
                                    (script-op op-checksig)))
             (output-data (taproot-script-output-data xonly script))
             (output-xonly (car output-data))
             (control-block (cadr output-data))
             (prevout (txout value: 1000 script-pubkey: (script-p2tr output-xonly)))
             (leaf-script (psbt-taproot-leaf-script
                            control-block: control-block
                            script: script
                            leaf-version: #xc0))
             (p (psbt
                  unsigned-tx: %witness-tx
                  inputs: (list
                    (psbt-input
                      non-witness-utxo: #f
                      witness-utxo: prevout
                      partial-sigs: '()
                      sighash-type: #f
                      final-script-sig: #u8()
                      final-script-witness: '()
                      taproot-key-sig: #f
                      taproot-script-sigs: '()
                      taproot-leaf-scripts: (list leaf-script)
                      redeem-script: #f
                      witness-script: #f
                      bip32-derivations: '()
                      taproot-bip32-derivations: '()
                      unknowns: '()))
                  outputs: (list (empty-test-psbt-output))
                  unknowns: '()))
             (signed (psbt-sign-p2tr-scriptpath-input p 0 %one))
             (signed-input (car (psbt-inputs signed)))
             (parsed (psbt-parse (psbt-serialize signed)))
             (finalized (psbt-finalize-p2tr-scriptpath-input parsed 0))
             (extracted (psbt-extract-transaction finalized))
             (witness (txin-witness (car (transaction-inputs extracted))))
             (sig (car witness))
             (msghash (transaction-sighash-taproot-scriptpath
                        %witness-tx 0 (list prevout) script #xc0)))
        (assert-equal 1 (length (psbt-input-taproot-script-sigs signed-input)))
        (assert-equal 3 (length witness))
        (assert-true (secp256k1-schnorrsig-verify sig msghash xonly))
        (assert-equal script (cadr witness))
        (assert-equal control-block (caddr witness))
        (assert-true (transaction-has-witness? extracted)))))
  (test-group "PSBT signing"
    (test-skip "native secp256k1 module is not linked in direct workspace runner"
      #t)))

(test-group "transaction validation"
  (test "rejects malformed compactSize"
    (assert-error (compact-size-encode -1))
    (assert-error (compact-size-decode #u8(#xfd #xfc #x00)))
    (assert-error (compact-size-decode #u8(#xfd #xfd))))

  (test "rejects truncated or trailing transactions"
    (assert-error (transaction-parse #u8(#x01 #x00 #x00)))
    (assert-error
      (transaction-parse (bytevector-append %legacy-serialized #u8(#x00)))))

  (test "rejects invalid outpoint txid length"
    (assert-error
      (transaction-serialize
        (transaction
          version: 1
          inputs: (list
            (txin
              previous-output: (outpoint txid: (make-bytevector 31 0) index: 0)
              script-sig: #u8()
              sequence: #xffffffff
              witness: '()))
          outputs: '()
          lock-time: 0))))

  (test "rejects output values outside u64"
    (assert-error
      (transaction-serialize
        (transaction
          version: 1
          inputs: '()
          outputs: (list (txout value: -1 script-pubkey: #u8()))
          lock-time: 0)))))

(run-tests)
