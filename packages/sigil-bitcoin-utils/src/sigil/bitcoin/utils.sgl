;;; (sigil bitcoin utils) — Shared internal helpers for Bitcoin packages

(define-library (sigil bitcoin utils)
  (import (sigil math))
  (export
    require-bytevector
    require-bytevector-length
    require-uint
    ensure-available
    read-byte
    read-u16-le
    read-u32-le
    read-u64-le
    u16-le
    u32-le
    u64-le
    reverse-bytevector
    byte-list->bytevector
    bytes-prefix?
    bytes-suffix?
    hex-encode-bytes
    join-strings)
  (begin

    ;;; Require a bytevector value.
    (define (require-bytevector who bytes)
      (: string? any? -> bytevector?)
      (unless (bytevector? bytes)
        (error (string-append who ": expected bytevector")))
      bytes)

    ;;; Require a bytevector with an exact length.
    (define (require-bytevector-length who bytes len)
      (: string? any? integer? -> bytevector?)
      (require-bytevector who bytes)
      (unless (= len (bytevector-length bytes))
        (error (string-append who ": expected "
                              (number->string len)
                              "-byte bytevector")))
      bytes)

    ;;; Require an unsigned integer no larger than `max`.
    (define (require-uint who value max)
      (: string? any? integer? -> integer?)
      (unless (and (integer? value) (<= 0 value max))
        (error (string-append who ": unsigned integer out of range")))
      value)

    ;;; Require `count` bytes to be available at `offset`.
    (define (ensure-available who bytes offset count)
      (: string? bytevector? integer? integer? -> void?)
      (require-bytevector who bytes)
      (when (or (< offset 0)
                (< count 0)
                (> (+ offset count) (bytevector-length bytes)))
        (error (string-append who ": truncated input"))))

    ;;; Read one byte from a bytevector.
    (define (read-byte bytes offset who)
      (: bytevector? integer? string? -> integer?)
      (ensure-available who bytes offset 1)
      (bytevector-u8-ref bytes offset))

    ;;; Encode a uint16 as little-endian bytes.
    (define (u16-le n)
      (: integer? -> bytevector?)
      (require-uint "u16-le" n #xffff)
      (let ((out (make-bytevector 2 0)))
        (bytevector-u8-set! out 0 (bitwise-and n #xff))
        (bytevector-u8-set! out 1 (bitwise-and (arithmetic-shift n -8) #xff))
        out))

    ;;; Encode a uint32 as little-endian bytes.
    (define (u32-le n)
      (: integer? -> bytevector?)
      (require-uint "u32-le" n #xffffffff)
      (let ((out (make-bytevector 4 0)))
        (bytevector-u8-set! out 0 (bitwise-and n #xff))
        (bytevector-u8-set! out 1 (bitwise-and (arithmetic-shift n -8) #xff))
        (bytevector-u8-set! out 2 (bitwise-and (arithmetic-shift n -16) #xff))
        (bytevector-u8-set! out 3 (bitwise-and (arithmetic-shift n -24) #xff))
        out))

    ;;; Encode a uint64 as little-endian bytes.
    (define (u64-le n)
      (: integer? -> bytevector?)
      (require-uint "u64-le" n #xffffffffffffffff)
      (let ((out (make-bytevector 8 0)))
        (do ((i 0 (+ i 1))
             (v n (quotient v 256)))
            ((>= i 8) out)
          (bytevector-u8-set! out i (remainder v 256)))))

    ;;; Read a little-endian uint16.
    (define (read-u16-le bytes offset who)
      (: bytevector? integer? string? -> integer?)
      (ensure-available who bytes offset 2)
      (+ (bytevector-u8-ref bytes offset)
         (arithmetic-shift (bytevector-u8-ref bytes (+ offset 1)) 8)))

    ;;; Read a little-endian uint32.
    (define (read-u32-le bytes offset who)
      (: bytevector? integer? string? -> integer?)
      (ensure-available who bytes offset 4)
      (+ (bytevector-u8-ref bytes offset)
         (arithmetic-shift (bytevector-u8-ref bytes (+ offset 1)) 8)
         (arithmetic-shift (bytevector-u8-ref bytes (+ offset 2)) 16)
         (arithmetic-shift (bytevector-u8-ref bytes (+ offset 3)) 24)))

    ;;; Read a little-endian uint64.
    (define (read-u64-le bytes offset who)
      (: bytevector? integer? string? -> integer?)
      (ensure-available who bytes offset 8)
      (let ((n 0))
        (do ((i 7 (- i 1)))
            ((< i 0) n)
          (set! n (+ (arithmetic-shift n 8)
                     (bytevector-u8-ref bytes (+ offset i)))))))

    ;;; Return a reversed copy of a bytevector.
    (define (reverse-bytevector bytes)
      (: bytevector? -> bytevector?)
      (require-bytevector "reverse-bytevector" bytes)
      (let* ((len (bytevector-length bytes))
             (out (make-bytevector len 0)))
        (do ((i 0 (+ i 1)))
            ((>= i len) out)
          (bytevector-u8-set! out i (bytevector-u8-ref bytes (- len 1 i))))))

    ;;; Convert a list of byte values to a bytevector.
    (define (byte-list->bytevector bytes)
      (: list? -> bytevector?)
      (let* ((len (length bytes))
             (out (make-bytevector len 0)))
        (let loop ((xs bytes) (i 0))
          (if (null? xs)
              out
              (begin
                (bytevector-u8-set! out i (require-uint "byte-list->bytevector" (car xs) #xff))
                (loop (cdr xs) (+ i 1)))))))

    ;;; Return true when `bytes` starts with `prefix`.
    (define (bytes-prefix? bytes prefix)
      (: bytevector? bytevector? -> boolean?)
      (and (>= (bytevector-length bytes) (bytevector-length prefix))
           (let loop ((i 0))
             (if (>= i (bytevector-length prefix))
                 #t
                 (and (= (bytevector-u8-ref bytes i)
                         (bytevector-u8-ref prefix i))
                      (loop (+ i 1)))))))

    ;;; Return true when `bytes` ends with `suffix`.
    (define (bytes-suffix? bytes suffix)
      (: bytevector? bytevector? -> boolean?)
      (let ((blen (bytevector-length bytes))
            (slen (bytevector-length suffix)))
        (and (>= blen slen)
             (let loop ((i 0))
               (if (>= i slen)
                   #t
                   (and (= (bytevector-u8-ref bytes (+ (- blen slen) i))
                           (bytevector-u8-ref suffix i))
                        (loop (+ i 1))))))))

    ;;; Encode a bytevector as lowercase hexadecimal text.
    (define (hex-encode-bytes bytes)
      (: bytevector? -> string?)
      (let* ((len (bytevector-length bytes))
             (hex "0123456789abcdef")
             (out (make-string (* 2 len))))
        (do ((i 0 (+ i 1)))
            ((>= i len) out)
          (let* ((b (bytevector-u8-ref bytes i))
                 (hi (arithmetic-shift b -4))
                 (lo (bitwise-and b #x0f)))
            (string-set! out (* 2 i) (string-ref hex hi))
            (string-set! out (+ 1 (* 2 i)) (string-ref hex lo))))))

    ;;; Join strings with a separator.
    (define (join-strings strings sep)
      (: list? string? -> string?)
      (cond ((null? strings) "")
            ((null? (cdr strings)) (car strings))
            (else
             (let loop ((xs (cdr strings))
                        (out (car strings)))
               (if (null? xs)
                   out
                   (loop (cdr xs) (string-append out sep (car xs))))))))))
