;; Development redirects — point workspace deps at local checkouts.
;; Use: sigil build --redirects ./dev-redirects.sgl
;;      sigil test --redirects ./dev-redirects.sgl
(import (sigil fs))

(define (first-existing paths)
  (cond ((null? paths) #f)
        ((directory? (car paths)) (car paths))
        (else (first-existing (cdr paths)))))

(define (workspace-dep name)
  (or (first-existing
        (list
          (string-append ".sigil/deps/" name)
          (string-append "../../.sigil/deps/" name)
          (string-append "../../../.sigil/deps/" name)))
      (error "dev-redirects: missing workspace dependency" name)))

(define (dep name)
  (for-package
    name: name
    use: (from-path dir: (workspace-dep name))))

(redirects
  packages: (list
    (dep "sigil-lib")
    (dep "sigil-stdlib")
    (dep "sigil-test")
    (dep "sigil-test-runner")
    (for-package
      name: "sigil-ansi"
      use: (from-path dir: (workspace-dep "sigil-ansi-v0.16")))
    (for-package
      name: "sigil-json"
      use: (from-path dir: (workspace-dep "sigil-json-v0.16")))
    (for-package
      name: "sigil-version"
      use: (from-path dir: (workspace-dep "sigil-version-v0.16")))))
