(import (sigil core)
        (sigil socket)
        (sigil bitcoin node)
        (sigil bitcoin p2p))

(define data-dir "/tmp/sigil-bitcoin-live-probe")

(define (connect-live-peer peer)
  (let ((sock (p2p-socket-connect-timeout
                (node-peer-address peer)
                (node-peer-port peer)
                5000)))
    (list
      (lambda () (p2p-socket-read-envelope-timeout sock 5000))
      (lambda (envelope)
        (p2p-socket-write-envelope sock envelope))
      (lambda () (socket-close sock)))))

(define (print-probe-status label status)
  (println "~a chain=~a peers=~a headers=~a best-height=~a best-header-time=~a header-sync-lag=~a blocks=~a validated=~a stage=~a failed-stage=~a sync-error=~a last-peer-error=~a"
           label
           (node-status-snapshot-chain status)
           (node-status-snapshot-peer-count status)
           (node-status-snapshot-header-count status)
           (node-status-snapshot-best-height status)
           (node-status-snapshot-best-header-time status)
           (node-status-snapshot-header-sync-lag status)
           (node-status-snapshot-block-count status)
           (node-status-snapshot-validated-block-count status)
           (node-status-snapshot-sync-stage status)
           (node-status-snapshot-sync-failed-stage status)
           (node-status-snapshot-sync-last-error status)
           (node-status-snapshot-last-peer-error status)))

(define n (node-open bitcoin-testnet-chain data-dir))
(let ((added (node-bootstrap-peers n)))
  (println "bootstrap-added: ~a" added)
  (let ((result (guard (err
                        (else #f))
                  (node-sync-with-peers n connect-live-peer 35 0 64 1))))
    (if result
        (begin
          (print-probe-status "result" result)
          (node-close n))
        (begin
          (print-probe-status "failed" (node-status n))
          (node-close n)
          (error "live probe failed")))))
